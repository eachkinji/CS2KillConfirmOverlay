<UserControl
    x:Class="KillConfirmGameBar.Controls.GameStyles.ValorantAdvancedEffectsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KillConfirmGameBar.Controls.GameStyles">

    <StackPanel Spacing="10">
        <StackPanel Spacing="2">
            <TextBlock
                x:Name="TitleText"
                FontSize="16"
                FontWeight="Bold"
                Text="VAL Effects" />
            <TextBlock
                x:Name="HintText"
                FontSize="10"
                Visibility="Collapsed"
                TextWrapping="WrapWholeWords" />
        </StackPanel>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <local:StreakWindowEditor
                x:Name="StreakEditor"
                Grid.ColumnSpan="2"
                SettingsChanged="OnStreakModeSelectionChanged" />
        </Grid>

        <ContentControl x:Name="StylePanelHost" />
    </StackPanel>
</UserControl>
