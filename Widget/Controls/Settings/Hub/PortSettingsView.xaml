<UserControl
    x:Class="KillConfirmGameBar.Controls.Settings.PortSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="ms-appx:///Controls/Settings/PanelDesign.xaml" />
        </ResourceDictionary.MergedDictionaries>

        <!-- Backward Compatibility Aliases for Code-Behind (theme brush overrides) -->
        <SolidColorBrush x:Key="HubCardBackground" Color="{StaticResource PanelSectionColor}" />
        <SolidColorBrush x:Key="HubCardBorder" Color="{StaticResource PanelBorderColor}" />
        <SolidColorBrush x:Key="HubDivider" Color="{StaticResource PanelDividerColor}" />
        <SolidColorBrush x:Key="HubTitleText" Color="{StaticResource PanelTextPrimaryColor}" />
        <SolidColorBrush x:Key="HubBodyText" Color="{StaticResource PanelTextSecondaryColor}" />
        <SolidColorBrush x:Key="HubMutedText" Color="{StaticResource PanelTextMutedColor}" />
        <SolidColorBrush x:Key="HubAccentText" Color="{StaticResource PanelAccentColor}" />
        <SolidColorBrush x:Key="HubPanelBackground" Color="{StaticResource PanelSectionColor}" />
        <SolidColorBrush x:Key="HubPanelBorder" Color="{StaticResource PanelBorderColor}" />

        <Style x:Key="FluentDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource PanelDangerButtonStyle}" />

        <Style x:Key="FluentBadgeBorderStyle" TargetType="Border">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Background" Value="{StaticResource PanelAccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource PanelControlRadius}" />
        </Style>

        <!-- Legacy Style Aliases for External/Internal Compatibility -->
        <Style x:Key="HubCardStyle" TargetType="Border" BasedOn="{StaticResource PanelSectionCardStyle}" />
        <Style x:Key="HubTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource PanelTitleTextStyle}" />
        <Style x:Key="HubBodyTextStyle" TargetType="TextBlock" BasedOn="{StaticResource PanelCaptionTextStyle}" />
        <Style x:Key="HubSectionLabelTextStyle" TargetType="TextBlock" BasedOn="{StaticResource PanelSectionTitleTextStyle}" />
        <Style x:Key="HubFieldLabelTextStyle" TargetType="TextBlock" BasedOn="{StaticResource PanelTitleTextStyle}" />
        <Style x:Key="HubHelperTextStyle" TargetType="TextBlock" BasedOn="{StaticResource PanelCaptionTextStyle}" />
        <Style x:Key="HubPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PanelPrimaryButtonStyle}" />
        <Style x:Key="HubSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PanelButtonStyle}" />
        <Style x:Key="HubBadgeBorderStyle" TargetType="Border" BasedOn="{StaticResource FluentBadgeBorderStyle}" />
        <Style x:Key="HubInputStyle" TargetType="TextBox" BasedOn="{StaticResource PanelTextBoxStyle}" />

        <Style x:Key="HubTabButtonStyle" TargetType="Button" BasedOn="{StaticResource PanelButtonStyle}">
            <Setter Property="MinWidth" Value="100" />
            <Setter Property="Background" Value="#F2F2F7" />
            <Setter Property="Foreground" Value="#3A3A3C" />
            <Setter Property="BorderBrush" Value="#E5E5EA" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="HubTabActiveButtonStyle" TargetType="Button" BasedOn="{StaticResource HubTabButtonStyle}">
            <Setter Property="Background" Value="{StaticResource PanelAccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelAccentBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>
            <ScrollViewer
                x:Name="HubPortView"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="12" MaxWidth="1480" HorizontalAlignment="Stretch">
                    <!-- Header Text Area -->
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,4,2,0" VerticalAlignment="Center"><Ellipse Width="22" Height="22" VerticalAlignment="Center"><Ellipse.Fill><ImageBrush x:Name="HubPortGameLogoBrush" Stretch="UniformToFill" ImageSource="ms-appx:///Assets/GameSources/CounterStrike/cs2.png"/></Ellipse.Fill></Ellipse><TextBlock x:Name="HubPortTitleText" Style="{StaticResource PanelTitleTextStyle}" VerticalAlignment="Center" Text="LOCAL SERVICE PORT" /></StackPanel>
                    <StackPanel Spacing="10" Margin="0,2,0,4">
                        <Border x:Name="CsCfgSectionCard" Style="{StaticResource PanelSectionCardStyle}">
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource PanelIconContainerStyle}"><FontIcon FontFamily="Segoe MDL2 Assets" FontSize="14" Glyph="&#xE8B7;" Foreground="{StaticResource PanelAccentBrush}"/></Border>
                                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock x:Name="CsRootTitleText" Style="{StaticResource PanelTitleTextStyle}" Text="游戏根目录与 CFG 配置"/>
                                        <TextBlock x:Name="CsRootPathText" Style="{StaticResource PanelCaptionTextStyle}" IsTextSelectionEnabled="True" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button x:Name="CsSelectRootButton" Style="{StaticResource PanelButtonStyle}" Content="选择根目录" Click="OnCsSelectRootClick"/>
                                        <Button x:Name="CsInstallCfgButton" Style="{StaticResource PanelPrimaryButtonStyle}" Content="一键写入 CFG" Click="OnCsInstallCfgClick"/>
                                    </StackPanel>
                                </Grid>
                                <Border Background="{StaticResource PanelSectionBrush}" BorderBrush="{StaticResource PanelDividerBrush}" Style="{StaticResource PanelSectionCardStyle}" Padding="12,8">
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Name="CsCfgDirPathText" FontFamily="Consolas" Style="{StaticResource PanelCaptionTextStyle}" IsTextSelectionEnabled="True" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="CsCfgStatusText" Style="{StaticResource PanelCaptionTextStyle}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border x:Name="LolPortSectionCard" Style="{StaticResource PanelSectionCardStyle}" Visibility="Collapsed">
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource PanelIconContainerStyle}"><FontIcon FontFamily="Segoe MDL2 Assets" FontSize="14" Glyph="&#xE8B7;" Foreground="{StaticResource PanelAccentBrush}"/></Border>
                                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock x:Name="LolRootTitleText" Style="{StaticResource PanelTitleTextStyle}" Text="英雄联盟游戏根目录与 Live Client 端口"/>
                                        <TextBlock x:Name="LolRootPathText" Style="{StaticResource PanelCaptionTextStyle}" IsTextSelectionEnabled="True" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="LolEndpointStatusText" FontFamily="Consolas" Style="{StaticResource PanelCaptionTextStyle}" IsTextSelectionEnabled="True" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button x:Name="LolSelectRootButton" Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource PanelButtonStyle}" Content="选择根目录" Click="OnLolSelectRootClick"/>
                                </Grid>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource PanelIconContainerStyle}"><FontIcon FontFamily="Segoe MDL2 Assets" FontSize="14" Glyph="&#xE945;" Foreground="{StaticResource PanelTextSecondaryBrush}"/></Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock x:Name="LolPollIntervalLabelText" Style="{StaticResource PanelTitleTextStyle}" Text="端口抓取速度调控 (Polling Interval)"/>
                                        <TextBlock x:Name="LolPollIntervalHintText" Style="{StaticResource PanelCaptionTextStyle}" Text="默认 50ms 极速采集；支持 20–1000ms 自定义调节。"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <ComboBox x:Name="LolPollIntervalSelector" Style="{StaticResource PanelComboBoxStyle}" Width="150" SelectionChanged="OnLolPollIntervalSelectionChanged">
                                            <ComboBoxItem Tag="50" Content="50ms (极速 · 推荐)"/>
                                            <ComboBoxItem Tag="100" Content="100ms (标准)"/>
                                            <ComboBoxItem Tag="250" Content="250ms (均衡)"/>
                                            <ComboBoxItem Tag="500" Content="500ms (省电)"/>
                                            <ComboBoxItem Tag="custom" Content="自定义 ms"/>
                                        </ComboBox>
                                        <TextBox x:Name="LolPollCustomInput" Style="{StaticResource PanelTextBoxStyle}" Width="84" FontFamily="Consolas" InputScope="Number" MaxLength="4" PlaceholderText="20-1000" Visibility="Collapsed"/>
                                        <Button x:Name="LolPollCustomApplyButton" Style="{StaticResource PanelPrimaryButtonStyle}" Content="应用" Click="OnLolPollCustomApplyClick" Visibility="Collapsed"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Spacing="2" Margin="2,4,2,4">
                        <TextBlock
                            x:Name="HubPortTitleTextLegacy" Visibility="Collapsed"
                            Style="{StaticResource PanelTitleTextStyle}"
                            Text="LOCAL SERVICE PORT" />
                        <TextBlock
                            x:Name="HubPortDescriptionText"
                            Style="{StaticResource PanelCaptionTextStyle}" />
                    </StackPanel>

                    <!-- Hero Card: Active Port & Status -->
                    <Border Style="{StaticResource PanelCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource PanelIconContainerStyle}" Width="40" Height="40" Background="{StaticResource PanelAccentSoftBrush}">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="16"
                                    Foreground="{StaticResource PanelAccentBrush}"
                                    Glyph="&#xE704;" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <TextBlock
                                        x:Name="HubPortCurrentLabel"
                                        Style="{StaticResource PanelTitleTextStyle}"
                                        VerticalAlignment="Center"
                                        Text="当前服务端口" />
                                    <Border Style="{StaticResource FluentBadgeBorderStyle}">
                                        <TextBlock
                                            x:Name="HubPortCurrentBadgeText"
                                            Foreground="{StaticResource PanelAccentBrush}"
                                            FontWeight="SemiBold" Style="{StaticResource PanelCaptionTextStyle}" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <TextBlock
                                        x:Name="HubPortCurrentValue"
                                        FontFamily="Consolas"
                                        Foreground="{StaticResource PanelAccentBrush}"
                                        VerticalAlignment="Center" Style="{StaticResource PanelPageTitleTextStyle}" />
                                    <TextBlock
                                        x:Name="HubPortServiceReportedValue"
                                        FontFamily="Consolas"
                                        Foreground="{StaticResource PanelTextMutedBrush}"
                                        VerticalAlignment="Center" Style="{StaticResource PanelCaptionTextStyle}" />
                                </StackPanel>
                            </StackPanel>

                            <Button
                                x:Name="HubPortRefreshButton"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Style="{StaticResource PanelButtonStyle}"
                                Click="OnHubPortRefreshClick">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="12" Glyph="&#xE72C;" />
                                    <TextBlock Text="重新检测" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- SettingsCard: Auto Search Port -->
                    <Border Style="{StaticResource PanelSectionCardStyle}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource PanelIconContainerStyle}">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="14"
                                    Foreground="{StaticResource PanelTextSecondaryBrush}"
                                    Glyph="&#xE721;" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock
                                    x:Name="HubPortAutoSearchLabel"
                                    Style="{StaticResource PanelTitleTextStyle}"
                                    Text="端口冲突时自动顺延切换" />
                                <TextBlock
                                    x:Name="HubPortAutoSearchHint"
                                    Style="{StaticResource PanelCaptionTextStyle}" />
                            </StackPanel>

                            <ToggleSwitch
                                x:Name="HubPortAutoSearchToggle"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                MinWidth="0"
                                OnContent=""
                                OffContent=""
                                Toggled="OnHubPortAutoSearchToggled" />
                        </Grid>
                    </Border>

                    <!-- SettingsCard: Backup Ports -->
                    <Border Style="{StaticResource PanelSectionCardStyle}">
                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource PanelIconContainerStyle}">
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="14"
                                        Foreground="{StaticResource PanelTextSecondaryBrush}"
                                        Glyph="&#xE8B9;" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock
                                        x:Name="HubPortBackupLabel"
                                        Style="{StaticResource PanelTitleTextStyle}"
                                        Text="快速切换备用端口" />
                                    <TextBlock
                                        x:Name="HubPortBackupHint"
                                        Style="{StaticResource PanelCaptionTextStyle}" />
                                </StackPanel>
                            </Grid>

                            <Border
                                Background="{StaticResource PanelSectionBrush}"
                                BorderBrush="{StaticResource PanelDividerBrush}" Style="{StaticResource PanelSectionCardStyle}">
                                <ItemsControl x:Name="HubPortBackupList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapGrid Orientation="Horizontal" MaximumRowsOrColumns="6" HorizontalAlignment="Left" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button
                                                Margin="0,0,8,0"
                                                MinWidth="76"
                                                Background="#FFFFFF"
                                                BorderBrush="#E0E0E5"
                                                BorderThickness="1"
                                                Foreground="{StaticResource PanelTextPrimaryBrush}"
                                                FontFamily="Consolas"
                                                FontWeight="SemiBold"
                                                Content="{Binding Label}"
                                                Tag="{Binding Port}"
                                                Click="OnPortChipClick" Style="{StaticResource PanelButtonStyle}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- SettingsCard: Custom Port Entry -->
                    <Border Style="{StaticResource PanelSectionCardStyle}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource PanelIconContainerStyle}">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="14"
                                    Foreground="{StaticResource PanelTextSecondaryBrush}"
                                    Glyph="&#xE70F;" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock
                                    x:Name="HubPortCustomLabel"
                                    Style="{StaticResource PanelTitleTextStyle}"
                                    Text="自定义端口" />
                                <TextBlock
                                    x:Name="HubPortCustomHint"
                                    Style="{StaticResource PanelCaptionTextStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBox
                                    x:Name="HubPortCustomInput"
                                    Style="{StaticResource PanelTextBoxStyle}"
                                    Width="120"
                                    FontFamily="Consolas"
                                    InputScope="Number"
                                    MaxLength="5"
                                    PlaceholderText="1024-65535" />
                                <Button
                                    x:Name="HubPortCustomApplyButton"
                                    Style="{StaticResource PanelPrimaryButtonStyle}"
                                    Click="OnHubPortCustomApplyClick" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- SettingsCard: Connection Probe Status -->
                    <Border Style="{StaticResource PanelSectionCardStyle}">
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource PanelIconContainerStyle}">
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="14"
                                        Foreground="{StaticResource PanelTextSecondaryBrush}"
                                        Glyph="&#xE946;" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock
                                        x:Name="HubPortStatusTitle"
                                        Style="{StaticResource PanelTitleTextStyle}"
                                        Text="连接状态" />
                                    <TextBlock
                                        x:Name="HubPortStatusBody"
                                        Style="{StaticResource PanelCaptionTextStyle}" />
                                </StackPanel>
                            </Grid>

                            <Border
                                Background="{StaticResource PanelSectionBrush}"
                                BorderBrush="{StaticResource PanelDividerBrush}" Style="{StaticResource PanelSectionCardStyle}">
                                <TextBlock
                                    x:Name="HubPortStatusMessage"
                                    FontFamily="Consolas"
                                    Foreground="{StaticResource PanelTextSecondaryBrush}"
                                    TextWrapping="Wrap" Style="{StaticResource PanelCaptionTextStyle}" />
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
</UserControl>
