<UserControl
    x:Class="KillConfirmGameBar.Controls.GameStyles.ValorantAdvancedEffectsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KillConfirmGameBar.Controls.GameStyles">

    <StackPanel Spacing="10">
        <StackPanel Spacing="2">
            <TextBlock
                x:Name="TitleText"
                FontSize="16"
                FontWeight="Bold"
                Text="VAL Effects" />
            <TextBlock
                x:Name="HintText"
                FontSize="10"
                Visibility="Collapsed"
                TextWrapping="WrapWholeWords" />
        </StackPanel>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <local:StreakWindowEditor
                x:Name="StreakEditor"
                SettingsChanged="OnStreakModeSelectionChanged" />

            <Border Grid.Column="1" Style="{StaticResource CompactChoiceCardStyle}">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Style="{StaticResource CompactCircleIconStyle}"><FontIcon FontSize="13" Foreground="White" Glyph="&#xE8D6;" /></Border>
                        <TextBlock x:Name="AssistAudioLabel" Style="{StaticResource CompactChoiceLabelStyle}" VerticalAlignment="Center" Text="Assist audio" />
                    </StackPanel>
                    <ToggleSwitch x:Name="AssistAudioToggle" MinWidth="0" IsOn="False" OffContent="Muted (default)" OnContent="Sound (common)" Toggled="OnAssistAudioToggled" />
                </StackPanel>
            </Border>

        </Grid>

        <ContentControl x:Name="StylePanelHost" />
    </StackPanel>
</UserControl>
