<UserControl
    x:Class="KillConfirmGameBar.Controls.Settings.CreditsCommunityPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="8">
        <TextBlock
            x:Name="CommunityTitleText"
            FontSize="13"
            FontWeight="SemiBold"
            Text="社区感谢" />

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <HyperlinkButton
                Padding="0"
                HorizontalContentAlignment="Stretch"
                NavigateUri="https://github.com/st0nie">
                <Border
                    x:Name="St0nieCommunityCard"
                    Padding="8"
                    BorderThickness="1"
                    CornerRadius="10">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="18">
                            <Image Source="ms-appx:///Assets/Credits/st0nie.png" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock x:Name="St0nieCommunityNameText" FontSize="11" FontWeight="SemiBold" Text="ston · st0nie" />
                            <TextBlock x:Name="St0nieCommunityRoleText" FontSize="9" Text="cskillconfirm 原作者" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Grid>
                </Border>
            </HyperlinkButton>

            <HyperlinkButton
                Grid.Column="1"
                Padding="0"
                HorizontalContentAlignment="Stretch"
                NavigateUri="https://github.com/gufan0000/cs2-customizer">
                <Border
                    x:Name="GufanCommunityCard"
                    Padding="8"
                    BorderThickness="1"
                    CornerRadius="10">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="18">
                            <Image Source="ms-appx:///Assets/Credits/gufan0000.png" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock x:Name="GufanCommunityNameText" FontSize="11" FontWeight="SemiBold" Text="gufan0000" />
                            <TextBlock x:Name="GufanCommunityRoleText" FontSize="9" Text="CS2 Customizer 作者" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Grid>
                </Border>
            </HyperlinkButton>
        </Grid>

        <TextBlock
            x:Name="ContributorsTitleText"
            Margin="0,2,0,0"
            FontSize="13"
            FontWeight="SemiBold"
            Text="代码贡献者" />

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <HyperlinkButton
                Padding="0"
                HorizontalContentAlignment="Stretch"
                NavigateUri="https://github.com/st0nie">
                <Border
                    x:Name="St0nieContributorCard"
                    Padding="8"
                    BorderThickness="1"
                    CornerRadius="10">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="30" Height="30" CornerRadius="15">
                            <Image Source="ms-appx:///Assets/Credits/st0nie.png" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock x:Name="St0nieContributorNameText" FontSize="10" FontWeight="SemiBold" Text="Ston Jia · st0nie" />
                            <TextBlock x:Name="St0nieContributorRoleText" FontSize="9" Text="安装包与发布支持" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Grid>
                </Border>
            </HyperlinkButton>

            <HyperlinkButton
                Grid.Column="1"
                Padding="0"
                HorizontalContentAlignment="Stretch"
                NavigateUri="https://github.com/system32ovo">
                <Border
                    x:Name="System32ContributorCard"
                    Padding="8"
                    BorderThickness="1"
                    CornerRadius="10">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="30" Height="30" CornerRadius="15">
                            <Image Source="ms-appx:///Assets/Credits/system32ovo.png" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock x:Name="System32ContributorNameText" FontSize="10" FontWeight="SemiBold" Text="XingKong1024ovo · system32ovo" TextWrapping="WrapWholeWords" />
                            <TextBlock x:Name="System32ContributorRoleText" FontSize="9" Text="死斗模式、游戏文件检测与稳定性改进" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Grid>
                </Border>
            </HyperlinkButton>
        </Grid>
    </StackPanel>
</UserControl>
