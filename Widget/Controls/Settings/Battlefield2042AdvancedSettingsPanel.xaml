<UserControl
    x:Class="KillConfirmGameBar.Controls.Settings.Battlefield2042AdvancedSettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        x:Name="Card"
        Padding="22"
        Background="#0B222D"
        BorderBrush="#1EDDDD"
        BorderThickness="1"
        CornerRadius="24">
        <StackPanel Spacing="10">
            <TextBlock
                x:Name="TitleText"
                FontSize="20"
                FontWeight="Bold"
                Text="Battlefield 2042 advanced settings" />
            <TextBlock
                x:Name="BodyText"
                FontSize="13"
                LineHeight="18"
                Text="2042 uses a separate HUD file set, battlefield2042 sound pack, and 2042-only UI. Imported files are disabled for this built-in module."
                TextWrapping="WrapWholeWords" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border x:Name="AssetTag" Padding="8,4" BorderThickness="1" CornerRadius="12">
                    <TextBlock x:Name="AssetTagText" FontSize="11" FontWeight="SemiBold" Text="2042 assets" />
                </Border>
                <Border x:Name="MoneyTag" Padding="8,4" BorderThickness="1" CornerRadius="12">
                    <TextBlock x:Name="MoneyTagText" FontSize="11" FontWeight="SemiBold" Text="Money waterfall" />
                </Border>
                <Border x:Name="ImportLockTag" Padding="8,4" BorderThickness="1" CornerRadius="12">
                    <TextBlock x:Name="ImportLockTagText" FontSize="11" FontWeight="SemiBold" Text="No file import" />
                </Border>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
