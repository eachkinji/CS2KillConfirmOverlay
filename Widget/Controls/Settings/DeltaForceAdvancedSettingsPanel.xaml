<UserControl
    x:Class="KillConfirmGameBar.Controls.Settings.DeltaForceAdvancedSettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        x:Name="Card"
        Padding="22"
        Background="#142A24"
        BorderBrush="#FFAE4B"
        BorderThickness="1"
        CornerRadius="24">
        <StackPanel Spacing="10">
            <TextBlock
                x:Name="TitleText"
                FontSize="20"
                FontWeight="Bold"
                Text="Delta Force advanced settings" />
            <TextBlock
                x:Name="BodyText"
                FontSize="13"
                LineHeight="18"
                Text="Delta Force uses a separate deltaforce sound pack, scrolling icon renderer, and deltaforce-only resource folder."
                TextWrapping="WrapWholeWords" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border x:Name="AssetTag" Padding="8,4" BorderThickness="1" CornerRadius="12">
                    <TextBlock x:Name="AssetTagText" FontSize="11" FontWeight="SemiBold" Text="deltaforce assets" />
                </Border>
                <Border x:Name="HudTag" Padding="8,4" BorderThickness="1" CornerRadius="12">
                    <TextBlock x:Name="HudTagText" FontSize="11" FontWeight="SemiBold" Text="Scrolling icons" />
                </Border>
                <Border x:Name="ImportLockTag" Padding="8,4" BorderThickness="1" CornerRadius="12">
                    <TextBlock x:Name="ImportLockTagText" FontSize="11" FontWeight="SemiBold" Text="No file import" />
                </Border>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
