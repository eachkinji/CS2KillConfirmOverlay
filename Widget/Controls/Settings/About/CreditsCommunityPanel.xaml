<UserControl
    x:Class="KillConfirmGameBar.Controls.Settings.CreditsCommunityPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="ms-appx:///Controls/Settings/PanelDesign.xaml" />
        </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Spacing="8">
        <TextBlock
            x:Name="CommunityTitleText"
            Text="社区感谢" Style="{StaticResource PanelTitleTextStyle}" />

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <HyperlinkButton
                Padding="0"
                HorizontalContentAlignment="Stretch"
                NavigateUri="https://github.com/st0nie">
                <Border
                    x:Name="St0nieCommunityCard" Style="{StaticResource PanelSectionCardStyle}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="18">
                            <Image x:Name="St0nieCommunityAvatar" Width="36" Height="36" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock x:Name="St0nieCommunityNameText" FontWeight="SemiBold" Text="ston · st0nie" Style="{StaticResource PanelCaptionTextStyle}" />
                            <TextBlock x:Name="St0nieCommunityRoleText" Text="cskillconfirm 原作者" TextWrapping="WrapWholeWords" Style="{StaticResource PanelCaptionTextStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </HyperlinkButton>

            <HyperlinkButton
                Grid.Column="1"
                Padding="0"
                HorizontalContentAlignment="Stretch"
                NavigateUri="https://github.com/gufan0000/cs2-customizer">
                <Border
                    x:Name="GufanCommunityCard" Style="{StaticResource PanelSectionCardStyle}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="18">
                            <Image x:Name="GufanCommunityAvatar" Width="36" Height="36" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock x:Name="GufanCommunityNameText" FontWeight="SemiBold" Text="gufan0000" Style="{StaticResource PanelCaptionTextStyle}" />
                            <TextBlock x:Name="GufanCommunityRoleText" Text="CS2 Customizer 作者" TextWrapping="WrapWholeWords" Style="{StaticResource PanelCaptionTextStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </HyperlinkButton>
        </Grid>

        <TextBlock
            x:Name="ContributorsTitleText"
            Margin="0,2,0,0"
            Text="代码贡献者" Style="{StaticResource PanelTitleTextStyle}" />

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <HyperlinkButton
                Padding="0"
                HorizontalContentAlignment="Stretch"
                NavigateUri="https://github.com/st0nie">
                <Border
                    x:Name="St0nieContributorCard" Style="{StaticResource PanelSectionCardStyle}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="30" Height="30" CornerRadius="15">
                            <Image x:Name="St0nieContributorAvatar" Width="30" Height="30" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock x:Name="St0nieContributorNameText" FontWeight="SemiBold" Text="Ston Jia · st0nie" Style="{StaticResource PanelCaptionTextStyle}" />
                            <TextBlock x:Name="St0nieContributorRoleText" Text="安装包与发布支持" TextWrapping="WrapWholeWords" Style="{StaticResource PanelCaptionTextStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </HyperlinkButton>

            <HyperlinkButton
                Grid.Column="1"
                Padding="0"
                HorizontalContentAlignment="Stretch"
                NavigateUri="https://github.com/system32ovo">
                <Border
                    x:Name="System32ContributorCard" Style="{StaticResource PanelSectionCardStyle}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="30" Height="30" CornerRadius="15">
                            <Image x:Name="System32ContributorAvatar" Width="30" Height="30" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock x:Name="System32ContributorNameText" FontWeight="SemiBold" Text="XingKong1024ovo · system32ovo" TextWrapping="WrapWholeWords" Style="{StaticResource PanelCaptionTextStyle}" />
                            <TextBlock x:Name="System32ContributorRoleText" Text="死斗模式、游戏文件检测与稳定性改进" TextWrapping="WrapWholeWords" Style="{StaticResource PanelCaptionTextStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </HyperlinkButton>
        </Grid>
    </StackPanel>
</UserControl>
