<Page
    x:Class="KillConfirmGameBar.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sources="using:KillConfirmGameBar.Controls.GameSources"
    xmlns:local="using:KillConfirmGameBar"
    xmlns:appearance="using:KillConfirmGameBar.Pages.Main.Appearance"
    xmlns:gameStyles="using:KillConfirmGameBar.Controls.GameStyles"
    xmlns:settings="using:KillConfirmGameBar.Controls.Settings"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    RequestedTheme="Light">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Pages/Main/Appearance/MainPage.Resources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="PackCardTemplate">
                <ContentControl Width="270" Height="108" IsTabStop="False"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                    DataContextChanged="OnPackCardHostDataContextChanged"
                    Loaded="OnPackCardHostLoaded" Unloaded="OnPackCardHostUnloaded" />
            </DataTemplate>
            <Style x:Key="PackCardContainerStyle" TargetType="GridViewItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="SettingsRootGrid" Background="{StaticResource MainBackgroundGradient}">
        <appearance:MainPageBackgroundView x:Name="BackgroundDecoration" IsHitTestVisible="False" />

        <Grid x:Name="ShellContentGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="84" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Two independent icon-only docks. They never expand; labels live in tooltips and automation names. -->
            <StackPanel x:Name="NavigationDocks" Grid.ColumnSpan="2" Canvas.ZIndex="20"
                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,12,0,12" Spacing="16">
                <Border x:Name="GameModeSidebar" Width="60" CornerRadius="20"
                    HorizontalAlignment="Left" Background="{StaticResource GlassPanelBrush}"
                    BorderBrush="{StaticResource GlassPanelBorderBrush}" BorderThickness="1">
                    <!-- Width equals the compact pane so no content area (and its rounded border) is laid out.
                         The template reserves ~17px of empty footer below the items; it stays in layout (shrinking
                         the view makes the item list scroll) but the negative bottom margin and clip hide it so the
                         top and bottom insets match. NavigationValidation asserts the equal insets. -->
                    <NavigationView x:Name="GameStyleSidebarSelector" Width="58" Height="146" Margin="0,2,0,-15"
                        Background="Transparent" CompactPaneLength="58" OpenPaneLength="58"
                        IsBackButtonVisible="Collapsed" IsPaneOpen="False" IsPaneToggleButtonVisible="False"
                        IsSettingsVisible="False" PaneDisplayMode="LeftCompact"
                        SelectionChanged="OnGameStyleSidebarSelectionChanged">
                        <NavigationView.Clip><RectangleGeometry Rect="0,0,58,129"/></NavigationView.Clip>
                        <NavigationView.Resources>
                            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent"/>
                            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent"/>
                            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent"/>
                            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent"/>
                        </NavigationView.Resources>
                        <NavigationView.MenuItems>
                            <NavigationViewItem x:Name="HomeSidebarItem" Tag="home" Content="主页" AutomationProperties.Name="主页" ToolTipService.ToolTip="主页">
                                <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;"/></NavigationViewItem.Icon>
                            </NavigationViewItem>
                            <NavigationViewItem x:Name="AdvancedSettingsSidebarItem" Tag="advanced" Content="高级设置" AutomationProperties.Name="高级设置" ToolTipService.ToolTip="高级设置">
                                <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;"/></NavigationViewItem.Icon>
                            </NavigationViewItem>
                            <NavigationViewItem x:Name="StyleSettingsSidebarItem" Tag="styles" Content="游戏风格设置" AutomationProperties.Name="游戏风格设置" ToolTipService.ToolTip="游戏风格设置">
                                <NavigationViewItem.Icon><FontIcon Glyph="&#xE790;"/></NavigationViewItem.Icon>
                            </NavigationViewItem>
                        </NavigationView.MenuItems>
                    </NavigationView>
                </Border>
                <Border x:Name="GameSourceDock" HorizontalAlignment="Left" Padding="9"
                    CornerRadius="20" Background="{StaticResource GlassPanelBrush}"
                    BorderBrush="{StaticResource GlassPanelBorderBrush}" BorderThickness="1">
                    <sources:GameSourceSelector x:Name="SidebarGameSources" Sidebar="True"/>
                </Border>
            </StackPanel>

            <!-- Main Content Area -->
            <ScrollViewer x:Name="PackLibraryScrollViewer" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent">
                <Grid Padding="24,20,24,28" RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Top Header Bar -->
                    <Grid
                        x:Name="PageTitleHeader"
                        MaxWidth="1480"
                        HorizontalAlignment="Stretch"
                        Padding="0"
                        Canvas.ZIndex="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            x:Name="PageTitleSurface"
                            Grid.ColumnSpan="2"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="10">
                            <TextBlock Style="{StaticResource PanelPageTitleTextStyle}" x:Name="TitleText" Margin="4,2" Text="主页" />
                        </Border>
                        <Border x:Name="StylePickerSurface" Grid.ColumnSpan="2" Padding="8" CornerRadius="20"
                            Background="{StaticResource GlassPanelBrush}" BorderBrush="{StaticResource GlassPanelBorderBrush}"
                            BorderThickness="1" Visibility="Collapsed">
                            <local:GameStyleWrapPanel x:Name="StylePicker"
                                HorizontalAlignment="Stretch" AutomationProperties.Name="游戏风格"/>
                        </Border>

                        <!-- Hidden compatibility anchor -->
                        <StackPanel Grid.Column="1" Visibility="Collapsed">
                            <TextBlock x:Name="GameStyleLabelText" />
                            <ComboBox x:Name="GameStyleSelector" SelectionChanged="OnGameStyleSelectionChanged">
                                <ComboBoxItem x:Name="CrossfireStyleItem" Tag="crossfire">CrossFire (穿越火线)</ComboBoxItem>
                                <ComboBoxItem x:Name="CsolStyleItem" Tag="csol">CSOL (反恐精英Online)</ComboBoxItem>
                                <ComboBoxItem x:Name="ValorantStyleItem" Tag="valorant">Valorant (无畏契约)</ComboBoxItem>
                                <ComboBoxItem x:Name="OverwatchStyleItem" Tag="overwatch">OverWatch (守望先锋)</ComboBoxItem>
                                <ComboBoxItem x:Name="ApexStyleItem" Tag="apex">Apex Legends (Apex 英雄)</ComboBoxItem>
                                <ComboBoxItem x:Name="CalabiyauStyleItem" Tag="calabiyau">卡拉彼丘 / Strinova</ComboBoxItem>
                                <ComboBoxItem x:Name="PubgStyleItem" Tag="pubg">PUBG (绝地求生)</ComboBoxItem>
                                <ComboBoxItem x:Name="DeltaForceStyleItem" Tag="deltaforce">Delta Force (三角洲行动)</ComboBoxItem>
                                <ComboBoxItem x:Name="Battlefield4StyleItem" Tag="battlefield4">Battlefield 4 (战地4)</ComboBoxItem>
                                <ComboBoxItem x:Name="Battlefield1StyleItem" Tag="battlefield1">Battlefield 1 (战地1)</ComboBoxItem>
                                <ComboBoxItem x:Name="Battlefield5StyleItem" Tag="battlefield5">Battlefield V (战地5)</ComboBoxItem>
                                <ComboBoxItem x:Name="Battlefield2042StyleItem" Tag="battlefield2042">Battlefield 2042 (战地2042)</ComboBoxItem>
                                <ComboBoxItem x:Name="Battlefield6StyleItem" Tag="battlefield6">Battlefield 6 (战地6)</ComboBoxItem>
                                <ComboBoxItem x:Name="ModernWarfare2019StyleItem" Tag="modernwarfare2019">Modern Warfare 2019 (使命召唤：现代战争)</ComboBoxItem>
                                <ComboBoxItem x:Name="SanguoshaStyleItem" Tag="sanguosha">Sanguosha (三国杀)</ComboBoxItem>
                                <ComboBoxItem x:Name="DoubaoStyleItem" Tag="doubao">Doubao (豆包)</ComboBoxItem>
                                <ComboBoxItem x:Name="DagoujiaoStyleItem" Tag="dagoujiao">Big Dog Bark (大狗叫)</ComboBoxItem>
                                <ComboBoxItem x:Name="CustomModuleStyleItem" Tag="custommodule">自定义</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- Advanced settings navigation, independent of home and game configuration. -->
                    <Border
                        x:Name="AdvancedSettingsTabBar"
                        Grid.Row="1"
                        MaxWidth="1480"
                        Padding="4"
                        HorizontalAlignment="Left"
                        Background="{StaticResource GlassTrackBrush}"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        CornerRadius="{StaticResource PanelSectionRadius}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button
                                x:Name="HomeTabGeneralButton"
                                Style="{StaticResource StudioTabActiveButtonStyle}"
                                Content="游戏体验增强"
                                Click="OnHomeTabGeneralClick" />
                            <Button
                                x:Name="HomeTabPortButton"
                                Style="{StaticResource StudioTabButtonStyle}"
                                Content="本地服务端口"
                                Click="OnHomeTabPortClick" />
                            <Button
                                x:Name="HomeTabDisplayButton"
                                Style="{StaticResource StudioTabButtonStyle}"
                                Content="进阶设置"
                                Click="OnHomeTabDisplayClick" />
                            <Button
                                x:Name="HomeTabAboutButton"
                                Style="{StaticResource StudioTabButtonStyle}"
                                Content="关于本版本"
                                Click="OnHomeTabAboutClick" />
                        </StackPanel>
                    </Border>

                    <!-- Game Studio Unified Navigation Tab Bar (For ALL games: CF, CSOL, Valorant, BF1, BF5, BF4, BF2042, PUBG, Delta Force, Doubao, Dagoujiao) -->
                    <Border
                        x:Name="GameWorkspaceTabBar"
                        Grid.Row="1"
                        MaxWidth="1480"
                        Padding="4"
                        HorizontalAlignment="Left"
                        Background="{StaticResource GlassTrackBrush}"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        CornerRadius="{StaticResource PanelSectionRadius}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button
                                x:Name="GameTabCombatButton"
                                Style="{StaticResource StudioTabActiveButtonStyle}"
                                Content="战斗与视效"
                                Click="OnGameTabCombatClick" />
                            <Button
                                x:Name="GameTabSoundEffectButton"
                                Style="{StaticResource StudioTabButtonStyle}"
                                Content="音效包库"
                                Click="OnGameTabSoundEffectClick" />
                            <Button
                                x:Name="GameTabVoiceButton"
                                Style="{StaticResource StudioTabButtonStyle}"
                                Content="语音包库"
                                Click="OnGameTabVoiceClick" />
                            <Button
                                x:Name="GameTabIconButton"
                                Style="{StaticResource StudioTabButtonStyle}"
                                Content="图标包库"
                                Click="OnGameTabIconClick" />
                            <Button
                                x:Name="GameTabGuideButton"
                                Style="{StaticResource StudioTabButtonStyle}"
                                Content="自定义指南"
                                Click="OnGameTabGuideClick" />
                        </StackPanel>
                    </Border>

                    <ContentControl x:Name="CompatibilityPageContent" Grid.Row="2" Visibility="Collapsed" HorizontalContentAlignment="Stretch" />
                    <!-- Advanced settings workspace -->
                    <Grid
                        x:Name="AdvancedSettingsContent"
                        Grid.Row="2"
                        MaxWidth="1480"
                        HorizontalAlignment="Stretch">
                        <settings:AdvancedSettingsHub x:Name="AdvancedSettingsHubControl" />
                    </Grid>

                    <!-- Game Control Page Content (Full Width Dedicated Views) -->
                    <Grid
                        x:Name="GamePageContent"
                        Grid.Row="2"
                        MaxWidth="1480"
                        HorizontalAlignment="Stretch">

                        <!-- View 1: Combat & Effects Engine Controls (Full Width) -->
                        <Border x:Name="GameEffectsCard" Style="{StaticResource SettingsSectionCardStyle}">
                            <StackPanel Spacing="14">
                                <TextBlock
                                    x:Name="GameEffectsTitleText"
                                    Style="{StaticResource SettingsSectionTitleTextStyle}"
                                    Text="CF 战斗与特效设置" />
                                <gameStyles:KillFeedbackAppearanceEditor
                                    x:Name="KillFeedbackAppearanceEditorControl" />
                                <ContentControl
                                    x:Name="GameAdvancedSettingsPanelHost"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch" />
                            </StackPanel>
                        </Border>

                        <!-- View 2: Voice Packs Hub (Full Width) -->
                        <Border
                            x:Name="VoicePackCollectionsCard"
                            AllowDrop="True"
                            DragOver="OnVoicePackLibraryDragOver"
                            Drop="OnVoicePackLibraryDrop"
                            Style="{StaticResource SettingsSectionCardStyle}"
                            Visibility="Collapsed">
                            <StackPanel Spacing="16">
                                <Grid RowSpacing="12">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Spacing="4" Grid.ColumnSpan="2">
                                        <TextBlock
                                            x:Name="VoiceCollectionsTitleText"
                                            Style="{StaticResource SettingsSectionTitleTextStyle}"
                                            Text="角色语音包库" />
                                        <TextBlock
                                            x:Name="VoiceCollectionsHintText"
                                            Style="{StaticResource SettingsCaptionTextStyle}"
                                            Text="官方角色与自定义语音包统一管理，可在游戏内悬浮窗随时切换启用。" />
                                    </StackPanel>

                                    <StackPanel
                                        Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Left"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                        <Button
                                            x:Name="DownloadVoicePackButton"
                                            Style="{StaticResource SettingsDownloadButtonStyle}"
                                            Click="OnDownloadPackClick" />
                                        <Button
                                            x:Name="ImportVoiceZipButton"
                                            Style="{StaticResource SettingsHeaderButtonStyle}"
                                            Click="OnImportVoiceZipClick" />
                                        <Button
                                            x:Name="BatchImportVoiceZipButton"
                                            Style="{StaticResource SettingsHeaderButtonStyle}"
                                            Click="OnBatchImportVoiceZipClick" />
                                        <Button
                                            x:Name="CreateVoicePackButton"
                                            Style="{StaticResource SettingsPrimaryButtonStyle}"
                                            Click="OnCreateVoicePackClick" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock
                                    x:Name="VoiceVisibleCountText"
                                    Foreground="{StaticResource AccentBrush}" />

                                <GridView x:Name="VoicePackListPanel" Margin="0,0,0,24"
                                    MaxHeight="540" SelectionMode="None" IsItemClickEnabled="False"
                                    CanDragItems="True" CanReorderItems="True" AllowDrop="True" IsSwipeEnabled="True"
                                    ItemTemplate="{StaticResource PackCardTemplate}"
                                    ItemContainerStyle="{StaticResource PackCardContainerStyle}"
                                    DragItemsStarting="OnNativePackDragStarting"
                                    DragItemsCompleted="OnNativePackDragCompleted"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <GridView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ItemsWrapGrid Orientation="Horizontal" ItemWidth="270" ItemHeight="108" />
                                        </ItemsPanelTemplate>
                                    </GridView.ItemsPanel>
                                </GridView>
                                <Grid MinHeight="156" Background="Transparent">
                                    <Rectangle Stroke="#C7C7CC" StrokeThickness="1.5" StrokeDashArray="4,3" RadiusX="16" RadiusY="16" IsHitTestVisible="False" />
                                    <StackPanel Margin="24" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock x:Name="VoicePackDropHint" TextAlignment="Center" TextWrapping="Wrap" Style="{StaticResource PanelTitleTextStyle}" />
                                        <TextBlock x:Name="VoicePackDownloadHint" TextAlignment="Center" TextWrapping="Wrap" Style="{StaticResource SettingsCaptionTextStyle}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- View 3: Icon Packs Hub (Full Width) -->
                        <Border
                            x:Name="IconPackCollectionsCard"
                            AllowDrop="True"
                            DragOver="OnIconPackLibraryDragOver"
                            Drop="OnIconPackLibraryDrop"
                            Style="{StaticResource SettingsSectionCardStyle}"
                            Visibility="Collapsed">
                            <StackPanel Spacing="16">
                                <Grid RowSpacing="12">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Spacing="4" Grid.ColumnSpan="2">
                                        <TextBlock
                                            x:Name="IconCollectionsTitleText"
                                            Style="{StaticResource SettingsSectionTitleTextStyle}"
                                            Text="击杀图标包库" />
                                        <TextBlock
                                            x:Name="IconCollectionsHintText"
                                            Style="{StaticResource SettingsCaptionTextStyle}"
                                            Text="经典原版、VIP、王者之魄、CFPL 及自定义图标包统一管理。" />
                                    </StackPanel>

                                    <StackPanel
                                        Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Left"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                        <Button
                                            x:Name="DownloadIconPackButton"
                                            Style="{StaticResource SettingsDownloadButtonStyle}"
                                            Click="OnDownloadPackClick" />
                                        <Button
                                            x:Name="ImportIconZipButton"
                                            Style="{StaticResource SettingsHeaderButtonStyle}"
                                            Click="OnImportIconZipClick" />
                                        <Button
                                            x:Name="BatchImportIconZipButton"
                                            Style="{StaticResource SettingsHeaderButtonStyle}"
                                            Click="OnBatchImportIconZipClick" />
                                        <Button
                                            x:Name="CreateIconPackButton"
                                            Style="{StaticResource SettingsPrimaryButtonStyle}"
                                            Click="OnCreateIconPackClick" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock
                                    x:Name="IconVisibleCountText"
                                    Foreground="{StaticResource AccentBrush}" />

                                <GridView x:Name="IconPackListPanel" Margin="0,0,0,24"
                                    MaxHeight="540" SelectionMode="None" IsItemClickEnabled="False"
                                    CanDragItems="True" CanReorderItems="True" AllowDrop="True" IsSwipeEnabled="True"
                                    ItemTemplate="{StaticResource PackCardTemplate}"
                                    ItemContainerStyle="{StaticResource PackCardContainerStyle}"
                                    DragItemsStarting="OnNativePackDragStarting"
                                    DragItemsCompleted="OnNativePackDragCompleted"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <GridView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ItemsWrapGrid Orientation="Horizontal" ItemWidth="270" ItemHeight="108" />
                                        </ItemsPanelTemplate>
                                    </GridView.ItemsPanel>
                                </GridView>
                                <Grid MinHeight="156" Background="Transparent">
                                    <Rectangle Stroke="#C7C7CC" StrokeThickness="1.5" StrokeDashArray="4,3" RadiusX="16" RadiusY="16" IsHitTestVisible="False" />
                                    <StackPanel Margin="24" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock x:Name="IconPackDropHint" TextAlignment="Center" TextWrapping="Wrap" Style="{StaticResource PanelTitleTextStyle}" />
                                        <TextBlock x:Name="IconPackDownloadHint" TextAlignment="Center" TextWrapping="Wrap" Style="{StaticResource SettingsCaptionTextStyle}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- View 4: Lightweight Technical Specifications & Guide (Full Width) -->
                        <Border x:Name="VoiceCollectionsCard" Style="{StaticResource SettingsSectionCardStyle}" Visibility="Collapsed">
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        x:Name="StructureTitleText"
                                        Style="{StaticResource SettingsSectionTitleTextStyle}"
                                        Text="CF 资源包制作指南" />
                                    <TextBlock
                                        x:Name="StructureBodyText"
                                        Style="{StaticResource SettingsCaptionTextStyle}"
                                        Text="内置包和自定义包都可以直接选择使用；导入素材时会自动整理所需文件。" />
                                </StackPanel>

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Audio Slot Spec Box -->
                                    <Border Style="{StaticResource PanelSectionCardStyle}">
                                        <StackPanel Spacing="8">
                                            <TextBlock x:Name="StructureVoiceSpecTitleText" Style="{StaticResource MethodStepDetailTitleTextStyle}" Text="提示音文件说明" />
                                            <TextBlock x:Name="StructureVoiceSpecBodyText" Style="{StaticResource MethodStepMonoTextStyle}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Icon Slot Spec Box -->
                                    <Border Grid.Column="1" Style="{StaticResource PanelSectionCardStyle}">
                                        <StackPanel Spacing="8">
                                            <TextBlock x:Name="StructureIconSpecTitleText" Style="{StaticResource MethodStepDetailTitleTextStyle}" Text="图标文件说明" />
                                            <TextBlock x:Name="StructureIconSpecSummaryText" Style="{StaticResource MethodStepBodyTextStyle}" Foreground="{StaticResource AccentBrush}" />
                                            <Button
                                                x:Name="IconSpecToggleButton"
                                                Style="{StaticResource MethodInlineButtonStyle}"
                                                HorizontalAlignment="Left"
                                                Click="OnIconSpecToggleClick" />
                                            <TextBlock
                                                x:Name="StructureIconSpecFullText"
                                                Style="{StaticResource MethodStepMonoTextStyle}"
                                                Visibility="Collapsed" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Style="{StaticResource PanelSectionCardStyle}">
                                    <TextBlock x:Name="StructureFileHintText" Style="{StaticResource MethodStepBodyTextStyle}" Foreground="{StaticResource TextSecondaryBrush}" />
                                </Border>

                                <!-- Hidden compatibility anchors for theme / language code-behind -->
                                <TextBlock x:Name="StructureImportFolderTitleText" Visibility="Collapsed" />
                                <TextBlock x:Name="StructureImportFolderBodyText" Visibility="Collapsed" />
                                <TextBlock x:Name="StructureImportZipTitleText" Visibility="Collapsed" />
                                <TextBlock x:Name="StructureImportZipBodyText" Visibility="Collapsed" />
                                <TextBlock x:Name="StructureCreatorTitleText" Visibility="Collapsed" />
                                <TextBlock x:Name="StructureCreatorBodyText" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="IconCollectionsCard" Visibility="Collapsed">
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="TipsTitleText" />
                                <TextBlock x:Name="TipsBodyText" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="CsolGuideCard" Style="{StaticResource SettingsSectionCardStyle}" Visibility="Collapsed">
                            <StackPanel Spacing="12">
                                <TextBlock Style="{StaticResource PanelSectionTitleTextStyle}" x:Name="CsolStructureTitleText" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Style="{StaticResource PanelCaptionTextStyle}" x:Name="CsolStructureBodyText" Foreground="{StaticResource TextTertiaryBrush}" TextWrapping="WrapWholeWords" />
                                <Border Style="{StaticResource PanelSectionCardStyle}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Style="{StaticResource PanelTitleTextStyle}" x:Name="CsolStructureVoiceSpecTitle" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Style="{StaticResource PanelCaptionTextStyle}" x:Name="CsolStructureVoiceSpecBody" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Consolas" TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource PanelSectionCardStyle}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Style="{StaticResource PanelTitleTextStyle}" x:Name="CsolStructureIconSpecTitle" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Style="{StaticResource PanelCaptionTextStyle}" x:Name="CsolStructureIconSpecBody" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Consolas" TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Style="{StaticResource PanelTitleTextStyle}" x:Name="CsolStructureImportZipTitle" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Style="{StaticResource PanelCaptionTextStyle}" x:Name="CsolStructureImportZipBody" Foreground="{StaticResource TextTertiaryBrush}" TextWrapping="WrapWholeWords" />
                                <TextBlock Style="{StaticResource PanelTitleTextStyle}" x:Name="CsolStructureCreatorTitle" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Style="{StaticResource PanelCaptionTextStyle}" x:Name="CsolStructureCreatorBody" Foreground="{StaticResource TextTertiaryBrush}" TextWrapping="WrapWholeWords" />
                                <TextBlock Style="{StaticResource PanelCaptionTextStyle}" x:Name="CsolStructureFileHint" Foreground="{StaticResource AccentBrush}" TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
