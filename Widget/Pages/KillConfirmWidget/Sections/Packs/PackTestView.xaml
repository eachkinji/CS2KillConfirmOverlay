            <ComboBox
                x:Name="AudioVolumeSelector" x:FieldModifier="public"
                Grid.Column="1"
                Width="82"
                Style="{StaticResource NarrowComboBoxStyle}"
                SelectionChanged="OnAudioVolumeSelectionChanged"
