<UserControl
    x:Class="KillConfirmGameBar.Controls.GameStyles.Battlefield2042AdvancedEffectsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KillConfirmGameBar.Controls.GameStyles">

    <StackPanel Spacing="8">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock
                    x:Name="TitleText"
                    FontSize="13"
                    FontWeight="Bold"
                    Text="2042 Effects" />
                <TextBlock
                    x:Name="HintText"
                    FontSize="10"
                    Visibility="Collapsed"
                    TextWrapping="WrapWholeWords" />
            </StackPanel>
            <Button
                x:Name="ResetButton"
                Grid.Column="1"
                MinWidth="88"
                Height="34"
                Padding="14,0"
                VerticalAlignment="Top"
                AutomationProperties.Name="Restore 2042 defaults"
                Click="OnResetButtonClick">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="12" Glyph="&#xE777;" />
                    <TextBlock x:Name="ResetButtonText" Text="Reset" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CompactChoiceCardStyle}">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Style="{StaticResource CompactCircleIconStyle}"><FontIcon FontSize="13" Foreground="White" Glyph="&#xE8C7;" /></Border>
                        <TextBlock x:Name="MoneyRewardModeLabel" Style="{StaticResource CompactChoiceLabelStyle}" VerticalAlignment="Center" Text="Money" />
                    </StackPanel>
                    <ComboBox x:Name="MoneyRewardModeSelector" SelectedIndex="0" Style="{StaticResource CompactSettingsComboBoxStyle}" SelectionChanged="OnMoneyRewardModeSelectionChanged" ToolTipService.ToolTip="Money reward calculation">
                        <ComboBoxItem x:Name="MoneyRewardDeltaItem" Tag="delta">Actual money change (recommended)</ComboBoxItem>
                        <ComboBoxItem x:Name="MoneyRewardRulesItem" Tag="rules">Kill reward rules</ComboBoxItem>
                    </ComboBox>
                </StackPanel>
            </Border>
            <local:StreakWindowEditor
                x:Name="StreakEditor"
                Grid.Column="1"
                SettingsChanged="OnStreakModeSelectionChanged" />
        </Grid>

        <Border x:Name="VisualEffectsCard" Padding="12" BorderThickness="1" CornerRadius="8">
            <StackPanel Spacing="8">
                <TextBlock x:Name="VisualEffectsTitle" FontSize="12" FontWeight="SemiBold" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="KillMarkEffectLabel" VerticalAlignment="Center" FontSize="10" TextWrapping="WrapWholeWords" />
                    <ToggleSwitch x:Name="KillMarkEffectToggle" Grid.Column="1" MinWidth="0" Toggled="OnKillMarkEffectToggled" />
                </Grid>
            </StackPanel>
        </Border>

        <local:Battlefield2042StylePanel x:Name="StylePanel" />
        <Border
            x:Name="ImportLockedNotice"
            Padding="8"
            BorderThickness="1"
            Visibility="Collapsed"
            CornerRadius="10">
            <TextBlock
                x:Name="ImportLockedText"
                FontSize="10"
                Text="Battlefield 2042 visuals stay built in; event sounds can be customized above."
                TextWrapping="WrapWholeWords" />
        </Border>
    </StackPanel>
</UserControl>
