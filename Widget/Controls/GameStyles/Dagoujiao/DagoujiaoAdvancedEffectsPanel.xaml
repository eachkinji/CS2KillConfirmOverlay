<UserControl
    x:Class="KillConfirmGameBar.Controls.GameStyles.DagoujiaoAdvancedEffectsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KillConfirmGameBar.Controls.GameStyles">

    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="ms-appx:///Controls/Settings/PanelDesign.xaml" />
        </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Spacing="12">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock x:Name="TitleText" Text="大狗叫高级设置" Style="{StaticResource PanelSectionTitleTextStyle}" />
            </StackPanel>
            <Button
                x:Name="ResetButton"
                Grid.Column="1"
                MinWidth="88"
                VerticalAlignment="Top"
                AutomationProperties.Name="Restore Dagoujiao defaults"
                Click="OnResetButtonClick" Style="{StaticResource PanelPrimaryButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="12" Glyph="&#xE777;" />
                    <TextBlock x:Name="ResetButtonText" Text="Reset" />
                </StackPanel>
            </Button>
        </Grid>

        <local:StreakWindowEditor x:Name="StreakEditor" SettingsChanged="OnStreakSettingChanged" />

        <Border x:Name="VisualEffectsCard" Style="{StaticResource PanelSectionCardStyle}">
            <StackPanel Spacing="8">
                <TextBlock x:Name="VisualEffectsTitle" Style="{StaticResource PanelTitleTextStyle}" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="KillMarkEffectLabel" VerticalAlignment="Center" TextWrapping="WrapWholeWords" Style="{StaticResource PanelCaptionTextStyle}" />
                    <ToggleSwitch x:Name="KillMarkEffectToggle" Grid.Column="1" MinWidth="0" Toggled="OnKillMarkEffectToggled" />
                </Grid>
            </StackPanel>
        </Border>

        <Grid ColumnSpacing="8" RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="4">
                <TextBlock x:Name="EpicCountLabel" Text="Epic 击杀数" Style="{StaticResource PanelCaptionTextStyle}" />
                <ComboBox x:Name="EpicKillCountSelector" SelectionChanged="OnCoreSettingChanged" Style="{StaticResource PanelComboBoxStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock x:Name="PriorityLabel" Text="音效优先级" Style="{StaticResource PanelCaptionTextStyle}" />
                <ComboBox x:Name="PrioritySelector" SelectionChanged="OnCoreSettingChanged" Style="{StaticResource PanelComboBoxStyle}">
                    <ComboBoxItem x:Name="HeadshotPriorityItem" Tag="headshot">爆头优先</ComboBoxItem>
                    <ComboBoxItem x:Name="StreakPriorityItem" Tag="streak">连杀优先</ComboBoxItem>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Row="1" Spacing="4">
                <TextBlock x:Name="OpacityLabel" Text="显示透明度：50%" Style="{StaticResource PanelCaptionTextStyle}" />
                <Slider x:Name="OpacitySlider" Minimum="10" Maximum="100" StepFrequency="5" ValueChanged="OnCoreSettingChanged" />
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                <TextBlock x:Name="InitialScaleLabel" Text="第一杀缩放：0.50×" Style="{StaticResource PanelCaptionTextStyle}" />
                <Slider x:Name="InitialScaleSlider" Minimum="10" Maximum="400" StepFrequency="10" ValueChanged="OnCoreSettingChanged" />
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="4">
                <TextBlock x:Name="ScaleLabel" Text="Epic 前一杀缩放：2.00×" Style="{StaticResource PanelCaptionTextStyle}" />
                <Slider x:Name="MaximumScaleSlider" Minimum="10" Maximum="400" StepFrequency="10" ValueChanged="OnCoreSettingChanged" />
            </StackPanel>
        </Grid>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock x:Name="InitialPlaybackSpeedLabel" Text="第一杀音频速度：0.50×" Style="{StaticResource PanelCaptionTextStyle}" />
                <Slider x:Name="InitialPlaybackSpeedSlider" Minimum="25" Maximum="400" StepFrequency="5" ValueChanged="OnCoreSettingChanged" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock x:Name="MaximumPlaybackSpeedLabel" Text="Epic 前一杀音频速度：2.00×" Style="{StaticResource PanelCaptionTextStyle}" />
                <Slider x:Name="MaximumPlaybackSpeedSlider" Minimum="25" Maximum="400" StepFrequency="5" ValueChanged="OnCoreSettingChanged" />
            </StackPanel>
        </Grid>

        <StackPanel Spacing="4">
            <TextBlock x:Name="EpicPlaybackSpeedLabel" Text="Epic 音频速度：1.00×" Style="{StaticResource PanelCaptionTextStyle}" />
            <Slider x:Name="EpicPlaybackSpeedSlider" Minimum="25" Maximum="400" StepFrequency="5" ValueChanged="OnCoreSettingChanged" />
        </StackPanel>

    </StackPanel>
</UserControl>
