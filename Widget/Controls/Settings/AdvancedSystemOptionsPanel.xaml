<UserControl
    x:Class="KillConfirmGameBar.Controls.Settings.AdvancedSystemOptionsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- Fluent 2 Palette -->
        <SolidColorBrush x:Key="FluentCardBackground" Color="#FFFFFF" />
        <SolidColorBrush x:Key="FluentCardSubBackground" Color="#FBFBFB" />
        <SolidColorBrush x:Key="FluentCardBorder" Color="#E5E5E5" />
        <SolidColorBrush x:Key="FluentDivider" Color="#F0F0F0" />
        <SolidColorBrush x:Key="FluentTitleText" Color="#1B1B1B" />
        <SolidColorBrush x:Key="FluentBodyText" Color="#424242" />
        <SolidColorBrush x:Key="FluentMutedText" Color="#6E6E6E" />
        <SolidColorBrush x:Key="FluentAccent" Color="#0067C0" />
        <SolidColorBrush x:Key="FluentAccentLight" Color="#EBF3FC" />

        <!-- Fluent 2 Setting Card Style -->
        <Style x:Key="FluentCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Background" Value="{StaticResource FluentCardBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource FluentCardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <!-- Fluent 2 Icon Box -->
        <Style x:Key="FluentIconStyle" TargetType="Border">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="#F3F3F3" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Fluent 2 Typography -->
        <Style x:Key="FluentCardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource FluentTitleText}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="FluentCardHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource FluentMutedText}" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
            <Setter Property="LineHeight" Value="15" />
        </Style>

        <!-- Fluent 2 ComboBox -->
        <Style x:Key="FluentComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="160" />
            <Setter Property="Padding" Value="10,0,24,0" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource FluentTitleText}" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D1D1D1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Fluent 2 Secondary Action Button -->
        <Style x:Key="FluentActionBtnStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="MinWidth" Value="60" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D1D1D1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Foreground" Value="{StaticResource FluentTitleText}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </UserControl.Resources>

    <StackPanel Spacing="8">
        <!-- 1. GSI Game Version Settings Card -->
        <Border Style="{StaticResource FluentCardStyle}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource FluentIconStyle}">
                    <FontIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="14"
                        Foreground="{StaticResource FluentBodyText}"
                        Glyph="&#xE7FC;" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        x:Name="GsiGameVersionLabelText"
                        Style="{StaticResource FluentCardTitle}"
                        Text="GSI 游戏版本" />
                    <TextBlock
                        x:Name="GsiGameVersionHintText"
                        Style="{StaticResource FluentCardHint}"
                        Text="选择监听 Counter-Strike 2 或 CS:GO 传统版的游戏状态" />
                </StackPanel>

                <ComboBox
                    x:Name="GsiGameVersionSelector"
                    Grid.Column="2"
                    Style="{StaticResource FluentComboBoxStyle}"
                    SelectionChanged="OnGsiGameVersionSelectionChanged">
                    <ComboBoxItem x:Name="GsiGameVersionCs2Item" Tag="cs2">Counter-Strike 2 (默认)</ComboBoxItem>
                    <ComboBoxItem x:Name="GsiGameVersionCsgoLegacyItem" Tag="csgo_legacy">CS:GO Legacy</ComboBoxItem>
                </ComboBox>
            </Grid>
        </Border>

        <!-- 2. Close Behavior Settings Card -->
        <Border Style="{StaticResource FluentCardStyle}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource FluentIconStyle}">
                    <FontIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="14"
                        Foreground="{StaticResource FluentBodyText}"
                        Glyph="&#xE8BB;" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        x:Name="CloseBehaviorLabelText"
                        Style="{StaticResource FluentCardTitle}"
                        Text="关闭主窗口时的行为" />
                    <TextBlock
                        Style="{StaticResource FluentCardHint}"
                        Text="设定点击右上角关闭按钮时是最小化托盘还是彻底退出" />
                </StackPanel>

                <ComboBox
                    x:Name="CloseBehaviorSelector"
                    Grid.Column="2"
                    Style="{StaticResource FluentComboBoxStyle}"
                    SelectionChanged="OnCloseBehaviorSelectionChanged">
                    <ComboBoxItem x:Name="CloseWindowTrayItem" Tag="tray">最小化到系统托盘 / 保持运行</ComboBoxItem>
                    <ComboBoxItem x:Name="CloseWindowExitItem" Tag="exit">退出应用程序</ComboBoxItem>
                </ComboBox>
            </Grid>
        </Border>

        <!-- 3. Process Priority Management Card -->
        <Border Style="{StaticResource FluentCardStyle}">
            <StackPanel Spacing="10">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource FluentIconStyle}">
                        <FontIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="14"
                            Foreground="{StaticResource FluentBodyText}"
                            Glyph="&#xE945;" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock
                            x:Name="ProcessPriorityTitleText"
                            Style="{StaticResource FluentCardTitle}"
                            Text="Xbox Game Bar 进程优先级管理" />
                        <TextBlock
                            x:Name="ProcessPriorityHintText"
                            Style="{StaticResource FluentCardHint}"
                            Text="读取并优化覆盖层三个关键进程的 Windows 调度优先级" />
                    </StackPanel>

                    <Button
                        x:Name="ProcessPriorityRefreshButton"
                        Grid.Column="2"
                        Style="{StaticResource FluentActionBtnStyle}"
                        Click="OnProcessPriorityRefreshClick">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="11" Glyph="&#xE72C;" />
                            <TextBlock Text="刷新状态" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Border
                    Background="{StaticResource FluentCardSubBackground}"
                    BorderBrush="{StaticResource FluentDivider}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,10">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="12" RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource FluentTitleText}"
                                Text="GameBar.exe" />
                            <ComboBox
                                x:Name="GameBarPrioritySelector"
                                Grid.Column="1"
                                Style="{StaticResource FluentComboBoxStyle}"
                                MinWidth="140"
                                SelectionChanged="OnProcessPrioritySelectionChanged" />
                            <TextBlock
                                x:Name="GameBarPriorityStatusText"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{StaticResource FluentMutedText}"
                                Text="正在检测…" />

                            <TextBlock
                                Grid.Row="1"
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource FluentTitleText}"
                                Text="GameBarFTServer.exe" />
                            <ComboBox
                                x:Name="GameBarFtServerPrioritySelector"
                                Grid.Row="1"
                                Grid.Column="1"
                                Style="{StaticResource FluentComboBoxStyle}"
                                MinWidth="140"
                                SelectionChanged="OnProcessPrioritySelectionChanged" />
                            <TextBlock
                                x:Name="GameBarFtServerPriorityStatusText"
                                Grid.Row="1"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{StaticResource FluentMutedText}"
                                Text="正在检测…" />

                            <TextBlock
                                Grid.Row="2"
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource FluentTitleText}"
                                Text="KillConfirmGameBar.exe" />
                            <ComboBox
                                x:Name="KillConfirmWidgetPrioritySelector"
                                Grid.Row="2"
                                Grid.Column="1"
                                Style="{StaticResource FluentComboBoxStyle}"
                                MinWidth="140"
                                SelectionChanged="OnProcessPrioritySelectionChanged" />
                            <TextBlock
                                x:Name="KillConfirmWidgetPriorityStatusText"
                                Grid.Row="2"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{StaticResource FluentMutedText}"
                                Text="正在检测…" />
                        </Grid>

                        <Rectangle Height="1" Fill="{StaticResource FluentDivider}" Margin="0,2" />

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource FluentTitleText}"
                                    Text="软件启动时自动恢复并保持上述优先级" />
                                <TextBlock
                                    x:Name="ProcessPriorityPersistenceHintText"
                                    Style="{StaticResource FluentCardHint}"
                                    Text="启用后，每次伴随服务启动均会自动校验并重新应用设定好的进程优先级" />
                            </StackPanel>

                            <ToggleSwitch
                                x:Name="ProcessPriorityPersistenceToggle"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                MinWidth="0"
                                OffContent="关"
                                OnContent="开"
                                Toggled="OnProcessPriorityPersistenceToggled" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
