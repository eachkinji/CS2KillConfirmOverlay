<UserControl
    x:Class="KillConfirmGameBar.Controls.GameSources.GameSourceSelector"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel x:Name="SourceButtons" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button x:Name="Cs2Button" Tag="cs2" Click="OnSourceClick" Padding="3" Width="40" Height="40" CornerRadius="20" BorderThickness="2" ToolTipService.ToolTip="CS2" AutomationProperties.Name="CS2">
            <StackPanel Orientation="Horizontal" Spacing="10"><Ellipse Width="30" Height="30"><Ellipse.Fill><ImageBrush ImageSource="ms-appx:///Assets/GameSources/CounterStrike/cs2.png" Stretch="UniformToFill"/></Ellipse.Fill></Ellipse><TextBlock VerticalAlignment="Center" FontSize="14" Visibility="Collapsed"/></StackPanel>
        </Button>
        <Button x:Name="CsgoButton" Tag="csgo_legacy" Click="OnSourceClick" Padding="3" Width="40" Height="40" CornerRadius="20" BorderThickness="2" ToolTipService.ToolTip="CSGO" AutomationProperties.Name="CSGO">
            <StackPanel Orientation="Horizontal" Spacing="10"><Ellipse Width="30" Height="30"><Ellipse.Fill><ImageBrush ImageSource="ms-appx:///Assets/GameSources/CounterStrike/csgo.png" Stretch="UniformToFill"/></Ellipse.Fill></Ellipse><TextBlock VerticalAlignment="Center" FontSize="14" Visibility="Collapsed"/></StackPanel>
        </Button>
        <Button x:Name="LolButton" Tag="lol" Click="OnSourceClick" Padding="3" Width="40" Height="40" CornerRadius="20" BorderThickness="2" ToolTipService.ToolTip="LOL" AutomationProperties.Name="LOL">
            <StackPanel Orientation="Horizontal" Spacing="10"><Ellipse Width="30" Height="30"><Ellipse.Fill><ImageBrush ImageSource="ms-appx:///Assets/GameSources/LeagueOfLegends/lol.png" Stretch="UniformToFill"/></Ellipse.Fill></Ellipse><TextBlock VerticalAlignment="Center" FontSize="14" Visibility="Collapsed"/></StackPanel>
        </Button>
        <TextBlock x:Name="SourceStatus" FontSize="11" VerticalAlignment="Center" MaxWidth="150" TextTrimming="CharacterEllipsis"/>
    </StackPanel>
</UserControl>
