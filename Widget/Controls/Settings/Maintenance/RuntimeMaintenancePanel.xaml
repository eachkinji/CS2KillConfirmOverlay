<UserControl
    x:Class="KillConfirmGameBar.Controls.Settings.RuntimeMaintenancePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="ms-appx:///Controls/Settings/PanelDesign.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <SolidColorBrush x:Key="FluentDangerBackground" Color="#FDF3F2" />
        <SolidColorBrush x:Key="FluentDangerBorder" Color="#F4BDB8" />
        <SolidColorBrush x:Key="FluentDangerText" Color="#C42B1C" />

        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Outer Card container (keeps x:Name="Card" for theme code-behind compatibility) -->
    <Border
        x:Name="Card"
        Padding="0"
        Background="Transparent"
        BorderThickness="0">
        <StackPanel Spacing="8">
            <!-- Hidden compatibility anchors for code-behind bindings -->
            <StackPanel Visibility="Collapsed">
                <TextBlock x:Name="TitleText" Text="软件与维护" />
                <TextBlock x:Name="DescriptionText" Text="Choose an audio output device or restore all plugin data." />
            </StackPanel>

            <!-- 1. Audio Output Device Card -->
            <Border Style="{StaticResource PanelSectionCardStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource PanelIconContainerStyle}">
                        <FontIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="14"
                            Foreground="{StaticResource PanelTextSecondaryBrush}"
                            Glyph="&#xE95D;" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock
                            x:Name="AudioDeviceLabel"
                            Style="{StaticResource PanelTitleTextStyle}"
                            Text="音频输出设备" />
                        <TextBlock
                            Style="{StaticResource PanelCaptionTextStyle}"
                            Text="选择击杀音效与语音播报的指定声卡输出设备" />
                    </StackPanel>

                    <ComboBox
                        x:Name="AudioDeviceSelector"
                        Grid.Column="2"
                        Style="{StaticResource PanelComboBoxStyle}"
                        SelectionChanged="OnAudioDeviceSelectionChanged" />
                </Grid>
            </Border>

            <!-- 2. Developer Mode & Diagnostics Card -->
            <Border Style="{StaticResource PanelSectionCardStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource PanelIconContainerStyle}">
                        <FontIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="14"
                            Foreground="{StaticResource PanelTextSecondaryBrush}"
                            Glyph="&#xE943;" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock
                            x:Name="DeveloperModeLabel"
                            Style="{StaticResource PanelTitleTextStyle}"
                            Text="开发者模式与诊断日志" />
                        <TextBlock
                            x:Name="DeveloperModeHint"
                            Style="{StaticResource PanelCaptionTextStyle}"
                            Text="启用所有诊断日志与详细调试信息" />
                        <TextBlock
                            x:Name="StatusText"
                            Foreground="{StaticResource PanelTextMutedBrush}"
                            TextWrapping="WrapWholeWords" Style="{StaticResource PanelCaptionTextStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <ToggleSwitch
                            x:Name="DeveloperModeToggle"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            MinWidth="0"
                            OffContent="关"
                            OnContent="开"
                            Toggled="OnDeveloperModeToggled" />
                        <Button
                            x:Name="OpenLogPathButton"
                            HorizontalAlignment="Right"
                            Style="{StaticResource PanelButtonStyle}"
                            Click="OnOpenLogPathClick">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="11" Glyph="&#xED25;" />
                                <TextBlock Text="打开日志目录" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. Reset All Plugin Data (Danger Zone) Card -->
            <Border
                Style="{StaticResource PanelSectionCardStyle}"
                Background="{StaticResource FluentDangerBackground}"
                BorderBrush="{StaticResource FluentDangerBorder}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource PanelIconContainerStyle}" Background="#FBEAE8">
                        <FontIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="14"
                            Foreground="{StaticResource FluentDangerText}"
                            Glyph="&#xE7BA;" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock
                            Style="{StaticResource PanelTitleTextStyle}"
                            Foreground="{StaticResource FluentDangerText}"
                            Text="重置所有插件数据" />
                        <TextBlock
                            Style="{StaticResource PanelCaptionTextStyle}"
                            Foreground="#8A1B16"
                            Text="恢复全部音频、特效、端口与偏好设置到出厂初始状态" />
                    </StackPanel>

                    <Button
                        x:Name="ResetPluginButton"
                        Grid.Column="2"
                        Background="{StaticResource FluentDangerText}"
                        BorderBrush="{StaticResource FluentDangerText}"
                        Foreground="White"
                        FontWeight="SemiBold"
                        Click="OnResetPluginClick"
                        Content="重置数据" Style="{StaticResource PanelButtonStyle}" />
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
