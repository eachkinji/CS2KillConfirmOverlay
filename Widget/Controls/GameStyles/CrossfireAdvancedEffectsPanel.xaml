<UserControl
    x:Class="KillConfirmGameBar.Controls.GameStyles.CrossfireAdvancedEffectsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KillConfirmGameBar.Controls.GameStyles">

    <StackPanel Spacing="10">
        <StackPanel Spacing="2">
            <TextBlock
                x:Name="TitleText"
                FontSize="16"
                FontWeight="Bold"
                Text="CrossFire Effects" />
            <TextBlock
                x:Name="HintText"
                FontSize="10"
                Text="CrossFire kill FX, elite icons, weapon badges, and animation styles are isolated here."
                TextWrapping="WrapWholeWords" />
        </StackPanel>

        <Border
            Padding="10"
            BorderBrush="#D5D0C4"
            BorderThickness="1"
            CornerRadius="12">
            <Grid RowSpacing="8" ColumnSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <local:StreakWindowEditor
                    x:Name="StreakEditor"
                    Grid.ColumnSpan="2"
                    SettingsChanged="OnStreakModeSelectionChanged" />

                <TextBlock x:Name="HeadshotAudioPriorityLabel" Grid.Row="1" VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold" Text="Headshot audio" />
                <ComboBox x:Name="HeadshotAudioPrioritySelector" Grid.Row="1" Grid.Column="1" Height="28" Padding="7,0,12,0" FontSize="10" SelectionChanged="OnHeadshotAudioPrioritySelectionChanged">
                    <ComboBoxItem x:Name="HeadshotSpecialPriorityItem" Tag="special">Headshot priority</ComboBoxItem>
                    <ComboBoxItem x:Name="HeadshotStreakPriorityItem" Tag="streak">Kill-streak priority</ComboBoxItem>
                </ComboBox>

                <TextBlock x:Name="KnifeAudioPriorityLabel" Grid.Row="2" VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold" Text="Knife-kill audio" />
                <ComboBox x:Name="KnifeAudioPrioritySelector" Grid.Row="2" Grid.Column="1" Height="28" Padding="7,0,12,0" FontSize="10" SelectionChanged="OnKnifeAudioPrioritySelectionChanged">
                    <ComboBoxItem x:Name="KnifeSpecialPriorityItem" Tag="special">Knife-kill priority</ComboBoxItem>
                    <ComboBoxItem x:Name="KnifeStreakPriorityItem" Tag="streak">Kill-streak priority</ComboBoxItem>
                </ComboBox>

                <TextBlock x:Name="HeadshotIconPriorityLabel" Grid.Row="3" VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold" Text="Headshot icon" />
                <ComboBox x:Name="HeadshotIconPrioritySelector" Grid.Row="3" Grid.Column="1" Height="28" Padding="7,0,12,0" FontSize="10" SelectionChanged="OnHeadshotIconPrioritySelectionChanged">
                    <ComboBoxItem x:Name="HeadshotIconSpecialPriorityItem" Tag="special">Headshot priority</ComboBoxItem>
                    <ComboBoxItem x:Name="HeadshotIconStreakPriorityItem" Tag="streak">Kill-streak priority</ComboBoxItem>
                </ComboBox>

                <TextBlock x:Name="KnifeIconPriorityLabel" Grid.Row="4" VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold" Text="Knife-kill icon" />
                <ComboBox x:Name="KnifeIconPrioritySelector" Grid.Row="4" Grid.Column="1" Height="28" Padding="7,0,12,0" FontSize="10" SelectionChanged="OnKnifeIconPrioritySelectionChanged">
                    <ComboBoxItem x:Name="KnifeIconSpecialPriorityItem" Tag="special">Knife-kill priority</ComboBoxItem>
                    <ComboBoxItem x:Name="KnifeIconStreakPriorityItem" Tag="streak">Kill-streak priority</ComboBoxItem>
                </ComboBox>

                <TextBlock x:Name="FirstKillAudioLabel" Grid.Row="5" VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold" Text="First-kill audio" />
                <ComboBox x:Name="FirstKillAudioSelector" Grid.Row="5" Grid.Column="1" Height="28" Padding="7,0,12,0" FontSize="10" SelectionChanged="OnFirstKillAudioSelectionChanged">
                    <ComboBoxItem x:Name="FirstKillSpecialItem" Tag="special">Special audio</ComboBoxItem>
                    <ComboBoxItem x:Name="FirstKillOriginalItem" Tag="original">Original kill audio</ComboBoxItem>
                </ComboBox>

                <TextBlock x:Name="LastKillAudioLabel" Grid.Row="6" VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold" Text="Last-kill audio" />
                <ComboBox x:Name="LastKillAudioSelector" Grid.Row="6" Grid.Column="1" Height="28" Padding="7,0,12,0" FontSize="10" SelectionChanged="OnLastKillAudioSelectionChanged">
                    <ComboBoxItem x:Name="LastKillSpecialItem" Tag="special">Special audio</ComboBoxItem>
                    <ComboBoxItem x:Name="LastKillOriginalItem" Tag="original">Original kill audio</ComboBoxItem>
                </ComboBox>

                <TextBlock x:Name="FirstKillEffectLabel" Grid.Row="7" VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold" Text="First-kill effect" />
                <ToggleSwitch x:Name="FirstKillEffectToggle" Grid.Row="7" Grid.Column="1" IsOn="True" OffContent="Off" OnContent="On (default)" Toggled="OnFirstKillEffectToggled" />

                <TextBlock x:Name="LastKillEffectLabel" Grid.Row="8" VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold" Text="Last-kill effect" />
                <ToggleSwitch x:Name="LastKillEffectToggle" Grid.Row="8" Grid.Column="1" IsOn="True" OffContent="Off" OnContent="On (default)" Toggled="OnLastKillEffectToggled" />

                <TextBlock x:Name="AssistAudioLabel" Grid.Row="9" VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold" Text="Assist audio" />
                <ToggleSwitch
                    x:Name="AssistAudioToggle"
                    Grid.Row="9"
                    Grid.Column="1"
                    IsOn="False"
                    OffContent="Muted (default)"
                    OnContent="Sound (common)"
                    Toggled="OnAssistAudioToggled" />
            </Grid>
        </Border>

        <ContentControl x:Name="StylePanelHost" />
    </StackPanel>
</UserControl>
