<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.18362.0</TargetPlatformMinVersion>
    <UseWPF>true</UseWPF>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>KillConfirmCompatibility</AssemblyName>
    <Version>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\Package\Package.appxmanifest')), 'Version=&quot;([0-9]+\.[0-9]+\.[0-9]+\.[0-9]+)&quot;').Groups[1].Value)</Version>
    <RootNamespace>KillConfirmCompatibility</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Common/*.cs" Link="Common/%(Filename)%(Extension)" />
    <Compile Include="../Widget/Validation/CalabiyauDefaultRenderValidation.cs" Link="Validation/CalabiyauDefaultRenderValidation.cs" />
    <Compile Remove="Integration/**/*.cs" />
    <Page Remove="Integration/**/*.xaml" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
  </ItemGroup>
  <Import Project="../Native/Lz4/Lz4.targets" />
  <Import Project="../Native/Composition/Composition.targets" />
</Project>
