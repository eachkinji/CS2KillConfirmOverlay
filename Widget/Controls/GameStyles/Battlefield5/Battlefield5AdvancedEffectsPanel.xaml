<UserControl
    x:Class="KillConfirmGameBar.Controls.GameStyles.Battlefield5AdvancedEffectsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KillConfirmGameBar.Controls.GameStyles">

    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="ms-appx:///Controls/Settings/PanelDesign.xaml" />
        </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Spacing="10">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <Grid ColumnSpacing="8" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Image x:Name="CombatGameLogo" Width="22" Height="22" VerticalAlignment="Center" Stretch="Uniform" />
                    <TextBlock x:Name="TitleText" Grid.Column="1" VerticalAlignment="Center" TextWrapping="WrapWholeWords" Style="{StaticResource PanelTitleTextStyle}" />
                </Grid>
                <TextBlock
                    x:Name="HintText"
                    Visibility="Collapsed"
                    TextWrapping="WrapWholeWords" Style="{StaticResource PanelCaptionTextStyle}" />
            </StackPanel>
            <Button
                x:Name="ResetButton"
                Grid.Column="1"
                MinWidth="88"
                VerticalAlignment="Top"
                AutomationProperties.Name="Restore BF5 defaults"
                Click="OnResetButtonClick" Style="{StaticResource PanelPrimaryButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="12" Glyph="&#xE777;" />
                    <TextBlock x:Name="ResetButtonText" Text="Reset" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource PanelSectionCardStyle}">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Style="{StaticResource PanelAccentIconContainerStyle}"><FontIcon FontSize="13" Foreground="White" Glyph="&#xE8C7;" /></Border>
                        <TextBlock x:Name="MoneyRewardModeLabel" Style="{StaticResource PanelTitleTextStyle}" VerticalAlignment="Center" Text="Money" />
                    </StackPanel>
                    <ComboBox x:Name="MoneyRewardModeSelector" SelectedIndex="0" Style="{StaticResource PanelComboBoxStyle}" SelectionChanged="OnMoneyRewardModeSelectionChanged" ToolTipService.ToolTip="Money reward calculation">
                        <ComboBoxItem x:Name="MoneyRewardDeltaItem" Tag="delta">Actual money change (recommended)</ComboBoxItem>
                        <ComboBoxItem x:Name="MoneyRewardRulesItem" Tag="rules">Kill reward rules</ComboBoxItem>
                    </ComboBox>
                </StackPanel>
            </Border>

            <local:StreakWindowEditor
                x:Name="StreakEditor"
                Grid.Column="1"
                SettingsChanged="OnStreakModeSelectionChanged" />
        </Grid>

        <Border x:Name="VisualEffectsCard" Style="{StaticResource PanelSectionCardStyle}">
            <StackPanel Spacing="8">
                <TextBlock x:Name="VisualEffectsTitle" Style="{StaticResource PanelTitleTextStyle}" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="KillMarkEffectLabel" VerticalAlignment="Center" TextWrapping="WrapWholeWords" Style="{StaticResource PanelCaptionTextStyle}" />
                    <ToggleSwitch x:Name="KillMarkEffectToggle" Grid.Column="1" MinWidth="0" Toggled="OnKillMarkEffectToggled" />
                </Grid>
            </StackPanel>
        </Border>

        <local:Battlefield5StylePanel x:Name="StylePanel" />

        <Border
            x:Name="ImportLockedNotice"
            Visibility="Collapsed" Style="{StaticResource PanelSectionCardStyle}">
            <TextBlock
                x:Name="ImportLockedText"
                FontWeight="SemiBold"
                Text="Battlefield 5 visuals stay built in; event sounds can be customized above."
                TextWrapping="WrapWholeWords" Style="{StaticResource PanelCaptionTextStyle}" />
        </Border>

    </StackPanel>
</UserControl>
