<UserControl
    x:Class="KillConfirmGameBar.Controls.Settings.PubgAdvancedSettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Pages/KillConfirmWidget/KillConfirmWidgetPage.Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border
        x:Name="Card"
        Padding="18,16"
        Background="{StaticResource FluentCardBackground}"
        BorderBrush="{StaticResource FluentCardBorder}"
        BorderThickness="1"
        CornerRadius="8">
        <StackPanel Spacing="14">
            <StackPanel Spacing="4">
                <TextBlock
                    x:Name="TitleText"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource FluentTitleText}"
                    Text="PUBG 战斗设置" />
                <TextBlock
                    x:Name="BodyText"
                    FontSize="12"
                    LineHeight="16"
                    Foreground="{StaticResource FluentMutedText}"
                    Visibility="Collapsed"
                    TextWrapping="WrapWholeWords" />
            </StackPanel>

            <Border Style="{StaticResource CompactChoiceCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CompactCircleIconStyle}">
                        <FontIcon FontSize="13" Foreground="White" Glyph="&#xE9D9;" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="StreakModeLabel" Style="{StaticResource CompactChoiceLabelStyle}" Text="连杀计算规则" />
                        <TextBlock FontSize="12" Foreground="{StaticResource FluentMutedText}" Text="设置绝地求生击杀连杀窗口持续时间或单生命周期累计。" />
                    </StackPanel>
                    <ComboBox x:Name="StreakModeSelector" Grid.Column="2" MinWidth="140" Style="{StaticResource CompactSettingsComboBoxStyle}" SelectionChanged="OnStreakModeSelectionChanged">
                        <ComboBoxItem x:Name="StreakLifeItem" Tag="life">单命持续至死亡</ComboBoxItem>
                        <ComboBoxItem x:Name="StreakTimed5Item" Tag="timed_5">5秒连杀窗口</ComboBoxItem>
                        <ComboBoxItem x:Name="StreakTimed10Item" Tag="timed_10">10秒连杀窗口</ComboBoxItem>
                        <ComboBoxItem x:Name="StreakTimed15Item" Tag="timed_15">15秒连杀窗口</ComboBoxItem>
                    </ComboBox>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
