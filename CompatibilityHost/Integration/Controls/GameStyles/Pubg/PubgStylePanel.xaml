<UserControl
    x:Class="KillConfirmGameBar.Features.CompatibilityDisplay.Controls.GameStyles.PubgStylePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="ms-appx:///Controls/Settings/PanelDesign.xaml" />
        </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border
        x:Name="Card"
        Background="#2B271B"
        BorderBrush="#E0A13A"
        Visibility="Collapsed" Style="{StaticResource PanelSectionCardStyle}">
        <StackPanel Spacing="3">
            <TextBlock
                x:Name="TitleText"
                Foreground="#F8F4E5"
                Text="PUBG Panel" Style="{StaticResource PanelTitleTextStyle}" />
            <TextBlock
                x:Name="BodyText"
                Foreground="#DBCEAB"
                Text="PUBG uses its own elimination captions, streak text, and pubg resource folder."
                TextWrapping="WrapWholeWords" Style="{StaticResource PanelCaptionTextStyle}" />
        </StackPanel>
    </Border>
</UserControl>
