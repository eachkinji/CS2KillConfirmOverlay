<UserControl
    x:Class="KillConfirmGameBar.StatusDetailsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Pages/KillConfirmWidget/KillConfirmWidgetPage.Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel
        x:Name="StatusDetailRow" x:FieldModifier="public"
        Grid.Row="1"
        Spacing="4">
        <Grid
            x:Name="ServiceDiagnosticRow" x:FieldModifier="public"
            ColumnSpacing="6"
            Visibility="Collapsed">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock
            x:Name="ServiceDiagnosticText" x:FieldModifier="public"
            Grid.Column="4"
            VerticalAlignment="Center"
            FontSize="10"
            FontWeight="SemiBold"
            Foreground="#FFFFD166"
            Text="Service failed to start. Restart your PC and try again."
            TextTrimming="CharacterEllipsis"
            TextWrapping="Wrap"
            MaxLines="2" />

        <Button
            x:Name="RetryServiceButton" x:FieldModifier="public"
            Grid.Column="0"
            Style="{StaticResource ToolbarIconButtonStyle}"
            Click="OnRetryServiceClick"
            ToolTipService.ToolTip="Retry service">
            <Grid Style="{StaticResource IconHostStyle}">
                <PathIcon Style="{StaticResource FluentPathIconStyle}" Data="M19.5 8.5V4.75C19.5 4.33579 19.1642 4 18.75 4C18.3358 4 18 4.33579 18 4.75V6.58211C16.5217 4.98252 14.4058 4 12.0714 4C7.61309 4 4 7.61309 4 12.0714C4 16.5297 7.61309 20.1429 12.0714 20.1429C15.6356 20.1429 18.6584 17.8317 19.7336 14.7704C19.8709 14.3796 19.6654 13.9515 19.2746 13.8142C18.8838 13.6769 18.4557 13.8824 18.3184 14.2732C17.4427 16.7659 14.9795 18.6429 12.0714 18.6429C8.44152 18.6429 5.5 15.7013 5.5 12.0714C5.5 8.44152 8.44152 5.5 12.0714 5.5C14.0471 5.5 15.8301 6.3731 17.035 7.75H14.75C14.3358 7.75 14 8.08579 14 8.5C14 8.91421 14.3358 9.25 14.75 9.25H18.75C19.1642 9.25 19.5 8.91421 19.5 8.5Z" />
            </Grid>
        </Button>

        <Button
            x:Name="CopyServiceDiagnosticButton" x:FieldModifier="public"
            Grid.Column="1"
            Style="{StaticResource ToolbarIconButtonStyle}"
            Click="OnCopyServiceDiagnosticClick"
            ToolTipService.ToolTip="Copy diagnostic information">
            <Grid Style="{StaticResource IconHostStyle}">
                <PathIcon Style="{StaticResource FluentPathIconStyle}" Data="M5.25 4.5C4.2835 4.5 3.5 5.2835 3.5 6.25V15.75C3.5 16.7165 4.2835 17.5 5.25 17.5H6.5V8.25C6.5 6.73122 7.73122 5.5 9.25 5.5H16.5V4.5H5.25ZM8 8.25C8 7.55964 8.55964 7 9.25 7H18.75C19.4404 7 20 7.55964 20 8.25V18.75C20 19.4404 19.4404 20 18.75 20H9.25C8.55964 20 8 19.4404 8 18.75V8.25Z" />
            </Grid>
        </Button>

        <Button
            x:Name="FreePortButton" x:FieldModifier="public"
            Grid.Column="2"
            Visibility="Collapsed"
            Style="{StaticResource ToolbarIconButtonStyle}"
            Click="OnFreePortClick"
            ToolTipService.ToolTip="Free service port">
            <Grid Style="{StaticResource IconHostStyle}">
                <PathIcon Style="{StaticResource FluentPathIconStyle}" Data="M6.25 3C4.45507 3 3 4.45507 3 6.25V17.75C3 19.5449 4.45507 21 6.25 21H15.25C15.6642 21 16 20.6642 16 20.25C16 19.8358 15.6642 19.5 15.25 19.5H6.25C5.2835 19.5 4.5 18.7165 4.5 17.75V6.25C4.5 5.2835 5.2835 4.5 6.25 4.5H15.25C15.6642 4.5 16 4.16421 16 3.75C16 3.33579 15.6642 3 15.25 3H6.25ZM17.5303 7.21967C17.2374 6.92678 16.7626 6.92678 16.4697 7.21967C16.1768 7.51256 16.1768 7.98744 16.4697 8.28033L19.4393 11.25H8.75C8.33579 11.25 8 11.5858 8 12C8 12.4142 8.33579 12.75 8.75 12.75H19.4393L16.4697 15.7197C16.1768 16.0126 16.1768 16.4874 16.4697 16.7803C16.7626 17.0732 17.2374 17.0732 17.5303 16.7803L21.7803 12.5303C22.0732 12.2374 22.0732 11.7626 21.7803 11.4697L17.5303 7.21967Z" />
            </Grid>
        </Button>

        <Button
            x:Name="OpenLogsButton" x:FieldModifier="public"
            Grid.Column="3"
            Style="{StaticResource ToolbarIconButtonStyle}"
            Click="OnOpenLogsClick"
            ToolTipService.ToolTip="Open logs folder">
            <Grid Style="{StaticResource IconHostStyle}">
                <PathIcon Style="{StaticResource FluentPathIconStyle}" Data="M3.50014 6.25C3.50014 5.2835 4.28364 4.5 5.25014 4.5H8.12882C8.32773 4.5 8.5185 4.57902 8.65915 4.71967L10.7198 6.78033C10.8605 6.92098 11.0512 7 11.2501 7H16.7501C17.7166 7 18.5001 7.7835 18.5001 8.75C18.5001 8.83602 18.5146 8.91866 18.5413 8.99561L8.71867 8.99561C7.37893 8.99561 6.14095 9.71035 5.47108 10.8706L3.50014 14.2844V6.25ZM2.00036 17.7883C2.02089 19.5656 3.468 21 5.25014 21H11.0001C11.0292 21 11.058 20.9983 11.0862 20.9951H16.2812C17.6209 20.9951 18.8589 20.2804 19.5288 19.1201L22.5596 13.8706C23.7748 11.7657 22.3337 9.14964 19.9567 9.00214C19.9848 8.92334 20.0001 8.83846 20.0001 8.75C20.0001 6.95507 18.5451 5.5 16.7501 5.5H11.5608L9.71981 3.65901C9.29786 3.23705 8.72556 3 8.12882 3H5.25014C3.45522 3 2.00014 4.45507 2.00014 6.25V17.71C1.9999 17.7362 1.99997 17.7623 2.00036 17.7883ZM8.71867 10.4956L19.745 10.4956C21.0921 10.4956 21.9341 11.9539 21.2605 13.1206L18.2297 18.3701C17.8278 19.0663 17.085 19.4951 16.2812 19.4951H5.25485C3.9077 19.4951 3.06573 18.0368 3.7393 16.8701L6.77011 11.6206C7.17204 10.9245 7.91482 10.4956 8.71867 10.4956Z" />
            </Grid>
        </Button>
        </Grid>

        <Grid
            x:Name="CfgActionRow" x:FieldModifier="public"
            ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="SelectCsFolderButton" x:FieldModifier="public"
                Grid.Column="0"
                Style="{StaticResource ToolbarIconButtonStyle}"
                Click="OnSelectCsFolderClick"
                ToolTipService.ToolTip="Select CS2 folder or any folder under it">
                <Grid Style="{StaticResource IconHostStyle}">
                    <PathIcon Style="{StaticResource FluentPathIconStyle}" Data="M3.5 6.25V8H8.12868C8.32759 8 8.51836 7.92098 8.65901 7.78033L10.1893 6.25L8.65901 4.71967C8.51836 4.57902 8.32759 4.5 8.12868 4.5H5.25C4.2835 4.5 3.5 5.2835 3.5 6.25ZM2 6.25C2 4.45507 3.45507 3 5.25 3H8.12868C8.72542 3 9.29771 3.23705 9.71967 3.65901L11.5607 5.5H18.75C20.5449 5.5 22 6.95507 22 8.75V17.75C22 19.5449 20.5449 21 18.75 21H5.25C4.45507 21 2 19.5449 2 17.75V6.25ZM3.5 9.5V17.75C3.5 18.7165 4.2835 19.5 5.25 19.5H18.75C19.7165 19.5 20.5 18.7165 20.5 17.75V8.75C20.5 7.7835 19.7165 7 18.75 7H11.5607L9.71967 8.84099C9.29771 9.26295 8.72542 9.5 8.12868 9.5H3.5Z" />
                </Grid>
            </Button>

            <Button
                x:Name="CfgInstallButton" x:FieldModifier="public"
                Grid.Column="1"
                MinWidth="36"
                Height="24"
                Padding="7,0"
                Background="#2E88B8"
                BorderBrush="#3A9CCF"
                BorderThickness="1"
                Click="OnInstallCfgClick"
                Content="Add"
                CornerRadius="14"
                FontSize="10"
                Foreground="#FFFFFF"
                ToolTipService.ToolTip="Add missing CFG"
                Visibility="Collapsed" />

            <StackPanel
                Grid.Column="2"
                VerticalAlignment="Center"
                Spacing="1">
                <TextBlock
                    x:Name="CfgStatusText" x:FieldModifier="public"
                    FontSize="10"
                    FontWeight="SemiBold"
                    Foreground="#1B1F31"
                    MaxLines="2"
                    Text="CFG not checked"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="CfgHintText" x:FieldModifier="public"
                    FontSize="10"
                    Foreground="#6B7280"
                    MaxLines="2"
                    Text="Finding CS2"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
