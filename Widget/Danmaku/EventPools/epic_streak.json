      "family": "superstition_ritual",
      "phase": "burst",
      "derivation": "context_rewrite",
      "source_index": 9501,
      "source_excerpt": "刘亦博我是无常，你阳寿已尽 速速跟我回阴曹地府报道",
      "classic_anchor": "阳寿已尽",
      "id": "epic_streak_0017"
