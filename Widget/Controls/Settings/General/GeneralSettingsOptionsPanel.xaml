<UserControl
    x:Class="KillConfirmGameBar.Controls.Settings.GeneralSettingsOptionsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:danmaku="using:KillConfirmGameBar.Danmaku"
    xmlns:settings="using:KillConfirmGameBar.Controls.Settings">

    <UserControl.Resources>
        <!-- Fluent 2 Palette -->
        <SolidColorBrush x:Key="FluentCardBackground" Color="#FFFFFF" />
        <SolidColorBrush x:Key="FluentCardSubBackground" Color="#FBFBFB" />
        <SolidColorBrush x:Key="FluentCardBorder" Color="#E5E5E5" />
        <SolidColorBrush x:Key="FluentDivider" Color="#F0F0F0" />
        <SolidColorBrush x:Key="FluentTitleText" Color="#1B1B1B" />
        <SolidColorBrush x:Key="FluentBodyText" Color="#424242" />
        <SolidColorBrush x:Key="FluentMutedText" Color="#6E6E6E" />
        <SolidColorBrush x:Key="FluentAccent" Color="#0067C0" />
        <SolidColorBrush x:Key="FluentAccentLight" Color="#EBF3FC" />

        <!-- Fluent 2 Setting Card Style -->
        <Style x:Key="FluentCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Background" Value="{StaticResource FluentCardBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource FluentCardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <!-- Fluent 2 Icon Box -->
        <Style x:Key="FluentIconStyle" TargetType="Border">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="#F3F3F3" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Fluent 2 Typography -->
        <Style x:Key="FluentCardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource FluentTitleText}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="FluentCardHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource FluentMutedText}" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
            <Setter Property="LineHeight" Value="15" />
        </Style>

        <!-- Fluent 2 ComboBox -->
        <Style x:Key="FluentComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="160" />
            <Setter Property="Padding" Value="10,0,24,0" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource FluentTitleText}" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D1D1D1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Fluent 2 Secondary Action Button -->
        <Style x:Key="FluentActionBtnStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="MinWidth" Value="60" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D1D1D1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Foreground" Value="{StaticResource FluentTitleText}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <!-- Backward Compatibility Aliases -->
        <Style x:Key="CompactChoiceCardStyle" TargetType="Border" BasedOn="{StaticResource FluentCardStyle}" />
        <Style x:Key="CompactCircleIconStyle" TargetType="Border" BasedOn="{StaticResource FluentIconStyle}" />
        <Style x:Key="CompactChoiceLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource FluentCardTitle}" />
        <Style x:Key="CompactSettingsComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource FluentComboBoxStyle}" />
    </UserControl.Resources>

    <StackPanel Spacing="8">
        <!-- 1. Spectated Player Kill Effects Card -->
        <Border Style="{StaticResource FluentCardStyle}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource FluentIconStyle}">
                    <FontIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="14"
                        Foreground="{StaticResource FluentBodyText}"
                        Glyph="&#xE7B3;" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        x:Name="SpectatedKillEffectsLabelText"
                        Style="{StaticResource FluentCardTitle}"
                        Text="观战玩家击杀特效" />
                    <TextBlock
                        x:Name="SpectatedKillEffectsHintText"
                        Style="{StaticResource FluentCardHint}"
                        Text="在死亡观战队友或 GOTV 录像时是否同步触发击杀动画" />
                </StackPanel>

                <ToggleSwitch
                    x:Name="SpectatedKillEffectsToggle"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    MinWidth="0"
                    OffContent="关"
                    OnContent="开"
                    Toggled="OnSpectatedKillEffectsToggled" />
            </Grid>
        </Border>

        <!-- 2. 6657 Kill Danmaku Card -->
        <Border Style="{StaticResource FluentCardStyle}">
            <StackPanel Spacing="10">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource FluentIconStyle}">
                        <FontIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="14"
                            Foreground="{StaticResource FluentBodyText}"
                            Glyph="&#xE8BD;" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock
                            x:Name="Danmaku6657LabelText"
                            Style="{StaticResource FluentCardTitle}"
                            Text="6657 击杀弹幕" />
                        <TextBlock
                            x:Name="Danmaku6657HintText"
                            Style="{StaticResource FluentCardHint}"
                            Text="检测到击杀时在屏幕内发送 6657 经典弹幕（支持位置、时长、数量、字号与背景定制）" />
                    </StackPanel>

                    <Button
                        x:Name="Danmaku6657TestButton"
                        Grid.Column="2"
                        Style="{StaticResource FluentActionBtnStyle}"
                        Content="测试弹幕"
                        Click="OnDanmaku6657TestClick"
                        ToolTipService.ToolTip="立即在小组件中发送测试弹幕"
                        Margin="0,0,8,0" />

                    <ToggleSwitch
                        x:Name="Danmaku6657Toggle"
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        MinWidth="0"
                        OffContent="关"
                        OnContent="开"
                        Toggled="OnDanmaku6657Toggled" />
                </Grid>

                <danmaku:DanmakuOptionsPanel
                    x:Name="DanmakuSettingsOptions"
                    Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <!-- 4. Auto-Close on Game Exit Card -->
        <Border Style="{StaticResource FluentCardStyle}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource FluentIconStyle}">
                    <FontIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="14"
                        Foreground="{StaticResource FluentBodyText}"
                        Glyph="&#xE73E;" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        x:Name="AutoCloseOnGameExitLabelText"
                        Style="{StaticResource FluentCardTitle}"
                        Text="游戏退出后自动关闭" />
                    <TextBlock
                        x:Name="AutoCloseOnGameExitHintText"
                        Style="{StaticResource FluentCardHint}"
                        Text="检测到 CS2 或 CS:GO 进程退出后，自动结束伴随服务与小组件" />
                </StackPanel>

                <ToggleSwitch
                    x:Name="AutoCloseOnGameExitToggle"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    MinWidth="0"
                    OffContent="关"
                    OnContent="开"
                    Toggled="OnAutoCloseOnGameExitToggled" />
            </Grid>
        </Border>

        <!-- 5. Interrupt Previous Kill Voice Card -->
        <Border Style="{StaticResource FluentCardStyle}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource FluentIconStyle}">
                    <FontIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="14"
                        Foreground="{StaticResource FluentBodyText}"
                        Glyph="&#xE74D;" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        x:Name="InterruptPreviousKillAudioLabelText"
                        Style="{StaticResource FluentCardTitle}"
                        Text="打断上一条击杀语音" />
                    <TextBlock
                        x:Name="InterruptPreviousKillAudioHintText"
                        Style="{StaticResource FluentCardHint}"
                        Text="连续击杀时立即播放最新击杀语音，防止多段长语音重叠混音" />
                </StackPanel>

                <ToggleSwitch
                    x:Name="InterruptPreviousKillAudioToggle"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    MinWidth="0"
                    OffContent="关"
                    OnContent="开"
                    Toggled="OnInterruptPreviousKillAudioToggled" />
            </Grid>
        </Border>

        <!-- Global streak audio gain -->
        <Border Style="{StaticResource FluentCardStyle}">
            <StackPanel Spacing="10">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource FluentIconStyle}">
                        <FontIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="14"
                            Foreground="{StaticResource FluentBodyText}"
                            Glyph="&#xE9D9;" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock
                            x:Name="StreakGainLabelText"
                            Style="{StaticResource FluentCardTitle}"
                            Text="连杀音量递增" />
                        <TextBlock
                            x:Name="StreakGainHintText"
                            Style="{StaticResource FluentCardHint}"
                            Text="对所有游戏和语音包生效，连杀越多音量越高" />
                    </StackPanel>

                    <ToggleSwitch
                        x:Name="StreakGainToggle"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        MinWidth="0"
                        OffContent="关"
                        OnContent="开"
                        Toggled="OnStreakGainToggled" />
                </Grid>

                <Border
                    Background="{StaticResource FluentCardSubBackground}"
                    BorderBrush="{StaticResource FluentDivider}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,12">
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Name="StreakGainStepLabelText"
                                    FontSize="11"
                                    Foreground="{StaticResource FluentTitleText}"
                                    Text="每次击杀增加" />
                                <TextBlock
                                    x:Name="StreakGainStepValueText"
                                    Grid.Column="1"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource FluentAccent}"
                                    Text="7%" />
                            </Grid>
                            <Slider
                                x:Name="StreakGainStepSlider"
                                Minimum="0"
                                Maximum="100"
                                StepFrequency="1"
                                ValueChanged="OnStreakGainValueChanged" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Name="StreakGainMaximumLabelText"
                                    FontSize="11"
                                    Foreground="{StaticResource FluentTitleText}"
                                    Text="最高音量" />
                                <TextBlock
                                    x:Name="StreakGainMaximumValueText"
                                    Grid.Column="1"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource FluentAccent}"
                                    Text="150%" />
                            </Grid>
                            <Slider
                                x:Name="StreakGainMaximumSlider"
                                Grid.Column="1"
                                Minimum="100"
                                Maximum="400"
                                StepFrequency="5"
                                ValueChanged="OnStreakGainValueChanged" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <settings:BombAudioOptionsPanel x:Name="BombAudioPanel" />
    </StackPanel>
</UserControl>
