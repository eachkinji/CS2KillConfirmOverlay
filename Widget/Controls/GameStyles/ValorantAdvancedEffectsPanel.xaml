<UserControl
    x:Class="KillConfirmGameBar.Controls.GameStyles.ValorantAdvancedEffectsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KillConfirmGameBar.Controls.GameStyles">

    <StackPanel Spacing="10">
        <StackPanel Spacing="2">
            <TextBlock
                x:Name="TitleText"
                FontSize="16"
                FontWeight="Bold"
                Text="VAL Effects" />
            <TextBlock
                x:Name="HintText"
                FontSize="10"
                Visibility="Collapsed"
                TextWrapping="WrapWholeWords" />
        </StackPanel>

        <Grid RowSpacing="8" ColumnSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <local:StreakWindowEditor
                x:Name="StreakEditor"
                Grid.ColumnSpan="2"
                SettingsChanged="OnStreakModeSelectionChanged" />

            <TextBlock x:Name="AssistAudioLabel" Grid.Row="1" VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold" Text="Assist audio" />
            <ToggleSwitch
                x:Name="AssistAudioToggle"
                Grid.Row="1"
                Grid.Column="1"
                IsOn="False"
                OffContent="Muted (default)"
                OnContent="Sound (common)"
                Toggled="OnAssistAudioToggled" />

            <StackPanel
                x:Name="DmOptimizeRow"
                Grid.Row="2"
                Grid.ColumnSpan="2"
                Spacing="6"
                Visibility="Collapsed">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <CheckBox
                        x:Name="DmOptimizeCheckbox"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Content="Deathmatch optimization"
                        Checked="OnDmOptimizeToggled"
                        Unchecked="OnDmOptimizeToggled" />
                    <ComboBox
                        x:Name="DmWindowSelector"
                        Grid.Column="1"
                        Height="28"
                        Padding="7,0,12,0"
                        FontSize="10"
                        SelectionChanged="OnDmWindowSelectionChanged">
                        <ComboBoxItem x:Name="DmWindow1sItem" Tag="1">1s</ComboBoxItem>
                        <ComboBoxItem x:Name="DmWindow2sItem" Tag="2">2s</ComboBoxItem>
                        <ComboBoxItem x:Name="DmWindow3sItem" Tag="3">3s</ComboBoxItem>
                        <ComboBoxItem x:Name="DmWindow5sItem" Tag="5">5s</ComboBoxItem>
                        <ComboBoxItem x:Name="DmWindow10sItem" Tag="10">10s</ComboBoxItem>
                        <ComboBoxItem x:Name="DmWindow15sItem" Tag="15">15s</ComboBoxItem>
                        <ComboBoxItem x:Name="DmWindow30sItem" Tag="30">30s</ComboBoxItem>
                        <ComboBoxItem x:Name="DmWindow60sItem" Tag="60">60s</ComboBoxItem>
                    </ComboBox>
                </Grid>
                <TextBlock
                    x:Name="DmOptimizeHint"
                    FontSize="10"
                    Opacity="0.7"
                    LineHeight="14"
                    TextWrapping="WrapWholeWords" />
            </StackPanel>
        </Grid>

        <ContentControl x:Name="StylePanelHost" />
    </StackPanel>
</UserControl>
