<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Controls/Settings/PanelDesign.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Compatibility names for existing home/game controls. All desktop metrics
         and interaction states come from PanelDesign, not a second style system. -->
    <Style x:Key="IconHostStyle" TargetType="Grid">
        <Setter Property="Width" Value="{StaticResource PanelControlHeight}" />
        <Setter Property="Height" Value="{StaticResource PanelControlHeight}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="CompactIconHostStyle" TargetType="Grid" BasedOn="{StaticResource IconHostStyle}" />
    <Style x:Key="FluentPathIconStyle" TargetType="PathIcon">
        <Setter Property="Width" Value="{StaticResource PanelControlHeight}" />
        <Setter Property="Height" Value="{StaticResource PanelControlHeight}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource PanelTextPrimaryBrush}" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.56" ScaleY="0.56" /></Setter.Value></Setter>
    </Style>
    <Style x:Key="FluentTinyPathIconStyle" TargetType="PathIcon" BasedOn="{StaticResource FluentPathIconStyle}">
        <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.52" ScaleY="0.52" /></Setter.Value></Setter>
    </Style>
    <Style x:Key="ToolbarIconButtonStyle" TargetType="Button" BasedOn="{StaticResource PanelIconButtonStyle}" />
    <Style x:Key="CompactIconButtonStyle" TargetType="Button" BasedOn="{StaticResource PanelIconButtonStyle}" />
    <Style x:Key="ModeIconButtonStyle" TargetType="Button" BasedOn="{StaticResource PanelIconButtonStyle}" />
    <Style x:Key="StatusStripIconButtonStyle" TargetType="Button" BasedOn="{StaticResource PanelIconButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style x:Key="PanelToggleBarButtonStyle" TargetType="Button" BasedOn="{StaticResource PanelButtonStyle}">
        <Setter Property="Width" Value="72" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="OverlayComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource PanelComboBoxStyle}">
        <Setter Property="MinWidth" Value="64" />
        <Setter Property="RequestedTheme" Value="Light" />
    </Style>
    <Style x:Key="CompactComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource OverlayComboBoxStyle}" />
    <Style x:Key="NarrowComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource OverlayComboBoxStyle}" />
    <Style x:Key="CompactSettingsComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource PanelComboBoxStyle}" />
    <Style TargetType="ComboBoxItem">
        <Setter Property="RequestedTheme" Value="Light" />
        <Setter Property="Foreground" Value="{StaticResource PanelTextPrimaryBrush}" />
        <Setter Property="Padding" Value="{StaticResource PanelControlPadding}" />
        <Setter Property="MinHeight" Value="{StaticResource PanelControlHeight}" />
        <Setter Property="FontSize" Value="{StaticResource PanelFontBody}" />
    </Style>
    <Style x:Key="PackAccentComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource PanelComboBoxStyle}">
        <Setter Property="Background" Value="{StaticResource PanelAccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelAccentBrush}" />
    </Style>
    <Style x:Key="PackImportantIconButtonStyle" TargetType="Button" BasedOn="{StaticResource PanelIconButtonStyle}">
        <Setter Property="Background" Value="{StaticResource PanelAccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelAccentBrush}" />
    </Style>
    <Style x:Key="VisualImportantIconButtonStyle" TargetType="Button" BasedOn="{StaticResource PanelIconButtonStyle}">
        <Setter Property="Background" Value="{StaticResource PanelAccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelAccentBrush}" />
    </Style>

    <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource PanelTitleTextStyle}">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="FluentSectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource PanelTitleTextStyle}">
        <Setter Property="Margin" Value="0,12,0,4" />
    </Style>
    <Style x:Key="FluentCardTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource PanelTitleTextStyle}" />
    <Style x:Key="FluentCardDescriptionStyle" TargetType="TextBlock" BasedOn="{StaticResource PanelCaptionTextStyle}" />
    <Style x:Key="CompactChoiceLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource PanelTitleTextStyle}" />
    <Style x:Key="ModeSectionFieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource PanelCaptionTextStyle}">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="FluentSettingsCardStyle" TargetType="Border" BasedOn="{StaticResource PanelSectionCardStyle}" />
    <Style x:Key="FluentHeroCardStyle" TargetType="Border" BasedOn="{StaticResource PanelCardStyle}" />
    <Style x:Key="CompactChoiceCardStyle" TargetType="Border" BasedOn="{StaticResource PanelSectionCardStyle}" />
    <Style x:Key="ModeSectionCardStyle" TargetType="Border" BasedOn="{StaticResource PanelCardStyle}">
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style x:Key="FluentIconContainerStyle" TargetType="Border" BasedOn="{StaticResource PanelIconContainerStyle}">
        <Setter Property="Background" Value="{StaticResource PanelSectionBrush}" />
        <Setter Property="Margin" Value="0,0,12,0" />
    </Style>
    <Style x:Key="CompactCircleIconStyle" TargetType="Border" BasedOn="{StaticResource FluentIconContainerStyle}">
        <Setter Property="Background" Value="{StaticResource PanelAccentBrush}" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style x:Key="FluentPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PanelPrimaryButtonStyle}" />
    <Style x:Key="FluentSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PanelButtonStyle}" />
    <Style x:Key="FluentInputStyle" TargetType="TextBox" BasedOn="{StaticResource PanelTextBoxStyle}" />
</ResourceDictionary>
