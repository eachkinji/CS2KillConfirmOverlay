<UserControl
    x:Class="KillConfirmGameBar.Controls.GameStyles.KillFeedbackAppearanceRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="ms-appx:///Controls/Settings/PanelDesign.xaml" />
        </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border
        x:Name="Card" Style="{StaticResource PanelSectionCardStyle}">
        <StackPanel Spacing="8">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="LayerNameText"
                    VerticalAlignment="Center"
                    TextWrapping="WrapWholeWords" Style="{StaticResource PanelTitleTextStyle}" />
                <ToggleSwitch
                    x:Name="EnabledToggle"
                    Grid.Column="1"
                    MinWidth="0"
                    Toggled="OnSettingChanged" />
            </Grid>

            <Grid x:Name="AdjustmentGrid" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="2">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="BrightnessLabel" HorizontalAlignment="Left" Style="{StaticResource PanelCaptionTextStyle}" />
                        <TextBlock x:Name="BrightnessValueText" Grid.Column="1" HorizontalAlignment="Right" FontWeight="SemiBold" Style="{StaticResource PanelCaptionTextStyle}" />
                    </Grid>
                    <Slider
                        x:Name="BrightnessSlider"
                        Minimum="50"
                        Maximum="150"
                        StepFrequency="5" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="2">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="ContrastLabel" HorizontalAlignment="Left" Style="{StaticResource PanelCaptionTextStyle}" />
                        <TextBlock x:Name="ContrastValueText" Grid.Column="1" HorizontalAlignment="Right" FontWeight="SemiBold" Style="{StaticResource PanelCaptionTextStyle}" />
                    </Grid>
                    <Slider
                        x:Name="ContrastSlider"
                        Minimum="50"
                        Maximum="150"
                        StepFrequency="5" />
                </StackPanel>

                <StackPanel Grid.Column="2" Spacing="2">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="OpacityLabel" HorizontalAlignment="Left" Style="{StaticResource PanelCaptionTextStyle}" />
                        <TextBlock x:Name="OpacityValueText" Grid.Column="1" HorizontalAlignment="Right" FontWeight="SemiBold" Style="{StaticResource PanelCaptionTextStyle}" />
                    </Grid>
                    <Slider
                        x:Name="OpacitySlider"
                        Minimum="10"
                        Maximum="100"
                        StepFrequency="5" />
                </StackPanel>
            </Grid>

            <ContentControl
                x:Name="AdditionalSettingsHost"
                HorizontalContentAlignment="Stretch"
                Visibility="Collapsed" />
        </StackPanel>
    </Border>
</UserControl>
