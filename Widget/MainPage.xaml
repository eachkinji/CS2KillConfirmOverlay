<Page
    x:Class="KillConfirmGameBar.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:KillConfirmGameBar.Controls.Settings"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    RequestedTheme="Light">

    <Page.Resources>
        <LinearGradientBrush x:Key="MainBackgroundGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F2F3F2" Offset="0.0" />
            <GradientStop Color="#D8D9D8" Offset="1.0" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="OrangeSlashGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F29A17" Offset="0.0" />
            <GradientStop Color="#EA7F05" Offset="0.55" />
            <GradientStop Color="#DB6900" Offset="1.0" />
        </LinearGradientBrush>

        <AcrylicBrush x:Key="MainBackgroundAcrylic"
                      BackgroundSource="HostBackdrop"
                      TintColor="#F4F4F1"
                      TintOpacity="0.55"
                      FallbackColor="#F4F4F1" />

        <AcrylicBrush x:Key="CardBackgroundAcrylic"
                      BackgroundSource="Backdrop"
                      TintColor="#FAFAF7"
                      TintOpacity="0.88"
                      FallbackColor="#FAFAF7" />

        <Style x:Key="SettingsSectionCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="22" />
            <Setter Property="Background" Value="{StaticResource CardBackgroundAcrylic}" />
            <Setter Property="BorderBrush" Value="#E2DDD3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="24" />
        </Style>

        <Style x:Key="SettingsHeaderButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#1D2233" />
            <Setter Property="BorderBrush" Value="#D5D0C4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="SettingsPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SettingsHeaderButtonStyle}">
            <Setter Property="Background" Value="#2E88B8" />
            <Setter Property="BorderBrush" Value="#3A9CCF" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="SettingsCaptionTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#555966" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
            <Setter Property="LineHeight" Value="20" />
        </Style>

        <Style x:Key="SettingsSectionTitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#1B1F31" />
            <Setter Property="CharacterSpacing" Value="40" />
        </Style>

        <Style x:Key="MethodStepCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="14" />
            <Setter Property="Background" Value="#FFFFFC" />
            <Setter Property="BorderBrush" Value="#E2DDD3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
        </Style>

        <Style x:Key="MethodStepBadgeStyle" TargetType="Border">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="#F29A17" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>

        <Style x:Key="MethodStepTitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#1B1F31" />
        </Style>

        <Style x:Key="MethodStepBodyTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#555966" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
            <Setter Property="LineHeight" Value="17" />
        </Style>

        <Style x:Key="MethodStepDetailTitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#1B1F31" />
        </Style>

        <Style x:Key="MethodStepMonoTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="#4B5563" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="LineHeight" Value="16" />
        </Style>

        <Style x:Key="MethodInlineButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Background" Value="#ECF7FC" />
            <Setter Property="Foreground" Value="#2E88B8" />
            <Setter Property="BorderBrush" Value="#B9DCEC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="GameModeSidebarItemStyle" TargetType="ListViewItem">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border
                            Width="{TemplateBinding Width}"
                            Height="{TemplateBinding Height}"
                            Background="{TemplateBinding Background}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GameModeLogoTileStyle" TargetType="Border">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="#F4FAFAF7" />
            <Setter Property="BorderBrush" Value="#D5D0C4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>
    </Page.Resources>

    <Grid x:Name="SettingsRootGrid" Background="{StaticResource MainBackgroundGradient}">
        <Canvas IsHitTestVisible="False">
            <Rectangle x:Name="HeroSlash" Width="620" Height="1200" Fill="{StaticResource OrangeSlashGradient}" Opacity="0.95" Canvas.Left="720" Canvas.Top="-160">
                <Rectangle.RenderTransform>
                    <SkewTransform AngleX="-18" />
                </Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle x:Name="HeroSlashLight" Width="24" Height="1200" Fill="#FFF0D5" Opacity="0.9" Canvas.Left="815" Canvas.Top="-120">
                <Rectangle.RenderTransform>
                    <SkewTransform AngleX="-18" />
                </Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle x:Name="FrameStripeOne" Width="260" Height="520" Stroke="#C4C4C4" StrokeThickness="3" Opacity="0.45" Canvas.Left="80" Canvas.Top="70">
                <Rectangle.RenderTransform>
                    <SkewTransform AngleX="-18" />
                </Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle x:Name="FrameStripeTwo" Width="260" Height="520" Stroke="#C4C4C4" StrokeThickness="3" Opacity="0.32" Canvas.Left="420" Canvas.Top="110">
                <Rectangle.RenderTransform>
                    <SkewTransform AngleX="-18" />
                </Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle x:Name="AccentLineOne" Width="190" Height="2" Fill="#CF6B00" Opacity="0.35" Canvas.Left="910" Canvas.Top="150">
                <Rectangle.RenderTransform>
                    <SkewTransform AngleX="-18" />
                </Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle x:Name="AccentLineTwo" Width="260" Height="2" Fill="#CF6B00" Opacity="0.35" Canvas.Left="910" Canvas.Top="165">
                <Rectangle.RenderTransform>
                    <SkewTransform AngleX="-18" />
                </Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle x:Name="AccentLineThree" Width="220" Height="2" Fill="#CF6B00" Opacity="0.35" Canvas.Left="910" Canvas.Top="180">
                <Rectangle.RenderTransform>
                    <SkewTransform AngleX="-18" />
                </Rectangle.RenderTransform>
            </Rectangle>
        </Canvas>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                x:Name="GameModeSidebar"
                Grid.Column="0"
                Width="62"
                Margin="5,18,5,18"
                Padding="5,10"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="{StaticResource CardBackgroundAcrylic}"
                BorderBrush="#D5D0C4"
                BorderThickness="1"
                CornerRadius="20">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        x:Name="GameStyleSidebarTitleText"
                        HorizontalAlignment="Center"
                        FontSize="10"
                        FontWeight="Bold"
                        Foreground="#555966"
                        Text="GAME"
                        TextTrimming="CharacterEllipsis" />

                    <ListView
                        x:Name="GameStyleSidebarSelector"
                        Grid.Row="1"
                        Width="50"
                        Padding="0"
                        HorizontalAlignment="Center"
                        HorizontalContentAlignment="Center"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Hidden"
                        SelectionChanged="OnGameStyleSidebarSelectionChanged"
                        SelectionMode="Single">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.Resources>
                            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
                            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
                            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="Transparent" />
                        </ListView.Resources>
                            <ListViewItem Tag="crossfire" Style="{StaticResource GameModeSidebarItemStyle}" ToolTipService.ToolTip="CrossFire">
                                <Border Style="{StaticResource GameModeLogoTileStyle}"><Image Source="ms-appx:///Assets/GameLogos/crossfire.png" Stretch="Uniform" /></Border>
                            </ListViewItem>
                            <ListViewItem Tag="csol" Style="{StaticResource GameModeSidebarItemStyle}" ToolTipService.ToolTip="CSOL">
                                <Border Style="{StaticResource GameModeLogoTileStyle}"><Image Source="ms-appx:///Assets/GameLogos/csol.png" Stretch="Uniform" /></Border>
                            </ListViewItem>
                            <ListViewItem Tag="valorant" Style="{StaticResource GameModeSidebarItemStyle}" ToolTipService.ToolTip="Valorant">
                                <Border Style="{StaticResource GameModeLogoTileStyle}"><Image Source="ms-appx:///Assets/GameLogos/valorant.png" Stretch="Uniform" /></Border>
                            </ListViewItem>
                            <ListViewItem Tag="battlefield1" Style="{StaticResource GameModeSidebarItemStyle}" ToolTipService.ToolTip="Battlefield 1">
                                <Border Style="{StaticResource GameModeLogoTileStyle}"><Image Source="ms-appx:///Assets/GameLogos/battlefield1.png" Stretch="Uniform" /></Border>
                            </ListViewItem>
                            <ListViewItem Tag="battlefield5" Style="{StaticResource GameModeSidebarItemStyle}" ToolTipService.ToolTip="Battlefield V">
                                <Border Style="{StaticResource GameModeLogoTileStyle}"><Image Source="ms-appx:///Assets/GameLogos/battlefield5.png" Stretch="Uniform" /></Border>
                            </ListViewItem>
                            <ListViewItem Tag="battlefield4" Style="{StaticResource GameModeSidebarItemStyle}" ToolTipService.ToolTip="Battlefield 4">
                                <Border Style="{StaticResource GameModeLogoTileStyle}"><Image Source="ms-appx:///Assets/GameLogos/battlefield4.png" Stretch="Uniform" /></Border>
                            </ListViewItem>
                            <ListViewItem Tag="battlefield2042" Style="{StaticResource GameModeSidebarItemStyle}" ToolTipService.ToolTip="Battlefield 2042">
                                <Border Style="{StaticResource GameModeLogoTileStyle}"><Image Source="ms-appx:///Assets/GameLogos/battlefield2042.png" Stretch="Uniform" /></Border>
                            </ListViewItem>
                            <ListViewItem Tag="pubg" Style="{StaticResource GameModeSidebarItemStyle}" ToolTipService.ToolTip="PUBG">
                                <Border Style="{StaticResource GameModeLogoTileStyle}"><Image Source="ms-appx:///Assets/GameLogos/pubg.png" Stretch="Uniform" /></Border>
                            </ListViewItem>
                            <ListViewItem Tag="deltaforce" Style="{StaticResource GameModeSidebarItemStyle}" ToolTipService.ToolTip="Delta Force">
                                <Border Style="{StaticResource GameModeLogoTileStyle}"><Image Source="ms-appx:///Assets/GameLogos/deltaforce.png" Stretch="Uniform" /></Border>
                            </ListViewItem>
                    </ListView>
                </Grid>
            </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent">
        <Grid Padding="18,18,22,24" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Sleek Top Header Bar for 16:9 Widescreen -->
            <Grid MaxWidth="1480" HorizontalAlignment="Stretch" Padding="4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.ColumnSpan="2" HorizontalAlignment="Center" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                    <TextBlock
                        x:Name="TitleText"
                        FontSize="22"
                        FontWeight="Bold"
                        Foreground="#1B1F31"
                        Text="Kill Confirm Overlay 控制面板" />
                </StackPanel>

                <StackPanel Grid.Column="1" Visibility="Collapsed" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                    <TextBlock
                        x:Name="GameStyleLabelText"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="#1B1F31"
                        Text="当前游戏模式:" />
                    <ComboBox
                        x:Name="GameStyleSelector"
                        Width="210"
                        Height="32"
                        Padding="10,2"
                        FontSize="12"
                        FontWeight="SemiBold"
                        CornerRadius="8"
                        SelectionChanged="OnGameStyleSelectionChanged">
                        <ComboBoxItem x:Name="CrossfireStyleItem" Tag="crossfire">CrossFire (穿越火线)</ComboBoxItem>
                        <ComboBoxItem x:Name="CsolStyleItem" Tag="csol">CSOL (反恐精英Online)</ComboBoxItem>
                        <ComboBoxItem x:Name="ValorantStyleItem" Tag="valorant">Valorant (无畏契约)</ComboBoxItem>
                        <ComboBoxItem x:Name="Battlefield1StyleItem" Tag="battlefield1">Battlefield 1 (战地1)</ComboBoxItem>
                        <ComboBoxItem x:Name="Battlefield5StyleItem" Tag="battlefield5">Battlefield V (战地5)</ComboBoxItem>
                        <ComboBoxItem x:Name="Battlefield4StyleItem" Tag="battlefield4">Battlefield 4 (战地4)</ComboBoxItem>
                        <ComboBoxItem x:Name="Battlefield2042StyleItem" Tag="battlefield2042">Battlefield 2042 (战地2042)</ComboBoxItem>
                        <ComboBoxItem x:Name="PubgStyleItem" Tag="pubg">PUBG (绝地求生)</ComboBoxItem>
                        <ComboBoxItem x:Name="DeltaForceStyleItem" Tag="deltaforce">Delta Force (三角洲行动)</ComboBoxItem>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <Grid
                Grid.Row="1"
                MaxWidth="1480"
                HorizontalAlignment="Stretch"
                ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="14">
                    <Border x:Name="GameEffectsCard" Style="{StaticResource SettingsSectionCardStyle}">
                        <StackPanel Spacing="14">
                            <TextBlock
                                x:Name="GameEffectsTitleText"
                                Style="{StaticResource SettingsSectionTitleTextStyle}"
                                FontSize="18"
                                Text="Game effects" />
                            <ContentControl
                                x:Name="GameAdvancedSettingsPanelHost"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="GeneralSettingsCard" Style="{StaticResource SettingsSectionCardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock
                                x:Name="GeneralSettingsTitleText"
                                Style="{StaticResource SettingsSectionTitleTextStyle}"
                                FontSize="18"
                                Text="通用设置" />
                            <settings:GeneralSettingsOptionsPanel x:Name="GeneralSettingsOptionsPanel" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="VoicePackCollectionsCard" Style="{StaticResource SettingsSectionCardStyle}">
                        <StackPanel Spacing="14">
                            <Grid RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Spacing="4">
                                    <TextBlock
                                        x:Name="VoiceCollectionsTitleText"
                                        Style="{StaticResource SettingsSectionTitleTextStyle}" />
                                    <TextBlock
                                        x:Name="VoiceCollectionsHintText"
                                        Style="{StaticResource SettingsCaptionTextStyle}" />
                                </StackPanel>

                                <StackPanel
                                    Grid.Row="1"
                                    Orientation="Horizontal"
                                    Spacing="12">
                                    <Button
                                        x:Name="ImportVoicePackButton"
                                        Style="{StaticResource SettingsHeaderButtonStyle}"
                                        Click="OnImportVoicePackClick" />
                                    <Button
                                        x:Name="ImportVoiceZipButton"
                                        Style="{StaticResource SettingsHeaderButtonStyle}"
                                        Click="OnImportVoiceZipClick" />
                                    <Button
                                        x:Name="CreateVoicePackButton"
                                        Style="{StaticResource SettingsPrimaryButtonStyle}"
                                        Click="OnCreateVoicePackClick" />
                                </StackPanel>
                            </Grid>

                            <TextBlock
                                x:Name="VoiceVisibleCountText"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="#2E88B8" />

                            <VariableSizedWrapGrid
                                x:Name="VoicePackListPanel"
                                Orientation="Horizontal"
                                ItemWidth="250"
                                ItemHeight="82" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="IconPackCollectionsCard" Style="{StaticResource SettingsSectionCardStyle}">
                        <StackPanel Spacing="14">
                            <Grid RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Spacing="4">
                                    <TextBlock
                                        x:Name="IconCollectionsTitleText"
                                        Style="{StaticResource SettingsSectionTitleTextStyle}" />
                                    <TextBlock
                                        x:Name="IconCollectionsHintText"
                                        Style="{StaticResource SettingsCaptionTextStyle}" />
                                </StackPanel>

                                <StackPanel
                                    Grid.Row="1"
                                    Orientation="Horizontal"
                                    Spacing="12">
                                    <Button
                                        x:Name="ImportIconPackButton"
                                        Style="{StaticResource SettingsHeaderButtonStyle}"
                                        Click="OnImportIconPackClick" />
                                    <Button
                                        x:Name="ImportIconZipButton"
                                        Style="{StaticResource SettingsHeaderButtonStyle}"
                                        Click="OnImportIconZipClick" />
                                    <Button
                                        x:Name="CreateIconPackButton"
                                        Style="{StaticResource SettingsPrimaryButtonStyle}"
                                        Click="OnCreateIconPackClick" />
                                </StackPanel>
                            </Grid>

                            <TextBlock
                                x:Name="IconVisibleCountText"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="#2E88B8" />

                            <VariableSizedWrapGrid
                                x:Name="IconPackListPanel"
                                Orientation="Horizontal"
                                ItemWidth="250"
                                ItemHeight="82" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Spacing="14">
                    <Border x:Name="VoiceCollectionsCard" Style="{StaticResource SettingsSectionCardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock
                                x:Name="StructureTitleText"
                                Style="{StaticResource SettingsSectionTitleTextStyle}" />
                            <TextBlock
                                x:Name="StructureBodyText"
                                Style="{StaticResource SettingsCaptionTextStyle}" />

                            <Border Style="{StaticResource MethodStepCardStyle}">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource MethodStepBadgeStyle}">
                                        <TextBlock Text="1" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="8">
                                        <TextBlock x:Name="StructureImportFolderTitleText" Style="{StaticResource MethodStepTitleTextStyle}" />
                                        <TextBlock x:Name="StructureImportFolderBodyText" Style="{StaticResource MethodStepBodyTextStyle}" />

                                        <Border Padding="10" Background="#F7F8FA" BorderBrush="#E2DDD3" BorderThickness="1" CornerRadius="14">
                                            <StackPanel Spacing="5">
                                                <TextBlock x:Name="StructureVoiceSpecTitleText" Style="{StaticResource MethodStepDetailTitleTextStyle}" />
                                                <TextBlock x:Name="StructureVoiceSpecBodyText" Style="{StaticResource MethodStepMonoTextStyle}" />
                                            </StackPanel>
                                        </Border>

                                        <Border Padding="10" Background="#FFF8EB" BorderBrush="#F2C078" BorderThickness="1" CornerRadius="14">
                                            <StackPanel Spacing="6">
                                                <TextBlock x:Name="StructureIconSpecTitleText" Style="{StaticResource MethodStepDetailTitleTextStyle}" />
                                                <TextBlock x:Name="StructureIconSpecSummaryText" Style="{StaticResource MethodStepBodyTextStyle}" Foreground="#8A4B00" />
                                                <Button
                                                    x:Name="IconSpecToggleButton"
                                                    Style="{StaticResource MethodInlineButtonStyle}"
                                                    HorizontalAlignment="Left"
                                                    Click="OnIconSpecToggleClick" />
                                                <TextBlock
                                                    x:Name="StructureIconSpecFullText"
                                                    Style="{StaticResource MethodStepMonoTextStyle}"
                                                    Visibility="Collapsed" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource MethodStepCardStyle}">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource MethodStepBadgeStyle}" Background="#2E88B8">
                                        <TextBlock Text="2" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock x:Name="StructureImportZipTitleText" Style="{StaticResource MethodStepTitleTextStyle}" />
                                        <TextBlock x:Name="StructureImportZipBodyText" Style="{StaticResource MethodStepBodyTextStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource MethodStepCardStyle}">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource MethodStepBadgeStyle}" Background="#1F2937">
                                        <TextBlock Text="3" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock x:Name="StructureCreatorTitleText" Style="{StaticResource MethodStepTitleTextStyle}" />
                                        <TextBlock x:Name="StructureCreatorBodyText" Style="{StaticResource MethodStepBodyTextStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Padding="12" Background="#FFF6E8" BorderBrush="#F2C078" BorderThickness="1" CornerRadius="16">
                                <TextBlock x:Name="StructureFileHintText" Style="{StaticResource MethodStepBodyTextStyle}" Foreground="#8A4B00" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border x:Name="IconCollectionsCard" Style="{StaticResource SettingsSectionCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock
                                x:Name="TipsTitleText"
                                Style="{StaticResource SettingsSectionTitleTextStyle}"
                                FontSize="18" />
                            <TextBlock
                                x:Name="TipsBodyText"
                                Style="{StaticResource SettingsCaptionTextStyle}" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
        </Grid>
    </Grid>
</Page>
