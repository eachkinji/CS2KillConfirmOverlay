<Page
    x:Class="KillConfirmGameBar.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:KillConfirmGameBar.Controls.Settings"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    RequestedTheme="Light">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///KillConfirmWidgetPage.Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="MainBackgroundSolid" Color="#F9F9F9" />
            <LinearGradientBrush x:Key="MainBackgroundGradient" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#F9F9F9" Offset="0.0" />
                <GradientStop Color="#F3F3F3" Offset="1.0" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="OrangeSlashGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F29A17" Offset="0" />
                <GradientStop Color="#EA7F05" Offset="0.58" />
                <GradientStop Color="#DB6900" Offset="1" />
            </LinearGradientBrush>

            <AcrylicBrush x:Key="MainBackgroundAcrylic"
                          BackgroundSource="HostBackdrop"
                          TintColor="#F3F3F3"
                          TintOpacity="0.8"
                          FallbackColor="#F3F3F3" />

        <AcrylicBrush x:Key="CardBackgroundAcrylic"
                      BackgroundSource="Backdrop"
                      TintColor="#FFFFFF"
                      TintOpacity="0.95"
                      FallbackColor="#FFFFFF" />

        <Style x:Key="SettingsSectionCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="18,16" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E5E5E5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style x:Key="SettingsHeaderButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#1B1B1B" />
            <Setter Property="BorderBrush" Value="#D1D1D1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="SettingsPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SettingsHeaderButtonStyle}">
            <Setter Property="Background" Value="#0067C0" />
            <Setter Property="BorderBrush" Value="#0067C0" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="StudioTabButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="MinWidth" Value="100" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#616161" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="StudioTabActiveButtonStyle" TargetType="Button" BasedOn="{StaticResource StudioTabButtonStyle}">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D1D1D1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#1B1B1B" />
        </Style>

        <Style x:Key="SettingsCaptionTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#616161" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
            <Setter Property="LineHeight" Value="16" />
        </Style>

        <Style x:Key="SettingsSectionTitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#1B1B1B" />
        </Style>

        <Style x:Key="MethodStepCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Background" Value="#FAFAFA" />
            <Setter Property="BorderBrush" Value="#E5E5E5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <Style x:Key="MethodStepBadgeStyle" TargetType="Border">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Background" Value="#0067C0" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <Style x:Key="MethodStepTitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#1B1B1B" />
        </Style>

        <Style x:Key="MethodStepBodyTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#616161" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
            <Setter Property="LineHeight" Value="16" />
        </Style>

        <Style x:Key="MethodStepDetailTitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#1B1B1B" />
        </Style>

        <Style x:Key="MethodStepMonoTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#424242" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="LineHeight" Value="16" />
        </Style>

        <Style x:Key="MethodInlineButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Background" Value="#EBF3FC" />
            <Setter Property="Foreground" Value="#0067C0" />
            <Setter Property="BorderBrush" Value="#CCE4F7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="GameModeSidebarItemStyle" TargetType="ListViewItem">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border
                            Width="{TemplateBinding Width}"
                            Height="{TemplateBinding Height}"
                            Background="{TemplateBinding Background}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GameModeLogoTileStyle" TargetType="Border">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="#F3F3F3" />
            <Setter Property="BorderBrush" Value="#E5E5E5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="SettingsRootGrid" Background="{StaticResource MainBackgroundGradient}">
        <Canvas IsHitTestVisible="False">
            <Rectangle x:Name="HeroSlash" Width="620" Height="1200" Fill="{StaticResource OrangeSlashGradient}" Opacity="0.95" Canvas.Left="720" Canvas.Top="-160">
                <Rectangle.RenderTransform>
                    <SkewTransform AngleX="-18" />
                </Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle x:Name="HeroSlashLight" Width="24" Height="1200" Fill="#FFF0D5" Opacity="0.9" Canvas.Left="815" Canvas.Top="-120">
                <Rectangle.RenderTransform>
                    <SkewTransform AngleX="-18" />
                </Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle x:Name="FrameStripeOne" Width="260" Height="520" Stroke="#C4C4C4" StrokeThickness="3" Opacity="0.45" Canvas.Left="80" Canvas.Top="70">
                <Rectangle.RenderTransform>
                    <SkewTransform AngleX="-18" />
                </Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle x:Name="FrameStripeTwo" Width="260" Height="520" Stroke="#C4C4C4" StrokeThickness="3" Opacity="0.32" Canvas.Left="420" Canvas.Top="110">
                <Rectangle.RenderTransform>
                    <SkewTransform AngleX="-18" />
                </Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle x:Name="AccentLineOne" Width="190" Height="2" Fill="#CF6B00" Opacity="0.35" Canvas.Left="910" Canvas.Top="150">
                <Rectangle.RenderTransform>
                    <SkewTransform AngleX="-18" />
                </Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle x:Name="AccentLineTwo" Width="260" Height="2" Fill="#CF6B00" Opacity="0.35" Canvas.Left="910" Canvas.Top="165">
                <Rectangle.RenderTransform>
                    <SkewTransform AngleX="-18" />
                </Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle x:Name="AccentLineThree" Width="220" Height="2" Fill="#CF6B00" Opacity="0.35" Canvas.Left="910" Canvas.Top="180">
                <Rectangle.RenderTransform>
                    <SkewTransform AngleX="-18" />
                </Rectangle.RenderTransform>
            </Rectangle>
        </Canvas>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar Navigation (Fluent 2 Vertical Navigation Rail) -->
            <Border
                x:Name="GameModeSidebar"
                Grid.Column="0"
                Width="54"
                Margin="5,12,5,12"
                Padding="4,8"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="#FFFFFF"
                BorderBrush="#E5E5E5"
                BorderThickness="1"
                CornerRadius="8">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        x:Name="GameStyleSidebarTitleText"
                        HorizontalAlignment="Center"
                        FontSize="9"
                        FontWeight="SemiBold"
                        Foreground="#8C8C8C"
                        Text="MODE"
                        TextTrimming="CharacterEllipsis" />

                    <ListView
                        x:Name="GameStyleSidebarSelector"
                        Grid.Row="1"
                        Width="44"
                        Padding="0"
                        HorizontalAlignment="Center"
                        HorizontalContentAlignment="Center"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Hidden"
                        SelectionChanged="OnGameStyleSidebarSelectionChanged"
                        SelectionMode="Single">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.Resources>
                            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
                            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
                            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="Transparent" />
                        </ListView.Resources>
                        <ListViewItem x:Name="HomeSidebarItem" Tag="home" Style="{StaticResource GameModeSidebarItemStyle}" ToolTipService.ToolTip="系统设置">
                            <Border Style="{StaticResource GameModeLogoTileStyle}">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="18"
                                    Foreground="{StaticResource FluentAccent}"
                                    Glyph="&#xE80F;" />
                            </Border>
                        </ListViewItem>
                        <ListViewItem Tag="crossfire" Style="{StaticResource GameModeSidebarItemStyle}" ToolTipService.ToolTip="CrossFire">
                            <Border Style="{StaticResource GameModeLogoTileStyle}"><Image Source="ms-appx:///Assets/GameLogos/crossfire.png" Stretch="Uniform" /></Border>
                        </ListViewItem>
                        <ListViewItem Tag="csol" Style="{StaticResource GameModeSidebarItemStyle}" ToolTipService.ToolTip="CSOL">
                            <Border Style="{StaticResource GameModeLogoTileStyle}"><Image Source="ms-appx:///Assets/GameLogos/csol.png" Stretch="Uniform" /></Border>
                        </ListViewItem>
                        <ListViewItem Tag="valorant" Style="{StaticResource GameModeSidebarItemStyle}" ToolTipService.ToolTip="Valorant">
                            <Border Style="{StaticResource GameModeLogoTileStyle}"><Image Source="ms-appx:///Assets/GameLogos/valorant.png" Stretch="Uniform" /></Border>
                        </ListViewItem>
                        <ListViewItem Tag="battlefield1" Style="{StaticResource GameModeSidebarItemStyle}" ToolTipService.ToolTip="Battlefield 1">
                            <Border Style="{StaticResource GameModeLogoTileStyle}"><Image Source="ms-appx:///Assets/GameLogos/battlefield1.png" Stretch="Uniform" /></Border>
                        </ListViewItem>
                        <ListViewItem Tag="battlefield5" Style="{StaticResource GameModeSidebarItemStyle}" ToolTipService.ToolTip="Battlefield V">
                            <Border Style="{StaticResource GameModeLogoTileStyle}"><Image Source="ms-appx:///Assets/GameLogos/battlefield5.png" Stretch="Uniform" /></Border>
                        </ListViewItem>
                        <ListViewItem Tag="battlefield4" Style="{StaticResource GameModeSidebarItemStyle}" ToolTipService.ToolTip="Battlefield 4">
                            <Border Style="{StaticResource GameModeLogoTileStyle}"><Image Source="ms-appx:///Assets/GameLogos/battlefield4.png" Stretch="Uniform" /></Border>
                        </ListViewItem>
                        <ListViewItem Tag="battlefield2042" Style="{StaticResource GameModeSidebarItemStyle}" ToolTipService.ToolTip="Battlefield 2042">
                            <Border Style="{StaticResource GameModeLogoTileStyle}"><Image Source="ms-appx:///Assets/GameLogos/battlefield2042.png" Stretch="Uniform" /></Border>
                        </ListViewItem>
                        <ListViewItem Tag="pubg" Style="{StaticResource GameModeSidebarItemStyle}" ToolTipService.ToolTip="PUBG">
                            <Border Style="{StaticResource GameModeLogoTileStyle}"><Image Source="ms-appx:///Assets/GameLogos/pubg.png" Stretch="Uniform" /></Border>
                        </ListViewItem>
                        <ListViewItem Tag="deltaforce" Style="{StaticResource GameModeSidebarItemStyle}" ToolTipService.ToolTip="Delta Force">
                            <Border Style="{StaticResource GameModeLogoTileStyle}"><Image Source="ms-appx:///Assets/GameLogos/deltaforce.png" Stretch="Uniform" /></Border>
                        </ListViewItem>
                        <ListViewItem Tag="doubao" Style="{StaticResource GameModeSidebarItemStyle}" ToolTipService.ToolTip="豆包">
                            <Border Style="{StaticResource GameModeLogoTileStyle}"><Image Source="ms-appx:///Assets/GameLogos/doubao.png" Stretch="Uniform" /></Border>
                        </ListViewItem>
                        <ListViewItem Tag="dagoujiao" Style="{StaticResource GameModeSidebarItemStyle}" ToolTipService.ToolTip="大狗叫">
                            <Border Style="{StaticResource GameModeLogoTileStyle}"><Image Source="ms-appx:///Assets/GameLogos/dagoujiao.jpg" Stretch="Uniform" /></Border>
                        </ListViewItem>
                    </ListView>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent">
                <Grid Padding="18,14,22,24" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Top Header Bar -->
                    <Grid MaxWidth="1480" HorizontalAlignment="Stretch" Padding="2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.ColumnSpan="2" HorizontalAlignment="Left" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                            <TextBlock
                                x:Name="TitleText"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="#1B1B1B"
                                Text="Kill Confirm Overlay 控制面板" />
                        </StackPanel>

                        <!-- Hidden compatibility anchor -->
                        <StackPanel Grid.Column="1" Visibility="Collapsed">
                            <TextBlock x:Name="GameStyleLabelText" />
                            <ComboBox x:Name="GameStyleSelector" SelectionChanged="OnGameStyleSelectionChanged">
                                <ComboBoxItem x:Name="CrossfireStyleItem" Tag="crossfire">CrossFire (穿越火线)</ComboBoxItem>
                                <ComboBoxItem x:Name="CsolStyleItem" Tag="csol">CSOL (反恐精英Online)</ComboBoxItem>
                                <ComboBoxItem x:Name="ValorantStyleItem" Tag="valorant">Valorant (无畏契约)</ComboBoxItem>
                                <ComboBoxItem x:Name="Battlefield1StyleItem" Tag="battlefield1">Battlefield 1 (战地1)</ComboBoxItem>
                                <ComboBoxItem x:Name="Battlefield5StyleItem" Tag="battlefield5">Battlefield V (战地5)</ComboBoxItem>
                                <ComboBoxItem x:Name="Battlefield4StyleItem" Tag="battlefield4">Battlefield 4 (战地4)</ComboBoxItem>
                                <ComboBoxItem x:Name="Battlefield2042StyleItem" Tag="battlefield2042">Battlefield 2042 (战地2042)</ComboBoxItem>
                                <ComboBoxItem x:Name="PubgStyleItem" Tag="pubg">PUBG (绝地求生)</ComboBoxItem>
                                <ComboBoxItem x:Name="DeltaForceStyleItem" Tag="deltaforce">Delta Force (三角洲行动)</ComboBoxItem>
                                <ComboBoxItem x:Name="DoubaoStyleItem" Tag="doubao">Doubao (豆包)</ComboBoxItem>
                                <ComboBoxItem x:Name="DagoujiaoStyleItem" Tag="dagoujiao">Big Dog Bark (大狗叫)</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- Home Dedicated Navigation Tab Bar (Distinct Fluent 2 Tabs) -->
                    <Border
                        x:Name="HomeWorkspaceTabBar"
                        Grid.Row="1"
                        MaxWidth="1480"
                        Padding="3"
                        HorizontalAlignment="Left"
                        Background="#E8F0F8"
                        BorderBrush="#CFDEEC"
                        BorderThickness="1"
                        CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button
                                x:Name="HomeTabGeneralButton"
                                Style="{StaticResource StudioTabActiveButtonStyle}"
                                Content="游戏体验增强"
                                Click="OnHomeTabGeneralClick" />
                            <Button
                                x:Name="HomeTabPortButton"
                                Style="{StaticResource StudioTabButtonStyle}"
                                Content="本地服务端口"
                                Click="OnHomeTabPortClick" />
                            <Button
                                x:Name="HomeTabDisplayButton"
                                Style="{StaticResource StudioTabButtonStyle}"
                                Content="进阶设置"
                                Click="OnHomeTabDisplayClick" />
                            <Button
                                x:Name="HomeTabAboutButton"
                                Style="{StaticResource StudioTabButtonStyle}"
                                Content="关于本版本"
                                Click="OnHomeTabAboutClick" />
                        </StackPanel>
                    </Border>

                    <!-- Game Studio Unified Navigation Tab Bar (For ALL games: CF, CSOL, Valorant, BF1, BF5, BF4, BF2042, PUBG, Delta Force, Doubao, Dagoujiao) -->
                    <Border
                        x:Name="GameWorkspaceTabBar"
                        Grid.Row="1"
                        MaxWidth="1480"
                        Padding="3"
                        HorizontalAlignment="Left"
                        Background="#EBEBEB"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button
                                x:Name="GameTabCombatButton"
                                Style="{StaticResource StudioTabActiveButtonStyle}"
                                Content="战斗与视效"
                                Click="OnGameTabCombatClick" />
                            <Button
                                x:Name="GameTabVoiceButton"
                                Style="{StaticResource StudioTabButtonStyle}"
                                Content="语音包库"
                                Click="OnGameTabVoiceClick" />
                            <Button
                                x:Name="GameTabIconButton"
                                Style="{StaticResource StudioTabButtonStyle}"
                                Content="图标包库"
                                Click="OnGameTabIconClick" />
                            <Button
                                x:Name="GameTabGuideButton"
                                Style="{StaticResource StudioTabButtonStyle}"
                                Content="自定义规范"
                                Click="OnGameTabGuideClick" />
                        </StackPanel>
                    </Border>

                    <!-- Home View -->
                    <Grid
                        x:Name="HomePageContent"
                        Grid.Row="2"
                        MaxWidth="1480"
                        HorizontalAlignment="Stretch">
                        <settings:AdvancedSettingsHub x:Name="AdvancedSettingsHubControl" />
                    </Grid>

                    <!-- Game Control Page Content (Full Width Dedicated Views) -->
                    <Grid
                        x:Name="GamePageContent"
                        Grid.Row="2"
                        MaxWidth="1480"
                        HorizontalAlignment="Stretch">

                        <!-- View 1: Combat & Effects Engine Controls (Full Width) -->
                        <Border x:Name="GameEffectsCard" Style="{StaticResource SettingsSectionCardStyle}">
                            <StackPanel Spacing="14">
                                <TextBlock
                                    x:Name="GameEffectsTitleText"
                                    Style="{StaticResource SettingsSectionTitleTextStyle}"
                                    FontSize="18"
                                    Text="CF 战斗与特效设置" />
                                <ContentControl
                                    x:Name="GameAdvancedSettingsPanelHost"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch" />
                            </StackPanel>
                        </Border>

                        <!-- View 2: Voice Packs Hub (Full Width) -->
                        <Border x:Name="VoicePackCollectionsCard" Style="{StaticResource SettingsSectionCardStyle}" Visibility="Collapsed">
                            <StackPanel Spacing="16">
                                <Grid RowSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            x:Name="VoiceCollectionsTitleText"
                                            Style="{StaticResource SettingsSectionTitleTextStyle}"
                                            Text="角色语音包仓库" />
                                        <TextBlock
                                            x:Name="VoiceCollectionsHintText"
                                            Style="{StaticResource SettingsCaptionTextStyle}"
                                            Text="官方角色与自定义语音包统一管理，可在游戏内悬浮窗随时切换启用。" />
                                    </StackPanel>

                                    <StackPanel
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                        <Button
                                            x:Name="ImportVoiceMaterialButton"
                                            Style="{StaticResource SettingsHeaderButtonStyle}"
                                            Click="OnImportVoiceMaterialClick" />
                                        <Button
                                            x:Name="ImportVoicePackButton"
                                            Style="{StaticResource SettingsHeaderButtonStyle}"
                                            Click="OnImportVoicePackClick" />
                                        <Button
                                            x:Name="ImportVoiceZipButton"
                                            Style="{StaticResource SettingsHeaderButtonStyle}"
                                            Click="OnImportVoiceZipClick" />
                                        <Button
                                            x:Name="CreateVoicePackButton"
                                            Style="{StaticResource SettingsPrimaryButtonStyle}"
                                            Click="OnCreateVoicePackClick" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock
                                    x:Name="VoiceVisibleCountText"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="#2E88B8" />

                                <VariableSizedWrapGrid
                                    x:Name="VoicePackListPanel"
                                    Orientation="Horizontal"
                                    ItemWidth="255"
                                    ItemHeight="84" />
                            </StackPanel>
                        </Border>

                        <!-- View 3: Icon Packs Hub (Full Width) -->
                        <Border x:Name="IconPackCollectionsCard" Style="{StaticResource SettingsSectionCardStyle}" Visibility="Collapsed">
                            <StackPanel Spacing="16">
                                <Grid RowSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            x:Name="IconCollectionsTitleText"
                                            Style="{StaticResource SettingsSectionTitleTextStyle}"
                                            Text="击杀图标包仓库" />
                                        <TextBlock
                                            x:Name="IconCollectionsHintText"
                                            Style="{StaticResource SettingsCaptionTextStyle}"
                                            Text="经典原版、VIP、王者之魄、CFPL 及自定义图标包统一管理。" />
                                    </StackPanel>

                                    <StackPanel
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                        <Button
                                            x:Name="ImportIconMaterialButton"
                                            Style="{StaticResource SettingsHeaderButtonStyle}"
                                            Click="OnImportIconMaterialClick" />
                                        <Button
                                            x:Name="ImportIconPackButton"
                                            Style="{StaticResource SettingsHeaderButtonStyle}"
                                            Click="OnImportIconPackClick" />
                                        <Button
                                            x:Name="ImportIconZipButton"
                                            Style="{StaticResource SettingsHeaderButtonStyle}"
                                            Click="OnImportIconZipClick" />
                                        <Button
                                            x:Name="CreateIconPackButton"
                                            Style="{StaticResource SettingsPrimaryButtonStyle}"
                                            Click="OnCreateIconPackClick" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock
                                    x:Name="IconVisibleCountText"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="#2E88B8" />

                                <VariableSizedWrapGrid
                                    x:Name="IconPackListPanel"
                                    Orientation="Horizontal"
                                    ItemWidth="255"
                                    ItemHeight="84" />
                            </StackPanel>
                        </Border>

                        <!-- View 4: Lightweight Technical Specifications & Guide (Full Width) -->
                        <Border x:Name="VoiceCollectionsCard" Style="{StaticResource SettingsSectionCardStyle}" Visibility="Collapsed">
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        x:Name="StructureTitleText"
                                        Style="{StaticResource SettingsSectionTitleTextStyle}"
                                        FontSize="18"
                                        Text="CF 资源包标准规范与制作指南" />
                                    <TextBlock
                                        x:Name="StructureBodyText"
                                        Style="{StaticResource SettingsCaptionTextStyle}"
                                        Text="所有内置包与自定义包均采用纯 Manifest 数据驱动，无需编写代码，只需放入规范命名的素材即可。" />
                                </StackPanel>

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Audio Slot Spec Box -->
                                    <Border Padding="14,12" Background="#FAFAFA" BorderBrush="#E5E5E5" BorderThickness="1" CornerRadius="6">
                                        <StackPanel Spacing="8">
                                            <TextBlock x:Name="StructureVoiceSpecTitleText" Style="{StaticResource MethodStepDetailTitleTextStyle}" FontSize="13" Text="音频插槽对照表 (Audio Slots)" />
                                            <TextBlock x:Name="StructureVoiceSpecBodyText" Style="{StaticResource MethodStepMonoTextStyle}" FontSize="11" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Icon Slot Spec Box -->
                                    <Border Grid.Column="1" Padding="14,12" Background="#FAFAFA" BorderBrush="#E5E5E5" BorderThickness="1" CornerRadius="6">
                                        <StackPanel Spacing="8">
                                            <TextBlock x:Name="StructureIconSpecTitleText" Style="{StaticResource MethodStepDetailTitleTextStyle}" FontSize="13" Text="图标与特效序列帧规范 (Visual Slots)" />
                                            <TextBlock x:Name="StructureIconSpecSummaryText" Style="{StaticResource MethodStepBodyTextStyle}" FontSize="11" Foreground="#0067C0" />
                                            <Button
                                                x:Name="IconSpecToggleButton"
                                                Style="{StaticResource MethodInlineButtonStyle}"
                                                HorizontalAlignment="Left"
                                                Click="OnIconSpecToggleClick" />
                                            <TextBlock
                                                x:Name="StructureIconSpecFullText"
                                                Style="{StaticResource MethodStepMonoTextStyle}"
                                                FontSize="11"
                                                Visibility="Collapsed" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Padding="12,10" Background="#F3F3F3" BorderBrush="#E5E5E5" BorderThickness="1" CornerRadius="6">
                                    <TextBlock x:Name="StructureFileHintText" Style="{StaticResource MethodStepBodyTextStyle}" FontSize="11" Foreground="#424242" />
                                </Border>

                                <!-- Hidden compatibility anchors for theme / language code-behind -->
                                <TextBlock x:Name="StructureImportFolderTitleText" Visibility="Collapsed" />
                                <TextBlock x:Name="StructureImportFolderBodyText" Visibility="Collapsed" />
                                <TextBlock x:Name="StructureImportZipTitleText" Visibility="Collapsed" />
                                <TextBlock x:Name="StructureImportZipBodyText" Visibility="Collapsed" />
                                <TextBlock x:Name="StructureCreatorTitleText" Visibility="Collapsed" />
                                <TextBlock x:Name="StructureCreatorBodyText" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="IconCollectionsCard" Visibility="Collapsed">
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="TipsTitleText" />
                                <TextBlock x:Name="TipsBodyText" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="CsolGuideCard" Style="{StaticResource SettingsSectionCardStyle}" Visibility="Collapsed">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="CsolStructureTitleText" FontSize="18" FontWeight="SemiBold" Foreground="#1B1B1B" />
                                <TextBlock x:Name="CsolStructureBodyText" FontSize="12" Foreground="#616161" TextWrapping="WrapWholeWords" />
                                <Border Background="#FAFAFA" BorderBrush="#E5E5E5" BorderThickness="1" CornerRadius="6" Padding="12">
                                    <StackPanel Spacing="6">
                                        <TextBlock x:Name="CsolStructureVoiceSpecTitle" FontSize="13" FontWeight="SemiBold" Foreground="#1B1B1B" />
                                        <TextBlock x:Name="CsolStructureVoiceSpecBody" FontSize="11" Foreground="#424242" FontFamily="Consolas" TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </Border>
                                <Border Background="#FAFAFA" BorderBrush="#E5E5E5" BorderThickness="1" CornerRadius="6" Padding="12">
                                    <StackPanel Spacing="6">
                                        <TextBlock x:Name="CsolStructureIconSpecTitle" FontSize="13" FontWeight="SemiBold" Foreground="#1B1B1B" />
                                        <TextBlock x:Name="CsolStructureIconSpecBody" FontSize="11" Foreground="#424242" FontFamily="Consolas" TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="CsolStructureImportZipTitle" FontSize="13" FontWeight="SemiBold" Foreground="#1B1B1B" />
                                <TextBlock x:Name="CsolStructureImportZipBody" FontSize="12" Foreground="#616161" TextWrapping="WrapWholeWords" />
                                <TextBlock x:Name="CsolStructureCreatorTitle" FontSize="13" FontWeight="SemiBold" Foreground="#1B1B1B" />
                                <TextBlock x:Name="CsolStructureCreatorBody" FontSize="12" Foreground="#616161" TextWrapping="WrapWholeWords" />
                                <TextBlock x:Name="CsolStructureFileHint" FontSize="11" Foreground="#0067C0" TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
