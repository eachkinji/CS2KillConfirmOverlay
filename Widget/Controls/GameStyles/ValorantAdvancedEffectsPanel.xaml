<UserControl
    x:Class="KillConfirmGameBar.Controls.GameStyles.ValorantAdvancedEffectsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="10">
        <StackPanel Spacing="2">
            <TextBlock
                x:Name="TitleText"
                FontSize="16"
                FontWeight="Bold"
                Text="VAL Effects" />
            <TextBlock
                x:Name="HintText"
                FontSize="10"
                Text="VAL uses Valorant packs and animation files only. CS money reward logic is not shown here."
                TextWrapping="WrapWholeWords" />
        </StackPanel>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="StreakModeLabel"
                VerticalAlignment="Center"
                FontSize="10"
                FontWeight="SemiBold"
                Text="Kill streak" />
            <ComboBox
                x:Name="StreakModeSelector"
                Grid.Column="1"
                Height="28"
                Padding="7,0,12,0"
                FontSize="10"
                SelectionChanged="OnStreakModeSelectionChanged">
                <ComboBoxItem x:Name="StreakLifeItem" Tag="life">Until death</ComboBoxItem>
                <ComboBoxItem x:Name="StreakTimed5Item" Tag="timed_5">5-second window</ComboBoxItem>
                <ComboBoxItem x:Name="StreakTimed10Item" Tag="timed_10">10-second window</ComboBoxItem>
                <ComboBoxItem x:Name="StreakTimed15Item" Tag="timed_15">15-second window</ComboBoxItem>
            </ComboBox>
        </Grid>

        <ContentControl x:Name="StylePanelHost" />
    </StackPanel>
</UserControl>
