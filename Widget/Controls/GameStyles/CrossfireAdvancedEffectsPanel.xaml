<UserControl
    x:Class="KillConfirmGameBar.Controls.GameStyles.CrossfireAdvancedEffectsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="10">
        <StackPanel Spacing="2">
            <TextBlock
                x:Name="TitleText"
                FontSize="16"
                FontWeight="Bold"
                Text="CrossFire Effects" />
            <TextBlock
                x:Name="HintText"
                FontSize="10"
                Text="CrossFire kill FX, elite icons, weapon badges, and animation styles are isolated here."
                TextWrapping="WrapWholeWords" />
        </StackPanel>

        <Border
            Padding="10"
            BorderBrush="#D5D0C4"
            BorderThickness="1"
            CornerRadius="12">
            <Grid RowSpacing="8" ColumnSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="StreakModeLabel"
                    VerticalAlignment="Center"
                    FontSize="10"
                    FontWeight="SemiBold"
                    Text="Kill streak" />
                <ComboBox
                    x:Name="StreakModeSelector"
                    Grid.Column="1"
                    Height="28"
                    Padding="7,0,12,0"
                    FontSize="10"
                    SelectionChanged="OnStreakModeSelectionChanged">
                    <ComboBoxItem x:Name="StreakLifeItem" Tag="life">Until death</ComboBoxItem>
                    <ComboBoxItem x:Name="StreakTimed5Item" Tag="timed_5">5-second window</ComboBoxItem>
                    <ComboBoxItem x:Name="StreakTimed10Item" Tag="timed_10">10-second window</ComboBoxItem>
                    <ComboBoxItem x:Name="StreakTimed15Item" Tag="timed_15">15-second window</ComboBoxItem>
                </ComboBox>

                <TextBlock
                    x:Name="FirstKillAudioLabel"
                    Grid.Row="1"
                    VerticalAlignment="Center"
                    FontSize="10"
                    FontWeight="SemiBold"
                    Text="First-kill audio" />
                <ComboBox
                    x:Name="FirstKillAudioSelector"
                    Grid.Row="1"
                    Grid.Column="1"
                    Height="28"
                    Padding="7,0,12,0"
                    FontSize="10"
                    SelectionChanged="OnFirstKillAudioSelectionChanged">
                    <ComboBoxItem x:Name="FirstKillSpecialItem" Tag="special">Special audio</ComboBoxItem>
                    <ComboBoxItem x:Name="FirstKillOriginalItem" Tag="original">Original kill audio</ComboBoxItem>
                </ComboBox>

                <TextBlock
                    x:Name="LastKillAudioLabel"
                    Grid.Row="2"
                    VerticalAlignment="Center"
                    FontSize="10"
                    FontWeight="SemiBold"
                    Text="Last-kill audio" />
                <ComboBox
                    x:Name="LastKillAudioSelector"
                    Grid.Row="2"
                    Grid.Column="1"
                    Height="28"
                    Padding="7,0,12,0"
                    FontSize="10"
                    SelectionChanged="OnLastKillAudioSelectionChanged">
                    <ComboBoxItem x:Name="LastKillSpecialItem" Tag="special">Special audio</ComboBoxItem>
                    <ComboBoxItem x:Name="LastKillOriginalItem" Tag="original">Original kill audio</ComboBoxItem>
                </ComboBox>
            </Grid>
        </Border>

        <ContentControl x:Name="StylePanelHost" />
    </StackPanel>
</UserControl>
