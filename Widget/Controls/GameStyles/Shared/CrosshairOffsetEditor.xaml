<UserControl
    x:Class="KillConfirmGameBar.Controls.GameStyles.CrosshairOffsetEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="ms-appx:///Controls/Settings/PanelDesign.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel HorizontalAlignment="Stretch" Spacing="6">
        <Border x:Name="Divider" Height="1" />

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="TitleLabel"
                VerticalAlignment="Center"
                Text="准心中心微调" Style="{StaticResource PanelTitleTextStyle}" />
            <TextBlock
                x:Name="CurrentValueText"
                Grid.Column="1"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Text="X 0 · Y 0" Style="{StaticResource PanelCaptionTextStyle}" />
        </Grid>

        <Grid x:Name="ResponsiveSettingsGrid" ColumnSpacing="18" RowSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="ManualColumn" Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel x:Name="PresetPanel" Spacing="6">
                <TextBlock
                    x:Name="QuickPresetLabel"
                    Text="快速方案" Style="{StaticResource PanelCaptionTextStyle}" />
                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="DefaultPresetButton"
                        MinWidth="0"
                        HorizontalAlignment="Stretch"
                        Click="OnPresetClick"
                        Style="{StaticResource PanelButtonStyle}"
                        Tag="0|0" />
                    <Button
                        x:Name="Preset1Button"
                        Grid.Column="1"
                        MinWidth="0"
                        HorizontalAlignment="Stretch"
                        Click="OnPresetClick"
                        Style="{StaticResource PanelButtonStyle}"
                        Tag="0.25|0.25" />
                    <Button
                        x:Name="Preset2Button"
                        Grid.Column="2"
                        MinWidth="0"
                        HorizontalAlignment="Stretch"
                        Click="OnPresetClick"
                        Style="{StaticResource PanelButtonStyle}"
                        Tag="0.25|0.5" />
                    <Button
                        x:Name="Preset3Button"
                        Grid.Column="3"
                        MinWidth="0"
                        HorizontalAlignment="Stretch"
                        Click="OnPresetClick"
                        Style="{StaticResource PanelButtonStyle}"
                        Tag="0.5|0.25" />
                    <Button
                        x:Name="Preset4Button"
                        Grid.Column="4"
                        MinWidth="0"
                        HorizontalAlignment="Stretch"
                        Click="OnPresetClick"
                        Style="{StaticResource PanelButtonStyle}"
                        Tag="0.5|0.5" />
                </Grid>
            </StackPanel>

            <StackPanel x:Name="ManualPanel" Grid.Column="1" Spacing="6">
                <TextBlock
                    x:Name="ManualInputLabel"
                    Text="手动输入" Style="{StaticResource PanelCaptionTextStyle}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock
                            x:Name="OffsetXLabel"
                            Text="X 右移 (px)" Style="{StaticResource PanelCaptionTextStyle}" />
                        <TextBox
                            x:Name="OffsetXBox"
                            KeyDown="OnOffsetKeyDown"
                            MaxLength="8"
                            LostFocus="OnOffsetXLostFocus"
                            PlaceholderText="0"
                            Style="{StaticResource PanelTextBoxStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock
                            x:Name="OffsetYLabel"
                            Text="Y 下移 (px)" Style="{StaticResource PanelCaptionTextStyle}" />
                        <TextBox
                            x:Name="OffsetYBox"
                            KeyDown="OnOffsetKeyDown"
                            MaxLength="8"
                            LostFocus="OnOffsetYLostFocus"
                            PlaceholderText="0"
                            Style="{StaticResource PanelTextBoxStyle}" />
                    </StackPanel>
                </Grid>
                <TextBlock
                    x:Name="OffsetHint"
                    Text="正值向右/下，负值向左/上；可输入小数。"
                    TextWrapping="WrapWholeWords" Style="{StaticResource PanelCaptionTextStyle}" />
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
