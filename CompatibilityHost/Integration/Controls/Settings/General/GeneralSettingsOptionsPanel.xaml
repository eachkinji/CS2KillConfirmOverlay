<UserControl
    x:Class="KillConfirmGameBar.Features.CompatibilityDisplay.Controls.Settings.GeneralSettingsOptionsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:danmaku="using:KillConfirmGameBar.Danmaku"
    xmlns:settings="using:KillConfirmGameBar.Features.CompatibilityDisplay.Controls.Settings">

    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="ms-appx:///Controls/Settings/PanelDesign.xaml" />
        </ResourceDictionary.MergedDictionaries>

                    <Style x:Key="DetailsStripStyle" TargetType="Button" BasedOn="{StaticResource PanelButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{StaticResource PanelAccentSoftBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PanelAccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel x:Name="ExperienceRows" Spacing="8">
        <Border x:Name="LolMultikillDependencyCard" Style="{StaticResource PanelSectionCardStyle}" Visibility="Collapsed">
            <StackPanel Spacing="8">
            <Grid ColumnSpacing="16" MinHeight="46">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource PanelIconContainerStyle}"><FontIcon Glyph="&#xE8EF;" FontSize="16" FontFamily="Segoe MDL2 Assets"/></Border>
                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                    <TextBlock x:Name="LolMultikillDependencyLabelText" Style="{StaticResource PanelTitleTextStyle}" Text="连杀统计依赖官方 Multikill"/>
                    <TextBlock x:Name="LolMultikillDependencyHintText" Style="{StaticResource PanelCaptionTextStyle}"/>
                </StackPanel>
                <ToggleSwitch x:Name="LolMultikillDependencyToggle" Grid.Column="2" MinWidth="0" VerticalAlignment="Center" OffContent="关" OnContent="开" Toggled="OnLolMultikillDependencyToggled"/>
            </Grid>
            </StackPanel>
        </Border>
        <Border x:Name="LolMinionKillCard" Style="{StaticResource PanelSectionCardStyle}" Visibility="Collapsed">
            <StackPanel Spacing="8">
            <Grid ColumnSpacing="16" MinHeight="46">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource PanelIconContainerStyle}"><FontIcon Glyph="&#xE7FC;" FontSize="16" FontFamily="Segoe MDL2 Assets"/></Border>
                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                    <TextBlock x:Name="LolMinionKillLabelText" Style="{StaticResource PanelTitleTextStyle}" Text="补刀 / 小兵击杀解析"/>
                    <TextBlock x:Name="LolMinionKillHintText" Style="{StaticResource PanelCaptionTextStyle}"/>
                </StackPanel>
                <ToggleSwitch x:Name="LolMinionKillToggle" Grid.Column="2" MinWidth="0" VerticalAlignment="Center" OffContent="关" OnContent="开" Toggled="OnLolMinionKillToggled"/>
            </Grid>
            </StackPanel>
        </Border>
        <Border x:Name="SpectatedKillEffectsCard" Style="{StaticResource PanelSectionCardStyle}">
            <StackPanel Spacing="8">
            <Grid ColumnSpacing="16" MinHeight="46">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource PanelIconContainerStyle}"><FontIcon Glyph="&#xE7B3;" FontSize="16" FontFamily="Segoe MDL2 Assets"/></Border>
                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                    <TextBlock x:Name="SpectatedKillEffectsLabelText" Style="{StaticResource PanelTitleTextStyle}"/>
                    <TextBlock x:Name="SpectatedKillEffectsHintText" Style="{StaticResource PanelCaptionTextStyle}"/>
                </StackPanel>
                <ToggleSwitch x:Name="SpectatedKillEffectsToggle" Grid.Column="2" MinWidth="0" VerticalAlignment="Center" OffContent="关" OnContent="开" Toggled="OnSpectatedKillEffectsToggled"/>
            </Grid>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource PanelSectionCardStyle}">
            <StackPanel Spacing="8">
            <Grid ColumnSpacing="16" MinHeight="46">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource PanelIconContainerStyle}"><FontIcon Glyph="&#xE8BD;" FontSize="16" FontFamily="Segoe MDL2 Assets"/></Border>
                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                    <TextBlock x:Name="Danmaku6657LabelText" Style="{StaticResource PanelTitleTextStyle}"/>
                    <TextBlock x:Name="Danmaku6657HintText" Style="{StaticResource PanelCaptionTextStyle}"/>
                </StackPanel>
                <ToggleSwitch x:Name="Danmaku6657Toggle" Grid.Column="2" MinWidth="0" VerticalAlignment="Center" OffContent="关" OnContent="开" Toggled="OnDanmaku6657Toggled"/>
            </Grid>
            <Button x:Name="DanmakuDetailsButton" Style="{StaticResource DetailsStripStyle}" Click="OnDetailsClick" Tag="Danmaku">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="DanmakuDetailsText" Text="展开详细设置" VerticalAlignment="Center" Style="{StaticResource PanelCaptionTextStyle}"/>
                    <FontIcon x:Name="DanmakuDetailsChevron" Grid.Column="1" FontFamily="Segoe MDL2 Assets" Glyph="&#xE70D;" FontSize="10" VerticalAlignment="Center"/>
                </Grid>
            </Button>
            <StackPanel x:Name="DanmakuDetailsContent" Spacing="12" Margin="0,4,0,2" Visibility="Collapsed">
                <danmaku:DanmakuOptionsPanel x:Name="DanmakuSettingsOptions"/>
                <Button x:Name="Danmaku6657TestButton" Click="OnDanmaku6657TestClick" HorizontalAlignment="Left" Style="{StaticResource PanelButtonStyle}"/>
            </StackPanel>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource PanelSectionCardStyle}">
            <StackPanel Spacing="8">
            <Grid ColumnSpacing="16" MinHeight="46">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource PanelIconContainerStyle}"><FontIcon Glyph="&#xE767;" FontSize="16" FontFamily="Segoe MDL2 Assets"/></Border>
                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                    <TextBlock x:Name="InterruptPreviousKillAudioLabelText" Style="{StaticResource PanelTitleTextStyle}"/>
                    <TextBlock x:Name="InterruptPreviousKillAudioHintText" Style="{StaticResource PanelCaptionTextStyle}"/>
                </StackPanel>
                <ToggleSwitch x:Name="InterruptPreviousKillAudioToggle" Grid.Column="2" MinWidth="0" VerticalAlignment="Center" OffContent="关" OnContent="开" Toggled="OnInterruptPreviousKillAudioToggled"/>
            </Grid>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource PanelSectionCardStyle}">
            <StackPanel Spacing="8">
            <Grid ColumnSpacing="16" MinHeight="46">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource PanelIconContainerStyle}"><FontIcon Glyph="&#xE720;" FontSize="16" FontFamily="Segoe MDL2 Assets"/></Border>
                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                    <TextBlock x:Name="CharacterVoiceInterruptLabelText" Style="{StaticResource PanelTitleTextStyle}"/>
                    <TextBlock x:Name="CharacterVoiceInterruptHintText" Style="{StaticResource PanelCaptionTextStyle}"/>
                </StackPanel>
                <ToggleSwitch x:Name="CharacterVoiceInterruptToggle" Grid.Column="2" MinWidth="0" VerticalAlignment="Center" OffContent="关" OnContent="开" Toggled="OnAudioBehaviorToggled"/>
            </Grid>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource PanelSectionCardStyle}">
            <StackPanel Spacing="8">
            <Grid ColumnSpacing="16" MinHeight="46">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource PanelIconContainerStyle}"><FontIcon Glyph="&#xE71B;" FontSize="16" FontFamily="Segoe MDL2 Assets"/></Border>
                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                    <TextBlock x:Name="LinkIconSoundLabelText" Style="{StaticResource PanelTitleTextStyle}"/>
                    <TextBlock x:Name="LinkIconSoundHintText" Style="{StaticResource PanelCaptionTextStyle}"/>
                </StackPanel>
                <ToggleSwitch x:Name="LinkIconSoundToggle" Grid.Column="2" MinWidth="0" VerticalAlignment="Center" OffContent="关" OnContent="开" Toggled="OnAudioBehaviorToggled"/>
            </Grid>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource PanelSectionCardStyle}">
            <StackPanel Spacing="8">
            <Grid ColumnSpacing="16" MinHeight="46">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource PanelIconContainerStyle}"><FontIcon Glyph="&#xE995;" FontSize="16" FontFamily="Segoe MDL2 Assets"/></Border>
                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                    <TextBlock x:Name="StreakGainLabelText" Style="{StaticResource PanelTitleTextStyle}"/>
                    <TextBlock x:Name="StreakGainHintText" Style="{StaticResource PanelCaptionTextStyle}"/>
                </StackPanel>
                <ToggleSwitch x:Name="StreakGainToggle" Grid.Column="2" MinWidth="0" VerticalAlignment="Center" OffContent="关" OnContent="开" Toggled="OnStreakGainToggled"/>
            </Grid>
            <Button x:Name="StreakGainDetailsButton" Style="{StaticResource DetailsStripStyle}" Click="OnDetailsClick" Tag="StreakGain">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="StreakGainDetailsText" Text="展开详细设置" VerticalAlignment="Center" Style="{StaticResource PanelCaptionTextStyle}"/>
                    <FontIcon x:Name="StreakGainDetailsChevron" Grid.Column="1" FontFamily="Segoe MDL2 Assets" Glyph="&#xE70D;" FontSize="10" VerticalAlignment="Center"/>
                </Grid>
            </Button>
            <Grid x:Name="StreakGainDetailsContent" Visibility="Collapsed" ColumnSpacing="24" Margin="12,8,12,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Spacing="6">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StreakGainStepLabelText"/><TextBlock x:Name="StreakGainStepValueText" Grid.Column="1"/></Grid>
                    <Slider x:Name="StreakGainStepSlider" Minimum="0" Maximum="100" StepFrequency="1" ValueChanged="OnStreakGainValueChanged"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="6">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StreakGainMaximumLabelText"/><TextBlock x:Name="StreakGainMaximumValueText" Grid.Column="1"/></Grid>
                    <Slider x:Name="StreakGainMaximumSlider" Minimum="100" Maximum="400" StepFrequency="5" ValueChanged="OnStreakGainValueChanged"/>
                </StackPanel>
            </Grid>
            </StackPanel>
        </Border>
        <settings:BombAudioOptionsPanel x:Name="BombAudioPanel"/>
    </StackPanel>
</UserControl>
