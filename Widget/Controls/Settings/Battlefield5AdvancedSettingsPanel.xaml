<UserControl
    x:Class="KillConfirmGameBar.Controls.Settings.Battlefield5AdvancedSettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        x:Name="Card"
        Padding="22"
        Background="#FAFAF7"
        BorderBrush="#7EC8D7"
        BorderThickness="1"
        CornerRadius="24">
        <StackPanel Spacing="10">
            <TextBlock
                x:Name="TitleText"
                FontSize="20"
                FontWeight="Bold"
                Text="Battlefield 5 advanced settings" />
            <TextBlock
                x:Name="BodyText"
                FontSize="13"
                LineHeight="18"
                Text="BF5 uses the Battlefield 5 resource folder, BF5 icon queue/text files, and BF1/BF5-only money reward modes. CF and VAL settings stay out of this module."
                TextWrapping="WrapWholeWords" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border x:Name="AssetTag" Padding="8,4" BorderThickness="1" CornerRadius="12">
                    <TextBlock x:Name="AssetTagText" FontSize="11" FontWeight="SemiBold" Text="battlefield5 assets" />
                </Border>
                <Border x:Name="MoneyTag" Padding="8,4" BorderThickness="1" CornerRadius="12">
                    <TextBlock x:Name="MoneyTagText" FontSize="11" FontWeight="SemiBold" Text="Money mode" />
                </Border>
                <Border x:Name="ImportLockTag" Padding="8,4" BorderThickness="1" CornerRadius="12">
                    <TextBlock x:Name="ImportLockTagText" FontSize="11" FontWeight="SemiBold" Text="No file import" />
                </Border>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
