<UserControl
    x:Class="KillConfirmGameBar.Controls.Settings.RuntimeMaintenancePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        x:Name="Card"
        Padding="12"
        Background="#FAFAF7"
        BorderBrush="#E2DDD3"
        BorderThickness="1"
        CornerRadius="12">
        <StackPanel Spacing="10">
            <TextBlock
                x:Name="TitleText"
                FontSize="15"
                FontWeight="SemiBold"
                Text="Plugin runtime" />
            <TextBlock
                x:Name="DescriptionText"
                Opacity="0.72"
                Text="Choose an audio output device or restore all plugin data."
                TextWrapping="WrapWholeWords" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CompactChoiceCardStyle}">
                    <StackPanel Spacing="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource CompactCircleIconStyle}">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="12"
                                    Foreground="White"
                                    Glyph="&#xE95D;" />
                            </Border>
                            <TextBlock
                                x:Name="AudioDeviceLabel"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Style="{StaticResource CompactChoiceLabelStyle}"
                                Text="Audio output" />
                        </Grid>
                        <ComboBox
                            x:Name="AudioDeviceSelector"
                            Style="{StaticResource CompactSettingsComboBoxStyle}"
                            SelectionChanged="OnAudioDeviceSelectionChanged" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CompactChoiceCardStyle}">
                    <StackPanel Spacing="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource CompactCircleIconStyle}">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="12"
                                    Foreground="White"
                                    Glyph="&#xE943;" />
                            </Border>
                            <TextBlock
                                x:Name="DeveloperModeLabel"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Style="{StaticResource CompactChoiceLabelStyle}"
                                Text="Developer mode" />
                        </Grid>
                        <ToggleSwitch
                            x:Name="DeveloperModeToggle"
                            HorizontalAlignment="Left"
                            MinWidth="0"
                            OffContent="Off"
                            OnContent="On"
                            Toggled="OnDeveloperModeToggled" />
                        <TextBlock
                            x:Name="DeveloperModeHint"
                            FontSize="10"
                            Text="Enable all diagnostic logs"
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </Border>
            </Grid>
            <TextBlock
                x:Name="StatusText"
                FontSize="11"
                Opacity="0.72"
                TextWrapping="WrapWholeWords" />
            <Button
                x:Name="ResetPluginButton"
                HorizontalAlignment="Stretch"
                Background="#FFF1F0"
                BorderBrush="#F2A7A0"
                Foreground="#A4262C"
                Click="OnResetPluginClick"
                Content="Reset all plugin data" />
        </StackPanel>
    </Border>
</UserControl>
