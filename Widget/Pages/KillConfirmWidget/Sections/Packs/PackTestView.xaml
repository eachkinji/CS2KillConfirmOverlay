                <ComboBoxItem Tag="160">160%</ComboBoxItem>
                <ComboBoxItem Tag="170">170%</ComboBoxItem>
                <ComboBoxItem Tag="180">180%</ComboBoxItem>
                <ComboBoxItem Tag="190">190%</ComboBoxItem>
                <ComboBoxItem Tag="200">200%</ComboBoxItem>
            </ComboBox>

            <PathIcon
                x:Name="TestPresetIcon" x:FieldModifier="public"
                Grid.Column="2"
                Style="{StaticResource FluentTinyPathIconStyle}"
                Data="M6.25 5C5.00736 5 4 6.00736 4 7.25V16.75C4 17.9926 5.00736 19 6.25 19H17.75C18.9926 19 20 17.9926 20 16.75V7.25C20 6.00736 18.9926 5 17.75 5H6.25ZM8 9.25C8 8.83579 8.33579 8.5 8.75 8.5H15.25C15.6642 8.5 16 8.83579 16 9.25C16 9.66421 15.6642 10 15.25 10H8.75C8.33579 10 8 9.66421 8 9.25ZM8.75 12C8.33579 12 8 12.3358 8 12.75C8 13.1642 8.33579 13.5 8.75 13.5H12.25C12.6642 13.5 13 13.1642 13 12.75C13 12.3358 12.6642 12 12.25 12H8.75Z"
