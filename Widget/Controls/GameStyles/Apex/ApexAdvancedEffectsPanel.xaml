<UserControl
    x:Class="KillConfirmGameBar.Controls.GameStyles.ApexAdvancedEffectsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KillConfirmGameBar.Controls.GameStyles">

    <StackPanel Spacing="8">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock x:Name="TitleText" FontSize="13" FontWeight="Bold" Text="Apex Effects" />
            </StackPanel>
            <Button
                x:Name="ResetButton"
                Grid.Column="1"
                MinWidth="88"
                Height="34"
                Padding="14,0"
                VerticalAlignment="Top"
                Click="OnResetButtonClick">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="12" Glyph="&#xE777;" />
                    <TextBlock x:Name="ResetButtonText" Text="Reset" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CompactChoiceCardStyle}">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Style="{StaticResource CompactCircleIconStyle}">
                            <FontIcon FontSize="13" Foreground="White" Glyph="&#xE8C7;" />
                        </Border>
                        <TextBlock x:Name="MoneyRewardModeLabel" Style="{StaticResource CompactChoiceLabelStyle}" VerticalAlignment="Center" Text="Money" />
                    </StackPanel>
                    <ComboBox
                        x:Name="MoneyRewardModeSelector"
                        SelectedIndex="0"
                        Style="{StaticResource CompactSettingsComboBoxStyle}"
                        SelectionChanged="OnMoneyRewardModeSelectionChanged">
                        <ComboBoxItem x:Name="MoneyRewardDeltaItem" Tag="delta">Actual money change (recommended)</ComboBoxItem>
                        <ComboBoxItem x:Name="MoneyRewardRulesItem" Tag="rules">Kill reward rules</ComboBoxItem>
                    </ComboBox>
                </StackPanel>
            </Border>
            <local:StreakWindowEditor
                x:Name="StreakEditor"
                Grid.Column="1"
                SettingsChanged="OnStreakModeSelectionChanged" />
        </Grid>

        <Border x:Name="VisualEffectsCard" Padding="10" BorderThickness="1" CornerRadius="10">
            <StackPanel Spacing="7">
                <TextBlock x:Name="VisualEffectsTitle" FontSize="11" FontWeight="SemiBold" />
                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="CrosshairEffectLabel" FontSize="10" TextWrapping="WrapWholeWords" />
                        <ToggleSwitch x:Name="CrosshairEffectToggle" Toggled="OnVisualEffectToggled" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock x:Name="LowerEffectLabel" FontSize="10" TextWrapping="WrapWholeWords" />
                        <ToggleSwitch x:Name="LowerEffectToggle" Toggled="OnVisualEffectToggled" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
