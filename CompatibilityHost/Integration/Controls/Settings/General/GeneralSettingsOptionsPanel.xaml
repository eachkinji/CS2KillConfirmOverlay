<UserControl
    x:Class="KillConfirmGameBar.Features.CompatibilityDisplay.Controls.Settings.GeneralSettingsOptionsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:danmaku="using:KillConfirmGameBar.Danmaku"
    xmlns:settings="using:KillConfirmGameBar.Features.CompatibilityDisplay.Controls.Settings">

    <UserControl.Resources>
        <!-- Fluent 2 Palette -->
        <SolidColorBrush x:Key="FluentCardBackground" Color="#FFFFFF" />
        <SolidColorBrush x:Key="FluentCardSubBackground" Color="#FAFAFC" />
        <SolidColorBrush x:Key="FluentCardBorder" Color="#E5E5EA" />
        <SolidColorBrush x:Key="FluentDivider" Color="#F0F0F5" />
        <SolidColorBrush x:Key="FluentTitleText" Color="#1C1C1E" />
        <SolidColorBrush x:Key="FluentBodyText" Color="#3A3A3C" />
        <SolidColorBrush x:Key="FluentMutedText" Color="#6E6E73" />
        <SolidColorBrush x:Key="FluentAccent" Color="#007AFF" />
        <SolidColorBrush x:Key="FluentAccentLight" Color="#EAF3FF" />

        <!-- Fluent 2 Setting Card Style -->
        <Style x:Key="FluentCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Background" Value="{StaticResource FluentCardBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource FluentCardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <!-- Fluent 2 Icon Box -->
        <Style x:Key="FluentIconStyle" TargetType="Border">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="#F2F2F7" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Fluent 2 Typography -->
        <Style x:Key="FluentCardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource FluentTitleText}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="FluentCardHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource FluentMutedText}" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
            <Setter Property="LineHeight" Value="15" />
        </Style>

        <!-- Fluent 2 Secondary Action Button -->
        <Style x:Key="FluentActionBtnStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="MinWidth" Value="60" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E0E0E5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Foreground" Value="{StaticResource FluentTitleText}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <!-- Backward Compatibility Aliases -->
        <Style x:Key="CompactChoiceCardStyle" TargetType="Border" BasedOn="{StaticResource FluentCardStyle}" />
        <Style x:Key="CompactCircleIconStyle" TargetType="Border" BasedOn="{StaticResource FluentIconStyle}" />
        <Style x:Key="CompactChoiceLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource FluentCardTitle}" />
        <Style x:Key="DetailsStripStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="#F2F6FC" />
            <Setter Property="Foreground" Value="#007AFF" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </UserControl.Resources>

    <StackPanel x:Name="ExperienceRows" Spacing="8">
        <Border Style="{StaticResource FluentCardStyle}">
            <StackPanel Spacing="8">
            <Grid ColumnSpacing="16" MinHeight="46">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource FluentIconStyle}"><FontIcon Glyph="&#xE7B3;" FontSize="16" FontFamily="Segoe MDL2 Assets"/></Border>
                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                    <TextBlock x:Name="SpectatedKillEffectsLabelText" Style="{StaticResource FluentCardTitle}"/>
                    <TextBlock x:Name="SpectatedKillEffectsHintText" Style="{StaticResource FluentCardHint}"/>
                </StackPanel>
                <ToggleSwitch x:Name="SpectatedKillEffectsToggle" Grid.Column="2" MinWidth="0" VerticalAlignment="Center" OffContent="关" OnContent="开" Toggled="OnSpectatedKillEffectsToggled"/>
            </Grid>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource FluentCardStyle}">
            <StackPanel Spacing="8">
            <Grid ColumnSpacing="16" MinHeight="46">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource FluentIconStyle}"><FontIcon Glyph="&#xE8BD;" FontSize="16" FontFamily="Segoe MDL2 Assets"/></Border>
                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                    <TextBlock x:Name="Danmaku6657LabelText" Style="{StaticResource FluentCardTitle}"/>
                    <TextBlock x:Name="Danmaku6657HintText" Style="{StaticResource FluentCardHint}"/>
                </StackPanel>
                <ToggleSwitch x:Name="Danmaku6657Toggle" Grid.Column="2" MinWidth="0" VerticalAlignment="Center" OffContent="关" OnContent="开" Toggled="OnDanmaku6657Toggled"/>
            </Grid>
            <Button x:Name="DanmakuDetailsButton" Style="{StaticResource DetailsStripStyle}" Click="OnDetailsClick" Tag="Danmaku">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="DanmakuDetailsText" Text="展开详细设置" FontSize="11" VerticalAlignment="Center"/>
                    <FontIcon x:Name="DanmakuDetailsChevron" Grid.Column="1" FontFamily="Segoe MDL2 Assets" Glyph="&#xE70D;" FontSize="10" VerticalAlignment="Center"/>
                </Grid>
            </Button>
            <StackPanel x:Name="DanmakuDetailsContent" Spacing="12" Margin="0,4,0,2" Visibility="Collapsed">
                <danmaku:DanmakuOptionsPanel x:Name="DanmakuSettingsOptions"/>
                <Button x:Name="Danmaku6657TestButton" Click="OnDanmaku6657TestClick" HorizontalAlignment="Left" Style="{StaticResource FluentActionBtnStyle}"/>
            </StackPanel>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource FluentCardStyle}">
            <StackPanel Spacing="8">
            <Grid ColumnSpacing="16" MinHeight="46">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource FluentIconStyle}"><FontIcon Glyph="&#xE8BB;" FontSize="16" FontFamily="Segoe MDL2 Assets"/></Border>
                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                    <TextBlock x:Name="AutoCloseOnGameExitLabelText" Style="{StaticResource FluentCardTitle}"/>
                    <TextBlock x:Name="AutoCloseOnGameExitHintText" Style="{StaticResource FluentCardHint}"/>
                </StackPanel>
                <ToggleSwitch x:Name="AutoCloseOnGameExitToggle" Grid.Column="2" MinWidth="0" VerticalAlignment="Center" OffContent="关" OnContent="开" Toggled="OnAutoCloseOnGameExitToggled"/>
            </Grid>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource FluentCardStyle}">
            <StackPanel Spacing="8">
            <Grid ColumnSpacing="16" MinHeight="46">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource FluentIconStyle}"><FontIcon Glyph="&#xE767;" FontSize="16" FontFamily="Segoe MDL2 Assets"/></Border>
                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                    <TextBlock x:Name="InterruptPreviousKillAudioLabelText" Style="{StaticResource FluentCardTitle}"/>
                    <TextBlock x:Name="InterruptPreviousKillAudioHintText" Style="{StaticResource FluentCardHint}"/>
                </StackPanel>
                <ToggleSwitch x:Name="InterruptPreviousKillAudioToggle" Grid.Column="2" MinWidth="0" VerticalAlignment="Center" OffContent="关" OnContent="开" Toggled="OnInterruptPreviousKillAudioToggled"/>
            </Grid>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource FluentCardStyle}">
            <StackPanel Spacing="8">
            <Grid ColumnSpacing="16" MinHeight="46">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource FluentIconStyle}"><FontIcon Glyph="&#xE995;" FontSize="16" FontFamily="Segoe MDL2 Assets"/></Border>
                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                    <TextBlock x:Name="StreakGainLabelText" Style="{StaticResource FluentCardTitle}"/>
                    <TextBlock x:Name="StreakGainHintText" Style="{StaticResource FluentCardHint}"/>
                </StackPanel>
                <ToggleSwitch x:Name="StreakGainToggle" Grid.Column="2" MinWidth="0" VerticalAlignment="Center" OffContent="关" OnContent="开" Toggled="OnStreakGainToggled"/>
            </Grid>
            <Button x:Name="StreakGainDetailsButton" Style="{StaticResource DetailsStripStyle}" Click="OnDetailsClick" Tag="StreakGain">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="StreakGainDetailsText" Text="展开详细设置" FontSize="11" VerticalAlignment="Center"/>
                    <FontIcon x:Name="StreakGainDetailsChevron" Grid.Column="1" FontFamily="Segoe MDL2 Assets" Glyph="&#xE70D;" FontSize="10" VerticalAlignment="Center"/>
                </Grid>
            </Button>
            <Grid x:Name="StreakGainDetailsContent" Visibility="Collapsed" ColumnSpacing="24" Margin="12,8,12,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Spacing="6">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StreakGainStepLabelText"/><TextBlock x:Name="StreakGainStepValueText" Grid.Column="1"/></Grid>
                    <Slider x:Name="StreakGainStepSlider" Minimum="0" Maximum="100" StepFrequency="1" ValueChanged="OnStreakGainValueChanged"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="6">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StreakGainMaximumLabelText"/><TextBlock x:Name="StreakGainMaximumValueText" Grid.Column="1"/></Grid>
                    <Slider x:Name="StreakGainMaximumSlider" Minimum="100" Maximum="400" StepFrequency="5" ValueChanged="OnStreakGainValueChanged"/>
                </StackPanel>
            </Grid>
            </StackPanel>
        </Border>
        <settings:BombAudioOptionsPanel x:Name="BombAudioPanel"/>
    </StackPanel>
</UserControl>
