<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.18362.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>KillConfirmGameBar</RootNamespace>
    <AssemblyName>KillConfirmControlPanel</AssemblyName>
    <Product>Kill Confirm Overlay 控制面板</Product>
    <Title>Kill Confirm Overlay 控制面板</Title>
    <Version>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\Package\Package.appxmanifest')), 'Version=&quot;([0-9]+\.[0-9]+\.[0-9]+\.[0-9]+)&quot;').Groups[1].Value)</Version>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**;Generated/**</DefaultItemExcludes>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <DefineConstants>$(DefineConstants);DESKTOP_CONTROL_PANEL</DefineConstants>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../Installer/Assets/KillConfirmOverlay.ico</ApplicationIcon>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="1.8.260204000" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <Compile Remove="Generated/**/*.cs" />
    <Compile Include="../Common/*.cs" Link="Runtime/%(Filename)%(Extension)" />
    <ApplicationDefinition Include="App.xaml" />
    <Content Include="../Installer/Assets/KillConfirmOverlay.ico" Link="Assets/KillConfirmOverlay.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- ms-appx:///Assets/... resolves next to the exe for unpackaged runs. -->
    <Content Include="../Widget/Assets/**/*" Exclude="../Widget/Assets/GameStyles/sanguosha/killconfirm/lz4/**/*" Link="Assets/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="AdaptOriginalControlPanel" BeforeTargets="PrepareForBuild">
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildProjectDirectory)/Build-OriginalPanel.ps1&quot;" />
    <ItemGroup>
      <Compile Include="Generated/**/*.cs" />
      <Page Include="Generated/**/*.xaml">
        <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
      </Page>
    </ItemGroup>
  </Target>
  <!-- Adapted Page items are added during the build, after the SDK gathers
       publish content. Carry their compiled XAML and resource index into a
       direct dotnet publish too, not just Build-DesktopPayload.ps1. -->
  <Target Name="PublishOriginalPanelXaml" AfterTargets="Publish">
    <ItemGroup>
      <_OriginalPanelXaml Include="$(TargetDir)**/*.xbf" />
    </ItemGroup>
    <Copy SourceFiles="@(_OriginalPanelXaml)"
          DestinationFiles="@(_OriginalPanelXaml->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).pri"
          DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
