<Window x:Class="KillConfirmCompatibility.Desktop.UI.DesktopControlPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Kill Confirm Overlay" Width="1220" Height="900" MinWidth="900" MinHeight="650" Background="#F6F7F9" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="15,9"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Foreground" Value="#202020"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D8DCE2"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#EBF3FC"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.7"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#0067C0"/><Setter Property="Foreground" Value="White"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#0067C0"/></Trigger></Style.Triggers></Style>
  <Style TargetType="RadioButton"><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="ModeCard" CornerRadius="6" BorderThickness="2" BorderBrush="#E2E5EA" Background="White" Padding="16,14"><ContentPresenter VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="ModeCard" Property="BorderBrush" Value="#0067C0"/><Setter TargetName="ModeCard" Property="Background" Value="#EDF5FF"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ModeCard" Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E2E5EA"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="20"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Title" TargetType="TextBlock"><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
  <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="32"/><Setter Property="Margin" Value="0,6,0,12"/></Style>
  <Style TargetType="TabControl"><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/></Style>
  <Style TargetType="TabItem"><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,0,7,12"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabFrame" Background="White" BorderBrush="#D8DCE2" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabFrame" Property="Background" Value="#EDF5FF"/><Setter TargetName="TabFrame" Property="BorderBrush" Value="#0067C0"/><Setter Property="Foreground" Value="#0067C0"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="TabFrame" Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,7,0,7"/></Style>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#EEF0F4" BorderBrush="#E2E5EA" BorderThickness="0,0,1,0" Padding="14,22">
   <DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="Kill Confirm" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="桌面控制面板" Foreground="#657080" Margin="0,5,0,20"/></StackPanel><ListBox x:Name="Navigation" SelectionChanged="OnNavigationChanged" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"/></DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="26,22">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock x:Name="PageTitle" Text="主页" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,18"/>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
     <StackPanel x:Name="HomeSection">
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="⌂  开始使用" Style="{StaticResource Title}"/><TextBlock Text="选择显示方式。兼容显示直接运行；Game Bar 小组件可选安装。" Foreground="#626B77" Margin="0,0,0,16"/>
       <UniformGrid Columns="2"><RadioButton x:Name="GameBarMode" GroupName="Mode" Checked="OnModeChanged" Padding="14" FontSize="16" Content="🎮  Game Bar 模式"/><RadioButton x:Name="CompatibilityMode" GroupName="Mode" Checked="OnModeChanged" Padding="14" FontSize="16" Content="▣  兼容显示模式"/></UniformGrid>
       <TextBlock x:Name="ModeDescription" Margin="0,12,0,0" Foreground="#626B77"/>
       <StackPanel Orientation="Horizontal" Margin="0,14,0,0"><Button x:Name="RetryGameBarButton" Content="补装 / 检查 Game Bar" Click="OnRetryGameBar"/><Button Content="刷新检测" Click="OnRefreshAvailability"/></StackPanel>
      </StackPanel></Border>
      <Border x:Name="GameBarStatusCard" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Game Bar 使用状态" Style="{StaticResource Title}"/><TextBlock x:Name="GameBarStatusText" Margin="0,0,0,12"/><Button Content="🎮  打开 Game Bar" Click="OnOpenGameBar" HorizontalAlignment="Left" Style="{StaticResource Primary}"/></StackPanel></Border>
     </StackPanel>
     <StackPanel x:Name="MaterialsSection"><TabControl><TabItem Header="▧ 素材与测试">
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="▧  素材与测试" Style="{StaticResource Title}"/><TextBlock x:Name="CurrentGameText" Foreground="#626B77" Margin="0,0,0,10"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="图标与动画素材"/><ComboBox x:Name="IconPacks" DisplayMemberPath="DisplayName" SelectedValuePath="Key" SelectionChanged="OnPackChanged"/><StackPanel Orientation="Horizontal"><Button Content="导入 ZIP" Tag="icon" Click="OnImportZip"/><Button Content="导入文件夹" Tag="icon" Click="OnImportFolder"/></StackPanel></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="语音与音效素材"/><ComboBox x:Name="VoicePacks" DisplayMemberPath="DisplayName" SelectedValuePath="Key" SelectionChanged="OnPackChanged"/><StackPanel Orientation="Horizontal"><Button Content="导入 ZIP" Tag="voice" Click="OnImportZip"/><Button Content="导入文件夹" Tag="voice" Click="OnImportFolder"/></StackPanel></StackPanel>
       </Grid>
       <StackPanel Orientation="Horizontal" Margin="0,18,0,0"><ComboBox x:Name="TestPreset" Width="140" SelectedIndex="2"><ComboBoxItem Content="一杀" Tag="one"/><ComboBoxItem Content="二杀" Tag="two"/><ComboBoxItem Content="三杀" Tag="three"/><ComboBoxItem Content="爆头" Tag="one_hs"/><ComboBoxItem Content="刀杀" Tag="one_knife"/><ComboBoxItem Content="助攻" Tag="assist"/></ComboBox><Button Content="▶  播放测试" Click="OnPreview" Margin="12,0,8,12" Style="{StaticResource Primary}"/><CheckBox x:Name="TestAudio" Content="同时播放声音" VerticalAlignment="Center"/></StackPanel>
       <TextBlock x:Name="PreviewFeedback" Foreground="#0067C0"/>
      </StackPanel></Border>
      </TabItem><TabItem x:Name="ScreenLayoutTab" Header="▣ 屏幕与布局" ToolTip="兼容显示的屏幕与元素布局；Game Bar 的布局请在小组件中调整。"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="▣  屏幕与布局" Style="{StaticResource Title}"/><TextBlock Text="显示器、跟随窗口、切出隐藏和帧率共用；元素位置、大小和显隐按游戏独立保存。" Foreground="#626B77" Margin="0,0,0,10"/>
       <StackPanel Orientation="Horizontal"><Button x:Name="EditLayout" Content="✎  编辑屏幕" Click="OnEditLayout" Style="{StaticResource Primary}"/><Button Content="恢复当前游戏布局" Click="OnResetLayout"/></StackPanel>
       <TextBlock Text="Ctrl + Alt + L 编辑 / 保存 · Ctrl + Alt + O 显示 / 隐藏 · Enter 或 Esc 保存" Foreground="#626B77" Margin="0,12,0,10"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><CheckBox x:Name="FollowGame" Content="自动跟随游戏窗口" Click="OnScreenChanged"/><ComboBox x:Name="Screens" DisplayMemberPath="Label" SelectedValuePath="Key" SelectionChanged="OnScreenChanged"/></StackPanel><StackPanel Grid.Column="2"><CheckBox x:Name="HideInactive" Content="切出游戏时隐藏" Click="OnScreenChanged"/><ComboBox x:Name="FrameRate" SelectionChanged="OnScreenChanged"><ComboBoxItem Content="60 FPS"/><ComboBoxItem Content="30 FPS"/></ComboBox></StackPanel></Grid>
       <WrapPanel x:Name="ElementVisibility"/>
      </StackPanel></Border>
      </TabItem><TabItem Header="◉ 运行状态"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="运行状态" Style="{StaticResource Title}"/><TextBlock x:Name="RuntimeStatus" LineHeight="24"/><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button Content="重试连接" Click="OnReconnect"/><Button Content="安装 / 修复游戏配置" Click="OnRepairGsi"/><Button Content="打开日志" Click="OnOpenLogs"/></StackPanel></StackPanel></Border>
      </TabItem></TabControl><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="战斗与视效" Style="{StaticResource Title}"/><StackPanel x:Name="GameSettings"/></StackPanel></Border>
     </StackPanel>
     <StackPanel x:Name="AdvancedSection" Visibility="Collapsed"><TabControl><TabItem Header="⚙ 通用设置">
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="游戏体验与音频" Style="{StaticResource Title}"/><StackPanel x:Name="GeneralSettings"/></StackPanel></Border>
      </TabItem><TabItem Header="☷ 弹幕"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="游戏事件弹幕" Style="{StaticResource Title}"/><StackPanel x:Name="DanmakuSettings"/><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button Content="测试击杀弹幕" Tag="kill" Click="OnDanmakuTest"/><Button Content="测试死亡弹幕" Tag="death" Click="OnDanmakuTest"/><Button Content="测试下包弹幕" Tag="bomb_plant" Click="OnDanmakuTest"/></StackPanel></StackPanel></Border>
      </TabItem><TabItem Header="⇄ 服务连接"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="本地服务端口" Style="{StaticResource Title}"/><TextBlock Text="修改后请安装 / 修复游戏配置，让游戏发送到相同端口。" Foreground="#626B77"/><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><TextBox x:Name="PortInput" Width="140" Padding="8"/><Button Content="保存端口" Click="OnSavePort" Margin="12,0,0,0"/></StackPanel></StackPanel></Border>
      </TabItem><TabItem Header="ⓘ 关于"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="关于" Style="{StaticResource Title}"/><TextBlock x:Name="VersionText"/><TextBlock Text="桌面控制面板和兼容显示可独立运行。Game Bar 小组件为可选组件。" Margin="0,10,0,0"/></StackPanel></Border></TabItem></TabControl>
     </StackPanel>
    </StackPanel>
   </ScrollViewer>
   <TextBlock x:Name="ActionFeedback" Grid.Row="2" Foreground="#0067C0" Margin="0,12,0,0" MinHeight="22"/>
  </Grid>
 </Grid>
</Window>
