<UserControl
    x:Class="KillConfirmGameBar.Features.CompatibilityDisplay.Controls.Settings.BombAudioOptionsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="ms-appx:///Controls/Settings/PanelDesign.xaml" />
        </ResourceDictionary.MergedDictionaries>

                    <Style x:Key="DetailsStripStyle" TargetType="Button" BasedOn="{StaticResource PanelButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{StaticResource PanelAccentSoftBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PanelAccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

        <!-- 6. Bomb Audio Settings Card (Expander Structure) -->
        <Border Style="{StaticResource PanelSectionCardStyle}">
            <StackPanel Spacing="10">
                <!-- Master Toggle Header -->
                <Grid ColumnSpacing="16" MinHeight="46">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource PanelIconContainerStyle}">
                        <FontIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="14"
                            Foreground="{StaticResource PanelTextSecondaryBrush}"
                            Glyph="&#xE7E7;" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock
                            x:Name="BombAudioLabelText"
                            Style="{StaticResource PanelTitleTextStyle}"
                            Text="C4 炸弹倒计时与音效" />
                        <TextBlock
                            x:Name="BombAudioHintText"
                            Style="{StaticResource PanelCaptionTextStyle}"
                            Text="在 C4 下包后播报倒计时滴答声、爆炸与拆除提示音" />
                    </StackPanel>

                    <ToggleSwitch
                        x:Name="BombAudioToggle"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        MinWidth="0"
                        OffContent="关"
                        OnContent="开"
                        Toggled="OnBombAudioToggled" />
                </Grid>

            <Button x:Name="BombDetailsButton" Style="{StaticResource DetailsStripStyle}" Click="OnBombDetailsClick" Tag="Bomb">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="BombDetailsText" Text="展开详细设置" VerticalAlignment="Center" Style="{StaticResource PanelCaptionTextStyle}"/>
                    <FontIcon x:Name="BombDetailsChevron" Grid.Column="1" FontFamily="Segoe MDL2 Assets" Glyph="&#xE70D;" FontSize="10" VerticalAlignment="Center"/>
                </Grid>
            </Button>

                <!-- Detailed Parameters & Sound Importer -->
                <Border x:Name="BombDetailsContent" Visibility="Collapsed"
                    Background="{StaticResource PanelSectionBrush}"
                    BorderBrush="{StaticResource PanelDividerBrush}" Style="{StaticResource PanelSectionCardStyle}">
                    <StackPanel Spacing="12">
                        <!-- Volume & Speed Controls -->
                        <Grid ColumnSpacing="16" RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Volume Slider -->
                            <StackPanel Grid.ColumnSpan="2" Spacing="3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Name="BombAudioVolumeLabelText"
                                        Style="{StaticResource PanelTitleTextStyle}"
                                        Text="炸弹音效音量" />
                                    <TextBlock
                                        x:Name="BombAudioVolumeValueText"
                                        Grid.Column="1"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource PanelAccentBrush}"
                                        Text="50%" Style="{StaticResource PanelCaptionTextStyle}" />
                                </Grid>
                                <Slider
                                    x:Name="BombAudioVolumeSlider"
                                    Minimum="0"
                                    Maximum="100"
                                    StepFrequency="5"
                                    ValueChanged="OnBombAudioVolumeChanged" />
                            </StackPanel>

                            <!-- Initial Speed Slider -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Name="BombAudioInitialSpeedLabelText"
                                        Foreground="{StaticResource PanelTextPrimaryBrush}"
                                        Text="初始倒计时速率" Style="{StaticResource PanelCaptionTextStyle}" />
                                    <TextBlock
                                        x:Name="BombAudioInitialSpeedValueText"
                                        Grid.Column="1"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource PanelAccentBrush}"
                                        Text="0.50×" Style="{StaticResource PanelCaptionTextStyle}" />
                                </Grid>
                                <Slider
                                    x:Name="BombAudioInitialSpeedSlider"
                                    Minimum="25"
                                    Maximum="400"
                                    StepFrequency="5"
                                    ValueChanged="OnBombAudioSpeedChanged" />
                            </StackPanel>

                            <!-- Final Speed Slider -->
                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Name="BombAudioFinalSpeedLabelText"
                                        Foreground="{StaticResource PanelTextPrimaryBrush}"
                                        Text="临近爆炸速率" Style="{StaticResource PanelCaptionTextStyle}" />
                                    <TextBlock
                                        x:Name="BombAudioFinalSpeedValueText"
                                        Grid.Column="1"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource PanelAccentBrush}"
                                        Text="1.50×" Style="{StaticResource PanelCaptionTextStyle}" />
                                </Grid>
                                <Slider
                                    x:Name="BombAudioFinalSpeedSlider"
                                    Minimum="25"
                                    Maximum="400"
                                    StepFrequency="5"
                                    ValueChanged="OnBombAudioSpeedChanged" />
                            </StackPanel>
                        </Grid>

                        <!-- Hidden label for localization binding -->
                        <TextBlock x:Name="BombAudioSpeedLabelText" Visibility="Collapsed" />

                        <Rectangle Height="1" Fill="{StaticResource PanelDividerBrush}" />

                        <!-- Custom Sounds Rows -->
                        <StackPanel Spacing="8">
                            <TextBlock
                                x:Name="BombAudioCustomLabelText"
                                Style="{StaticResource PanelTitleTextStyle}"
                                Text="自定义炸弹音效文件" />

                            <Grid ColumnSpacing="8" RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Timer Sound -->
                                <StackPanel Grid.Row="0" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock x:Name="BombTimerAudioLabelText" FontWeight="SemiBold" Text="倒计时滴答声 (Timer)" Style="{StaticResource PanelCaptionTextStyle}" />
                                    <TextBlock x:Name="BombTimerAudioStatusText" Foreground="{StaticResource PanelTextMutedBrush}" Text="内置默认" Style="{StaticResource PanelCaptionTextStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                    <Button
                                        x:Name="BombTimerAudioPreviewButton"
                                        Style="{StaticResource PanelButtonStyle}"
                                        MinWidth="28"
                                        Click="OnBombAudioPreviewClick"
                                        Tag="timer">
                                        <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="11" Glyph="&#xE768;" />
                                    </Button>
                                    <Button
                                        x:Name="BombTimerAudioImportButton"
                                        Style="{StaticResource PanelButtonStyle}"
                                        Click="OnBombAudioImportClick"
                                        Tag="timer">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="11" Glyph="&#xE8B5;" />
                                            <TextBlock x:Name="BombTimerAudioImportButtonText" Text="导入" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        x:Name="BombTimerAudioClearButton"
                                        Style="{StaticResource PanelButtonStyle}"
                                        MinWidth="28"
                                        Click="OnBombAudioClearClick"
                                        Tag="timer"
                                        ToolTipService.ToolTip="恢复为内置默认"
                                        Visibility="Collapsed">
                                        <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="10" Glyph="&#xE894;" />
                                    </Button>
                                </StackPanel>

                                <!-- Exploded Sound -->
                                <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock x:Name="BombExplodedAudioLabelText" FontWeight="SemiBold" Text="爆炸提示音 (Explosion)" Style="{StaticResource PanelCaptionTextStyle}" />
                                    <TextBlock x:Name="BombExplodedAudioStatusText" Foreground="{StaticResource PanelTextMutedBrush}" Text="内置默认" Style="{StaticResource PanelCaptionTextStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                    <Button
                                        x:Name="BombExplodedAudioPreviewButton"
                                        Style="{StaticResource PanelButtonStyle}"
                                        MinWidth="28"
                                        Click="OnBombAudioPreviewClick"
                                        Tag="exploded">
                                        <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="11" Glyph="&#xE768;" />
                                    </Button>
                                    <Button
                                        x:Name="BombExplodedAudioImportButton"
                                        Style="{StaticResource PanelButtonStyle}"
                                        Click="OnBombAudioImportClick"
                                        Tag="exploded">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="11" Glyph="&#xE8B5;" />
                                            <TextBlock x:Name="BombExplodedAudioImportButtonText" Text="导入" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        x:Name="BombExplodedAudioClearButton"
                                        Style="{StaticResource PanelButtonStyle}"
                                        MinWidth="28"
                                        Click="OnBombAudioClearClick"
                                        Tag="exploded"
                                        ToolTipService.ToolTip="恢复为内置默认"
                                        Visibility="Collapsed">
                                        <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="10" Glyph="&#xE894;" />
                                    </Button>
                                </StackPanel>

                                <!-- Defused Sound -->
                                <StackPanel Grid.Row="2" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock x:Name="BombDefusedAudioLabelText" FontWeight="SemiBold" Text="拆除成功提示音 (Defuse)" Style="{StaticResource PanelCaptionTextStyle}" />
                                    <TextBlock x:Name="BombDefusedAudioStatusText" Foreground="{StaticResource PanelTextMutedBrush}" Text="内置默认" Style="{StaticResource PanelCaptionTextStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                    <Button
                                        x:Name="BombDefusedAudioPreviewButton"
                                        Style="{StaticResource PanelButtonStyle}"
                                        MinWidth="28"
                                        Click="OnBombAudioPreviewClick"
                                        Tag="defused">
                                        <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="11" Glyph="&#xE768;" />
                                    </Button>
                                    <Button
                                        x:Name="BombDefusedAudioImportButton"
                                        Style="{StaticResource PanelButtonStyle}"
                                        Click="OnBombAudioImportClick"
                                        Tag="defused">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="11" Glyph="&#xE8B5;" />
                                            <TextBlock x:Name="BombDefusedAudioImportButtonText" Text="导入" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        x:Name="BombDefusedAudioClearButton"
                                        Style="{StaticResource PanelButtonStyle}"
                                        MinWidth="28"
                                        Click="OnBombAudioClearClick"
                                        Tag="defused"
                                        ToolTipService.ToolTip="恢复为内置默认"
                                        Visibility="Collapsed">
                                        <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="10" Glyph="&#xE894;" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Button
                                x:Name="BombFullEffectPreviewButton"
                                Style="{StaticResource PanelButtonStyle}"
                                HorizontalAlignment="Right"
                                Click="OnBombFullEffectPreviewClick">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="11" Glyph="&#xE768;" />
                                    <TextBlock x:Name="BombFullEffectPreviewButtonText" Text="完整效果试听" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
</UserControl>
