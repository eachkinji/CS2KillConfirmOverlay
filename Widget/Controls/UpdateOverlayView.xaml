<UserControl
    x:Class="KillConfirmGameBar.Controls.UpdateOverlayView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:KillConfirmGameBar.Controls.Settings">
        <Grid
            x:Name="Root"
            x:FieldModifier="public"
            Background="#99000000">
            <Border
                x:Name="DialogCard"
                x:FieldModifier="public"
                Width="408"
                Padding="22"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#FFFAF7F0"
                BorderBrush="#E2DDD3"
                BorderThickness="1"
                CornerRadius="24">
                <Grid RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock
                                x:Name="UpdateDialogTitleText"
                                x:FieldModifier="public"
                                FontSize="24"
                                FontWeight="Bold"
                                Foreground="#1B1F31"
                                Text="鍙戠幇鏇存柊" />
                            <TextBlock
                                x:Name="UpdateDialogVersionText"
                                x:FieldModifier="public"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="#8A6A36"
                                Text="v..." />
                        </StackPanel>
                        <Button
                            x:Name="UpdateCloseButton"
                            x:FieldModifier="public"
                            Grid.Column="1"
                            Width="30"
                            Height="30"
                            MinWidth="30"
                            Padding="0"
                            Background="#FFFDFC"
                            BorderBrush="#D5D0C4"
                            BorderThickness="1"
                            Click="OnCloseUpdateOverlayClick"
                            CornerRadius="15"
                            FontSize="13"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Foreground="#1B1F31">
                            <FontIcon
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="12"
                                Glyph="&#xE711;"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="#1B1F31" />
                        </Button>
                    </Grid>

                    <TextBlock
                        x:Name="UpdateDialogBodyText"
                        x:FieldModifier="public"
                        Grid.Row="1"
                        FontSize="13"
                        Foreground="#4B5563"
                        LineHeight="20"
                        TextWrapping="WrapWholeWords" />

                    <ScrollViewer
                        Grid.Row="2"
                        MaxHeight="520"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <Border
                            x:Name="AboutCard"
                            x:FieldModifier="public"
                            Padding="12"
                            Background="#FFFDFC"
                            BorderBrush="#E2DDD3"
                            BorderThickness="1"
                            CornerRadius="16">
                        <StackPanel Spacing="7">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Border
                                        x:Name="AuthorAvatarFrame"
                                        x:FieldModifier="public"
                                        Width="30"
                                        Height="30"
                                        Background="#F3F8FB"
                                        BorderBrush="#D5D0C4"
                                        BorderThickness="1"
                                        CornerRadius="15">
                                        <Image
                                            Width="28"
                                            Height="28"
                                            Source="ms-appx:///Assets/DeveloperAvatar.jpg"
                                            Stretch="UniformToFill" />
                                    </Border>
                                    <TextBlock
                                        x:Name="UpdateAboutText"
                                        x:FieldModifier="public"
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe UI"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="#1B1F31"
                                        LineHeight="17"
                                        Text="作者：Zac" />
                                </StackPanel>
                                <Button
                                    x:Name="UpdateAuthorGitHubButton"
                                    x:FieldModifier="public"
                                    Grid.Column="1"
                                    Width="104"
                                    Height="28"
                                    MinWidth="104"
                                    Background="#FFFDFC"
                                    BorderBrush="#D5D0C4"
                                    BorderThickness="1"
                                    Click="OnOpenAuthorGitHubClick"
                                    CornerRadius="10"
                                    FontSize="12"
                                    Foreground="#1B1F31">
                                    <StackPanel
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="5">
                                        <Image
                                            Width="14"
                                            Height="14"
                                            Source="ms-appx:///Assets/GitHub.png"
                                            Stretch="Uniform" />
                                        <TextBlock
                                            x:Name="UpdateAuthorGitHubText"
                                            x:FieldModifier="public"
                                            VerticalAlignment="Center"
                                            Text="GitHub" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    x:Name="UpdateAuthorBilibiliButton"
                                    x:FieldModifier="public"
                                    Grid.Column="2"
                                    Width="116"
                                    Height="28"
                                    MinWidth="116"
                                    Background="#FFFDFC"
                                    BorderBrush="#D5D0C4"
                                    BorderThickness="1"
                                    Click="OnOpenBilibiliClick"
                                    CornerRadius="10"
                                    FontSize="12"
                                    Foreground="#1B1F31">
                                    <StackPanel
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="5">
                                        <Image
                                            Width="17"
                                            Height="14"
                                            Source="ms-appx:///Assets/bilibili.png"
                                            Stretch="Uniform" />
                                        <TextBlock
                                            x:Name="UpdateAuthorBilibiliText"
                                            x:FieldModifier="public"
                                            VerticalAlignment="Center"
                                            Text="B站" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Button
                                x:Name="UpdateDownloadLinkButton"
                                x:FieldModifier="public"
                                Height="28"
                                HorizontalAlignment="Stretch"
                                Background="#F3F8FB"
                                BorderBrush="#B9DCEC"
                                BorderThickness="1"
                                Click="OnOpenDownloadLinkClick"
                                CornerRadius="10"
                                Foreground="#1B1F31">
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="7">
                                    <Image
                                        Width="18"
                                        Height="18"
                                        Source="ms-appx:///Assets/Square44x44Logo.scale-200.png"
                                        Stretch="Uniform" />
                                    <TextBlock
                                        x:Name="UpdateDownloadLinkText"
                                        x:FieldModifier="public"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Text="项目下载更新链接" />
                                </StackPanel>
                            </Button>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Name="UpdateQuarkCodeText"
                                    x:FieldModifier="public"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="#1B1F31" />
                                <Button
                                    x:Name="UpdateCopyQuarkButton"
                                    x:FieldModifier="public"
                                    Grid.Column="1"
                                    Height="28"
                                    MinWidth="112"
                                    Background="#FFFDFC"
                                    BorderBrush="#B9DCEC"
                                    BorderThickness="1"
                                    Click="OnCopyQuarkUpdateClick"
                                    Content="复制网盘链接"
                                    CornerRadius="10"
                                    FontSize="12"
                                    Foreground="#1B1F31" />
                            </Grid>
                            <settings:CreditsCommunityPanel
                                x:Name="UpdateCreditsCommunityPanel"
                                x:FieldModifier="public" />
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Name="UpdateReleaseTitleText"
                                    x:FieldModifier="public"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="#1B1F31"
                                    Text="最新版本说明" />
                                <Button
                                    x:Name="UpdateReleaseToggleButton"
                                    x:FieldModifier="public"
                                    Grid.Column="1"
                                    Width="56"
                                    Height="24"
                                    MinWidth="56"
                                    Padding="0"
                                    Background="#FFFDFC"
                                    BorderBrush="#D5D0C4"
                                    BorderThickness="1"
                                    Click="OnToggleReleaseNotesClick"
                                    Content="展开"
                                    CornerRadius="8"
                                    FontSize="11"
                                    Foreground="#1B1F31" />
                            </Grid>
                            <ScrollViewer
                                x:Name="UpdateReleaseScrollViewer"
                                x:FieldModifier="public"
                                MaxHeight="0"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled">
                                <TextBlock
                                    x:Name="UpdateReleaseInfoText"
                                    x:FieldModifier="public"
                                    FontSize="11"
                                    Foreground="#4B5563"
                                    LineHeight="17"
                                    TextWrapping="WrapWholeWords" />
                            </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>

                </Grid>
            </Border>
        </Grid>
</UserControl>
