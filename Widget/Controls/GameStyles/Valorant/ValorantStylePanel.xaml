<UserControl
    x:Class="KillConfirmGameBar.Controls.GameStyles.ValorantStylePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="ms-appx:///Controls/Settings/PanelDesign.xaml" />
        </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border
        Background="#101826"
        BorderBrush="#FF4655"
        Visibility="Collapsed" Style="{StaticResource PanelSectionCardStyle}">
        <StackPanel Spacing="3">
            <TextBlock
                FontWeight="Bold"
                Foreground="#FFFFFF"
                Text="VALORANT 击杀提示" Style="{StaticResource PanelCaptionTextStyle}" />
            <TextBlock
                Foreground="#D8E5EF"
                Text="选择 VALORANT 音效包和图标包，设置连杀与爆头提示效果。"
                TextWrapping="WrapWholeWords" Style="{StaticResource PanelCaptionTextStyle}" />
        </StackPanel>
    </Border>
</UserControl>
