<UserControl
    x:Class="KillConfirmGameBar.Controls.GameStyles.LeagueOfLegendsAdvancedEffectsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KillConfirmGameBar.Controls.GameStyles"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignWidth="320"
    d:DesignHeight="360">

    <StackPanel Spacing="10">
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Border Width="22" Height="22" CornerRadius="6" Background="#E6FFFFFF" Padding="2">
                    <Image x:Name="CombatGameLogo" Source="ms-appx:///Assets/GameLogos/leagueoflegends.png" Stretch="Uniform" />
                </Border>
                <TextBlock x:Name="TitleText"
                           VerticalAlignment="Center"
                           Foreground="#1C1C1E"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button x:Name="ResetButton"
                    Grid.Column="1"
                    Height="26"
                    Padding="9,0"
                    Background="#DDF0FA"
                    BorderBrush="#9CC7DE"
                    BorderThickness="1"
                    CornerRadius="7"
                    Foreground="#085C84"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Click="OnResetClick" />
        </Grid>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="MoneyRewardCard"
                    Background="#FFFFFF"
                    BorderBrush="#DCE3EE"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="10,8">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="MoneyRewardModeLabel"
                               Foreground="#5F6B7A"
                               FontSize="11"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <ComboBox x:Name="MoneyRewardModeSelector"
                              Height="30"
                              HorizontalAlignment="Stretch"
                              Background="#F5F7FB"
                              Foreground="#1C1C1E"
                              BorderBrush="#D5DCE7"
                              BorderThickness="1"
                              CornerRadius="8"
                              FontSize="11.5"
                              Padding="8,2"
                              SelectionChanged="OnMoneyRewardModeSelectionChanged">
                        <ComboBoxItem x:Name="MoneyDeltaModeItem" Tag="delta" />
                        <ComboBoxItem x:Name="MoneyRuleModeItem" Tag="rules" />
                    </ComboBox>
                </StackPanel>
            </Border>

            <local:StreakWindowEditor x:Name="StreakEditor" Grid.Column="1" />
        </Grid>

        <Border x:Name="LolHudOptionsCard"
                Background="#FFFFFF"
                BorderBrush="#DCE3EE"
                BorderThickness="1"
                CornerRadius="10"
                Padding="10,8">
            <StackPanel Spacing="8">
                <TextBlock x:Name="HudOptionsTitleText"
                           Foreground="#5F6B7A"
                           FontSize="11"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <Grid ColumnSpacing="8" RowSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="LanguageLabel"
                                   Foreground="#5F6B7A"
                                   FontSize="10.5"
                                   TextTrimming="CharacterEllipsis" />
                        <ComboBox x:Name="LanguageSelector"
                                  Height="30"
                                  HorizontalAlignment="Stretch"
                                  Background="#F5F7FB"
                                  Foreground="#1C1C1E"
                                  BorderBrush="#D5DCE7"
                                  BorderThickness="1"
                                  CornerRadius="8"
                                  FontSize="11.5"
                                  Padding="8,2"
                                  SelectionChanged="OnHudComboSelectionChanged">
                            <ComboBoxItem x:Name="LangAutoItem" Tag="auto" />
                            <ComboBoxItem x:Name="LangZhItem" Tag="zh-CN" />
                            <ComboBoxItem x:Name="LangEnItem" Tag="en" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock x:Name="TeamThemeLabel"
                                   Foreground="#5F6B7A"
                                   FontSize="10.5"
                                   TextTrimming="CharacterEllipsis" />
                        <ComboBox x:Name="TeamThemeSelector"
                                  Height="30"
                                  HorizontalAlignment="Stretch"
                                  Background="#F5F7FB"
                                  Foreground="#1C1C1E"
                                  BorderBrush="#D5DCE7"
                                  BorderThickness="1"
                                  CornerRadius="8"
                                  FontSize="11.5"
                                  Padding="8,2"
                                  SelectionChanged="OnHudComboSelectionChanged">
                            <ComboBoxItem x:Name="ThemeBlueItem" Tag="blue" />
                            <ComboBoxItem x:Name="ThemeRedItem" Tag="red" />
                            <ComboBoxItem x:Name="ThemeGoldItem" Tag="gold" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Spacing="4">
                        <TextBlock x:Name="ActorTextLabel"
                                   Foreground="#5F6B7A"
                                   FontSize="10.5"
                                   TextTrimming="CharacterEllipsis" />
                        <ComboBox x:Name="ActorTextSelector"
                                  Height="30"
                                  HorizontalAlignment="Stretch"
                                  Background="#F5F7FB"
                                  Foreground="#1C1C1E"
                                  BorderBrush="#D5DCE7"
                                  BorderThickness="1"
                                  CornerRadius="8"
                                  FontSize="11.5"
                                  Padding="8,2"
                                  SelectionChanged="OnHudComboSelectionChanged">
                            <ComboBoxItem x:Name="ActorYouItem" Tag="you" />
                            <ComboBoxItem x:Name="ActorChampionItem" Tag="champion" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                        <TextBlock x:Name="DefaultChampionLabel"
                                   Foreground="#5F6B7A"
                                   FontSize="10.5"
                                   TextTrimming="CharacterEllipsis" />
                        <ComboBox x:Name="DefaultChampionSelector"
                                  Height="30"
                                  HorizontalAlignment="Stretch"
                                  Background="#F5F7FB"
                                  Foreground="#1C1C1E"
                                  BorderBrush="#D5DCE7"
                                  BorderThickness="1"
                                  CornerRadius="8"
                                  FontSize="11.5"
                                  Padding="8,2"
                                  SelectionChanged="OnHudComboSelectionChanged">
                            <ComboBoxItem x:Name="ChampYasuoItem" Tag="Yasuo" />
                            <ComboBoxItem x:Name="ChampYoneItem" Tag="Yone" />
                            <ComboBoxItem x:Name="ChampZedItem" Tag="Zed" />
                            <ComboBoxItem x:Name="ChampAhriItem" Tag="Ahri" />
                            <ComboBoxItem x:Name="ChampJinxItem" Tag="Jinx" />
                            <ComboBoxItem x:Name="ChampLeeSinItem" Tag="LeeSin" />
                            <ComboBoxItem x:Name="ChampDariusItem" Tag="Darius" />
                            <ComboBoxItem x:Name="ChampVayneItem" Tag="Vayne" />
                            <ComboBoxItem x:Name="ChampEzrealItem" Tag="Ezreal" />
                            <ComboBoxItem x:Name="ChampLuxItem" Tag="Lux" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Spacing="4">
                        <TextBlock x:Name="BannerModeLabel"
                                   Foreground="#5F6B7A"
                                   FontSize="10.5"
                                   TextTrimming="CharacterEllipsis" />
                        <ComboBox x:Name="BannerModeSelector"
                                  Height="30"
                                  HorizontalAlignment="Stretch"
                                  Background="#F5F7FB"
                                  Foreground="#1C1C1E"
                                  BorderBrush="#D5DCE7"
                                  BorderThickness="1"
                                  CornerRadius="8"
                                  FontSize="11.5"
                                  Padding="8,2"
                                  SelectionChanged="OnHudComboSelectionChanged">
                            <ComboBoxItem x:Name="BannerAllItem" Tag="all" />
                            <ComboBoxItem x:Name="BannerHighlightsItem" Tag="highlights" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4">
                        <TextBlock x:Name="CsStreakModeLabel"
                                   Foreground="#5F6B7A"
                                   FontSize="10.5"
                                   TextTrimming="CharacterEllipsis" />
                        <ComboBox x:Name="CsStreakModeSelector"
                                  Height="30"
                                  HorizontalAlignment="Stretch"
                                  Background="#F5F7FB"
                                  Foreground="#1C1C1E"
                                  BorderBrush="#D5DCE7"
                                  BorderThickness="1"
                                  CornerRadius="8"
                                  FontSize="11.5"
                                  Padding="8,2"
                                  SelectionChanged="OnHudComboSelectionChanged">
                            <ComboBoxItem x:Name="CsStreakCombinedItem" Tag="combined" />
                            <ComboBoxItem x:Name="CsStreakMultikillItem" Tag="multikill" />
                            <ComboBoxItem x:Name="CsStreakSpreeItem" Tag="spree" />
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <Grid ColumnSpacing="10" RowSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <CheckBox x:Name="TextFlankingToggle"
                              MinWidth="0"
                              FontSize="11.5"
                              Foreground="#1C1C1E"
                              Checked="OnHudOptionToggled"
                              Unchecked="OnHudOptionToggled" />
                    <CheckBox x:Name="PulseVfxToggle"
                              Grid.Column="1"
                              MinWidth="0"
                              FontSize="11.5"
                              Foreground="#1C1C1E"
                              Checked="OnHudOptionToggled"
                              Unchecked="OnHudOptionToggled" />
                    <CheckBox x:Name="EnemyEventsToggle"
                              Grid.Row="1"
                              MinWidth="0"
                              FontSize="11.5"
                              Foreground="#1C1C1E"
                              Checked="OnHudOptionToggled"
                              Unchecked="OnHudOptionToggled" />
                    <CheckBox x:Name="AssistAudioToggle"
                              Grid.Row="1"
                              Grid.Column="1"
                              MinWidth="0"
                              FontSize="11.5"
                              Foreground="#1C1C1E"
                              Checked="OnAssistAudioChanged"
                              Unchecked="OnAssistAudioChanged" />
                </Grid>
            </StackPanel>
        </Border>

        <Border x:Name="VisualEffectsCard"
                Background="#FFFFFF"
                BorderBrush="#DCE3EE"
                BorderThickness="1"
                CornerRadius="10"
                Padding="10,8">
            <StackPanel Spacing="6">
                <TextBlock x:Name="VisualEffectsTitleText"
                           Foreground="#5F6B7A"
                           FontSize="11"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="UpperToggle"
                              MinWidth="0"
                              FontSize="11.5"
                              Foreground="#1C1C1E"
                              Checked="OnLayerVisibilityChanged"
                              Unchecked="OnLayerVisibilityChanged" />
                    <CheckBox x:Name="LowerToggle"
                              Grid.Column="1"
                              MinWidth="0"
                              FontSize="11.5"
                              Foreground="#1C1C1E"
                              Checked="OnLayerVisibilityChanged"
                              Unchecked="OnLayerVisibilityChanged" />
                    <CheckBox x:Name="CrosshairToggle"
                              Grid.Column="2"
                              MinWidth="0"
                              FontSize="11.5"
                              Foreground="#1C1C1E"
                              Checked="OnLayerVisibilityChanged"
                              Unchecked="OnLayerVisibilityChanged" />
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
