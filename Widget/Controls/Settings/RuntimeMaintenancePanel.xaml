<UserControl
    x:Class="KillConfirmGameBar.Controls.Settings.RuntimeMaintenancePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        x:Name="Card"
        Padding="12"
        Background="#FAFAF7"
        BorderBrush="#E2DDD3"
        BorderThickness="1"
        CornerRadius="12">
        <StackPanel Spacing="10">
            <TextBlock
                x:Name="TitleText"
                FontSize="15"
                FontWeight="SemiBold"
                Text="Plugin runtime" />
            <TextBlock
                x:Name="DescriptionText"
                Opacity="0.72"
                Text="Choose an audio output device or restore all plugin data."
                TextWrapping="WrapWholeWords" />
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="AudioDeviceLabel"
                    VerticalAlignment="Center"
                    Text="Audio output" />
                <ComboBox
                    x:Name="AudioDeviceSelector"
                    Grid.Column="1"
                    MinWidth="180"
                    HorizontalAlignment="Stretch"
                    SelectionChanged="OnAudioDeviceSelectionChanged" />
            </Grid>
            <TextBlock
                x:Name="StatusText"
                FontSize="11"
                Opacity="0.72"
                TextWrapping="WrapWholeWords" />
            <Button
                x:Name="ResetPluginButton"
                HorizontalAlignment="Stretch"
                Background="#FFF1F0"
                BorderBrush="#F2A7A0"
                Foreground="#A4262C"
                Click="OnResetPluginClick"
                Content="Reset all plugin data" />
        </StackPanel>
    </Border>
</UserControl>
