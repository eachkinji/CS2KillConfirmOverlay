<UserControl
    x:Class="KillConfirmGameBar.Features.CompatibilityDisplay.Controls.GameStyles.Battlefield4StylePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="ms-appx:///Controls/Settings/PanelDesign.xaml" />
        </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border
        x:Name="Card"
        Background="#14273A"
        BorderBrush="#4D9ED6"
        Visibility="Collapsed" Style="{StaticResource PanelSectionCardStyle}">
        <StackPanel Spacing="3">
            <TextBlock
                x:Name="TitleText"
                Foreground="#EAF5FC"
                Text="Battlefield 4 Panel" Style="{StaticResource PanelTitleTextStyle}" />
            <TextBlock
                x:Name="BodyText"
                Foreground="#B9D3E2"
                Text="BF4 uses its own Battlefield 4 text HUD, score rewards, and bf4 resource folder."
                TextWrapping="WrapWholeWords" Style="{StaticResource PanelCaptionTextStyle}" />
        </StackPanel>
    </Border>
</UserControl>
