<UserControl
    x:Class="KillConfirmGameBar.Controls.GameStyles.ModernWarfare2019AdvancedEffectsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KillConfirmGameBar.Controls.GameStyles">

    <StackPanel Spacing="10">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="3">
                <TextBlock x:Name="TitleText" FontSize="16" FontWeight="Bold" />
            </StackPanel>
            <Button
                x:Name="ResetButton"
                Grid.Column="1"
                MinWidth="88"
                Height="34"
                Padding="14,0"
                VerticalAlignment="Top"
                Click="OnResetButtonClick">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="12" Glyph="&#xE777;" />
                    <TextBlock x:Name="ResetButtonText" Text="Reset" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CompactChoiceCardStyle}">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Style="{StaticResource CompactCircleIconStyle}">
                            <FontIcon FontSize="13" Foreground="White" Glyph="&#xE8C7;" />
                        </Border>
                        <TextBlock x:Name="MoneyRewardModeLabel" Style="{StaticResource CompactChoiceLabelStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                    <ComboBox
                        x:Name="MoneyRewardModeSelector"
                        SelectedIndex="0"
                        Style="{StaticResource CompactSettingsComboBoxStyle}"
                        SelectionChanged="OnMoneyRewardModeSelectionChanged">
                        <ComboBoxItem x:Name="MoneyRewardDeltaItem" Tag="delta" />
                        <ComboBoxItem x:Name="MoneyRewardRulesItem" Tag="rules" />
                    </ComboBox>
                </StackPanel>
            </Border>
            <local:StreakWindowEditor
                x:Name="StreakEditor"
                Grid.Column="1"
                SettingsChanged="OnStreakModeSelectionChanged" />
        </Grid>

        <Border x:Name="VisualEffectsCard" Padding="12" BorderThickness="1" CornerRadius="8">
            <StackPanel Spacing="8">
                <TextBlock x:Name="VisualEffectsTitle" FontSize="12" FontWeight="SemiBold" />
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="UpperEffectLabel" FontSize="10" TextWrapping="WrapWholeWords" />
                        <ToggleSwitch x:Name="UpperEffectToggle" Toggled="OnVisualEffectToggled" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock x:Name="CrosshairEffectLabel" FontSize="10" TextWrapping="WrapWholeWords" />
                        <ToggleSwitch x:Name="CrosshairEffectToggle" Toggled="OnVisualEffectToggled" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="2">
                        <TextBlock x:Name="LowerEffectLabel" FontSize="10" TextWrapping="WrapWholeWords" />
                        <ToggleSwitch x:Name="LowerEffectToggle" Toggled="OnVisualEffectToggled" />
                    </StackPanel>
                </Grid>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="AssistAudioLabel"
                        VerticalAlignment="Center"
                        FontSize="10"
                        TextWrapping="WrapWholeWords" />
                    <ToggleSwitch
                        x:Name="AssistAudioToggle"
                        Grid.Column="1"
                        MinWidth="0"
                        Toggled="OnAssistAudioToggled" />
                </Grid>
            </StackPanel>
        </Border>

        <Border x:Name="RightFeedOffsetCard" Padding="12" BorderThickness="1" CornerRadius="8">
            <StackPanel Spacing="7">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="RightFeedOffsetLabel"
                        FontSize="11"
                        FontWeight="SemiBold"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        x:Name="RightFeedOffsetValue"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="11"
                        FontWeight="SemiBold" />
                </Grid>
                <Slider
                    x:Name="RightFeedOffsetSlider"
                    Minimum="0"
                    Maximum="300"
                    StepFrequency="10"
                    ValueChanged="OnRightFeedOffsetValueChanged" />
                <TextBlock
                    x:Name="RightFeedOffsetHint"
                    FontSize="9"
                    Opacity="0.72"
                    TextWrapping="WrapWholeWords" />
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
