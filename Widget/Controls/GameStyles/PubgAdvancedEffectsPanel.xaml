<UserControl
    x:Class="KillConfirmGameBar.Controls.GameStyles.PubgAdvancedEffectsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KillConfirmGameBar.Controls.GameStyles">

    <StackPanel Spacing="8">
        <TextBlock
            x:Name="TitleText"
            FontSize="13"
            FontWeight="Bold"
            Text="PUBG Effects" />
        <TextBlock
            x:Name="HintText"
            FontSize="10"
            Visibility="Collapsed"
            TextWrapping="WrapWholeWords" />
        <Grid ColumnSpacing="8" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="MoneyRewardModeLabel"
                VerticalAlignment="Center"
                FontSize="10"
                FontWeight="SemiBold"
                Text="Money" />

            <ComboBox
                x:Name="MoneyRewardModeSelector"
                Grid.Column="1"
                Height="28"
                Padding="7,0,12,0"
                FontSize="10"
                SelectionChanged="OnMoneyRewardModeSelectionChanged"
                ToolTipService.ToolTip="Money reward calculation">
                <ComboBoxItem x:Name="MoneyRewardDeltaItem" Tag="delta">GSI delta validation (experimental)</ComboBoxItem>
                <ComboBoxItem x:Name="MoneyRewardRulesItem" Tag="rules">Kill reward rules (recommended)</ComboBoxItem>
            </ComboBox>
            <local:StreakWindowEditor
                x:Name="StreakEditor"
                Grid.Row="1"
                Grid.ColumnSpan="2"
                SettingsChanged="OnStreakModeSelectionChanged" />
        </Grid>
        <local:PubgStylePanel x:Name="StylePanel" />
        <Border
            x:Name="ImportLockedNotice"
            Padding="8"
            BorderThickness="1"
            Visibility="Collapsed"
            CornerRadius="10">
            <TextBlock
                x:Name="ImportLockedText"
                FontSize="10"
                Text="Built-in PUBG resources only. File import is disabled for this page."
                TextWrapping="WrapWholeWords" />
        </Border>
    </StackPanel>
</UserControl>
