<UserControl
    x:Class="KillConfirmGameBar.Controls.GameStyles.Battlefield1AdvancedEffectsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KillConfirmGameBar.Controls.GameStyles">

    <StackPanel Spacing="10">
        <StackPanel Spacing="2">
            <TextBlock
                x:Name="TitleText"
                FontSize="16"
                FontWeight="Bold"
                Text="BF1 Effects" />
            <TextBlock
                x:Name="HintText"
                FontSize="10"
                Visibility="Collapsed"
                TextWrapping="WrapWholeWords" />
        </StackPanel>

        <Grid ColumnSpacing="8" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="MoneyRewardModeLabel"
                VerticalAlignment="Center"
                FontSize="10"
                FontWeight="SemiBold"
                Text="Money" />

            <ComboBox
                x:Name="MoneyRewardModeSelector"
                Grid.Column="1"
                Height="28"
                Padding="7,0,12,0"
                FontSize="10"
                SelectionChanged="OnMoneyRewardModeSelectionChanged"
                ToolTipService.ToolTip="Money reward calculation">
                <ComboBoxItem x:Name="MoneyRewardDeltaItem" Tag="delta">GSI delta (default)</ComboBoxItem>
                <ComboBoxItem x:Name="MoneyRewardRulesItem" Tag="rules">Kill reward rules</ComboBoxItem>
            </ComboBox>
            <local:StreakWindowEditor
                x:Name="StreakEditor"
                Grid.Row="1"
                Grid.ColumnSpan="2"
                SettingsChanged="OnStreakModeSelectionChanged" />
        </Grid>

        <Border
            x:Name="ImportLockedNotice"
            Padding="9,6"
            BorderThickness="1"
            Visibility="Collapsed"
            CornerRadius="12">
            <TextBlock
                x:Name="ImportLockedText"
                FontSize="10"
                FontWeight="SemiBold"
                Text="Built-in Battlefield 1 resources only. File import is disabled for this page."
                TextWrapping="WrapWholeWords" />
        </Border>

        <local:Battlefield1StylePanel x:Name="StylePanel" />
    </StackPanel>
</UserControl>
