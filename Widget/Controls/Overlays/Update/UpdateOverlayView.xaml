<UserControl
    x:Class="KillConfirmGameBar.Controls.UpdateOverlayView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:KillConfirmGameBar.Controls.Settings">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Controls/Settings/PanelDesign.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
        <Grid
            x:Name="Root"
            x:FieldModifier="public"
            Background="#99000000">
            <Border Style="{StaticResource PanelCardStyle}"
                x:Name="DialogCard"
                x:FieldModifier="public"
                Width="520"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <Grid RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource PanelPageTitleTextStyle}"
                                x:Name="UpdateDialogTitleText"
                                x:FieldModifier="public"
                                Text="发现更新" />
                            <TextBlock Style="{StaticResource PanelTitleTextStyle}"
                                x:Name="UpdateDialogVersionText"
                                x:FieldModifier="public"
                                Text="v..." />
                        </StackPanel>
                        <Button Style="{StaticResource PanelIconButtonStyle}"
                            x:Name="UpdateCloseButton"
                            AutomationProperties.Name="关闭更新提示 / Close update"
                            x:FieldModifier="public"
                            Grid.Column="1"
                            Click="OnCloseUpdateOverlayClick"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center">
                            <FontIcon
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="12"
                                Glyph="&#xE711;"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="#1C1C1E" />
                        </Button>
                    </Grid>

                    <TextBlock Style="{StaticResource PanelBodyTextStyle}"
                        x:Name="UpdateDialogBodyText"
                        x:FieldModifier="public"
                        Grid.Row="1"
                        TextWrapping="WrapWholeWords" />

                    <ScrollViewer
                        Grid.Row="2"
                        MaxHeight="520"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <Border Style="{StaticResource PanelSectionCardStyle}"
                            x:Name="AboutCard"
                            x:FieldModifier="public">
                        <StackPanel Spacing="7">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Border
                                        x:Name="AuthorAvatarFrame"
                                        x:FieldModifier="public"
                                        Width="30"
                                        Height="30"
                                        Background="#F3F8FB"
                                        BorderBrush="#1F000000"
                                        BorderThickness="1"
                                        CornerRadius="15">
                                        <Image
                                            Width="28"
                                            Height="28"
                                            Source="ms-appx:///Assets/DeveloperAvatar.jpg"
                                            Stretch="UniformToFill" />
                                    </Border>
                                    <TextBlock Style="{StaticResource PanelTitleTextStyle}"
                                        x:Name="UpdateAboutText"
                                        x:FieldModifier="public"
                                        VerticalAlignment="Center"
                                        Text="作者：Zac" />
                                </StackPanel>
                                <Button Style="{StaticResource PanelButtonStyle}"
                                    x:Name="UpdateAuthorGitHubButton"
                                    x:FieldModifier="public"
                                    Grid.Column="1"
                                    Width="104"
                                    Click="OnOpenAuthorGitHubClick">
                                    <StackPanel
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="5">
                                        <Image
                                            Width="14"
                                            Height="14"
                                            Source="ms-appx:///Assets/GitHub.png"
                                            Stretch="Uniform" />
                                        <TextBlock Style="{StaticResource PanelBodyTextStyle}"
                                            x:Name="UpdateAuthorGitHubText"
                                            x:FieldModifier="public"
                                            VerticalAlignment="Center"
                                            Text="GitHub" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource PanelButtonStyle}"
                                    x:Name="UpdateAuthorBilibiliButton"
                                    x:FieldModifier="public"
                                    Grid.Column="2"
                                    Width="116"
                                    Click="OnOpenBilibiliClick">
                                    <StackPanel
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="5">
                                        <Image
                                            Width="17"
                                            Height="14"
                                            Source="ms-appx:///Assets/bilibili.png"
                                            Stretch="Uniform" />
                                        <TextBlock Style="{StaticResource PanelBodyTextStyle}"
                                            x:Name="UpdateAuthorBilibiliText"
                                            x:FieldModifier="public"
                                            VerticalAlignment="Center"
                                            Text="B站" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Button Style="{StaticResource PanelButtonStyle}"
                                x:Name="UpdateDownloadLinkButton"
                                x:FieldModifier="public"
                                HorizontalAlignment="Stretch"
                                Click="OnOpenDownloadLinkClick">
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="7">
                                    <Image
                                        Width="18"
                                        Height="18"
                                        Source="ms-appx:///Assets/Square44x44Logo.scale-200.png"
                                        Stretch="Uniform" />
                                    <TextBlock Style="{StaticResource PanelTitleTextStyle}"
                                        x:Name="UpdateDownloadLinkText"
                                        x:FieldModifier="public"
                                        VerticalAlignment="Center"
                                        Text="项目下载更新链接" />
                                </StackPanel>
                            </Button>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource PanelTitleTextStyle}"
                                    x:Name="UpdateQuarkCodeText"
                                    x:FieldModifier="public"
                                    VerticalAlignment="Center" />
                                <Button Style="{StaticResource PanelButtonStyle}"
                                    x:Name="UpdateCopyQuarkButton"
                                    x:FieldModifier="public"
                                    Grid.Column="1"
                                    Click="OnCopyQuarkUpdateClick"
                                    Content="复制网盘链接" />
                            </Grid>
                            <settings:CreditsCommunityPanel
                                x:Name="UpdateCreditsCommunityPanel"
                                x:FieldModifier="public" />
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource PanelTitleTextStyle}"
                                    x:Name="UpdateReleaseTitleText"
                                    x:FieldModifier="public"
                                    VerticalAlignment="Center"
                                    Text="最新版本说明" />
                                <Button Style="{StaticResource PanelButtonStyle}"
                                    x:Name="UpdateReleaseToggleButton"
                                    x:FieldModifier="public"
                                    Grid.Column="1"
                                    MinWidth="64"
                                    Click="OnToggleReleaseNotesClick"
                                    Content="展开" />
                            </Grid>
                            <ScrollViewer
                                x:Name="UpdateReleaseScrollViewer"
                                x:FieldModifier="public"
                                MaxHeight="0"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled">
                                <TextBlock Style="{StaticResource PanelCaptionTextStyle}"
                                    x:Name="UpdateReleaseInfoText"
                                    x:FieldModifier="public"
                                    TextWrapping="WrapWholeWords" />
                            </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>

                </Grid>
            </Border>
        </Grid>
</UserControl>
