<UserControl
    x:Class="KillConfirmGameBar.PackTestView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:gameStyles="using:KillConfirmGameBar.Controls.GameStyles"
    xmlns:settings="using:KillConfirmGameBar.Controls.Settings"
    xmlns:primitives="using:Windows.UI.Xaml.Controls.Primitives"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Pages/KillConfirmWidget/KillConfirmWidgetPage.Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

<Grid x:Name="PackTestSection" x:FieldModifier="public">
    <Border
        x:Name="PackTestCard" x:FieldModifier="public"
        Padding="0"
        Background="#FAFAF7"
        BorderBrush="#E2DDD3"
        BorderThickness="1"
        CornerRadius="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                x:Name="PackTestHeaderBorder" x:FieldModifier="public"
                Grid.Row="0"
                Background="#F29A17"
                BorderBrush="#D87800"
                BorderThickness="0,0,0,1"
                CornerRadius="16,16,0,0"
                Padding="9,0,9,0">
                <TextBlock
                    x:Name="PackTestHeaderText" x:FieldModifier="public"
                    Style="{StaticResource SectionHeaderTextStyle}"
                    Foreground="#FFFFFF"
                    Text="PACK / TEST" />
            </Border>

        <StackPanel
            Grid.Row="1"
            Margin="4,4,4,4"
            Spacing="4">
            <Grid
                HorizontalAlignment="Center"
                ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <PathIcon
                    x:Name="VoicePackIcon" x:FieldModifier="public"
                    Grid.Column="0"
                    Margin="0,0,2,0"
                    Style="{StaticResource FluentTinyPathIconStyle}"
                    Data="M12 3C12.4142 3 12.75 3.33579 12.75 3.75V10.25C12.75 10.6642 12.4142 11 12 11C11.5858 11 11.25 10.6642 11.25 10.25V3.75C11.25 3.33579 11.5858 3 12 3ZM8.5 6.75C8.91421 6.75 9.25 7.08579 9.25 7.5V10C9.25 11.5188 10.4812 12.75 12 12.75C13.5188 12.75 14.75 11.5188 14.75 10V7.5C14.75 7.08579 15.0858 6.75 15.5 6.75C15.9142 6.75 16.25 7.08579 16.25 7.5V10C16.25 12.1054 14.6054 13.833 12.5332 13.9659V16.25H14.75C15.1642 16.25 15.5 16.5858 15.5 17C15.5 17.4142 15.1642 17.75 14.75 17.75H9.25C8.83579 17.75 8.5 17.4142 8.5 17C8.5 16.5858 8.83579 16.25 9.25 16.25H11.0332V13.9659C8.96096 13.833 7.31641 12.1054 7.31641 10V7.5C7.31641 7.08579 7.6522 6.75 8.06641 6.75H8.5Z" />

                <ComboBox
                    x:Name="VoicePackSelector" x:FieldModifier="public"
                    Grid.Column="1"
                    Width="150"
                    Style="{StaticResource PackAccentComboBoxStyle}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    SelectionChanged="OnVoicePackSelectionChanged"
                    ToolTipService.ToolTip="Select voice pack">
                    <ComboBoxItem x:Name="CrossfireSwatGrVoiceItem" x:FieldModifier="public" Tag="crossfire_swat_gr">swat GR</ComboBoxItem>
                    <ComboBoxItem x:Name="CrossfireSwatBlVoiceItem" x:FieldModifier="public" Tag="crossfire_swat_bl">swat BL</ComboBoxItem>
                    <ComboBoxItem x:Name="CrossfireFlyingTigerGrVoiceItem" x:FieldModifier="public" Tag="crossfire_flying_tiger_gr">tiger GR</ComboBoxItem>
                    <ComboBoxItem x:Name="CrossfireFlyingTigerBlVoiceItem" x:FieldModifier="public" Tag="crossfire_flying_tiger_bl">tiger BL</ComboBoxItem>
                    <ComboBoxItem Tag="crossfire_v_sex">American Girl</ComboBoxItem>
                    <ComboBoxItem x:Name="CrossfireWomenGrVoiceItem" x:FieldModifier="public" Tag="crossfire_women_gr">women GR</ComboBoxItem>
                    <ComboBoxItem x:Name="CrossfireWomenBlVoiceItem" x:FieldModifier="public" Tag="crossfire_women_bl">women BL</ComboBoxItem>
                </ComboBox>

                <PathIcon
                    x:Name="IconPackIcon" x:FieldModifier="public"
                    Grid.Column="2"
                    Margin="0,0,2,0"
                    Style="{StaticResource FluentTinyPathIconStyle}"
                    Data="M6.75 4C5.7835 4 5 4.7835 5 5.75V18.25C5 19.2165 5.7835 20 6.75 20H17.25C18.2165 20 19 19.2165 19 18.25V5.75C19 4.7835 18.2165 4 17.25 4H6.75ZM8.75 8.5C8.75 8.08579 9.08579 7.75 9.5 7.75H14.5C14.9142 7.75 15.25 8.08579 15.25 8.5C15.25 8.91421 14.9142 9.25 14.5 9.25H9.5C9.08579 9.25 8.75 8.91421 8.75 8.5ZM8.75 12C8.75 11.5858 9.08579 11.25 9.5 11.25H14.5C14.9142 11.25 15.25 11.5858 15.25 12C15.25 12.4142 14.9142 12.75 14.5 12.75H9.5C9.08579 12.75 8.75 12.4142 8.75 12ZM9.5 14.75C9.08579 14.75 8.75 15.0858 8.75 15.5C8.75 15.9142 9.08579 16.25 9.5 16.25H12.5C12.9142 16.25 13.25 15.9142 13.25 15.5C13.25 15.0858 12.9142 14.75 12.5 14.75H9.5Z" />

                <ComboBox
                    x:Name="IconPackSelector" x:FieldModifier="public"
                    Grid.Column="3"
                    Width="150"
                    Style="{StaticResource PackAccentComboBoxStyle}"
                    HorizontalContentAlignment="Left"
                    SelectionChanged="OnIconPackSelectionChanged">
                    <ComboBoxItem x:Name="DefaultIconPackItem" x:FieldModifier="public" Tag="default" Foreground="#1B1F31">Default</ComboBoxItem>
                    <ComboBoxItem x:Name="VipIconPackItem" x:FieldModifier="public" Tag="vip" Foreground="#1B1F31">VIP</ComboBoxItem>
                    <ComboBoxItem x:Name="CustomIconPackItem" x:FieldModifier="public" Tag="angelic_beast" Foreground="#1B1F31">Custom</ComboBoxItem>
                </ComboBox>

                <Button
                    x:Name="AdvancedEffectsButton" x:FieldModifier="public"
                    Grid.Column="4"
                    Width="34"
                    Height="32"
                    Margin="4,0,0,0"
                    Style="{StaticResource PackImportantIconButtonStyle}"
                    AutomationProperties.Name="Advanced effects"
                    Click="OnAdvancedEffectsButtonClick"
                    ToolTipService.ToolTip="Advanced effects">
                    <primitives:FlyoutBase.AttachedFlyout>
                        <Flyout x:Name="AdvancedEffectsFlyout" x:FieldModifier="public" Placement="Bottom">
                            <Flyout.FlyoutPresenterStyle>
                                <Style TargetType="FlyoutPresenter">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
                                    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                                    <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled" />
                                    <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
                                    <Setter Property="MaxWidth" Value="520" />
                                    <Setter Property="MaxHeight" Value="800" />
                                </Style>
                            </Flyout.FlyoutPresenterStyle>
                            <Border
                                x:Name="AdvancedEffectsFlyoutCard" x:FieldModifier="public"
                                Width="440"
                                MaxHeight="720"
                                Padding="12"
                                Background="#FAFAF7"
                                BorderBrush="#E2DDD3"
                                BorderThickness="1"
                                CornerRadius="16">
                                <ScrollViewer
                                    VerticalScrollBarVisibility="Auto"
                                    VerticalScrollMode="Auto"
                                    ZoomMode="Disabled">
                                    <StackPanel Spacing="10">
                                        <Border
                                            x:Name="AdvancedEffectsGameCard" x:FieldModifier="public"
                                            Padding="12"
                                            BorderThickness="1"
                                            CornerRadius="18">
                                            <StackPanel Spacing="10">
                                                <TextBlock
                                                    x:Name="AdvancedEffectsGameTitleText" x:FieldModifier="public"
                                                    FontSize="16"
                                                    FontWeight="Bold"
                                                    Text="Game effects" />
                                                <gameStyles:KillFeedbackAppearanceEditor
                                                    x:Name="KillFeedbackAppearanceEditorControl"
                                                    x:FieldModifier="public" />
                                                <ContentControl x:Name="AdvancedEffectsPanelHost" x:FieldModifier="public" />
                                            </StackPanel>
                                        </Border>

                                        <Border
                                            x:Name="AdvancedEffectsExperienceCard" x:FieldModifier="public"
                                            Padding="12"
                                            BorderThickness="1"
                                            CornerRadius="18">
                                            <StackPanel Spacing="10">
                                                <TextBlock
                                                    x:Name="AdvancedEffectsExperienceTitleText" x:FieldModifier="public"
                                                    FontSize="16"
                                                    FontWeight="Bold"
                                                    Text="游戏体验增强" />
                                                <settings:GeneralSettingsOptionsPanel x:Name="AdvancedEffectsExperiencePanel" x:FieldModifier="public" />
                                            </StackPanel>
                                        </Border>

                                        <Border
                                            x:Name="AdvancedEffectsRuntimeCard" x:FieldModifier="public"
                                            Padding="12"
                                            BorderThickness="1"
                                            CornerRadius="18">
                                            <StackPanel Spacing="10">
                                                <TextBlock
                                                    x:Name="AdvancedEffectsRuntimeTitleText" x:FieldModifier="public"
                                                    FontSize="16"
                                                    FontWeight="Bold"
                                                    Text="软件与维护" />
                                                <settings:RuntimeMaintenancePanel x:Name="AdvancedEffectsRuntimePanel" x:FieldModifier="public" />
                                            </StackPanel>
                                        </Border>

                                        <Border
                                            x:Name="AdvancedEffectsCreditsCard" x:FieldModifier="public"
                                            Padding="12"
                                            BorderThickness="1"
                                            CornerRadius="18">
                                            <StackPanel Spacing="10">
                                                <TextBlock
                                                    x:Name="AdvancedEffectsCreditsTitleText" x:FieldModifier="public"
                                                    FontSize="16"
                                                    FontWeight="Bold"
                                                    Text="作者与致谢" />
                                                <Border
                                                    x:Name="AdvancedEffectsAuthorCard" x:FieldModifier="public"
                                                    Padding="10"
                                                    BorderThickness="1"
                                                    CornerRadius="12">
                                                    <Grid ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="46" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border
                                                            x:Name="AdvancedEffectsAuthorAvatarFrame" x:FieldModifier="public"
                                                            Width="46"
                                                            Height="46"
                                                            BorderThickness="1"
                                                            CornerRadius="23">
                                                            <Image
                                                                Source="ms-appx:///Assets/DeveloperAvatar.jpg"
                                                                Stretch="UniformToFill" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                            <TextBlock
                                                                x:Name="AdvancedEffectsAuthorNameText" x:FieldModifier="public"
                                                                FontSize="13"
                                                                FontWeight="SemiBold"
                                                                Text="Zac · eachkinji" />
                                                            <TextBlock
                                                                x:Name="AdvancedEffectsAuthorDescriptionText" x:FieldModifier="public"
                                                                FontSize="10"
                                                                Text="Kill Confirm Overlay 作者与维护者" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <Grid ColumnSpacing="6" RowSpacing="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <HyperlinkButton
                                                        x:Name="AdvancedEffectsAuthorGitHubButton" x:FieldModifier="public"
                                                        HorizontalContentAlignment="Center"
                                                        NavigateUri="https://github.com/eachkinji"
                                                        Content="GitHub · eachkinji" />
                                                    <HyperlinkButton
                                                        x:Name="AdvancedEffectsAuthorBilibiliButton" x:FieldModifier="public"
                                                        Grid.Column="1"
                                                        HorizontalContentAlignment="Center"
                                                        NavigateUri="https://space.bilibili.com/18017622"
                                                        Content="B站 · Zac不想烤肉" />
                                                    <HyperlinkButton
                                                        x:Name="AdvancedEffectsProjectButton" x:FieldModifier="public"
                                                        Grid.Row="1"
                                                        HorizontalContentAlignment="Center"
                                                        NavigateUri="https://github.com/eachkinji/CS2KillConfirmOverlay"
                                                        Content="项目主页" />
                                                    <HyperlinkButton
                                                        x:Name="AdvancedEffectsDownloadButton" x:FieldModifier="public"
                                                        Grid.Row="1"
                                                        Grid.Column="1"
                                                        HorizontalContentAlignment="Center"
                                                        NavigateUri="https://pan.quark.cn/s/1f3cfbcf8d5f?pwd=7Twv"
                                                        Content="下载与更新 · 7Twv" />
                                                </Grid>
                                                <TextBlock
                                                    x:Name="AdvancedEffectsCreditsBodyText" x:FieldModifier="public"
                                                    FontSize="12"
                                                    LineHeight="17"
                                                    TextWrapping="Wrap" />
                                                <settings:CreditsCommunityPanel x:Name="AdvancedEffectsCreditsCommunityPanel" x:FieldModifier="public" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Flyout>
                    </primitives:FlyoutBase.AttachedFlyout>
                    <Grid Style="{StaticResource IconHostStyle}">
                        <FontIcon
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="12"
                            Glyph="&#xE7C1;"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="#FFFFFF" />
                    </Grid>
                </Button>

            </Grid>

            <Grid
                HorizontalAlignment="Center"
                ColumnSpacing="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="82" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <PathIcon
                x:Name="VolumeIcon" x:FieldModifier="public"
                Grid.Column="0"
