<UserControl
    x:Class="KillConfirmGameBar.Features.CompatibilityDisplay.Controls.GameStyles.CalabiyauAdvancedEffectsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KillConfirmGameBar.Features.CompatibilityDisplay.Controls.GameStyles">

    <StackPanel Spacing="10">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock
                    x:Name="TitleText"
                    FontSize="15"
                    FontWeight="Bold"
                    Text="Strinova Combat &amp; Effects" />
                <TextBlock
                    x:Name="HintText"
                    FontSize="10.5"
                    Opacity="0.78"
                    TextWrapping="WrapWholeWords" />
            </StackPanel>
            <Button
                x:Name="ResetButton"
                Grid.Column="1"
                MinWidth="88"
                Height="34"
                Padding="14,0"
                VerticalAlignment="Top"
                AutomationProperties.Name="Restore Strinova defaults"
                Click="OnResetClick">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="12" Glyph="&#xE777;" />
                    <TextBlock x:Name="ResetButtonText" Text="Reset" />
                </StackPanel>
            </Button>
        </Grid>

        <local:StreakWindowEditor
            x:Name="StreakEditor"
            SettingsChanged="OnStreakModeSelectionChanged" />
    </StackPanel>
</UserControl>
