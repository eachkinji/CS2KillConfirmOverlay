<UserControl
    x:Class="KillConfirmGameBar.Controls.Settings.AdvancedSettingsHub"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:KillConfirmGameBar.Controls.Settings"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <SolidColorBrush x:Key="HubCardBackground" Color="#FAFAF7" />
        <SolidColorBrush x:Key="HubCardBorder" Color="#E2DDD3" />
        <SolidColorBrush x:Key="HubDivider" Color="#E2DDD3" />
        <SolidColorBrush x:Key="HubTitleText" Color="#1B1F31" />
        <SolidColorBrush x:Key="HubBodyText" Color="#555966" />
        <SolidColorBrush x:Key="HubMutedText" Color="#757575" />
        <SolidColorBrush x:Key="HubAccentText" Color="#2E88B8" />
        <SolidColorBrush x:Key="HubPanelBackground" Color="#FFFFFF" />
        <SolidColorBrush x:Key="HubPanelBorder" Color="#E2DDD3" />

        <Style x:Key="HubCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="22" />
            <Setter Property="Background" Value="{StaticResource HubCardBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource HubCardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="24" />
        </Style>

        <Style x:Key="HubTitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource HubTitleText}" />
            <Setter Property="CharacterSpacing" Value="40" />
        </Style>

        <Style x:Key="HubBodyTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource HubBodyText}" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
            <Setter Property="LineHeight" Value="20" />
        </Style>

        <Style x:Key="HubSectionLabelTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource HubTitleText}" />
            <Setter Property="CharacterSpacing" Value="100" />
        </Style>

        <Style x:Key="HubFieldLabelTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource HubTitleText}" />
        </Style>

        <Style x:Key="HubHelperTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource HubMutedText}" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
            <Setter Property="LineHeight" Value="16" />
        </Style>

        <Style x:Key="HubPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Background" Value="#2E88B8" />
            <Setter Property="BorderBrush" Value="#3A9CCF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="HubSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D5D0C4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Foreground" Value="#1D2233" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="HubTabButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="Background" Value="#EFEFEA" />
            <Setter Property="Foreground" Value="#4B5563" />
            <Setter Property="BorderBrush" Value="#DCD7CC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="HubTabActiveButtonStyle" TargetType="Button" BasedOn="{StaticResource HubTabButtonStyle}">
            <Setter Property="Background" Value="#2E88B8" />
            <Setter Property="BorderBrush" Value="#3A9CCF" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="HubBadgeBorderStyle" TargetType="Border">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Background" Value="#E6F4FA" />
            <Setter Property="BorderBrush" Value="#B9DCEC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <Style x:Key="HubInputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D5D0C4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#1B1F31" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="10,6" />
        </Style>

        <Style x:Key="HubComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D5D0C4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#1B1F31" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinHeight" Value="32" />
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid RowSpacing="16">
            <!-- Hidden compatibility anchors for code-behind tab buttons if ever invoked internally -->
            <StackPanel Visibility="Collapsed">
                <Button x:Name="HubTabGeneralButton" Click="OnHubTabGeneralClick" />
                <Button x:Name="HubTabPortButton" Click="OnHubTabPortClick" />
                <Button x:Name="HubTabDisplayButton" Click="OnHubTabDisplayClick" />
                <Button x:Name="HubTabAboutButton" Click="OnHubTabAboutClick" />
                <TextBlock x:Name="HubHeaderBadgeText" />
                <TextBlock x:Name="HubHeaderTitleText" />
                <TextBlock x:Name="HubHeaderSubtitleText" />
                <TextBlock x:Name="HubStatusBadgeText" />
            </StackPanel>

            <!-- Tab content views (managed by MainPage HomeWorkspaceTabBar) -->
            <!-- General tab -->
            <ScrollViewer
                x:Name="HubGeneralView"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="16" MaxWidth="1480" HorizontalAlignment="Stretch">
                    <Border Style="{StaticResource HubCardStyle}">
                        <StackPanel Spacing="14">
                            <TextBlock
                                x:Name="HubGeneralCardTitle"
                                Style="{StaticResource HubSectionLabelTextStyle}"
                                FontSize="18"
                                Text="RUNTIME &amp; MAINTENANCE" />
                            <TextBlock
                                x:Name="HubGeneralCardDescription"
                                Style="{StaticResource HubBodyTextStyle}" />
                            <settings:RuntimeMaintenancePanel x:Name="HubRuntimePanel" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource HubCardStyle}">
                        <StackPanel Spacing="14">
                            <TextBlock
                                x:Name="HubGeneralCardSecondaryTitle"
                                Style="{StaticResource HubSectionLabelTextStyle}"
                                FontSize="18"
                                Text="GAME-STATE INTEGRATION" />
                            <TextBlock
                                x:Name="HubGeneralCardSecondaryDescription"
                                Style="{StaticResource HubBodyTextStyle}" />
                            <settings:GeneralSettingsOptionsPanel x:Name="HubGeneralOptionsPanel" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Port tab -->
            <ScrollViewer
                x:Name="HubPortView"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Visibility="Collapsed">
                <StackPanel Spacing="16" MaxWidth="1480" HorizontalAlignment="Stretch">
                    <Border Style="{StaticResource HubCardStyle}">
                        <StackPanel Spacing="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        x:Name="HubPortTitleText"
                                        Style="{StaticResource HubSectionLabelTextStyle}"
                                        FontSize="18"
                                        Text="LOCAL SERVICE PORT" />
                                    <TextBlock
                                        x:Name="HubPortDescriptionText"
                                        Style="{StaticResource HubBodyTextStyle}" />
                                </StackPanel>
                                <Border
                                    Grid.Column="1"
                                    VerticalAlignment="Top"
                                    Style="{StaticResource HubBadgeBorderStyle}">
                                    <TextBlock
                                        x:Name="HubPortCurrentBadgeText"
                                        Foreground="{StaticResource HubAccentText}"
                                        FontWeight="Bold"
                                        FontSize="11" />
                                </Border>
                            </Grid>

                            <Border
                                Background="{StaticResource HubPanelBackground}"
                                BorderBrush="{StaticResource HubPanelBorder}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="16">
                                <StackPanel Spacing="14">
                                    <StackPanel Spacing="6">
                                        <TextBlock
                                            x:Name="HubPortCurrentLabel"
                                            Style="{StaticResource HubFieldLabelTextStyle}" />
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                x:Name="HubPortCurrentValue"
                                                FontFamily="Consolas"
                                                FontSize="22"
                                                FontWeight="Bold"
                                                Foreground="{StaticResource HubAccentText}"
                                                VerticalAlignment="Center" />
                                            <TextBlock
                                                x:Name="HubPortServiceReportedValue"
                                                Grid.Column="1"
                                                FontFamily="Consolas"
                                                FontSize="13"
                                                Foreground="{StaticResource HubBodyText}"
                                                VerticalAlignment="Center" />
                                            <Button
                                                x:Name="HubPortRefreshButton"
                                                Grid.Column="2"
                                                Style="{StaticResource HubSecondaryButtonStyle}"
                                                Click="OnHubPortRefreshClick" />
                                        </Grid>
                                    </StackPanel>

                                    <Rectangle Height="1" Fill="{StaticResource HubDivider}" />

                                    <StackPanel Spacing="6">
                                        <TextBlock
                                            x:Name="HubPortBackupLabel"
                                            Style="{StaticResource HubFieldLabelTextStyle}" />
                                        <TextBlock
                                            x:Name="HubPortBackupHint"
                                            Style="{StaticResource HubHelperTextStyle}" />
                                        <ItemsControl x:Name="HubPortBackupList">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapGrid Orientation="Horizontal" MaximumRowsOrColumns="6" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button
                                                        Margin="0,0,8,8"
                                                        Padding="14,8"
                                                        MinWidth="0"
                                                        Background="#F7F8FA"
                                                        BorderBrush="#D5D0C4"
                                                        BorderThickness="1"
                                                        CornerRadius="14"
                                                        Foreground="#1B1F31"
                                                        FontFamily="Consolas"
                                                        FontSize="14"
                                                        FontWeight="Bold"
                                                        Content="{Binding Label}"
                                                        Tag="{Binding Port}"
                                                        Click="OnPortChipClick" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <Rectangle Height="1" Fill="{StaticResource HubDivider}" />

                                    <StackPanel Spacing="6">
                                        <TextBlock
                                            x:Name="HubPortCustomLabel"
                                            Style="{StaticResource HubFieldLabelTextStyle}" />
                                        <TextBlock
                                            x:Name="HubPortCustomHint"
                                            Style="{StaticResource HubHelperTextStyle}" />
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox
                                                x:Name="HubPortCustomInput"
                                                Style="{StaticResource HubInputStyle}"
                                                InputScope="Number"
                                                MaxLength="5" />
                                            <Button
                                                x:Name="HubPortCustomApplyButton"
                                                Grid.Column="1"
                                                Style="{StaticResource HubPrimaryButtonStyle}"
                                                Click="OnHubPortCustomApplyClick" />
                                        </Grid>
                                    </StackPanel>

                                    <Rectangle Height="1" Fill="{StaticResource HubDivider}" />

                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4" VerticalAlignment="Center">
                                            <TextBlock
                                                x:Name="HubPortAutoSearchLabel"
                                                Style="{StaticResource HubFieldLabelTextStyle}" />
                                            <TextBlock
                                                x:Name="HubPortAutoSearchHint"
                                                Style="{StaticResource HubHelperTextStyle}" />
                                        </StackPanel>
                                        <ToggleSwitch
                                            x:Name="HubPortAutoSearchToggle"
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            OnContent=""
                                            OffContent=""
                                            Toggled="OnHubPortAutoSearchToggled" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource HubCardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock
                                x:Name="HubPortStatusTitle"
                                Style="{StaticResource HubSectionLabelTextStyle}"
                                FontSize="18"
                                Text="CONNECTION STATUS" />
                            <TextBlock
                                x:Name="HubPortStatusBody"
                                Style="{StaticResource HubHelperTextStyle}" />
                            <Border
                                Background="{StaticResource HubPanelBackground}"
                                BorderBrush="{StaticResource HubPanelBorder}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="14">
                                <TextBlock
                                    x:Name="HubPortStatusMessage"
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    Foreground="{StaticResource HubBodyText}"
                                    TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Display tab -->
            <ScrollViewer
                x:Name="HubDisplayView"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Visibility="Collapsed">
                <StackPanel Spacing="16" MaxWidth="1480" HorizontalAlignment="Stretch">
                    <Border Style="{StaticResource HubCardStyle}">
                        <StackPanel Spacing="14">
                            <TextBlock
                                x:Name="HubDisplayCardTitle"
                                Style="{StaticResource HubSectionLabelTextStyle}"
                                FontSize="18"
                                Text="DISPLAY &amp; SCALING" />
                            <TextBlock
                                x:Name="HubDisplayCardDescription"
                                Style="{StaticResource HubBodyTextStyle}" />
                            <settings:DisplayScalingSettingsPanel x:Name="HubDisplayScalingPanel" x:FieldModifier="public" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- About tab -->
            <ScrollViewer
                x:Name="HubAboutView"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Visibility="Collapsed">
                <StackPanel Spacing="16" MaxWidth="1480" HorizontalAlignment="Stretch">
                    <Border Style="{StaticResource HubCardStyle}">
                        <StackPanel Spacing="14">
                            <TextBlock
                                x:Name="HubAboutTitle"
                                Style="{StaticResource HubSectionLabelTextStyle}"
                                FontSize="18"
                                Text="ABOUT THIS BUILD" />
                            <TextBlock
                                x:Name="HubAboutBody"
                                Style="{StaticResource HubBodyTextStyle}" />
                            <TextBlock
                                x:Name="HubAboutVersion"
                                Style="{StaticResource HubHelperTextStyle}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
