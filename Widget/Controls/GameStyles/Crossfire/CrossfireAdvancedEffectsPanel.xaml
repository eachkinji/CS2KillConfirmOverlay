<UserControl
    x:Class="KillConfirmGameBar.Controls.GameStyles.CrossfireAdvancedEffectsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KillConfirmGameBar.Controls.GameStyles">

    <StackPanel Spacing="10">
        <!-- Panel Header -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock
                    x:Name="TitleText"
                    FontSize="15"
                    FontWeight="Bold"
                    Text="CF (穿越火线) 特效与战斗控制" />
                <TextBlock
                    x:Name="HintText"
                    FontSize="10.5"
                    Opacity="0.75"
                    Text="集中设置 CF 的连杀规则、爆头、刀杀与雷杀提示、首杀与最终击杀，以及画面特效。"
                    TextWrapping="WrapWholeWords" />
            </StackPanel>
            <Button
                x:Name="ResetButton"
                Grid.Column="1"
                Style="{StaticResource FluentSecondaryButtonStyle}"
                VerticalAlignment="Top"
                AutomationProperties.Name="Restore CF defaults"
                Click="OnResetButtonClick">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="12" Glyph="&#xE777;" />
                    <TextBlock x:Name="ResetButtonText" Text="Reset" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Section 1: Visual FX & Badges (Style Panel Host) -->
        <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                <Border Width="3" Height="14" Background="#2E88B8" CornerRadius="1" VerticalAlignment="Center" />
                <TextBlock
                    x:Name="VisualEffectsGroupLabel"
                    FontSize="12"
                    FontWeight="Bold"
                    VerticalAlignment="Center"
                    Text="画面特效与武器徽章" />
            </StackPanel>
            <ContentControl
                x:Name="StylePanelHost"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch" />
            <Border x:Name="VisualEffectsCard" Padding="12" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="VisualEffectsTitle" FontSize="12" FontWeight="SemiBold" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="KillMarkEffectLabel" VerticalAlignment="Center" FontSize="10" TextWrapping="WrapWholeWords" />
                        <ToggleSwitch x:Name="KillMarkEffectToggle" Grid.Column="1" MinWidth="0" Toggled="OnKillMarkEffectToggled" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Section 2: Streak & Assist Trigger -->
        <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                <Border Width="3" Height="14" Background="#F29A17" CornerRadius="1" VerticalAlignment="Center" />
                <TextBlock
                    x:Name="StreakTriggerGroupLabel"
                    FontSize="12"
                    FontWeight="Bold"
                    VerticalAlignment="Center"
                    Text="连杀机制与助攻触发" />
            </StackPanel>
            <Grid RowSpacing="8" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <local:StreakWindowEditor
                    x:Name="StreakEditor"
                    SettingsChanged="OnStreakModeSelectionChanged" />
                <Border Grid.Column="1" Style="{StaticResource CompactChoiceCardStyle}">
                    <StackPanel Spacing="5">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Border Style="{StaticResource CompactCircleIconStyle}">
                                <FontIcon FontSize="11" Foreground="White" Glyph="&#xE8D6;" />
                            </Border>
                            <TextBlock x:Name="AssistAudioLabel" Style="{StaticResource CompactChoiceLabelStyle}" VerticalAlignment="Center" Text="Assist audio" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="AssistAudioToggle"
                            MinWidth="0"
                            IsOn="False"
                            OffContent="Muted (default)"
                            OnContent="Sound (common)"
                            Toggled="OnAssistAudioToggled" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>

        <!-- Section 3: Audio & Icon Priorities -->
        <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                <Border Width="3" Height="14" Background="#E05252" CornerRadius="1" VerticalAlignment="Center" />
                <TextBlock
                    x:Name="PrioritiesGroupLabel"
                    FontSize="12"
                    FontWeight="Bold"
                    VerticalAlignment="Center"
                    Text="爆头、刀杀与雷杀提示优先级" />
            </StackPanel>
            <TextBlock
                x:Name="PrioritiesHintText"
                FontSize="10.5"
                Opacity="0.75"
                TextWrapping="WrapWholeWords"
                Text="2 连杀起比较优先级；单杀仍显示、播放对应击杀提示。声音与图标独立设置。" />
            <Grid RowSpacing="8" ColumnSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CompactChoiceCardStyle}">
                    <StackPanel Spacing="5">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Border Style="{StaticResource CompactCircleIconStyle}">
                                <FontIcon FontSize="11" Foreground="White" Glyph="&#xE8D6;" />
                            </Border>
                            <TextBlock x:Name="HeadshotAudioPriorityLabel" Style="{StaticResource CompactChoiceLabelStyle}" VerticalAlignment="Center" Text="Headshot audio" />
                        </StackPanel>
                        <ComboBox x:Name="HeadshotAudioPrioritySelector" Style="{StaticResource CompactSettingsComboBoxStyle}" SelectionChanged="OnHeadshotAudioPrioritySelectionChanged">
                            <ComboBoxItem x:Name="HeadshotSpecialPriorityItem" Tag="special">Headshot priority</ComboBoxItem>
                            <ComboBoxItem x:Name="HeadshotStreakPriorityItem" Tag="streak">Kill-streak priority</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CompactChoiceCardStyle}">
                    <StackPanel Spacing="5">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Border Style="{StaticResource CompactCircleIconStyle}">
                                <FontIcon FontSize="11" Foreground="White" Glyph="&#xE91F;" />
                            </Border>
                            <TextBlock x:Name="HeadshotIconPriorityLabel" Style="{StaticResource CompactChoiceLabelStyle}" VerticalAlignment="Center" Text="Headshot icon" />
                        </StackPanel>
                        <ComboBox x:Name="HeadshotIconPrioritySelector" Style="{StaticResource CompactSettingsComboBoxStyle}" SelectionChanged="OnHeadshotIconPrioritySelectionChanged">
                            <ComboBoxItem x:Name="HeadshotIconSpecialPriorityItem" Tag="special">Headshot priority</ComboBoxItem>
                            <ComboBoxItem x:Name="HeadshotIconStreakPriorityItem" Tag="streak">Kill-streak priority</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CompactChoiceCardStyle}">
                    <StackPanel Spacing="5">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Border Style="{StaticResource CompactCircleIconStyle}">
                                <FontIcon FontSize="11" Foreground="White" Glyph="&#xE767;" />
                            </Border>
                            <TextBlock x:Name="KnifeAudioPriorityLabel" Style="{StaticResource CompactChoiceLabelStyle}" VerticalAlignment="Center" Text="Knife-kill audio" />
                        </StackPanel>
                        <ComboBox x:Name="KnifeAudioPrioritySelector" Style="{StaticResource CompactSettingsComboBoxStyle}" SelectionChanged="OnKnifeAudioPrioritySelectionChanged">
                            <ComboBoxItem x:Name="KnifeSpecialPriorityItem" Tag="special">Knife-kill priority</ComboBoxItem>
                            <ComboBoxItem x:Name="KnifeStreakPriorityItem" Tag="streak">Kill-streak priority</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CompactChoiceCardStyle}">
                    <StackPanel Spacing="5">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Border Style="{StaticResource CompactCircleIconStyle}">
                                <FontIcon FontSize="11" Foreground="White" Glyph="&#xE7F4;" />
                            </Border>
                            <TextBlock x:Name="KnifeIconPriorityLabel" Style="{StaticResource CompactChoiceLabelStyle}" VerticalAlignment="Center" Text="Knife-kill icon" />
                        </StackPanel>
                        <ComboBox x:Name="KnifeIconPrioritySelector" Style="{StaticResource CompactSettingsComboBoxStyle}" SelectionChanged="OnKnifeIconPrioritySelectionChanged">
                            <ComboBoxItem x:Name="KnifeIconSpecialPriorityItem" Tag="special">Knife-kill priority</ComboBoxItem>
                            <ComboBoxItem x:Name="KnifeIconStreakPriorityItem" Tag="streak">Kill-streak priority</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource CompactChoiceCardStyle}">
                    <StackPanel Spacing="5">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Border Style="{StaticResource CompactCircleIconStyle}">
                                <FontIcon FontSize="11" Foreground="White" Glyph="&#xE767;" />
                            </Border>
                            <TextBlock x:Name="GrenadeAudioPriorityLabel" Style="{StaticResource CompactChoiceLabelStyle}" VerticalAlignment="Center" Text="雷杀声音" />
                        </StackPanel>
                        <ComboBox x:Name="GrenadeAudioPrioritySelector" Style="{StaticResource CompactSettingsComboBoxStyle}" SelectionChanged="OnGrenadeAudioPrioritySelectionChanged">
                            <ComboBoxItem x:Name="GrenadeSpecialPriorityItem" Tag="special">Grenade-kill priority</ComboBoxItem>
                            <ComboBoxItem x:Name="GrenadeStreakPriorityItem" Tag="streak">Kill-streak priority</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource CompactChoiceCardStyle}">
                    <StackPanel Spacing="5">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Border Style="{StaticResource CompactCircleIconStyle}">
                                <FontIcon FontSize="11" Foreground="White" Glyph="&#xE7F4;" />
                            </Border>
                            <TextBlock x:Name="GrenadeIconPriorityLabel" Style="{StaticResource CompactChoiceLabelStyle}" VerticalAlignment="Center" Text="雷杀图标" />
                        </StackPanel>
                        <ComboBox x:Name="GrenadeIconPrioritySelector" Style="{StaticResource CompactSettingsComboBoxStyle}" SelectionChanged="OnGrenadeIconPrioritySelectionChanged">
                            <ComboBoxItem x:Name="GrenadeIconSpecialPriorityItem" Tag="special">Grenade-kill priority</ComboBoxItem>
                            <ComboBoxItem x:Name="GrenadeIconStreakPriorityItem" Tag="streak">Kill-streak priority</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>

        <!-- Section 4: Special & First/Last Kills -->
        <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                <Border Width="3" Height="14" Background="#1F2937" CornerRadius="1" VerticalAlignment="Center" />
                <TextBlock
                    x:Name="SpecialKillsGroupLabel"
                    FontSize="12"
                    FontWeight="Bold"
                    VerticalAlignment="Center"
                    Text="首杀与最终击杀" />
            </StackPanel>
            <Grid RowSpacing="8" ColumnSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CompactChoiceCardStyle}">
                    <StackPanel Spacing="5">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Border Style="{StaticResource CompactCircleIconStyle}">
                                <FontIcon FontSize="11" Foreground="White" Glyph="&#xE8D6;" />
                            </Border>
                            <TextBlock x:Name="FirstKillAudioLabel" Style="{StaticResource CompactChoiceLabelStyle}" VerticalAlignment="Center" Text="First-kill audio" />
                        </StackPanel>
                        <ComboBox x:Name="FirstKillAudioSelector" Style="{StaticResource CompactSettingsComboBoxStyle}" SelectionChanged="OnFirstKillAudioSelectionChanged">
                            <ComboBoxItem x:Name="FirstKillSpecialItem" Tag="special">Special audio</ComboBoxItem>
                            <ComboBoxItem x:Name="FirstKillOriginalItem" Tag="original">Original kill audio</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CompactChoiceCardStyle}">
                    <StackPanel Spacing="5">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Border Style="{StaticResource CompactCircleIconStyle}">
                                <FontIcon FontSize="11" Foreground="White" Glyph="&#xE945;" />
                            </Border>
                            <TextBlock x:Name="FirstKillEffectLabel" Style="{StaticResource CompactChoiceLabelStyle}" VerticalAlignment="Center" Text="First-kill effect" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="FirstKillEffectToggle"
                            MinWidth="0"
                            IsOn="True"
                            OffContent="Off"
                            OnContent="On (default)"
                            Toggled="OnFirstKillEffectToggled" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CompactChoiceCardStyle}">
                    <StackPanel Spacing="5">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Border Style="{StaticResource CompactCircleIconStyle}">
                                <FontIcon FontSize="11" Foreground="White" Glyph="&#xE8D6;" />
                            </Border>
                            <TextBlock x:Name="LastKillAudioLabel" Style="{StaticResource CompactChoiceLabelStyle}" VerticalAlignment="Center" Text="Last-kill audio" />
                        </StackPanel>
                        <ComboBox x:Name="LastKillAudioSelector" Style="{StaticResource CompactSettingsComboBoxStyle}" SelectionChanged="OnLastKillAudioSelectionChanged">
                            <ComboBoxItem x:Name="LastKillSpecialItem" Tag="special">Special audio</ComboBoxItem>
                            <ComboBoxItem x:Name="LastKillOriginalItem" Tag="original">Original kill audio</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CompactChoiceCardStyle}">
                    <StackPanel Spacing="5">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Border Style="{StaticResource CompactCircleIconStyle}">
                                <FontIcon FontSize="11" Foreground="White" Glyph="&#xE945;" />
                            </Border>
                            <TextBlock x:Name="LastKillEffectLabel" Style="{StaticResource CompactChoiceLabelStyle}" VerticalAlignment="Center" Text="Last-kill effect" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="LastKillEffectToggle"
                            MinWidth="0"
                            IsOn="True"
                            OffContent="Off"
                            OnContent="On (default)"
                            Toggled="OnLastKillEffectToggled" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </StackPanel>
</UserControl>
