<UserControl
    x:Class="KillConfirmGameBar.Controls.Settings.CrossfireAdvancedSettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:gameStyles="using:KillConfirmGameBar.Controls.GameStyles">

    <Border
        x:Name="Card"
        Padding="22"
        Background="#FAFAF7"
        BorderBrush="#E2DDD3"
        BorderThickness="1"
        CornerRadius="24">
        <StackPanel Spacing="10">
            <TextBlock
                x:Name="TitleText"
                FontSize="20"
                FontWeight="Bold"
                Text="CrossFire advanced settings" />
            <TextBlock
                x:Name="BodyText"
                FontSize="13"
                LineHeight="18"
                Text="Choose whether CF streaks last until death or expire after 15 seconds, and whether first/last kills use special or original kill audio."
                TextWrapping="WrapWholeWords" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border x:Name="VoiceTag" Padding="8,4" BorderThickness="1" CornerRadius="12">
                    <TextBlock x:Name="VoiceTagText" FontSize="11" FontWeight="SemiBold" Text="CF voices" />
                </Border>
                <Border x:Name="IconTag" Padding="8,4" BorderThickness="1" CornerRadius="12">
                    <TextBlock x:Name="IconTagText" FontSize="11" FontWeight="SemiBold" Text="CF icons" />
                </Border>
            </StackPanel>

            <Grid Margin="0,8,0,0" RowSpacing="10" ColumnSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <gameStyles:StreakWindowEditor
                    x:Name="StreakEditor"
                    Grid.ColumnSpan="2"
                    SettingsChanged="OnGameplaySettingChanged" />

                <TextBlock x:Name="HeadshotAudioPriorityLabel" Grid.Row="1" VerticalAlignment="Center" Text="Headshot audio" />
                <ComboBox x:Name="HeadshotAudioPrioritySelector" Grid.Row="1" Grid.Column="1" SelectionChanged="OnGameplaySettingChanged">
                    <ComboBoxItem x:Name="HeadshotSpecialPriorityItem" Tag="special">Headshot priority</ComboBoxItem>
                    <ComboBoxItem x:Name="HeadshotStreakPriorityItem" Tag="streak">Kill-streak priority</ComboBoxItem>
                </ComboBox>

                <TextBlock x:Name="KnifeAudioPriorityLabel" Grid.Row="2" VerticalAlignment="Center" Text="Knife-kill audio" />
                <ComboBox x:Name="KnifeAudioPrioritySelector" Grid.Row="2" Grid.Column="1" SelectionChanged="OnGameplaySettingChanged">
                    <ComboBoxItem x:Name="KnifeSpecialPriorityItem" Tag="special">Knife-kill priority</ComboBoxItem>
                    <ComboBoxItem x:Name="KnifeStreakPriorityItem" Tag="streak">Kill-streak priority</ComboBoxItem>
                </ComboBox>

                <TextBlock x:Name="HeadshotIconPriorityLabel" Grid.Row="3" VerticalAlignment="Center" Text="Headshot icon" />
                <ComboBox x:Name="HeadshotIconPrioritySelector" Grid.Row="3" Grid.Column="1" SelectionChanged="OnGameplaySettingChanged">
                    <ComboBoxItem x:Name="HeadshotIconSpecialPriorityItem" Tag="special">Headshot priority</ComboBoxItem>
                    <ComboBoxItem x:Name="HeadshotIconStreakPriorityItem" Tag="streak">Kill-streak priority</ComboBoxItem>
                </ComboBox>

                <TextBlock x:Name="KnifeIconPriorityLabel" Grid.Row="4" VerticalAlignment="Center" Text="Knife-kill icon" />
                <ComboBox x:Name="KnifeIconPrioritySelector" Grid.Row="4" Grid.Column="1" SelectionChanged="OnGameplaySettingChanged">
                    <ComboBoxItem x:Name="KnifeIconSpecialPriorityItem" Tag="special">Knife-kill priority</ComboBoxItem>
                    <ComboBoxItem x:Name="KnifeIconStreakPriorityItem" Tag="streak">Kill-streak priority</ComboBoxItem>
                </ComboBox>

                <TextBlock x:Name="FirstKillAudioLabel" Grid.Row="5" VerticalAlignment="Center" Text="First-kill audio" />
                <ComboBox x:Name="FirstKillAudioSelector" Grid.Row="5" Grid.Column="1" SelectionChanged="OnGameplaySettingChanged">
                    <ComboBoxItem x:Name="FirstKillSpecialItem" Tag="special">Special audio</ComboBoxItem>
                    <ComboBoxItem x:Name="FirstKillOriginalItem" Tag="original">Original kill audio</ComboBoxItem>
                </ComboBox>

                <TextBlock x:Name="LastKillAudioLabel" Grid.Row="6" VerticalAlignment="Center" Text="Last-kill audio" />
                <ComboBox x:Name="LastKillAudioSelector" Grid.Row="6" Grid.Column="1" SelectionChanged="OnGameplaySettingChanged">
                    <ComboBoxItem x:Name="LastKillSpecialItem" Tag="special">Special audio</ComboBoxItem>
                    <ComboBoxItem x:Name="LastKillOriginalItem" Tag="original">Original kill audio</ComboBoxItem>
                </ComboBox>

                <TextBlock x:Name="FirstKillEffectLabel" Grid.Row="7" VerticalAlignment="Center" Text="First-kill effect" />
                <ToggleSwitch x:Name="FirstKillEffectToggle" Grid.Row="7" Grid.Column="1" IsOn="True" OffContent="Off" OnContent="On (default)" Toggled="OnGameplaySettingChanged" />

                <TextBlock x:Name="LastKillEffectLabel" Grid.Row="8" VerticalAlignment="Center" Text="Last-kill effect" />
                <ToggleSwitch x:Name="LastKillEffectToggle" Grid.Row="8" Grid.Column="1" IsOn="True" OffContent="Off" OnContent="On (default)" Toggled="OnGameplaySettingChanged" />

                <TextBlock x:Name="AssistAudioLabel" Grid.Row="9" VerticalAlignment="Center" Text="Assist audio" />
                <ToggleSwitch
                    x:Name="AssistAudioToggle"
                    Grid.Row="9"
                    Grid.Column="1"
                    IsOn="False"
                    OffContent="Muted (default)"
                    OnContent="Sound (common)"
                    Toggled="OnGameplaySettingChanged" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
