<UserControl
    x:Class="KillConfirmGameBar.Features.CompatibilityDisplay.Controls.GameStyles.Rdr2AdvancedEffectsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KillConfirmGameBar.Features.CompatibilityDisplay.Controls.GameStyles"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignWidth="320"
    d:DesignHeight="320">

    <StackPanel Spacing="10">
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Border Width="22" Height="22" CornerRadius="6" Background="#E6FFFFFF" Padding="2">
                    <Image x:Name="CombatGameLogo" Source="ms-appx:///Assets/GameLogos/rdr2.png" Stretch="Uniform" />
                </Border>
                <TextBlock x:Name="TitleText"
                           VerticalAlignment="Center"
                           Foreground="#1C1C1E"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button x:Name="ResetButton"
                    Grid.Column="1"
                    Height="26"
                    Padding="9,0"
                    Background="#FCE2E4"
                    BorderBrush="#E2C6C2"
                    BorderThickness="1"
                    CornerRadius="7"
                    Foreground="#981018"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Click="OnResetClick" />
        </Grid>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="MoneyRewardCard"
                    Background="#FFFFFF"
                    BorderBrush="#DCE3EE"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="10,8">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="MoneyRewardModeLabel"
                               Foreground="#5F6B7A"
                               FontSize="11"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <ComboBox x:Name="MoneyRewardModeSelector"
                              Height="30"
                              HorizontalAlignment="Stretch"
                              Background="#F5F7FB"
                              Foreground="#1C1C1E"
                              BorderBrush="#D5DCE7"
                              BorderThickness="1"
                              CornerRadius="8"
                              FontSize="11.5"
                              Padding="8,2"
                              SelectionChanged="OnMoneyRewardModeSelectionChanged">
                        <ComboBoxItem x:Name="MoneyDeltaModeItem" Tag="delta" />
                        <ComboBoxItem x:Name="MoneyRuleModeItem" Tag="rules" />
                    </ComboBox>
                </StackPanel>
            </Border>

            <local:StreakWindowEditor x:Name="StreakEditor" Grid.Column="1" />
        </Grid>

        <Border x:Name="Rdr2HudOptionsCard"
                Background="#FFFFFF"
                BorderBrush="#DCE3EE"
                BorderThickness="1"
                CornerRadius="10"
                Padding="10,8">
            <StackPanel Spacing="8">
                <TextBlock x:Name="HudOptionsTitleText"
                           Foreground="#5F6B7A"
                           FontSize="11"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <Grid ColumnSpacing="8" RowSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="HudLanguageLabel"
                                   Foreground="#5F6B7A"
                                   FontSize="10.5"
                                   TextTrimming="CharacterEllipsis" />
                        <ComboBox x:Name="HudLanguageSelector"
                                  Height="30"
                                  HorizontalAlignment="Stretch"
                                  Background="#F5F7FB"
                                  Foreground="#1C1C1E"
                                  BorderBrush="#D5DCE7"
                                  BorderThickness="1"
                                  CornerRadius="8"
                                  FontSize="11.5"
                                  Padding="8,2"
                                  SelectionChanged="OnHudComboSelectionChanged">
                            <ComboBoxItem x:Name="HudLangAutoItem" Tag="auto" />
                            <ComboBoxItem x:Name="HudLangZhCnItem" Tag="zh-CN" />
                            <ComboBoxItem x:Name="HudLangEnItem" Tag="en" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock x:Name="HonorModeLabel"
                                   Foreground="#5F6B7A"
                                   FontSize="10.5"
                                   TextTrimming="CharacterEllipsis" />
                        <ComboBox x:Name="HonorModeSelector"
                                  Height="30"
                                  HorizontalAlignment="Stretch"
                                  Background="#F5F7FB"
                                  Foreground="#1C1C1E"
                                  BorderBrush="#D5DCE7"
                                  BorderThickness="1"
                                  CornerRadius="8"
                                  FontSize="11.5"
                                  Padding="8,2"
                                  SelectionChanged="OnHudComboSelectionChanged">
                            <ComboBoxItem x:Name="HonorDynamicItem" Tag="dynamic" />
                            <ComboBoxItem x:Name="HonorHighItem" Tag="high_honor" />
                            <ComboBoxItem x:Name="HonorLowItem" Tag="low_honor" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Spacing="4">
                        <TextBlock x:Name="ReticleStyleLabel"
                                   Foreground="#5F6B7A"
                                   FontSize="10.5"
                                   TextTrimming="CharacterEllipsis" />
                        <ComboBox x:Name="ReticleStyleSelector"
                                  Height="30"
                                  HorizontalAlignment="Stretch"
                                  Background="#F5F7FB"
                                  Foreground="#1C1C1E"
                                  BorderBrush="#D5DCE7"
                                  BorderThickness="1"
                                  CornerRadius="8"
                                  FontSize="11.5"
                                  Padding="8,2"
                                  SelectionChanged="OnHudComboSelectionChanged">
                            <ComboBoxItem x:Name="ReticleScaleformItem" Tag="scaleform" />
                            <ComboBoxItem x:Name="ReticleDeadEyeItem" Tag="deadeye" />
                            <ComboBoxItem x:Name="ReticleMinimalItem" Tag="minimal" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                        <TextBlock x:Name="BountyModeLabel"
                                   Foreground="#5F6B7A"
                                   FontSize="10.5"
                                   TextTrimming="CharacterEllipsis" />
                        <ComboBox x:Name="BountyModeSelector"
                                  Height="30"
                                  HorizontalAlignment="Stretch"
                                  Background="#F5F7FB"
                                  Foreground="#1C1C1E"
                                  BorderBrush="#D5DCE7"
                                  BorderThickness="1"
                                  CornerRadius="8"
                                  FontSize="11.5"
                                  Padding="8,2"
                                  SelectionChanged="OnHudComboSelectionChanged">
                            <ComboBoxItem x:Name="BountyXpItem" Tag="xp" />
                            <ComboBoxItem x:Name="BountyCashItem" Tag="cash" />
                            <ComboBoxItem x:Name="BountyOffItem" Tag="off" />
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <Grid ColumnSpacing="10" RowSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <CheckBox x:Name="AccuracyCircleToggle"
                              MinWidth="0"
                              FontSize="11.5"
                              Foreground="#1C1C1E"
                              Checked="OnHudOptionToggled"
                              Unchecked="OnHudOptionToggled" />
                    <CheckBox x:Name="HonorPopupToggle"
                              Grid.Column="1"
                              MinWidth="0"
                              FontSize="11.5"
                              Foreground="#1C1C1E"
                              Checked="OnHudOptionToggled"
                              Unchecked="OnHudOptionToggled" />
                    <CheckBox x:Name="LowerCaptionToggle"
                              Grid.Row="1"
                              MinWidth="0"
                              FontSize="11.5"
                              Foreground="#1C1C1E"
                              Checked="OnHudOptionToggled"
                              Unchecked="OnHudOptionToggled" />
                    <CheckBox x:Name="AssistAudioToggle"
                              Grid.Row="1"
                              Grid.Column="1"
                              MinWidth="0"
                              FontSize="11.5"
                              Foreground="#1C1C1E"
                              Checked="OnAssistAudioChanged"
                              Unchecked="OnAssistAudioChanged" />
                </Grid>
            </StackPanel>
        </Border>

        <Border x:Name="VisualEffectsCard"
                Background="#FFFFFF"
                BorderBrush="#DCE3EE"
                BorderThickness="1"
                CornerRadius="10"
                Padding="10,8">
            <StackPanel Spacing="6">
                <TextBlock x:Name="VisualEffectsTitleText"
                           Foreground="#5F6B7A"
                           FontSize="11"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="UpperToggle"
                              MinWidth="0"
                              FontSize="11.5"
                              Foreground="#1C1C1E"
                              Checked="OnLayerVisibilityChanged"
                              Unchecked="OnLayerVisibilityChanged" />
                    <CheckBox x:Name="CrosshairToggle"
                              Grid.Column="1"
                              MinWidth="0"
                              FontSize="11.5"
                              Foreground="#1C1C1E"
                              Checked="OnLayerVisibilityChanged"
                              Unchecked="OnLayerVisibilityChanged" />
                    <CheckBox x:Name="LowerToggle"
                              Grid.Column="2"
                              MinWidth="0"
                              FontSize="11.5"
                              Foreground="#1C1C1E"
                              Checked="OnLayerVisibilityChanged"
                              Unchecked="OnLayerVisibilityChanged" />
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
