<UserControl
    x:Class="KillConfirmGameBar.Controls.Settings.Battlefield4AdvancedSettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        x:Name="Card"
        Padding="22"
        Background="#14273A"
        BorderBrush="#4D9ED6"
        BorderThickness="1"
        CornerRadius="24">
        <StackPanel Spacing="10">
            <TextBlock
                x:Name="TitleText"
                FontSize="20"
                FontWeight="Bold"
                Text="Battlefield 4 advanced settings" />
            <TextBlock
                x:Name="BodyText"
                FontSize="13"
                LineHeight="18"
                Visibility="Collapsed"
                TextWrapping="WrapWholeWords" />

        </StackPanel>
    </Border>
</UserControl>
