<UserControl
    x:Class="KillConfirmGameBar.Controls.Settings.DisplayScalingSettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- Fluent 2 Palette -->
        <SolidColorBrush x:Key="FluentCardBackground" Color="#FFFFFF" />
        <SolidColorBrush x:Key="FluentCardBorder" Color="#E5E5E5" />
        <SolidColorBrush x:Key="FluentTitleText" Color="#1B1B1B" />
        <SolidColorBrush x:Key="FluentBodyText" Color="#424242" />
        <SolidColorBrush x:Key="FluentMutedText" Color="#6E6E6E" />
        <SolidColorBrush x:Key="FluentAccent" Color="#0067C0" />

        <!-- Fluent 2 Setting Card Style -->
        <Style x:Key="FluentCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Background" Value="{StaticResource FluentCardBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource FluentCardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <!-- Fluent 2 Icon Box -->
        <Style x:Key="FluentIconStyle" TargetType="Border">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="#F3F3F3" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Fluent 2 Typography -->
        <Style x:Key="FluentCardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource FluentTitleText}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="FluentCardHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource FluentMutedText}" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
            <Setter Property="LineHeight" Value="15" />
        </Style>

        <!-- Fluent 2 ComboBox -->
        <Style x:Key="FluentComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="180" />
            <Setter Property="Padding" Value="10,0,24,0" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource FluentTitleText}" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D1D1D1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Backward Compatibility Aliases -->
        <Style x:Key="CompactChoiceCardStyle" TargetType="Border" BasedOn="{StaticResource FluentCardStyle}" />
        <Style x:Key="CompactCircleIconStyle" TargetType="Border" BasedOn="{StaticResource FluentIconStyle}" />
        <Style x:Key="CompactChoiceLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource FluentCardTitle}" />
        <Style x:Key="CompactSettingsComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource FluentComboBoxStyle}" />
    </UserControl.Resources>

    <!-- Display Scaling SettingsCard -->
    <Border Style="{StaticResource FluentCardStyle}">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource FluentIconStyle}">
                <FontIcon
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="14"
                    Foreground="{StaticResource FluentBodyText}"
                    Glyph="&#xE7F4;" />
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock
                    x:Name="ScaleLabelText"
                    Style="{StaticResource FluentCardTitle}"
                    Text="Game Bar 控制面板缩放" />
                <TextBlock
                    x:Name="ScaleHintText"
                    Style="{StaticResource FluentCardHint}" />
            </StackPanel>

            <ComboBox
                x:Name="ScaleSelector"
                Grid.Column="2"
                Style="{StaticResource FluentComboBoxStyle}"
                SelectionChanged="OnScaleSelectionChanged">
                <ComboBoxItem Tag="100">100% (默认)</ComboBoxItem>
                <ComboBoxItem Tag="125">125%</ComboBoxItem>
                <ComboBoxItem Tag="150">150%</ComboBoxItem>
                <ComboBoxItem Tag="175">175%</ComboBoxItem>
                <ComboBoxItem Tag="200">200%</ComboBoxItem>
                <ComboBoxItem Tag="225">225%</ComboBoxItem>
                <ComboBoxItem Tag="250">250%</ComboBoxItem>
                <ComboBoxItem Tag="275">275%</ComboBoxItem>
                <ComboBoxItem Tag="300">300%</ComboBoxItem>
            </ComboBox>
        </Grid>
    </Border>
</UserControl>
