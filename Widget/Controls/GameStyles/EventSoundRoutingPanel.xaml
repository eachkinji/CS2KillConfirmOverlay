<UserControl
    x:Class="KillConfirmGameBar.Controls.GameStyles.EventSoundRoutingPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///KillConfirmWidgetPage.Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Spacing="10">
        <StackPanel Spacing="3">
            <TextBlock
                x:Name="TitleText"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="{StaticResource FluentTitleText}"
                Text="事件音效路由" />
            <TextBlock
                x:Name="HintText"
                FontSize="12"
                Foreground="{StaticResource FluentMutedText}"
                Text="可保持默认音效、复用普通击杀音效或为每种事件指定独立自定义音频文件。"
                TextWrapping="WrapWholeWords" />
        </StackPanel>

        <Grid ColumnSpacing="10" RowSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource CompactChoiceCardStyle}">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="NormalLabel" Style="{StaticResource CompactChoiceLabelStyle}" Text="普通击杀 (Normal Kill)" />
                    <ComboBox x:Name="NormalSelector" Tag="normal" SelectedIndex="0" Style="{StaticResource CompactSettingsComboBoxStyle}" SelectionChanged="OnRouteSelectionChanged">
                        <ComboBoxItem Tag="default">内置默认音效</ComboBoxItem>
                        <ComboBoxItem Tag="common">复用普通击杀音效</ComboBoxItem>
                        <ComboBoxItem Tag="custom">自定义本地音频</ComboBoxItem>
                    </ComboBox>
                    <StackPanel x:Name="NormalCustomPanel" Visibility="Collapsed" Spacing="4">
                        <Button x:Name="NormalPickButton" Tag="normal" Style="{StaticResource FluentSecondaryButtonStyle}" HorizontalAlignment="Stretch" Click="OnPickCustomSoundClick" Content="选择音频文件" />
                        <TextBlock x:Name="NormalFileText" FontSize="11" Foreground="{StaticResource FluentMutedText}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CompactChoiceCardStyle}">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="HeadshotLabel" Style="{StaticResource CompactChoiceLabelStyle}" Text="爆头击杀 (Headshot)" />
                    <ComboBox x:Name="HeadshotSelector" Tag="headshot" SelectedIndex="0" Style="{StaticResource CompactSettingsComboBoxStyle}" SelectionChanged="OnRouteSelectionChanged">
                        <ComboBoxItem Tag="default">内置默认音效</ComboBoxItem>
                        <ComboBoxItem Tag="common">复用普通击杀音效</ComboBoxItem>
                        <ComboBoxItem Tag="custom">自定义本地音频</ComboBoxItem>
                    </ComboBox>
                    <StackPanel x:Name="HeadshotCustomPanel" Visibility="Collapsed" Spacing="4">
                        <Button x:Name="HeadshotPickButton" Tag="headshot" Style="{StaticResource FluentSecondaryButtonStyle}" HorizontalAlignment="Stretch" Click="OnPickCustomSoundClick" Content="选择音频文件" />
                        <TextBlock x:Name="HeadshotFileText" FontSize="11" Foreground="{StaticResource FluentMutedText}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource CompactChoiceCardStyle}">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="KnifeLabel" Style="{StaticResource CompactChoiceLabelStyle}" Text="近战击杀 (Knife Kill)" />
                    <ComboBox x:Name="KnifeSelector" Tag="knife" SelectedIndex="0" Style="{StaticResource CompactSettingsComboBoxStyle}" SelectionChanged="OnRouteSelectionChanged">
                        <ComboBoxItem Tag="default">内置默认音效</ComboBoxItem>
                        <ComboBoxItem Tag="common">复用普通击杀音效</ComboBoxItem>
                        <ComboBoxItem Tag="custom">自定义本地音频</ComboBoxItem>
                    </ComboBox>
                    <StackPanel x:Name="KnifeCustomPanel" Visibility="Collapsed" Spacing="4">
                        <Button x:Name="KnifePickButton" Tag="knife" Style="{StaticResource FluentSecondaryButtonStyle}" HorizontalAlignment="Stretch" Click="OnPickCustomSoundClick" Content="选择音频文件" />
                        <TextBlock x:Name="KnifeFileText" FontSize="11" Foreground="{StaticResource FluentMutedText}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CompactChoiceCardStyle}">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="AssistLabel" Style="{StaticResource CompactChoiceLabelStyle}" Text="助攻 (Assist)" />
                    <ComboBox x:Name="AssistSelector" Tag="assist" SelectedIndex="0" Style="{StaticResource CompactSettingsComboBoxStyle}" SelectionChanged="OnRouteSelectionChanged">
                        <ComboBoxItem Tag="default">内置默认音效</ComboBoxItem>
                        <ComboBoxItem Tag="common">复用普通击杀音效</ComboBoxItem>
                        <ComboBoxItem Tag="custom">自定义本地音频</ComboBoxItem>
                    </ComboBox>
                    <StackPanel x:Name="AssistCustomPanel" Visibility="Collapsed" Spacing="4">
                        <Button x:Name="AssistPickButton" Tag="assist" Style="{StaticResource FluentSecondaryButtonStyle}" HorizontalAlignment="Stretch" Click="OnPickCustomSoundClick" Content="选择音频文件" />
                        <TextBlock x:Name="AssistFileText" FontSize="11" Foreground="{StaticResource FluentMutedText}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
