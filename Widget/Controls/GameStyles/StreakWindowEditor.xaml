<UserControl
    x:Class="KillConfirmGameBar.Controls.GameStyles.StreakWindowEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Style="{StaticResource CompactChoiceCardStyle}">
        <StackPanel Spacing="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CompactCircleIconStyle}">
                    <FontIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="12"
                        Foreground="White"
                        Glyph="&#xE9D9;" />
                </Border>
                <TextBlock
                    x:Name="StreakModeLabel"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Style="{StaticResource CompactChoiceLabelStyle}"
                    Text="Kill streak" />
            </Grid>
            <ComboBox
                x:Name="StreakModeSelector"
                Style="{StaticResource CompactSettingsComboBoxStyle}"
                SelectionChanged="OnStreakModeSelectionChanged">
                <ComboBoxItem x:Name="StreakLifeItem" Tag="life">Until death</ComboBoxItem>
                <ComboBoxItem x:Name="StreakTimed5Item" Tag="timed_5">5-second window</ComboBoxItem>
                <ComboBoxItem x:Name="StreakTimed10Item" Tag="timed_10">10-second window</ComboBoxItem>
                <ComboBoxItem x:Name="StreakTimed15Item" Tag="timed_15">15-second window</ComboBoxItem>
                <ComboBoxItem x:Name="StreakNoneItem" Tag="none">No streak window</ComboBoxItem>
                <ComboBoxItem x:Name="StreakCustomItem" Tag="custom">Custom window</ComboBoxItem>
                <ComboBoxItem x:Name="StreakLoopItem" Tag="loop">Loop streak window</ComboBoxItem>
            </ComboBox>

            <Grid
                x:Name="CustomSecondsEditor"
                ColumnSpacing="6"
                Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="CustomSecondsBox"
                    Height="28"
                    MaxLength="7"
                    Padding="7,0"
                    FontSize="10"
                    InputScope="Number"
                    LostFocus="OnCustomSecondsLostFocus"
                    PlaceholderText="1.0" />
                <TextBlock
                    x:Name="CustomSecondsHint"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="10"
                    Text="seconds (0.1-300)" />
            </Grid>

            <Grid
                x:Name="LoopKillEditor"
                ColumnSpacing="6"
                Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox
                    x:Name="LoopKillCountSelector"
                    Height="28"
                    MinWidth="90"
                    Style="{StaticResource CompactSettingsComboBoxStyle}"
                    SelectionChanged="OnLoopKillCountSelectionChanged" />
                <TextBlock
                    x:Name="LoopKillCountHint"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="10"
                    Text="then restart at 1" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
