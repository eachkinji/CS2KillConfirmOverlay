<UserControl
    x:Class="KillConfirmGameBar.Controls.GameStyles.DagoujiaoAdvancedEffectsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KillConfirmGameBar.Controls.GameStyles">

    <StackPanel Spacing="10">
        <TextBlock x:Name="TitleText" FontSize="15" FontWeight="Bold" Text="大狗叫高级设置" />
        <TextBlock x:Name="HintText" FontSize="10" TextWrapping="WrapWholeWords"
                   Text="设置 Epic 击杀数、音效优先级、变速缩放以及每一杀的图片。" />

        <local:StreakWindowEditor x:Name="StreakEditor" SettingsChanged="OnStreakSettingChanged" />

        <Grid ColumnSpacing="8" RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="4">
                <TextBlock x:Name="EpicCountLabel" FontSize="11" Text="Epic 击杀数" />
                <ComboBox x:Name="EpicKillCountSelector" SelectionChanged="OnCoreSettingChanged" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock x:Name="PriorityLabel" FontSize="11" Text="音效优先级" />
                <ComboBox x:Name="PrioritySelector" SelectionChanged="OnCoreSettingChanged">
                    <ComboBoxItem x:Name="HeadshotPriorityItem" Tag="headshot">爆头优先</ComboBoxItem>
                    <ComboBoxItem x:Name="StreakPriorityItem" Tag="streak">连杀优先</ComboBoxItem>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Row="1" Spacing="4">
                <TextBlock x:Name="OpacityLabel" FontSize="11" Text="显示透明度：50%" />
                <Slider x:Name="OpacitySlider" Minimum="10" Maximum="100" StepFrequency="5" ValueChanged="OnCoreSettingChanged" />
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                <TextBlock x:Name="InitialScaleLabel" FontSize="11" Text="第一杀缩放：0.50×" />
                <Slider x:Name="InitialScaleSlider" Minimum="10" Maximum="400" StepFrequency="10" ValueChanged="OnCoreSettingChanged" />
            </StackPanel>
            <StackPanel Grid.Row="2" Spacing="4">
                <TextBlock x:Name="ScaleLabel" FontSize="11" Text="Epic 前一杀缩放：2.00×" />
                <Slider x:Name="MaximumScaleSlider" Minimum="10" Maximum="400" StepFrequency="10" ValueChanged="OnCoreSettingChanged" />
            </StackPanel>
        </Grid>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock x:Name="InitialPlaybackSpeedLabel" FontSize="11" Text="第一杀音频速度：0.50×" />
                <Slider x:Name="InitialPlaybackSpeedSlider" Minimum="25" Maximum="400" StepFrequency="5" ValueChanged="OnCoreSettingChanged" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock x:Name="MaximumPlaybackSpeedLabel" FontSize="11" Text="Epic 前一杀音频速度：2.00×" />
                <Slider x:Name="MaximumPlaybackSpeedSlider" Minimum="25" Maximum="400" StepFrequency="5" ValueChanged="OnCoreSettingChanged" />
            </StackPanel>
        </Grid>

        <Border x:Name="EpicNotice" Padding="8" BorderThickness="1" CornerRadius="8">
            <TextBlock x:Name="EpicNoticeText" FontSize="10" TextWrapping="WrapWholeWords"
                       Text="Epic 图固定使用“叫叫叫”；普通连杀语音和图片分别按设定的起止倍率等距变化。" />
        </Border>

        <TextBlock x:Name="AudioTitle" FontSize="12" FontWeight="SemiBold" Text="事件语音" />
        <Grid ColumnSpacing="8" RowSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="88" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="CommonAudioLabel" VerticalAlignment="Center" FontSize="11" Text="普通连杀" />
            <ComboBox x:Name="CommonAudioSelector" Grid.Column="1" MinWidth="180" SelectionChanged="OnCoreSettingChanged" />
            <TextBlock x:Name="EpicAudioLabel" Grid.Row="1" VerticalAlignment="Center" FontSize="11" Text="Epic" />
            <ComboBox x:Name="EpicAudioSelector" Grid.Row="1" Grid.Column="1" MinWidth="180" SelectionChanged="OnCoreSettingChanged" />
            <TextBlock x:Name="HeadshotAudioLabel" Grid.Row="2" VerticalAlignment="Center" FontSize="11" Text="爆头" />
            <ComboBox x:Name="HeadshotAudioSelector" Grid.Row="2" Grid.Column="1" MinWidth="180" SelectionChanged="OnCoreSettingChanged" />
            <Button x:Name="ImportAudioButton" Grid.Column="2" Grid.RowSpan="3" MinWidth="100" VerticalAlignment="Bottom"
                    Click="OnImportAudioClick" Content="导入语音" />
        </Grid>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock x:Name="HeadshotImageLabel" FontSize="11" Text="爆头图片" />
                <ComboBox x:Name="HeadshotImageSelector" MinWidth="180" SelectionChanged="OnCoreSettingChanged" />
            </StackPanel>
            <Button x:Name="ImportImageButton" Grid.Column="1" MinWidth="100" VerticalAlignment="Bottom"
                    Click="OnImportImageClick" Content="导入图片" />
        </Grid>

        <TextBlock x:Name="KillImagesTitle" FontSize="12" FontWeight="SemiBold" Text="逐杀图片" />
        <StackPanel x:Name="KillImageRows" Spacing="6" />
    </StackPanel>
</UserControl>
