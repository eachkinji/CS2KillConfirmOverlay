<UserControl
    x:Class="KillConfirmGameBar.Controls.GameStyles.DagoujiaoAdvancedEffectsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KillConfirmGameBar.Controls.GameStyles">

    <StackPanel Spacing="12">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock x:Name="TitleText" FontSize="15" FontWeight="Bold" Text="大狗叫高级设置" />
                <TextBlock x:Name="HintText" FontSize="10" TextWrapping="WrapWholeWords"
                           Text="设置 Epic 击杀阈值、优先级、变速与缩放曲线。语音与图标包请在上方标签页中管理。" />
            </StackPanel>
            <Button
                x:Name="ResetButton"
                Grid.Column="1"
                MinWidth="88"
                Height="34"
                Padding="14,0"
                VerticalAlignment="Top"
                AutomationProperties.Name="Restore Dagoujiao defaults"
                Click="OnResetButtonClick">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="12" Glyph="&#xE777;" />
                    <TextBlock x:Name="ResetButtonText" Text="Reset" />
                </StackPanel>
            </Button>
        </Grid>

        <local:StreakWindowEditor x:Name="StreakEditor" SettingsChanged="OnStreakSettingChanged" />

        <Grid ColumnSpacing="8" RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="4">
                <TextBlock x:Name="EpicCountLabel" FontSize="11" Text="Epic 击杀数" />
                <ComboBox x:Name="EpicKillCountSelector" SelectionChanged="OnCoreSettingChanged" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock x:Name="PriorityLabel" FontSize="11" Text="音效优先级" />
                <ComboBox x:Name="PrioritySelector" SelectionChanged="OnCoreSettingChanged">
                    <ComboBoxItem x:Name="HeadshotPriorityItem" Tag="headshot">爆头优先</ComboBoxItem>
                    <ComboBoxItem x:Name="StreakPriorityItem" Tag="streak">连杀优先</ComboBoxItem>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Row="1" Spacing="4">
                <TextBlock x:Name="OpacityLabel" FontSize="11" Text="显示透明度：50%" />
                <Slider x:Name="OpacitySlider" Minimum="10" Maximum="100" StepFrequency="5" ValueChanged="OnCoreSettingChanged" />
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                <TextBlock x:Name="InitialScaleLabel" FontSize="11" Text="第一杀缩放：0.50×" />
                <Slider x:Name="InitialScaleSlider" Minimum="10" Maximum="400" StepFrequency="10" ValueChanged="OnCoreSettingChanged" />
            </StackPanel>
            <StackPanel Grid.Row="2" Spacing="4">
                <TextBlock x:Name="ScaleLabel" FontSize="11" Text="Epic 前一杀缩放：2.00×" />
                <Slider x:Name="MaximumScaleSlider" Minimum="10" Maximum="400" StepFrequency="10" ValueChanged="OnCoreSettingChanged" />
            </StackPanel>
        </Grid>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock x:Name="InitialPlaybackSpeedLabel" FontSize="11" Text="第一杀音频速度：0.50×" />
                <Slider x:Name="InitialPlaybackSpeedSlider" Minimum="25" Maximum="400" StepFrequency="5" ValueChanged="OnCoreSettingChanged" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock x:Name="MaximumPlaybackSpeedLabel" FontSize="11" Text="Epic 前一杀音频速度：2.00×" />
                <Slider x:Name="MaximumPlaybackSpeedSlider" Minimum="25" Maximum="400" StepFrequency="5" ValueChanged="OnCoreSettingChanged" />
            </StackPanel>
        </Grid>

        <Border x:Name="EpicNotice" Padding="10" BorderThickness="1" CornerRadius="10">
            <TextBlock x:Name="EpicNoticeText" FontSize="11" TextWrapping="WrapWholeWords"
                       Text="提示：大狗叫语音包（包含普通连杀、爆头与 Epic 叫叫叫）与图标包（包含 16 款大狗表情包与自定义图片）均由上方“语音包库”与“图标包库”统一管理。" />
        </Border>
    </StackPanel>
</UserControl>
