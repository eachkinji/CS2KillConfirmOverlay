<UserControl
    x:Class="KillConfirmGameBar.Controls.GameStyles.Battlefield6StylePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="ms-appx:///Controls/Settings/PanelDesign.xaml" />
        </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border
        x:Name="Card"
        Background="#0B222D"
        BorderBrush="#1EDDDD"
        Visibility="Collapsed" Style="{StaticResource PanelSectionCardStyle}">
        <StackPanel Spacing="3">
            <TextBlock
                x:Name="TitleText"
                Foreground="#ECFFFF"
                Text="Battlefield 6 Panel" Style="{StaticResource PanelTitleTextStyle}" />
            <TextBlock
                x:Name="BodyText"
                Foreground="#B5E2E5"
                Text="6 uses isolated skull assets, kill-feed styling, money rewards, and its own sound pack."
                TextWrapping="WrapWholeWords" Style="{StaticResource PanelCaptionTextStyle}" />
        </StackPanel>
    </Border>
</UserControl>
