                Grid.Column="3"
                Width="96"
                Style="{StaticResource PackAccentComboBoxStyle}"
                MinWidth="96"
                SelectedIndex="0"
                ToolTipService.ToolTip="Select test preset">
                <ComboBoxItem Tag="one">1鏉€</ComboBoxItem>
                <ComboBoxItem Tag="one_hs">1鏉€鐖嗗ご</ComboBoxItem>
                <ComboBoxItem Tag="one_knife">1鏉€鍒€鏉€</ComboBoxItem>
                <ComboBoxItem Tag="one_grenade">1杀雷杀</ComboBoxItem>
                <ComboBoxItem Tag="one_first">1鏉€棣栨潃</ComboBoxItem>
                <ComboBoxItem Tag="one_last">1鏉€灏炬潃</ComboBoxItem>
                <ComboBoxItem Tag="assist">Assist</ComboBoxItem>
                <ComboBoxItem Tag="gold_first">閲戦鏉€</ComboBoxItem>
                <ComboBoxItem Tag="gold_last">閲戝熬鏉€</ComboBoxItem>
                <ComboBoxItem Tag="two">2鏉€</ComboBoxItem>
                <ComboBoxItem Tag="three">3鏉€</ComboBoxItem>
                <ComboBoxItem Tag="four">4鏉€</ComboBoxItem>
                <ComboBoxItem Tag="five">5鏉€</ComboBoxItem>
                <ComboBoxItem Tag="six">6鏉€</ComboBoxItem>
                <ComboBoxItem Tag="seven">7鏉€</ComboBoxItem>
                <ComboBoxItem Tag="eight">8鏉€</ComboBoxItem>
                <ComboBoxItem Tag="nine">9鏉€</ComboBoxItem>
                <ComboBoxItem Tag="badge_first">棣栨潃寰界珷</ComboBoxItem>
                <ComboBoxItem Tag="badge_last">灏炬潃寰界珷</ComboBoxItem>
                <ComboBoxItem Tag="bomb_plant">C4下包</ComboBoxItem>
                <ComboBoxItem Tag="bomb_defuse">C4拆包</ComboBoxItem>
                <ComboBoxItem Tag="hostage_interact">人质接触</ComboBoxItem>
                <ComboBoxItem Tag="hostage_rescue">人质救出</ComboBoxItem>
                <ComboBoxItem Tag="round_win">回合胜利</ComboBoxItem>
                <ComboBoxItem Tag="round_loss">回合失败</ComboBoxItem>
            </ComboBox>

            <Button
                x:Name="SendTestButton" x:FieldModifier="public"
                Grid.Column="4"
                Style="{StaticResource PackImportantIconButtonStyle}"
                Click="OnTestEventClick"
                ToolTipService.ToolTip="Send selected test event">
                <Grid Style="{StaticResource IconHostStyle}">
                    <PathIcon Foreground="#FFFFFF" Style="{StaticResource FluentPathIconStyle}" Data="M15 4.24951C15 3.17089 13.7255 2.59866 12.9195 3.31534L8.42794 7.30861C8.29065 7.43067 8.11333 7.4981 7.92961 7.4981H4.25C3.00736 7.4981 2 8.50546 2 9.7481V14.246C2 15.4886 3.00736 16.496 4.25 16.496H7.92956C8.11329 16.496 8.29063 16.5634 8.42793 16.6855L12.9194 20.6792C13.7255 21.396 15 20.8238 15 19.7451V4.24951ZM9.4246 8.42962L13.5 4.8063V19.1883L9.42465 15.5646C9.01275 15.1983 8.48074 14.996 7.92956 14.996H4.25C3.83579 14.996 3.5 14.6602 3.5 14.246V9.7481C3.5 9.33388 3.83579 8.9981 4.25 8.9981H7.92961C8.48075 8.9981 9.01272 8.79581 9.4246 8.42962ZM18.9916 5.89684C19.3244 5.6503 19.7941 5.72028 20.0407 6.05313C21.2717 7.71521 22 9.77341 22 11.9995C22 14.2256 21.2717 16.2838 20.0407 17.9459C19.7941 18.2788 19.3244 18.3488 18.9916 18.1022C18.6587 17.8557 18.5888 17.386 18.8353 17.0531C19.8815 15.6406 20.5 13.8934 20.5 11.9995C20.5 10.1057 19.8815 8.35848 18.8353 6.94592C18.5888 6.61307 18.6587 6.14338 18.9916 5.89684ZM17.143 8.36884C17.5072 8.17165 17.9624 8.30709 18.1596 8.67135C18.6958 9.66196 19 10.7963 19 11.9995C19 13.2027 18.6958 14.3371 18.1596 15.3277C17.9624 15.6919 17.5072 15.8274 17.143 15.6302C16.7787 15.433 16.6432 14.9778 16.8404 14.6136C17.2609 13.8368 17.5 12.9472 17.5 11.9995C17.5 11.0518 17.2609 10.1622 16.8404 9.38544C16.6432 9.02118 16.7787 8.56603 17.143 8.36884Z" />
