<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Controls/Settings/PanelDesign.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
      Shared design tokens for the panel UI.
      One layer of translucency: page-level cards are frosted white; anything
      inside a card uses a flatter semi-transparent white so the two do not
      stack into grey. Accent blue is reserved for primary actions and links.
    -->
    <!--
      One layer of real backdrop glass for page-level surfaces. Inner sections
      stay on flat translucent white so blur never stacks into grey.
    -->
    <AcrylicBrush
        x:Key="GlassCardBrush"
        TintColor="#FFFFFF"
        TintOpacity="0.44"
        FallbackColor="#F2F3F7" />
    <AcrylicBrush
        x:Key="GlassPanelBrush"
        TintColor="#FFFFFF"
        TintOpacity="0.56"
        FallbackColor="#F6F7FA" />
    <SolidColorBrush x:Key="GlassCardHoverBrush" Color="#D9FFFFFF" />
    <SolidColorBrush x:Key="GlassCardStrokeBrush" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="GlassFieldBrush" Color="#99FFFFFF" />
    <SolidColorBrush x:Key="GlassFieldStrokeBrush" Color="#0F000000" />
    <SolidColorBrush x:Key="GlassSectionBrush" Color="#70FFFFFF" />
    <SolidColorBrush x:Key="GlassTrackBrush" Color="#1F787880" />
    <SolidColorBrush x:Key="GhostButtonBrush" Color="#24787880" />
    <SolidColorBrush x:Key="GhostButtonHoverBrush" Color="#3D787880" />
    <SolidColorBrush x:Key="DividerBrush" Color="#14000000" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource PanelTextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource PanelTextSecondaryColor}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource PanelTextMutedColor}" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource PanelAccentColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1A007AFF" />
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#3D007AFF" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource PanelSuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource PanelWarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource PanelDangerColor}" />

    <SolidColorBrush x:Key="GlassPanelBorderBrush" Color="#D9FFFFFF" />


    <Style x:Key="PanelFontTextStyle" TargetType="TextBlock" BasedOn="{StaticResource PanelBodyTextStyle}" />

    <Style x:Key="SettingsSectionCardStyle" TargetType="Border" BasedOn="{StaticResource PanelCardStyle}" />

    <Style x:Key="SettingsHeaderButtonStyle" TargetType="Button" BasedOn="{StaticResource PanelButtonStyle}" />

    <Style x:Key="SettingsPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PanelPrimaryButtonStyle}" />

    <Style x:Key="SettingsDownloadButtonStyle" TargetType="Button" BasedOn="{StaticResource SettingsPrimaryButtonStyle}">
        <Setter Property="MinHeight" Value="42"/>
        <Setter Property="Padding" Value="20,10"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="ContentTemplate"><Setter.Value><DataTemplate>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE896;" FontSize="16" Foreground="White"/>
                <TextBlock Text="{Binding}" Foreground="White" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate></Setter.Value></Setter>
    </Style>

    <!-- Segmented-control tabs: transparent buttons on a soft grey track. -->
    <Style x:Key="StudioTabButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="MinWidth" Value="100"/>
        <Setter Property="MinHeight" Value="{StaticResource PanelControlHeight}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{StaticResource PanelControlRadius}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="{StaticResource PanelFontBody}"/>
        <Setter Property="FontFamily" Value="{StaticResource PanelFontFamily}"/>
    </Style>

    <Style x:Key="StudioTabActiveButtonStyle" TargetType="Button" BasedOn="{StaticResource StudioTabButtonStyle}">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="SettingsCaptionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource PanelCaptionTextStyle}" />

    <Style x:Key="SettingsSectionTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource PanelSectionTitleTextStyle}" />

    <Style x:Key="MethodStepBodyTextStyle" TargetType="TextBlock" BasedOn="{StaticResource PanelCaptionTextStyle}" />

    <Style x:Key="MethodStepDetailTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource PanelTitleTextStyle}" />

    <Style x:Key="MethodStepMonoTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource PanelFontCaption}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="LineHeight" Value="18" />
    </Style>

    <Style x:Key="MethodInlineButtonStyle" TargetType="Button" BasedOn="{StaticResource PanelCompactButtonStyle}">
        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentBorderBrush}" />
    </Style>

    <!-- Inline field/section surfaces used inside glass cards. -->
    <Style x:Key="GlassSectionSurfaceStyle" TargetType="Border" BasedOn="{StaticResource PanelSectionCardStyle}" />

    <Style x:Key="GlassFieldStyle" TargetType="TextBox" BasedOn="{StaticResource PanelTextBoxStyle}" />

    <Style x:Key="GlassComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource PanelComboBoxStyle}" />
</ResourceDictionary>
