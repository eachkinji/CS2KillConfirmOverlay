<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Controls/Settings/SettingsWorkspace.Styles.xaml" />
        <ResourceDictionary Source="ms-appx:///Pages/KillConfirmWidget/KillConfirmWidgetPage.Styles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Cool light wash; the coloured blobs live in MainPageBackgroundView. -->
    <LinearGradientBrush x:Key="MainBackgroundGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F7F7FA" Offset="0.0" />
        <GradientStop Color="#EDEEF3" Offset="0.55" />
        <GradientStop Color="#E7E8EE" Offset="1.0" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="MainCardBrush" Color="#B8FFFFFF" />
    <SolidColorBrush x:Key="MainCardStrokeBrush" Color="#A6FFFFFF" />
    <SolidColorBrush x:Key="MainNestedSurfaceBrush" Color="#70FFFFFF" />

</ResourceDictionary>
