<UserControl
    x:Class="KillConfirmGameBar.Controls.GameStyles.DoubaoAdvancedEffectsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KillConfirmGameBar.Controls.GameStyles">

    <StackPanel Spacing="10">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock
                    x:Name="TitleText"
                    FontSize="13"
                    FontWeight="Bold"
                    Text="Doubao Effects" />
            </StackPanel>
            <Button
                x:Name="ResetButton"
                Grid.Column="1"
                MinWidth="88"
                Height="34"
                Padding="14,0"
                VerticalAlignment="Top"
                AutomationProperties.Name="Restore Doubao defaults"
                Click="OnResetClick">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="12" Glyph="&#xE777;" />
                    <TextBlock x:Name="ResetButtonText" Text="Reset" />
                </StackPanel>
            </Button>
        </Grid>

        <local:StreakWindowEditor
            x:Name="StreakEditor"
            SettingsChanged="OnStreakModeSelectionChanged" />

        <Border x:Name="VisualEffectsCard" Padding="12" BorderThickness="1" CornerRadius="8">
            <StackPanel Spacing="8">
                <TextBlock x:Name="VisualEffectsTitle" FontSize="12" FontWeight="SemiBold" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="KillMarkEffectLabel" VerticalAlignment="Center" FontSize="10" TextWrapping="WrapWholeWords" />
                    <ToggleSwitch x:Name="KillMarkEffectToggle" Grid.Column="1" MinWidth="0" Toggled="OnKillMarkEffectToggled" />
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
