<UserControl
    x:Class="KillConfirmGameBar.Controls.Settings.CrossfireAdvancedSettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:gameStyles="using:KillConfirmGameBar.Controls.GameStyles">

    <Border
        x:Name="Card"
        Padding="22"
        Background="#FAFAF7"
        BorderBrush="#E2DDD3"
        BorderThickness="1"
        CornerRadius="24">
        <StackPanel Spacing="10">
            <TextBlock
                x:Name="TitleText"
                FontSize="20"
                FontWeight="Bold"
                Text="CrossFire advanced settings" />
            <TextBlock
                x:Name="BodyText"
                FontSize="13"
                LineHeight="18"
                Text="Choose whether CF streaks last until death or expire after 15 seconds, and whether first/last kills use special or original kill audio."
                TextWrapping="WrapWholeWords" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border x:Name="VoiceTag" Padding="8,4" BorderThickness="1" CornerRadius="12">
                    <TextBlock x:Name="VoiceTagText" FontSize="11" FontWeight="SemiBold" Text="CF voices" />
                </Border>
                <Border x:Name="IconTag" Padding="8,4" BorderThickness="1" CornerRadius="12">
                    <TextBlock x:Name="IconTagText" FontSize="11" FontWeight="SemiBold" Text="CF icons" />
                </Border>
            </StackPanel>

            <Grid Margin="0,8,0,0" RowSpacing="8" ColumnSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <gameStyles:StreakWindowEditor
                    x:Name="StreakEditor"
                    SettingsChanged="OnGameplaySettingChanged" />

                <Border Grid.Column="1" Style="{StaticResource CompactChoiceCardStyle}">
                    <StackPanel Spacing="6"><StackPanel Orientation="Horizontal" Spacing="6"><Border Style="{StaticResource CompactCircleIconStyle}"><FontIcon FontSize="13" Foreground="White" Glyph="&#xE8D6;" /></Border><TextBlock x:Name="AssistAudioLabel" Style="{StaticResource CompactChoiceLabelStyle}" VerticalAlignment="Center" Text="Assist audio" /></StackPanel><ToggleSwitch x:Name="AssistAudioToggle" MinWidth="0" IsOn="False" OffContent="Muted (default)" OnContent="Sound (common)" Toggled="OnGameplaySettingChanged" /></StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource CompactChoiceCardStyle}">
                    <StackPanel Spacing="6"><StackPanel Orientation="Horizontal" Spacing="6"><Border Style="{StaticResource CompactCircleIconStyle}"><FontIcon FontSize="13" Foreground="White" Glyph="&#xE8D6;" /></Border><TextBlock x:Name="HeadshotAudioPriorityLabel" Style="{StaticResource CompactChoiceLabelStyle}" VerticalAlignment="Center" Text="Headshot audio" /></StackPanel><ComboBox x:Name="HeadshotAudioPrioritySelector" Style="{StaticResource CompactSettingsComboBoxStyle}" SelectionChanged="OnGameplaySettingChanged"><ComboBoxItem x:Name="HeadshotSpecialPriorityItem" Tag="special">Headshot priority</ComboBoxItem><ComboBoxItem x:Name="HeadshotStreakPriorityItem" Tag="streak">Kill-streak priority</ComboBoxItem></ComboBox></StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CompactChoiceCardStyle}">
                    <StackPanel Spacing="6"><StackPanel Orientation="Horizontal" Spacing="6"><Border Style="{StaticResource CompactCircleIconStyle}"><FontIcon FontSize="13" Foreground="White" Glyph="&#xE767;" /></Border><TextBlock x:Name="KnifeAudioPriorityLabel" Style="{StaticResource CompactChoiceLabelStyle}" VerticalAlignment="Center" Text="Knife-kill audio" /></StackPanel><ComboBox x:Name="KnifeAudioPrioritySelector" Style="{StaticResource CompactSettingsComboBoxStyle}" SelectionChanged="OnGameplaySettingChanged"><ComboBoxItem x:Name="KnifeSpecialPriorityItem" Tag="special">Knife-kill priority</ComboBoxItem><ComboBoxItem x:Name="KnifeStreakPriorityItem" Tag="streak">Kill-streak priority</ComboBoxItem></ComboBox></StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CompactChoiceCardStyle}">
                    <StackPanel Spacing="6"><StackPanel Orientation="Horizontal" Spacing="6"><Border Style="{StaticResource CompactCircleIconStyle}"><FontIcon FontSize="13" Foreground="White" Glyph="&#xE91F;" /></Border><TextBlock x:Name="HeadshotIconPriorityLabel" Style="{StaticResource CompactChoiceLabelStyle}" VerticalAlignment="Center" Text="Headshot icon" /></StackPanel><ComboBox x:Name="HeadshotIconPrioritySelector" Style="{StaticResource CompactSettingsComboBoxStyle}" SelectionChanged="OnGameplaySettingChanged"><ComboBoxItem x:Name="HeadshotIconSpecialPriorityItem" Tag="special">Headshot priority</ComboBoxItem><ComboBoxItem x:Name="HeadshotIconStreakPriorityItem" Tag="streak">Kill-streak priority</ComboBoxItem></ComboBox></StackPanel>
                </Border>
                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource CompactChoiceCardStyle}">
                    <StackPanel Spacing="6"><StackPanel Orientation="Horizontal" Spacing="6"><Border Style="{StaticResource CompactCircleIconStyle}"><FontIcon FontSize="13" Foreground="White" Glyph="&#xE7F4;" /></Border><TextBlock x:Name="KnifeIconPriorityLabel" Style="{StaticResource CompactChoiceLabelStyle}" VerticalAlignment="Center" Text="Knife-kill icon" /></StackPanel><ComboBox x:Name="KnifeIconPrioritySelector" Style="{StaticResource CompactSettingsComboBoxStyle}" SelectionChanged="OnGameplaySettingChanged"><ComboBoxItem x:Name="KnifeIconSpecialPriorityItem" Tag="special">Knife-kill priority</ComboBoxItem><ComboBoxItem x:Name="KnifeIconStreakPriorityItem" Tag="streak">Kill-streak priority</ComboBoxItem></ComboBox></StackPanel>
                </Border>

                <Border Grid.Row="3" Style="{StaticResource CompactChoiceCardStyle}">
                    <StackPanel Spacing="6"><StackPanel Orientation="Horizontal" Spacing="6"><Border Style="{StaticResource CompactCircleIconStyle}"><FontIcon FontSize="13" Foreground="White" Glyph="&#xE8D6;" /></Border><TextBlock x:Name="FirstKillAudioLabel" Style="{StaticResource CompactChoiceLabelStyle}" VerticalAlignment="Center" Text="First-kill audio" /></StackPanel><ComboBox x:Name="FirstKillAudioSelector" Style="{StaticResource CompactSettingsComboBoxStyle}" SelectionChanged="OnGameplaySettingChanged"><ComboBoxItem x:Name="FirstKillSpecialItem" Tag="special">Special audio</ComboBoxItem><ComboBoxItem x:Name="FirstKillOriginalItem" Tag="original">Original kill audio</ComboBoxItem></ComboBox></StackPanel>
                </Border>
                <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource CompactChoiceCardStyle}">
                    <StackPanel Spacing="6"><StackPanel Orientation="Horizontal" Spacing="6"><Border Style="{StaticResource CompactCircleIconStyle}"><FontIcon FontSize="13" Foreground="White" Glyph="&#xE8D6;" /></Border><TextBlock x:Name="LastKillAudioLabel" Style="{StaticResource CompactChoiceLabelStyle}" VerticalAlignment="Center" Text="Last-kill audio" /></StackPanel><ComboBox x:Name="LastKillAudioSelector" Style="{StaticResource CompactSettingsComboBoxStyle}" SelectionChanged="OnGameplaySettingChanged"><ComboBoxItem x:Name="LastKillSpecialItem" Tag="special">Special audio</ComboBoxItem><ComboBoxItem x:Name="LastKillOriginalItem" Tag="original">Original kill audio</ComboBoxItem></ComboBox></StackPanel>
                </Border>

                <Border Grid.Row="4" Style="{StaticResource CompactChoiceCardStyle}">
                    <StackPanel Spacing="6"><StackPanel Orientation="Horizontal" Spacing="6"><Border Style="{StaticResource CompactCircleIconStyle}"><FontIcon FontSize="13" Foreground="White" Glyph="&#xE945;" /></Border><TextBlock x:Name="FirstKillEffectLabel" Style="{StaticResource CompactChoiceLabelStyle}" VerticalAlignment="Center" Text="First-kill effect" /></StackPanel><ToggleSwitch x:Name="FirstKillEffectToggle" MinWidth="0" IsOn="True" OffContent="Off" OnContent="On (default)" Toggled="OnGameplaySettingChanged" /></StackPanel>
                </Border>
                <Border Grid.Row="4" Grid.Column="1" Style="{StaticResource CompactChoiceCardStyle}">
                    <StackPanel Spacing="6"><StackPanel Orientation="Horizontal" Spacing="6"><Border Style="{StaticResource CompactCircleIconStyle}"><FontIcon FontSize="13" Foreground="White" Glyph="&#xE945;" /></Border><TextBlock x:Name="LastKillEffectLabel" Style="{StaticResource CompactChoiceLabelStyle}" VerticalAlignment="Center" Text="Last-kill effect" /></StackPanel><ToggleSwitch x:Name="LastKillEffectToggle" MinWidth="0" IsOn="True" OffContent="Off" OnContent="On (default)" Toggled="OnGameplaySettingChanged" /></StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
