<UserControl
    x:Class="KillConfirmGameBar.Controls.GameStyles.KillFeedbackAppearanceEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KillConfirmGameBar.Controls.GameStyles">

    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="ms-appx:///Controls/Settings/PanelDesign.xaml" />
        </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border
        x:Name="EditorCard" Style="{StaticResource PanelSectionCardStyle}">
        <StackPanel Spacing="8">
            <TextBlock
                x:Name="TitleText" Style="{StaticResource PanelTitleTextStyle}" />
            <TextBlock
                x:Name="HintText"
                TextWrapping="WrapWholeWords" Style="{StaticResource PanelCaptionTextStyle}" />
            <local:KillFeedbackAppearanceRow
                x:Name="CrosshairRow"
                CrosshairOffsetChanged="OnCrosshairOffsetChanged"
                SettingsChanged="OnSettingsChanged" />
            <local:KillFeedbackAppearanceRow x:Name="LowerRow" SettingsChanged="OnSettingsChanged" />
            <local:KillFeedbackAppearanceRow x:Name="UpperRow" SettingsChanged="OnSettingsChanged" />

        </StackPanel>
    </Border>
</UserControl>
