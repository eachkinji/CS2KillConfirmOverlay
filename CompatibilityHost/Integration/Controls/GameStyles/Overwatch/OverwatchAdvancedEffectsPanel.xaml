<UserControl
    x:Class="KillConfirmGameBar.Features.CompatibilityDisplay.Controls.GameStyles.OverwatchAdvancedEffectsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="ms-appx:///Controls/Settings/PanelDesign.xaml" />
        </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Spacing="12">
        <StackPanel Spacing="3">
            <Grid ColumnSpacing="8" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Image x:Name="CombatGameLogo" Width="22" Height="22" VerticalAlignment="Center" Stretch="Uniform" />
                    <TextBlock x:Name="TitleText" Grid.Column="1" VerticalAlignment="Center" TextWrapping="WrapWholeWords" Style="{StaticResource PanelTitleTextStyle}" />
                </Grid>
        </StackPanel>

        <Border x:Name="VisualEffectsCard" Style="{StaticResource PanelSectionCardStyle}">
            <StackPanel Spacing="8">
                <TextBlock
                    x:Name="VisualEffectsTitle"
                    Text="显示哪些击杀提示" Style="{StaticResource PanelTitleTextStyle}" />
                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock
                            x:Name="CrosshairEffectLabel"
                            Text="中央准心提示"
                            TextWrapping="WrapWholeWords" Style="{StaticResource PanelCaptionTextStyle}" />
                        <ToggleSwitch
                            x:Name="CrosshairEffectToggle"
                            Toggled="OnVisualEffectToggled" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock
                            x:Name="LowerEffectLabel"
                            Text="下方击杀卡片"
                            TextWrapping="WrapWholeWords" Style="{StaticResource PanelCaptionTextStyle}" />
                        <ToggleSwitch
                            x:Name="LowerEffectToggle"
                            Toggled="OnVisualEffectToggled" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Border x:Name="CombatAudioCard" Style="{StaticResource PanelSectionCardStyle}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="AssistAudioLabel"
                    VerticalAlignment="Center"
                    Text="助攻语音" Style="{StaticResource PanelCaptionTextStyle}" />
                <ToggleSwitch
                    x:Name="AssistAudioToggle"
                    Grid.Column="1"
                    MinWidth="0"
                    Toggled="OnAssistAudioToggled" />
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
