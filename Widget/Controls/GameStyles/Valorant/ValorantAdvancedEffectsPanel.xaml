<UserControl
    x:Class="KillConfirmGameBar.Controls.GameStyles.ValorantAdvancedEffectsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KillConfirmGameBar.Controls.GameStyles">

    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="ms-appx:///Controls/Settings/PanelDesign.xaml" />
        </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Spacing="10">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock
                    x:Name="TitleText"
                    Text="VAL Effects" Style="{StaticResource PanelSectionTitleTextStyle}" />
                <TextBlock
                    x:Name="HintText"
                    Visibility="Collapsed"
                    TextWrapping="WrapWholeWords" Style="{StaticResource PanelCaptionTextStyle}" />
            </StackPanel>
            <Button
                x:Name="ResetButton"
                Grid.Column="1"
                MinWidth="88"
                VerticalAlignment="Top"
                AutomationProperties.Name="Restore VAL defaults"
                Click="OnResetButtonClick" Style="{StaticResource PanelPrimaryButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="12" Glyph="&#xE777;" />
                    <TextBlock x:Name="ResetButtonText" Text="Reset" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <local:StreakWindowEditor
                x:Name="StreakEditor"
                SettingsChanged="OnStreakModeSelectionChanged" />

            <Border Grid.Column="1" Style="{StaticResource PanelSectionCardStyle}">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Style="{StaticResource PanelAccentIconContainerStyle}"><FontIcon FontSize="13" Foreground="White" Glyph="&#xE8D6;" /></Border>
                        <TextBlock x:Name="AssistAudioLabel" Style="{StaticResource PanelTitleTextStyle}" VerticalAlignment="Center" Text="Assist audio" />
                    </StackPanel>
                    <ToggleSwitch x:Name="AssistAudioToggle" MinWidth="0" IsOn="False" OffContent="Muted (default)" OnContent="Sound (common)" Toggled="OnAssistAudioToggled" />
                </StackPanel>
            </Border>
        </Grid>

        <Border x:Name="VisualEffectsCard" Style="{StaticResource PanelSectionCardStyle}">
            <StackPanel Spacing="8">
                <TextBlock x:Name="VisualEffectsTitle" Style="{StaticResource PanelTitleTextStyle}" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="KillMarkEffectLabel" VerticalAlignment="Center" TextWrapping="WrapWholeWords" Style="{StaticResource PanelCaptionTextStyle}" />
                    <ToggleSwitch x:Name="KillMarkEffectToggle" Grid.Column="1" MinWidth="0" Toggled="OnKillMarkEffectToggled" />
                </Grid>
            </StackPanel>
        </Border>

        <ContentControl x:Name="StylePanelHost" />
    </StackPanel>
</UserControl>
