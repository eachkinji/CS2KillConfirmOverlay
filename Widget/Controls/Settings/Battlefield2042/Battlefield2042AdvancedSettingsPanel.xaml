<UserControl
    x:Class="KillConfirmGameBar.Controls.Settings.Battlefield2042AdvancedSettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="ms-appx:///Controls/Settings/PanelDesign.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border
        x:Name="Card"
        Background="{StaticResource PanelSectionBrush}"
        BorderBrush="{StaticResource PanelBorderBrush}" Style="{StaticResource PanelSectionCardStyle}">
        <StackPanel Spacing="14">
            <StackPanel Spacing="4">
                <TextBlock
                    x:Name="TitleText"
                    Foreground="{StaticResource PanelTextPrimaryBrush}"
                    Text="Battlefield 2042 战斗设置" Style="{StaticResource PanelSectionTitleTextStyle}" />
                <TextBlock
                    x:Name="BodyText"
                    LineHeight="16"
                    Foreground="{StaticResource PanelTextMutedBrush}"
                    Visibility="Collapsed"
                    TextWrapping="WrapWholeWords" Style="{StaticResource PanelCaptionTextStyle}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
