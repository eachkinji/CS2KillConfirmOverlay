<UserControl
    x:Class="KillConfirmGameBar.Controls.Settings.BombAudioOptionsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- Fluent 2 Palette -->
        <SolidColorBrush x:Key="FluentCardBackground" Color="#FFFFFF" />
        <SolidColorBrush x:Key="FluentCardSubBackground" Color="#FBFBFB" />
        <SolidColorBrush x:Key="FluentCardBorder" Color="#E5E5E5" />
        <SolidColorBrush x:Key="FluentDivider" Color="#F0F0F0" />
        <SolidColorBrush x:Key="FluentTitleText" Color="#1B1B1B" />
        <SolidColorBrush x:Key="FluentBodyText" Color="#424242" />
        <SolidColorBrush x:Key="FluentMutedText" Color="#6E6E6E" />
        <SolidColorBrush x:Key="FluentAccent" Color="#0067C0" />
        <SolidColorBrush x:Key="FluentAccentLight" Color="#EBF3FC" />

        <!-- Fluent 2 Setting Card Style -->
        <Style x:Key="FluentCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Background" Value="{StaticResource FluentCardBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource FluentCardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <!-- Fluent 2 Icon Box -->
        <Style x:Key="FluentIconStyle" TargetType="Border">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="#F3F3F3" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Fluent 2 Typography -->
        <Style x:Key="FluentCardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource FluentTitleText}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="FluentCardHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource FluentMutedText}" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
            <Setter Property="LineHeight" Value="15" />
        </Style>

        <!-- Fluent 2 ComboBox -->
        <Style x:Key="FluentComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="160" />
            <Setter Property="Padding" Value="10,0,24,0" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource FluentTitleText}" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D1D1D1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Fluent 2 Secondary Action Button -->
        <Style x:Key="FluentActionBtnStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="MinWidth" Value="60" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D1D1D1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Foreground" Value="{StaticResource FluentTitleText}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <!-- Backward Compatibility Aliases -->
        <Style x:Key="CompactChoiceCardStyle" TargetType="Border" BasedOn="{StaticResource FluentCardStyle}" />
        <Style x:Key="CompactCircleIconStyle" TargetType="Border" BasedOn="{StaticResource FluentIconStyle}" />
        <Style x:Key="CompactChoiceLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource FluentCardTitle}" />
        <Style x:Key="CompactSettingsComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource FluentComboBoxStyle}" />
    </UserControl.Resources>

        <!-- 6. Bomb Audio Settings Card (Expander Structure) -->
        <Border Style="{StaticResource FluentCardStyle}">
            <StackPanel Spacing="10">
                <!-- Master Toggle Header -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource FluentIconStyle}">
                        <FontIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="14"
                            Foreground="{StaticResource FluentBodyText}"
                            Glyph="&#xE7E7;" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock
                            x:Name="BombAudioLabelText"
                            Style="{StaticResource FluentCardTitle}"
                            Text="C4 炸弹倒计时与音效" />
                        <TextBlock
                            x:Name="BombAudioHintText"
                            Style="{StaticResource FluentCardHint}"
                            Text="在 C4 下包后播报倒计时滴答声、爆炸与拆除提示音" />
                    </StackPanel>

                    <ToggleSwitch
                        x:Name="BombAudioToggle"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        MinWidth="0"
                        OffContent="关"
                        OnContent="开"
                        Toggled="OnBombAudioToggled" />
                </Grid>

                <!-- Detailed Parameters & Sound Importer -->
                <Border
                    Background="{StaticResource FluentCardSubBackground}"
                    BorderBrush="{StaticResource FluentDivider}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,12">
                    <StackPanel Spacing="12">
                        <!-- Volume & Speed Controls -->
                        <Grid ColumnSpacing="16" RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Volume Slider -->
                            <StackPanel Grid.ColumnSpan="2" Spacing="3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Name="BombAudioVolumeLabelText"
                                        Style="{StaticResource FluentCardTitle}"
                                        FontSize="12"
                                        Text="炸弹音效音量" />
                                    <TextBlock
                                        x:Name="BombAudioVolumeValueText"
                                        Grid.Column="1"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource FluentAccent}"
                                        Text="50%" />
                                </Grid>
                                <Slider
                                    x:Name="BombAudioVolumeSlider"
                                    Minimum="0"
                                    Maximum="100"
                                    StepFrequency="5"
                                    ValueChanged="OnBombAudioVolumeChanged" />
                            </StackPanel>

                            <!-- Initial Speed Slider -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Name="BombAudioInitialSpeedLabelText"
                                        FontSize="11"
                                        Foreground="{StaticResource FluentTitleText}"
                                        Text="初始倒计时速率" />
                                    <TextBlock
                                        x:Name="BombAudioInitialSpeedValueText"
                                        Grid.Column="1"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource FluentAccent}"
                                        Text="0.50×" />
                                </Grid>
                                <Slider
                                    x:Name="BombAudioInitialSpeedSlider"
                                    Minimum="25"
                                    Maximum="400"
                                    StepFrequency="5"
                                    ValueChanged="OnBombAudioSpeedChanged" />
                            </StackPanel>

                            <!-- Final Speed Slider -->
                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Name="BombAudioFinalSpeedLabelText"
                                        FontSize="11"
                                        Foreground="{StaticResource FluentTitleText}"
                                        Text="临近爆炸速率" />
                                    <TextBlock
                                        x:Name="BombAudioFinalSpeedValueText"
                                        Grid.Column="1"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource FluentAccent}"
                                        Text="1.50×" />
                                </Grid>
                                <Slider
                                    x:Name="BombAudioFinalSpeedSlider"
                                    Minimum="25"
                                    Maximum="400"
                                    StepFrequency="5"
                                    ValueChanged="OnBombAudioSpeedChanged" />
                            </StackPanel>
                        </Grid>

                        <!-- Hidden label for localization binding -->
                        <TextBlock x:Name="BombAudioSpeedLabelText" Visibility="Collapsed" />

                        <Rectangle Height="1" Fill="{StaticResource FluentDivider}" />

                        <!-- Custom Sounds Rows -->
                        <StackPanel Spacing="8">
                            <TextBlock
                                x:Name="BombAudioCustomLabelText"
                                Style="{StaticResource FluentCardTitle}"
                                FontSize="12"
                                Text="自定义炸弹音效文件" />

                            <Grid ColumnSpacing="8" RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Timer Sound -->
                                <StackPanel Grid.Row="0" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock x:Name="BombTimerAudioLabelText" FontSize="12" FontWeight="SemiBold" Text="倒计时滴答声 (Timer)" />
                                    <TextBlock x:Name="BombTimerAudioStatusText" FontSize="11" Foreground="{StaticResource FluentMutedText}" Text="内置默认" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                    <Button
                                        x:Name="BombTimerAudioPreviewButton"
                                        Style="{StaticResource FluentActionBtnStyle}"
                                        MinWidth="28"
                                        Padding="6,4"
                                        Click="OnBombAudioPreviewClick"
                                        Tag="timer">
                                        <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="11" Glyph="&#xE768;" />
                                    </Button>
                                    <Button
                                        x:Name="BombTimerAudioImportButton"
                                        Style="{StaticResource FluentActionBtnStyle}"
                                        Click="OnBombAudioImportClick"
                                        Tag="timer">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="11" Glyph="&#xE8B5;" />
                                            <TextBlock x:Name="BombTimerAudioImportButtonText" Text="导入" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        x:Name="BombTimerAudioClearButton"
                                        Style="{StaticResource FluentActionBtnStyle}"
                                        MinWidth="28"
                                        Padding="6,4"
                                        Click="OnBombAudioClearClick"
                                        Tag="timer"
                                        ToolTipService.ToolTip="恢复为内置默认"
                                        Visibility="Collapsed">
                                        <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="10" Glyph="&#xE894;" />
                                    </Button>
                                </StackPanel>

                                <!-- Exploded Sound -->
                                <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock x:Name="BombExplodedAudioLabelText" FontSize="12" FontWeight="SemiBold" Text="爆炸提示音 (Explosion)" />
                                    <TextBlock x:Name="BombExplodedAudioStatusText" FontSize="11" Foreground="{StaticResource FluentMutedText}" Text="内置默认" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                    <Button
                                        x:Name="BombExplodedAudioPreviewButton"
                                        Style="{StaticResource FluentActionBtnStyle}"
                                        MinWidth="28"
                                        Padding="6,4"
                                        Click="OnBombAudioPreviewClick"
                                        Tag="exploded">
                                        <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="11" Glyph="&#xE768;" />
                                    </Button>
                                    <Button
                                        x:Name="BombExplodedAudioImportButton"
                                        Style="{StaticResource FluentActionBtnStyle}"
                                        Click="OnBombAudioImportClick"
                                        Tag="exploded">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="11" Glyph="&#xE8B5;" />
                                            <TextBlock x:Name="BombExplodedAudioImportButtonText" Text="导入" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        x:Name="BombExplodedAudioClearButton"
                                        Style="{StaticResource FluentActionBtnStyle}"
                                        MinWidth="28"
                                        Padding="6,4"
                                        Click="OnBombAudioClearClick"
                                        Tag="exploded"
                                        ToolTipService.ToolTip="恢复为内置默认"
                                        Visibility="Collapsed">
                                        <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="10" Glyph="&#xE894;" />
                                    </Button>
                                </StackPanel>

                                <!-- Defused Sound -->
                                <StackPanel Grid.Row="2" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock x:Name="BombDefusedAudioLabelText" FontSize="12" FontWeight="SemiBold" Text="拆除成功提示音 (Defuse)" />
                                    <TextBlock x:Name="BombDefusedAudioStatusText" FontSize="11" Foreground="{StaticResource FluentMutedText}" Text="内置默认" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                    <Button
                                        x:Name="BombDefusedAudioPreviewButton"
                                        Style="{StaticResource FluentActionBtnStyle}"
                                        MinWidth="28"
                                        Padding="6,4"
                                        Click="OnBombAudioPreviewClick"
                                        Tag="defused">
                                        <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="11" Glyph="&#xE768;" />
                                    </Button>
                                    <Button
                                        x:Name="BombDefusedAudioImportButton"
                                        Style="{StaticResource FluentActionBtnStyle}"
                                        Click="OnBombAudioImportClick"
                                        Tag="defused">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="11" Glyph="&#xE8B5;" />
                                            <TextBlock x:Name="BombDefusedAudioImportButtonText" Text="导入" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        x:Name="BombDefusedAudioClearButton"
                                        Style="{StaticResource FluentActionBtnStyle}"
                                        MinWidth="28"
                                        Padding="6,4"
                                        Click="OnBombAudioClearClick"
                                        Tag="defused"
                                        ToolTipService.ToolTip="恢复为内置默认"
                                        Visibility="Collapsed">
                                        <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="10" Glyph="&#xE894;" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Button
                                x:Name="BombFullEffectPreviewButton"
                                Style="{StaticResource FluentActionBtnStyle}"
                                HorizontalAlignment="Right"
                                Click="OnBombFullEffectPreviewClick">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="11" Glyph="&#xE768;" />
                                    <TextBlock x:Name="BombFullEffectPreviewButtonText" Text="完整效果试听" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
</UserControl>
