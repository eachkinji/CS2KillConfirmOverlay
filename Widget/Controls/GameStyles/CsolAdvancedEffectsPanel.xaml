<UserControl
    x:Class="KillConfirmGameBar.Controls.GameStyles.CsolAdvancedEffectsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KillConfirmGameBar.Controls.GameStyles">

    <StackPanel Spacing="12">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="3">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border
                        x:Name="TitleAccent"
                        Width="4"
                        Height="20"
                        VerticalAlignment="Center"
                        CornerRadius="2" />
                    <TextBlock
                        x:Name="TitleText"
                        FontSize="16"
                        FontWeight="Bold"
                        Text="CSOL Effects" />
                </StackPanel>
                <TextBlock
                    x:Name="HintText"
                    FontSize="10"
                    MaxWidth="320"
                    HorizontalAlignment="Left"
                    Text="Configure kill-streak timing, special-event priority, and separate first/last-kill effects."
                    TextWrapping="WrapWholeWords" />
            </StackPanel>
            <Button
                x:Name="ResetButton"
                Grid.Column="1"
                MinWidth="88"
                Height="34"
                Padding="14,0"
                VerticalAlignment="Top"
                AutomationProperties.Name="Restore CSOL defaults"
                Click="OnResetButtonClick">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="12" Glyph="&#xE777;" />
                    <TextBlock x:Name="ResetButtonText" Text="Reset" />
                </StackPanel>
            </Button>
        </Grid>

        <Border
            x:Name="CoverageNotice"
            Padding="10,7"
            BorderThickness="1"
            CornerRadius="8">
            <Grid ColumnSpacing="7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon x:Name="CoverageIcon" FontSize="12" VerticalAlignment="Top" Glyph="&#xE946;" />
                <TextBlock
                    x:Name="CoverageText"
                    Grid.Column="1"
                    FontSize="11"
                    Text="The CSOL pack now plays distinct streak voices from 1 through 10 kills."
                    TextWrapping="WrapWholeWords" />
            </Grid>
        </Border>

        <Grid RowSpacing="8" ColumnSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <local:StreakWindowEditor
                x:Name="StreakEditor"
                SettingsChanged="OnVoiceSettingChanged" />

            <Border Grid.Column="1" Style="{StaticResource CompactChoiceCardStyle}">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Style="{StaticResource CompactCircleIconStyle}"><FontIcon FontSize="13" Foreground="White" Glyph="&#xE8D6;" /></Border>
                        <TextBlock x:Name="PriorityLabel" Style="{StaticResource CompactChoiceLabelStyle}" VerticalAlignment="Center" Text="Voice priority" />
                    </StackPanel>
                    <ComboBox x:Name="PrioritySelector" Style="{StaticResource CompactSettingsComboBoxStyle}" SelectionChanged="OnVoiceSettingChanged" ToolTipService.ToolTip="Choose whether special-event or streak audio plays first">
                        <ComboBoxItem x:Name="PrioritySpecialItem" Tag="special">Special first</ComboBoxItem>
                        <ComboBoxItem x:Name="PriorityStreakItem" Tag="streak">Kill-streak first</ComboBoxItem>
                    </ComboBox>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource CompactChoiceCardStyle}">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Style="{StaticResource CompactCircleIconStyle}"><FontIcon FontSize="13" Foreground="White" Glyph="&#xE91F;" /></Border>
                        <TextBlock x:Name="FirstKillIconLabel" Style="{StaticResource CompactChoiceLabelStyle}" VerticalAlignment="Center" Text="First-kill icon" />
                    </StackPanel>
                    <ComboBox x:Name="FirstKillIconSelector" Style="{StaticResource CompactSettingsComboBoxStyle}" SelectionChanged="OnVoiceSettingChanged" ToolTipService.ToolTip="Choose the first-kill icon">
                        <ComboBoxItem x:Name="FirstKillIconFirstKillItem" Tag="firstkill">First kill</ComboBoxItem>
                        <ComboBoxItem x:Name="FirstKillIconRevengeItem" Tag="revenge">Revenge</ComboBoxItem>
                    </ComboBox>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CompactChoiceCardStyle}">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Style="{StaticResource CompactCircleIconStyle}"><FontIcon FontSize="13" Foreground="White" Glyph="&#xE91F;" /></Border>
                        <TextBlock x:Name="LastKillIconLabel" Style="{StaticResource CompactChoiceLabelStyle}" VerticalAlignment="Center" Text="Last-kill icon" />
                    </StackPanel>
                    <ComboBox x:Name="LastKillIconSelector" Style="{StaticResource CompactSettingsComboBoxStyle}" SelectionChanged="OnVoiceSettingChanged" ToolTipService.ToolTip="Choose the last-kill icon">
                        <ComboBoxItem x:Name="LastKillIconRevengeItem" Tag="revenge">Revenge</ComboBoxItem>
                        <ComboBoxItem x:Name="LastKillIconFirstKillItem" Tag="firstkill">First kill</ComboBoxItem>
                    </ComboBox>
                </StackPanel>
            </Border>
        </Grid>

    </StackPanel>
</UserControl>

