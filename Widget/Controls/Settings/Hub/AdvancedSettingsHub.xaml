<UserControl
    x:Class="KillConfirmGameBar.Controls.Settings.AdvancedSettingsHub"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:KillConfirmGameBar.Controls.Settings"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="ms-appx:///Controls/Settings/PanelDesign.xaml" />
        </ResourceDictionary.MergedDictionaries>

        <!-- Backward Compatibility Aliases for Code-Behind (theme brush overrides) -->
        <SolidColorBrush x:Key="HubCardBackground" Color="{StaticResource PanelSectionColor}" />
        <SolidColorBrush x:Key="HubCardBorder" Color="{StaticResource PanelBorderColor}" />
        <SolidColorBrush x:Key="HubDivider" Color="{StaticResource PanelDividerColor}" />
        <SolidColorBrush x:Key="HubTitleText" Color="{StaticResource PanelTextPrimaryColor}" />
        <SolidColorBrush x:Key="HubBodyText" Color="{StaticResource PanelTextSecondaryColor}" />
        <SolidColorBrush x:Key="HubMutedText" Color="{StaticResource PanelTextMutedColor}" />
        <SolidColorBrush x:Key="HubAccentText" Color="{StaticResource PanelAccentColor}" />
        <SolidColorBrush x:Key="HubPanelBackground" Color="{StaticResource PanelSectionColor}" />
        <SolidColorBrush x:Key="HubPanelBorder" Color="{StaticResource PanelBorderColor}" />

        <Style x:Key="FluentSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PanelButtonStyle}" />

        <Style x:Key="FluentDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource PanelDangerButtonStyle}" />
        <Style x:Key="FluentInputStyle" TargetType="TextBox" BasedOn="{StaticResource PanelTextBoxStyle}" />
        <Style x:Key="FluentBadgeBorderStyle" TargetType="Border">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Background" Value="{StaticResource PanelAccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource PanelControlRadius}" />
        </Style>

        <!-- Legacy Style Aliases for External/Internal Compatibility -->
        <Style x:Key="HubCardStyle" TargetType="Border" BasedOn="{StaticResource PanelSectionCardStyle}" />
        <Style x:Key="HubTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource PanelTitleTextStyle}" />
        <Style x:Key="HubBodyTextStyle" TargetType="TextBlock" BasedOn="{StaticResource PanelCaptionTextStyle}" />
        <Style x:Key="HubSectionLabelTextStyle" TargetType="TextBlock" BasedOn="{StaticResource PanelSectionTitleTextStyle}" />
        <Style x:Key="HubFieldLabelTextStyle" TargetType="TextBlock" BasedOn="{StaticResource PanelTitleTextStyle}" />
        <Style x:Key="HubHelperTextStyle" TargetType="TextBlock" BasedOn="{StaticResource PanelCaptionTextStyle}" />
        <Style x:Key="HubPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PanelPrimaryButtonStyle}" />
        <Style x:Key="HubSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PanelButtonStyle}" />
        <Style x:Key="HubBadgeBorderStyle" TargetType="Border" BasedOn="{StaticResource FluentBadgeBorderStyle}" />
        <Style x:Key="HubInputStyle" TargetType="TextBox" BasedOn="{StaticResource PanelTextBoxStyle}" />

        <Style x:Key="HubTabButtonStyle" TargetType="Button" BasedOn="{StaticResource PanelButtonStyle}">
            <Setter Property="MinWidth" Value="100" />
            <Setter Property="Background" Value="#F2F2F7" />
            <Setter Property="Foreground" Value="#3A3A3C" />
            <Setter Property="BorderBrush" Value="#E5E5EA" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="HubTabActiveButtonStyle" TargetType="Button" BasedOn="{StaticResource HubTabButtonStyle}">
            <Setter Property="Background" Value="{StaticResource PanelAccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelAccentBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid RowSpacing="12">
            <!-- Hidden compatibility anchors for code-behind bindings -->
            <StackPanel Visibility="Collapsed">
                <Button x:Name="HubTabGeneralButton" Click="OnHubTabGeneralClick" Style="{StaticResource PanelButtonStyle}" />
                <Button x:Name="HubTabPortButton" Click="OnHubTabPortClick" Style="{StaticResource PanelButtonStyle}" />
                <Button x:Name="HubTabDisplayButton" Click="OnHubTabDisplayClick" Style="{StaticResource PanelButtonStyle}" />
                <Button x:Name="HubTabAboutButton" Click="OnHubTabAboutClick" Style="{StaticResource PanelButtonStyle}" />
                <TextBlock x:Name="HubHeaderBadgeText" />
                <TextBlock x:Name="HubHeaderTitleText" />
                <TextBlock x:Name="HubHeaderSubtitleText" />
                <TextBlock x:Name="HubStatusBadgeText" />
            </StackPanel>

            <!-- Tab 1: Game Experience View (Fluent 2) -->
            <ScrollViewer
                x:Name="HubGeneralView"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="16" MaxWidth="1480" HorizontalAlignment="Stretch">
                    <!-- Game Experience Options -->
                    <StackPanel Spacing="6">
                        <TextBlock
                        Visibility="Collapsed" Text=""/>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Ellipse Width="22" Height="22" VerticalAlignment="Center"><Ellipse.Fill><ImageBrush x:Name="HubExperienceGameLogoBrush" Stretch="UniformToFill" ImageSource="ms-appx:///Assets/GameSources/CounterStrike/cs2.png"/></Ellipse.Fill></Ellipse><TextBlock x:Name="HubExperienceCardTitle" Style="{StaticResource PanelTitleTextStyle}" VerticalAlignment="Center" Text="Counter-Strike 2 体验增强" /></StackPanel>
                        <TextBlock Visibility="Collapsed"
                            Style="{StaticResource PanelTitleTextStyle}"
                            Text="" />
                        <settings:GeneralSettingsOptionsPanel x:Name="HubGeneralOptionsPanel" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Tab 2: Port Configuration View (Fluent 2) -->
            <settings:PortSettingsView x:Name="HubPortSettingsView" Visibility="Collapsed" />

            <!-- Tab 3: Advanced Settings View (Fluent 2) -->
            <ScrollViewer
                x:Name="HubDisplayView"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Visibility="Collapsed">
                <StackPanel Spacing="16" MaxWidth="1480" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="2" Margin="2,4,2,4">
                        <TextBlock
                            x:Name="HubDisplayCardTitle"
                            Style="{StaticResource PanelTitleTextStyle}"
                            Text="ADVANCED SETTINGS" />
                    </StackPanel>

                    <!-- GSI & System Options -->
                    <StackPanel Spacing="6">
                        <TextBlock
                            x:Name="HubGeneralCardSecondaryTitle" Visibility="Collapsed"
                            Style="{StaticResource PanelTitleTextStyle}"
                            Text="游戏状态集成与系统选项 (GAME-STATE &amp; SYSTEM)" />
                        <TextBlock
                            x:Name="HubGeneralCardSecondaryDescription" Visibility="Collapsed"
                            Style="{StaticResource PanelCaptionTextStyle}"
                            Margin="2,0,2,6" />
                        <settings:AdvancedSystemOptionsPanel x:Name="HubAdvancedSystemOptionsPanel" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="安装与存储" Style="{StaticResource PanelSectionTitleTextStyle}" />
                        <Border Style="{StaticResource PanelSectionCardStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource PanelIconContainerStyle}" VerticalAlignment="Top">
                                    <FontIcon Glyph="&#xE7F8;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource PanelTextSecondaryBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="7">
                                    <TextBlock Text="程序安装位置" Style="{StaticResource PanelTitleTextStyle}" />
                                    <TextBlock Text="在安装器中更换位置；更新后自动沿用现有设置。" Style="{StaticResource PanelCaptionTextStyle}" />
                                    <TextBlock x:Name="HubInstallPath" Foreground="{StaticResource PanelTextSecondaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource PanelCaptionTextStyle}" />
                                    <Button Content="打开安装文件夹" Style="{StaticResource PanelButtonStyle}" Click="OnOpenInstallFolder" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource PanelSectionCardStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource PanelIconContainerStyle}" VerticalAlignment="Top" Background="{StaticResource PanelAccentSoftBrush}">
                                    <FontIcon Glyph="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource PanelAccentBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="7">
                                    <TextBlock Text="素材包存放位置" Style="{StaticResource PanelTitleTextStyle}" />
                                    <TextBlock Text="图标包、音效包、语音包和自定义素材统一存放。更换位置会迁移并校验已有素材。" Style="{StaticResource PanelCaptionTextStyle}" />
                                    <TextBlock x:Name="HubMaterialPath" Foreground="{StaticResource PanelTextSecondaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource PanelCaptionTextStyle}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="HubMaterialMove" Content="更换位置" Style="{StaticResource PanelPrimaryButtonStyle}" Click="OnMoveMaterialLibrary" />
                                        <Button Content="打开文件夹" Style="{StaticResource PanelButtonStyle}" Click="OnOpenMaterialLibrary" />
                                    </StackPanel>
                                    <TextBlock x:Name="HubMaterialStatus" Style="{StaticResource PanelCaptionTextStyle}" Visibility="Collapsed" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                    <!-- Runtime & Maintenance Options -->
                    <StackPanel Spacing="6">
                        <TextBlock
                            x:Name="HubGeneralCardTitle"
                            Style="{StaticResource PanelTitleTextStyle}"
                            Text="软件与维护" />
                        <TextBlock
                            x:Name="HubGeneralCardDescription"
                            Style="{StaticResource PanelCaptionTextStyle}"
                            Margin="2,0,2,6" />
                        <settings:RuntimeMaintenancePanel x:Name="HubRuntimePanel" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Tab 4: About View (Fluent 2) -->
            <ScrollViewer
                x:Name="HubAboutView"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Visibility="Collapsed">
                <StackPanel  Spacing="16">
                <Border BorderBrush="#CDE2FF" Style="{StaticResource PanelCardStyle}">
                    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#EAF3FF" Offset="0"/><GradientStop Color="#FAFCFF" Offset="1"/></LinearGradientBrush></Border.Background>
                    <StackPanel Spacing="12">
                        <TextBlock x:Name="HubAboutTitle" Foreground="#007AFF" Style="{StaticResource PanelTitleTextStyle}"/>
                        <TextBlock Text="Kill Confirm Overlay" TextWrapping="Wrap" Style="{StaticResource PanelPageTitleTextStyle}"/>
                        <Grid x:Name="HubVersionActionsRow" ColumnSpacing="10" RowSpacing="10" SizeChanged="OnAboutHeaderSizeChanged">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Border Background="White" Padding="12,6" CornerRadius="8" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock x:Name="HubAboutVersion" FontWeight="SemiBold" Style="{StaticResource PanelBodyTextStyle}"/></Border>
                            <StackPanel x:Name="HubVersionActions" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                <Button x:Name="HubExitAllButton" Style="{StaticResource PanelPrimaryButtonStyle}" Click="OnHubExitAllClick">
                                </Button>
                                <Button x:Name="HubUninstallButton" Style="{StaticResource FluentDangerButtonStyle}" Click="OnHubUninstallClick">
                                </Button>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="HubAppActionsStatusText" TextWrapping="Wrap" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource PanelCardStyle}">
                    <StackPanel Spacing="14">
                        <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Spacing="5"><TextBlock x:Name="HubVersionStatus" TextWrapping="Wrap" Style="{StaticResource PanelSectionTitleTextStyle}"/><TextBlock x:Name="HubVersionDetail" Foreground="{StaticResource PanelTextMutedBrush}" TextWrapping="Wrap" Style="{StaticResource PanelCaptionTextStyle}"/></StackPanel>
                            <Button x:Name="HubCheckUpdateButton" Grid.Column="1" VerticalAlignment="Top" Content="检查更新" Click="OnCheckUpdateClick" Style="{StaticResource PanelButtonStyle}"/>
                        </Grid>
                        <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button x:Name="HubCopyUpdateLinkButton" HorizontalAlignment="Stretch" Click="OnCopyUpdateLinkClick" Style="{StaticResource PanelPrimaryButtonStyle}"/>
                            <HyperlinkButton x:Name="HubDownloadButton" Grid.Column="1" NavigateUri="https://pan.quark.cn/s/1f3cfbcf8d5f?pwd=7Twv" Background="#F1F6FF" Foreground="#007AFF" CornerRadius="{StaticResource PanelControlRadius}" Padding="{StaticResource PanelControlPadding}" MinHeight="{StaticResource PanelControlHeight}" FontSize="{StaticResource PanelFontBody}" HorizontalAlignment="Stretch"/>
                        </Grid>
                        <TextBlock x:Name="HubUpdateLinkFeedback" Foreground="#007AFF" Visibility="Collapsed" Style="{StaticResource PanelCaptionTextStyle}"/>
                        <TextBlock x:Name="HubUpdateStepsTitle" Margin="0,8,0,0" Style="{StaticResource PanelTitleTextStyle}"/>
                        <TextBlock x:Name="HubUpdateSteps" LineHeight="24" TextWrapping="Wrap" Foreground="{StaticResource PanelTextSecondaryBrush}" Style="{StaticResource PanelBodyTextStyle}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource PanelCardStyle}">
                    <StackPanel Spacing="12"><TextBlock x:Name="HubAboutUpdateTitle" Style="{StaticResource PanelTitleTextStyle}"/><ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="HubAboutUpdateBody" LineHeight="22" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource PanelBodyTextStyle}"/></ScrollViewer></StackPanel>
                </Border>
                <Border Style="{StaticResource PanelCardStyle}"><StackPanel Spacing="16">
                    <TextBlock x:Name="HubAboutCreditsTitle" Style="{StaticResource PanelTitleTextStyle}"/>
                    <Border x:Name="HubAuthorProfileCard" Style="{StaticResource PanelSectionCardStyle}"><Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border x:Name="HubAuthorAvatarFrame" Width="52" Height="52" CornerRadius="26"><Image Source="ms-appx:///Assets/DeveloperAvatar.jpg" Stretch="UniformToFill"/></Border>
                        <StackPanel Grid.Column="1" Spacing="4"><TextBlock x:Name="HubAuthorNameText" Style="{StaticResource PanelTitleTextStyle}"/><TextBlock x:Name="HubAuthorDescriptionText" Style="{StaticResource PanelCaptionTextStyle}"/>
                            <StackPanel Orientation="Horizontal" Spacing="8"><HyperlinkButton x:Name="HubAuthorGitHubButton" NavigateUri="https://github.com/eachkinji"/><HyperlinkButton x:Name="HubAuthorBilibiliButton" NavigateUri="https://space.bilibili.com/18017622"/><HyperlinkButton x:Name="HubProjectButton" NavigateUri="https://github.com/eachkinji/CS2KillConfirmOverlay"/></StackPanel>
                        </StackPanel>
                    </Grid></Border>
                    <settings:CreditsCommunityPanel x:Name="HubCreditsCommunityPanel"/>
                    <TextBlock x:Name="HubAboutCreditsBody" Foreground="{StaticResource PanelTextMutedBrush}" TextWrapping="Wrap" Style="{StaticResource PanelCaptionTextStyle}"/>
                </StackPanel></Border>
            </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
