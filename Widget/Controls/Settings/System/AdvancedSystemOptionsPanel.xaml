<UserControl
    x:Class="KillConfirmGameBar.Controls.Settings.AdvancedSystemOptionsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- Fluent 2 Palette -->
        <SolidColorBrush x:Key="FluentCardBackground" Color="#FFFFFF" />
        <SolidColorBrush x:Key="FluentCardSubBackground" Color="#FAFAFC" />
        <SolidColorBrush x:Key="FluentCardBorder" Color="#E5E5EA" />
        <SolidColorBrush x:Key="FluentDivider" Color="#F0F0F5" />
        <SolidColorBrush x:Key="FluentTitleText" Color="#1C1C1E" />
        <SolidColorBrush x:Key="FluentBodyText" Color="#3A3A3C" />
        <SolidColorBrush x:Key="FluentMutedText" Color="#6E6E73" />
        <SolidColorBrush x:Key="FluentAccent" Color="#007AFF" />
        <SolidColorBrush x:Key="FluentAccentLight" Color="#EAF3FF" />

        <!-- Fluent 2 Setting Card Style -->
        <Style x:Key="FluentCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Background" Value="{StaticResource FluentCardBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource FluentCardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <!-- Fluent 2 Icon Box -->
        <Style x:Key="FluentIconStyle" TargetType="Border">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="#F2F2F7" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Fluent 2 Typography -->
        <Style x:Key="FluentCardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource FluentTitleText}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="FluentCardHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource FluentMutedText}" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
            <Setter Property="LineHeight" Value="15" />
        </Style>

        <!-- Fluent 2 ComboBox -->
        <Style x:Key="FluentComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="160" />
            <Setter Property="Padding" Value="10,0,24,0" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource FluentTitleText}" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E0E0E5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Fluent 2 Secondary Action Button -->
        <Style x:Key="FluentActionBtnStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="MinWidth" Value="60" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E0E0E5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Foreground" Value="{StaticResource FluentTitleText}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </UserControl.Resources>

    <StackPanel Spacing="8">
        <!-- 1. GSI Game Version Settings Card -->
        <Border Style="{StaticResource FluentCardStyle}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource FluentIconStyle}">
                    <FontIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="14"
                        Foreground="{StaticResource FluentBodyText}"
                        Glyph="&#xE7FC;" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        x:Name="GsiGameVersionLabelText"
                        Style="{StaticResource FluentCardTitle}"
                        Text="Counter-Strike 版本" />
                    <TextBlock
                        x:Name="GsiGameVersionHintText"
                        Style="{StaticResource FluentCardHint}"
                        Text="选择监听 Counter-Strike 2 或 CS:GO 传统版的游戏状态" />
                </StackPanel>

                <ComboBox
                    x:Name="GsiGameVersionSelector"
                    Grid.Column="2"
                    Style="{StaticResource FluentComboBoxStyle}"
                    SelectionChanged="OnGsiGameVersionSelectionChanged">
                    <ComboBoxItem x:Name="GsiGameVersionCs2Item" Tag="cs2">Counter-Strike 2 (默认)</ComboBoxItem>
                    <ComboBoxItem x:Name="GsiGameVersionCsgoLegacyItem" Tag="csgo_legacy">CS:GO Legacy</ComboBoxItem>
                </ComboBox>
            </Grid>
        </Border>

    </StackPanel>
</UserControl>
