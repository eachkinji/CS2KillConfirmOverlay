<UserControl
    x:Class="KillConfirmGameBar.Controls.Settings.Battlefield1AdvancedSettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        x:Name="Card"
        Padding="22"
        Background="#FAFAF7"
        BorderBrush="#C98A3E"
        BorderThickness="1"
        CornerRadius="24">
        <StackPanel Spacing="10">
            <TextBlock
                x:Name="TitleText"
                FontSize="20"
                FontWeight="Bold"
                Text="Battlefield 1 advanced settings" />
            <TextBlock
                x:Name="BodyText"
                FontSize="13"
                LineHeight="18"
                Text="BF1 uses the Battlefield 1 resource folder, BF1 card animation files, and BF1/BF5-only money reward modes. CF and VAL settings stay out of this module."
                TextWrapping="WrapWholeWords" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border x:Name="AssetTag" Padding="8,4" BorderThickness="1" CornerRadius="12">
                    <TextBlock x:Name="AssetTagText" FontSize="11" FontWeight="SemiBold" Text="battlefield1 assets" />
                </Border>
                <Border x:Name="MoneyTag" Padding="8,4" BorderThickness="1" CornerRadius="12">
                    <TextBlock x:Name="MoneyTagText" FontSize="11" FontWeight="SemiBold" Text="Money mode" />
                </Border>
                <Border x:Name="ImportLockTag" Padding="8,4" BorderThickness="1" CornerRadius="12">
                    <TextBlock x:Name="ImportLockTagText" FontSize="11" FontWeight="SemiBold" Text="No file import" />
                </Border>
            </StackPanel>
            <Grid Margin="0,8,0,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StreakModeLabel" VerticalAlignment="Center" Text="Kill streak" />
                <ComboBox x:Name="StreakModeSelector" Grid.Column="1" SelectionChanged="OnStreakModeSelectionChanged">
                    <ComboBoxItem x:Name="StreakLifeItem" Tag="life">Until death</ComboBoxItem>
                    <ComboBoxItem x:Name="StreakTimed5Item" Tag="timed_5">5-second window</ComboBoxItem>
                    <ComboBoxItem x:Name="StreakTimed10Item" Tag="timed_10">10-second window</ComboBoxItem>
                    <ComboBoxItem x:Name="StreakTimed15Item" Tag="timed_15">15-second window</ComboBoxItem>
                </ComboBox>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
