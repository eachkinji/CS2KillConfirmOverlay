<UserControl
    x:Class="KillConfirmGameBar.Controls.GameStyles.CsolAdvancedEffectsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KillConfirmGameBar.Controls.GameStyles">

    <StackPanel Spacing="12">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="3">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border
                        x:Name="TitleAccent"
                        Width="4"
                        Height="20"
                        VerticalAlignment="Center"
                        CornerRadius="2" />
                    <TextBlock
                        x:Name="TitleText"
                        FontSize="16"
                        FontWeight="Bold"
                        Text="CSOL Effects" />
                </StackPanel>
                <TextBlock
                    x:Name="HintText"
                    FontSize="10"
                    MaxWidth="320"
                    HorizontalAlignment="Left"
                    Text="Configure kill-streak timing, special-event priority, and separate first/last-kill effects."
                    TextWrapping="WrapWholeWords" />
            </StackPanel>
            <Button
                x:Name="ResetButton"
                Grid.Column="1"
                MinWidth="88"
                Height="34"
                Padding="14,0"
                VerticalAlignment="Top"
                AutomationProperties.Name="Restore CSOL defaults"
                Click="OnResetButtonClick">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="12" Glyph="&#xE777;" />
                    <TextBlock x:Name="ResetButtonText" Text="Reset" />
                </StackPanel>
            </Button>
        </Grid>

        <Border
            x:Name="CoverageNotice"
            Padding="10,7"
            BorderThickness="1"
            CornerRadius="8">
            <Grid ColumnSpacing="7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon x:Name="CoverageIcon" FontSize="12" VerticalAlignment="Top" Glyph="&#xE946;" />
                <TextBlock
                    x:Name="CoverageText"
                    Grid.Column="1"
                    FontSize="11"
                    Text="The CSOL pack now plays distinct streak voices from 1 through 10 kills."
                    TextWrapping="WrapWholeWords" />
            </Grid>
        </Border>

        <Grid RowSpacing="8" ColumnSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <local:StreakWindowEditor
                x:Name="StreakEditor"
                SettingsChanged="OnVoiceSettingChanged" />

            <Border Grid.Column="1" Style="{StaticResource CompactChoiceCardStyle}">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Style="{StaticResource CompactCircleIconStyle}"><FontIcon FontSize="13" Foreground="White" Glyph="&#xE8D6;" /></Border>
                        <TextBlock x:Name="PriorityLabel" Style="{StaticResource CompactChoiceLabelStyle}" VerticalAlignment="Center" Text="Voice priority" />
                    </StackPanel>
                    <ComboBox x:Name="PrioritySelector" Style="{StaticResource CompactSettingsComboBoxStyle}" SelectionChanged="OnVoiceSettingChanged" ToolTipService.ToolTip="Choose whether special-event or streak audio plays first">
                        <ComboBoxItem x:Name="PrioritySpecialItem" Tag="special">Special first</ComboBoxItem>
                        <ComboBoxItem x:Name="PriorityStreakItem" Tag="streak">Kill-streak first</ComboBoxItem>
                    </ComboBox>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource CompactChoiceCardStyle}">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Style="{StaticResource CompactCircleIconStyle}"><FontIcon FontSize="13" Foreground="White" Glyph="&#xE91F;" /></Border>
                        <TextBlock x:Name="FirstKillIconLabel" Style="{StaticResource CompactChoiceLabelStyle}" VerticalAlignment="Center" Text="First-kill icon" />
                    </StackPanel>
                    <ComboBox x:Name="FirstKillIconSelector" Style="{StaticResource CompactSettingsComboBoxStyle}" SelectionChanged="OnVoiceSettingChanged" ToolTipService.ToolTip="Choose the first-kill icon">
                        <ComboBoxItem x:Name="FirstKillIconFirstKillItem" Tag="firstkill">First kill</ComboBoxItem>
                        <ComboBoxItem x:Name="FirstKillIconRevengeItem" Tag="revenge">Revenge</ComboBoxItem>
                    </ComboBox>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CompactChoiceCardStyle}">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Style="{StaticResource CompactCircleIconStyle}"><FontIcon FontSize="13" Foreground="White" Glyph="&#xE91F;" /></Border>
                        <TextBlock x:Name="LastKillIconLabel" Style="{StaticResource CompactChoiceLabelStyle}" VerticalAlignment="Center" Text="Last-kill icon" />
                    </StackPanel>
                    <ComboBox x:Name="LastKillIconSelector" Style="{StaticResource CompactSettingsComboBoxStyle}" SelectionChanged="OnVoiceSettingChanged" ToolTipService.ToolTip="Choose the last-kill icon">
                        <ComboBoxItem x:Name="LastKillIconRevengeItem" Tag="revenge">Revenge</ComboBoxItem>
                        <ComboBoxItem x:Name="LastKillIconFirstKillItem" Tag="firstkill">First kill</ComboBoxItem>
                    </ComboBox>
                </StackPanel>
            </Border>
        </Grid>

        <!-- CSOL Voice Variant / Event Sound Manager Card -->
        <Border
            x:Name="VoiceManagerCard"
            Padding="12"
            BorderThickness="1"
            CornerRadius="10"
            Style="{StaticResource CompactChoiceCardStyle}">
            <StackPanel Spacing="10">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Style="{StaticResource CompactCircleIconStyle}"><FontIcon Glyph="&#xE8D6;" FontSize="13" Foreground="White" /></Border>
                            <TextBlock x:Name="VoiceManagerTitleText" Text="CSOL 语音包事件音效与随机管理" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="VoiceManagerHintText" Text="为多音效事件（如 1杀、4杀、刀杀等）指定具体播放音效或设为随机播放。" FontSize="10" Foreground="#888888" TextWrapping="WrapWholeWords" />
                    </StackPanel>
                    <Button
                        x:Name="ImportVoiceButton"
                        Grid.Column="1"
                        Padding="10,4"
                        FontSize="11"
                        Height="28"
                        VerticalAlignment="Center"
                        Click="OnImportVoiceButtonClick">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE8B7;" FontSize="11" />
                            <TextBlock x:Name="ImportVoiceButtonText" Text="导入语音" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid RowSpacing="8" ColumnSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Kill 1 -->
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="Kill1VoiceLabel" Text="1杀音效" FontSize="11" FontWeight="SemiBold" />
                        <ComboBox x:Name="Kill1VoiceSelector" Style="{StaticResource CompactSettingsComboBoxStyle}" SelectionChanged="OnVoiceSettingChanged">
                            <ComboBoxItem x:Name="Kill1RandomItem" Tag="random">🎲 随机语音</ComboBoxItem>
                            <ComboBoxItem Tag="Cantbelive.wav">Cantbelive</ComboBoxItem>
                            <ComboBoxItem Tag="Crazy.wav">Crazy</ComboBoxItem>
                            <ComboBoxItem Tag="Excellent.wav">Excellent</ComboBoxItem>
                            <ComboBoxItem Tag="Firstkill.wav">Firstkill</ComboBoxItem>
                            <ComboBoxItem Tag="Incredible.wav">Incredible</ComboBoxItem>
                            <ComboBoxItem Tag="Gotit.wav">Gotit</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>

                    <!-- Kill 4 -->
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock x:Name="Kill4VoiceLabel" Text="4杀音效" FontSize="11" FontWeight="SemiBold" />
                        <ComboBox x:Name="Kill4VoiceSelector" Style="{StaticResource CompactSettingsComboBoxStyle}" SelectionChanged="OnVoiceSettingChanged">
                            <ComboBoxItem x:Name="Kill4RandomItem" Tag="random">🎲 随机语音</ComboBoxItem>
                            <ComboBoxItem Tag="Multikill.wav">Multikill (原版)</ComboBoxItem>
                            <ComboBoxItem Tag="Multikill_ch.wav">Multikill_ch (国服)</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>

                    <!-- Knife -->
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock x:Name="KnifeVoiceLabel" Text="小刀击杀音效" FontSize="11" FontWeight="SemiBold" />
                        <ComboBox x:Name="KnifeVoiceSelector" Style="{StaticResource CompactSettingsComboBoxStyle}" SelectionChanged="OnVoiceSettingChanged">
                            <ComboBoxItem x:Name="KnifeRandomItem" Tag="random">🎲 随机语音</ComboBoxItem>
                            <ComboBoxItem Tag="Humililation.wav">Humililation</ComboBoxItem>
                            <ComboBoxItem Tag="Ohno.wav">Ohno</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>

                    <!-- First Kill Voice -->
                    <StackPanel Grid.Row="1" Spacing="4">
                        <TextBlock x:Name="FirstKillVoiceLabel" Text="首杀专属音效" FontSize="11" FontWeight="SemiBold" />
                        <ComboBox x:Name="FirstKillVoiceSelector" Style="{StaticResource CompactSettingsComboBoxStyle}" SelectionChanged="OnVoiceSettingChanged">
                            <ComboBoxItem x:Name="FirstKillRandomItem" Tag="random">🎲 随机语音</ComboBoxItem>
                            <ComboBoxItem Tag="Firstkill.wav">Firstkill</ComboBoxItem>
                            <ComboBoxItem Tag="Cantbelive.wav">Cantbelive</ComboBoxItem>
                            <ComboBoxItem Tag="Crazy.wav">Crazy</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>

                    <!-- Last Kill Voice -->
                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                        <TextBlock x:Name="LastKillVoiceLabel" Text="尾杀/复仇音效" FontSize="11" FontWeight="SemiBold" />
                        <ComboBox x:Name="LastKillVoiceSelector" Style="{StaticResource CompactSettingsComboBoxStyle}" SelectionChanged="OnVoiceSettingChanged">
                            <ComboBoxItem x:Name="LastKillRandomItem" Tag="random">🎲 随机语音</ComboBoxItem>
                            <ComboBoxItem Tag="Revenge.wav">Revenge</ComboBoxItem>
                            <ComboBoxItem Tag="Monsterkill.wav">Monsterkill</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>

                    <!-- Assist Voice -->
                    <StackPanel Grid.Row="1" Grid.Column="2" Spacing="4">
                        <TextBlock x:Name="AssistVoiceLabel" Text="助攻音效" FontSize="11" FontWeight="SemiBold" />
                        <ComboBox x:Name="AssistVoiceSelector" Style="{StaticResource CompactSettingsComboBoxStyle}" SelectionChanged="OnVoiceSettingChanged">
                            <ComboBoxItem x:Name="AssistRandomItem" Tag="random">🎲 随机语音</ComboBoxItem>
                            <ComboBoxItem Tag="Assist.wav">Assist</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
