<UserControl
    x:Class="KillConfirmGameBar.Controls.GameStyles.DoubaoAdvancedEffectsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KillConfirmGameBar.Controls.GameStyles">

    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="ms-appx:///Controls/Settings/PanelDesign.xaml" />
        </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Spacing="10">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <Grid ColumnSpacing="8" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Image x:Name="CombatGameLogo" Width="22" Height="22" VerticalAlignment="Center" Stretch="Uniform" />
                    <TextBlock x:Name="TitleText" Grid.Column="1" VerticalAlignment="Center" TextWrapping="WrapWholeWords" Style="{StaticResource PanelTitleTextStyle}" />
                </Grid>
            </StackPanel>
            <Button
                x:Name="ResetButton"
                Grid.Column="1"
                MinWidth="88"
                VerticalAlignment="Top"
                AutomationProperties.Name="Restore Doubao defaults"
                Click="OnResetClick" Style="{StaticResource PanelPrimaryButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="12" Glyph="&#xE777;" />
                    <TextBlock x:Name="ResetButtonText" Text="Reset" />
                </StackPanel>
            </Button>
        </Grid>

        <local:StreakWindowEditor
            x:Name="StreakEditor"
            SettingsChanged="OnStreakModeSelectionChanged" />

        <Border x:Name="VisualEffectsCard" Style="{StaticResource PanelSectionCardStyle}">
            <StackPanel Spacing="8">
                <TextBlock x:Name="VisualEffectsTitle" Style="{StaticResource PanelTitleTextStyle}" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="KillMarkEffectLabel" VerticalAlignment="Center" TextWrapping="WrapWholeWords" Style="{StaticResource PanelCaptionTextStyle}" />
                    <ToggleSwitch x:Name="KillMarkEffectToggle" Grid.Column="1" MinWidth="0" Toggled="OnKillMarkEffectToggled" />
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
