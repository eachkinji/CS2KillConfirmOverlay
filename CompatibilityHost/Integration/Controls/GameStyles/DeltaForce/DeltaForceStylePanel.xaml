<UserControl
    x:Class="KillConfirmGameBar.Features.CompatibilityDisplay.Controls.GameStyles.DeltaForceStylePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="ms-appx:///Controls/Settings/PanelDesign.xaml" />
        </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border
        x:Name="Card"
        Background="#142A24"
        BorderBrush="#FFAE4B"
        Visibility="Collapsed" Style="{StaticResource PanelSectionCardStyle}">
        <StackPanel Spacing="3">
            <TextBlock
                x:Name="TitleText"
                Foreground="#F1FFF6"
                Text="Delta Force Panel" Style="{StaticResource PanelTitleTextStyle}" />
            <TextBlock
                x:Name="BodyText"
                Foreground="#C5E2CD"
                Text="Delta Force uses its own scrolling icons, score waterfall, and deltaforce resource folder."
                TextWrapping="WrapWholeWords" Style="{StaticResource PanelCaptionTextStyle}" />
        </StackPanel>
    </Border>
</UserControl>
