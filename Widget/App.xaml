<Application
    x:Class="KillConfirmGameBar.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <Style x:Key="CompactSettingsComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Tag" Value="SoftChoiceField" />
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Padding" Value="9,0,24,0" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#F4FFF8" />
            <Setter Property="Background" Value="#142A24" />
            <Setter Property="BorderBrush" Value="#668779" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="CornerRadius" Value="17" />
        </Style>
        <Style x:Key="CompactChoiceCardStyle" TargetType="Border">
            <Setter Property="Tag" Value="SoftChoiceCard" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="MinHeight" Value="72" />
            <Setter Property="Background" Value="#203D34" />
            <Setter Property="BorderBrush" Value="#668779" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
        </Style>
        <Style x:Key="CompactCircleIconStyle" TargetType="Border">
            <Setter Property="Tag" Value="CircleChoiceIcon" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{ThemeResource SystemControlHighlightAccentBrush}" />
            <Setter Property="CornerRadius" Value="15" />
        </Style>
        <Style x:Key="CompactChoiceLabelStyle" TargetType="TextBlock">
            <Setter Property="Tag" Value="SoftChoiceLabel" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#F4FFF8" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </Application.Resources>
</Application>
