<UserControl
    x:Class="KillConfirmGameBar.Pages.Main.Appearance.MainPageBackgroundView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Static colour washes. Alpha stays under 20% so the glass above them reads as tinted, not painted. -->
        <RadialGradientBrush x:Key="GreenWashBrush" Center="0.5,0.5" GradientOrigin="0.35,0.3" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="#3334C759" Offset="0" />
            <GradientStop Color="#0034C759" Offset="1" />
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="OrangeWashBrush" Center="0.5,0.5" GradientOrigin="0.4,0.35" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="#2BFF9500" Offset="0" />
            <GradientStop Color="#00FF9500" Offset="1" />
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="PurpleWashBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="#1FAF52DE" Offset="0" />
            <GradientStop Color="#00AF52DE" Offset="1" />
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="BlueWashBrush" Center="0.5,0.5" GradientOrigin="0.38,0.3" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="#47007AFF" Offset="0" />
            <GradientStop Color="#00007AFF" Offset="1" />
        </RadialGradientBrush>
    </UserControl.Resources>

    <Grid>
        <Ellipse
            Width="980" Height="820"
            Margin="-300,-380,0,0"
            HorizontalAlignment="Left" VerticalAlignment="Top"
            Fill="{StaticResource BlueWashBrush}"
            Opacity="0.9" />

        <Ellipse
            Width="760" Height="640"
            Margin="0,-320,-220,0"
            HorizontalAlignment="Right" VerticalAlignment="Top"
            Fill="{StaticResource GreenWashBrush}" />

        <Ellipse
            Width="900" Height="780"
            Margin="0,0,-280,-340"
            HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Fill="{StaticResource OrangeWashBrush}" />

        <Ellipse
            Width="720" Height="600"
            Margin="0,120,0,0"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            Fill="{StaticResource PurpleWashBrush}" />

        <!-- Per-game wash and highlight; filled from the active game palette. -->
        <Ellipse
            x:Name="HeroSlash"
            Width="860" Height="720"
            Margin="0,-260,-180,0"
            HorizontalAlignment="Right" VerticalAlignment="Top"
            Opacity="0.20"
            IsHitTestVisible="False">
            <Ellipse.RenderTransform>
                <RotateTransform Angle="-12" CenterX="430" CenterY="360" />
            </Ellipse.RenderTransform>
        </Ellipse>

        <Ellipse
            x:Name="HeroSlashLight"
            Width="520" Height="460"
            Margin="0,0,120,-160"
            HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Opacity="0.14"
            IsHitTestVisible="False" />

        <!-- Hairline rings replace the old diagonal frame stripes. -->
        <Ellipse
            x:Name="FrameStripeOne"
            Width="460" Height="460"
            Margin="0,0,150,70"
            HorizontalAlignment="Right" VerticalAlignment="Bottom"
            StrokeThickness="1"
            Opacity="0.12"
            IsHitTestVisible="False" />

        <Ellipse
            x:Name="FrameStripeTwo"
            Width="680" Height="680"
            Margin="0,0,30,-70"
            HorizontalAlignment="Right" VerticalAlignment="Bottom"
            StrokeThickness="1"
            Opacity="0.08"
            IsHitTestVisible="False" />

        <Ellipse
            x:Name="AccentLineOne"
            Width="9" Height="9"
            Margin="0,0,318,300"
            HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Opacity="0.55"
            IsHitTestVisible="False" />

        <Ellipse
            x:Name="AccentLineTwo"
            Width="6" Height="6"
            Margin="0,0,236,368"
            HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Opacity="0.42"
            IsHitTestVisible="False" />

        <Ellipse
            x:Name="AccentLineThree"
            Width="5" Height="5"
            Margin="0,0,392,232"
            HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Opacity="0.32"
            IsHitTestVisible="False" />
    </Grid>
</UserControl>
