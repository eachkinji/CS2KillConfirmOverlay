<UserControl x:Class="KillConfirmGameBar.Features.CompatibilityDisplay.CompatibilityHomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KillConfirmGameBar.Features.CompatibilityDisplay">
    <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Controls/Settings/SettingsWorkspace.Styles.xaml"/>
        <ResourceDictionary Source="ms-appx:///Features/CompatibilityDisplay/Integration/Home/CompatibilityHome.Styles.xaml"/>
    </ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
    <StackPanel Spacing="16">
        <Border x:Name="GameCard" Visibility="Collapsed" Style="{StaticResource SettingsSectionCardStyle}">
            <Grid ColumnSpacing="18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE7FC;" FontSize="18" Foreground="#007AFF"/><TextBlock x:Name="GameTitle" FontSize="20" FontWeight="SemiBold"/></StackPanel>
                    <TextBlock x:Name="GameHint" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"/>
                    <ComboBox x:Name="GameSelector" MinWidth="220" FontSize="13" SelectionChanged="OnGameChanged"/>
                </StackPanel>
                <Button x:Name="EffectsButton" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource SettingsHeaderButtonStyle}" Click="OnOpenGameSettings" Visibility="Collapsed"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE713;" FontSize="14"/><TextBlock x:Name="EffectsLabel" Text="当前游戏设置"/></StackPanel></Button>
            </Grid>
        </Border>

        <Border x:Name="RuntimeNoticeBorder" CornerRadius="8" Padding="10,7" Visibility="Collapsed"><StackPanel Orientation="Horizontal" Spacing="7"><Ellipse x:Name="ConnectionNoticeDot" Width="7" Height="7" VerticalAlignment="Center" Fill="#8E8E93"/><TextBlock x:Name="StatusText" FontSize="11" TextWrapping="Wrap" LineHeight="16"/></StackPanel></Border>

        <local:PackTestView x:Name="PackTestSectionView" VoicePackSelectionChanged="OnVoicePackSelectionChanged" CharacterVoicePackSelectionChanged="OnCharacterVoicePackSelectionChanged" AudioChannelSettingsChanged="OnAudioChannelSettingsChanged"
            IconPackSelectionChanged="OnIconPackSelectionChanged" AudioVolumeSelectionChanged="OnAudioVolumeSelectionChanged"
            GameSettingsRequested="OnGameSettingsRequested"
            TestEventRequested="OnTestEventClick" RepeatTestRequested="OnRepeatTestClick" ReloadAudioRequested="OnReloadAudioClick"/>

        <ContentControl x:Name="LayoutHost" HorizontalContentAlignment="Stretch"/>
    </StackPanel>
</UserControl>
