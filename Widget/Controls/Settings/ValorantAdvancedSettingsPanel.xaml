<UserControl
    x:Class="KillConfirmGameBar.Controls.Settings.ValorantAdvancedSettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        x:Name="Card"
        Padding="22"
        Background="#131B28"
        BorderBrush="#FF4655"
        BorderThickness="1"
        CornerRadius="24">
        <StackPanel Spacing="10">
            <TextBlock
                x:Name="TitleText"
                FontSize="20"
                FontWeight="Bold"
                Text="VAL advanced settings" />
            <TextBlock
                x:Name="BodyText"
                FontSize="13"
                LineHeight="18"
                Visibility="Collapsed"
                TextWrapping="WrapWholeWords" />

            <Grid Margin="0,8,0,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StreakModeLabel" VerticalAlignment="Center" Text="Kill streak" />
                <ComboBox x:Name="StreakModeSelector" Grid.Column="1" SelectionChanged="OnStreakModeSelectionChanged">
                    <ComboBoxItem x:Name="StreakLifeItem" Tag="life">Until death</ComboBoxItem>
                    <ComboBoxItem x:Name="StreakTimed5Item" Tag="timed_5">5-second window</ComboBoxItem>
                    <ComboBoxItem x:Name="StreakTimed10Item" Tag="timed_10">10-second window</ComboBoxItem>
                    <ComboBoxItem x:Name="StreakTimed15Item" Tag="timed_15">15-second window</ComboBoxItem>
                </ComboBox>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
