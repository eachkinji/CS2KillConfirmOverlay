<UserControl
    x:Class="KillConfirmGameBar.Danmaku.DanmakuOptionsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border
        x:Name="OptionsCard"
        Padding="12"
        Background="#08000000"
        BorderBrush="#18000000"
        BorderThickness="1"
        CornerRadius="10">
        <StackPanel Spacing="10">
            <!-- Header with Title and Test Button -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        x:Name="PanelTitle"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Text="6657 击杀弹幕个性化设置" />
                    <TextBlock
                        x:Name="PanelSubtitle"
                        FontSize="10"
                        Foreground="#888888"
                        Text="可自定义弹幕数量、飞行时间、显示区域、字号粗细与背景底框" />
                </StackPanel>

                <Button
                    x:Name="TestButton"
                    Grid.Column="1"
                    Padding="12,4"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Content="测试弹幕"
                    Click="OnTestClick"
                    ToolTipService.ToolTip="立即按照当前设置发射弹幕" />
            </Grid>

            <!-- Row 1: Count & Duration -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="3">
                    <TextBlock
                        x:Name="CountLabel"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Text="弹幕数量" />
                    <ComboBox
                        x:Name="CountSelector"
                        HorizontalAlignment="Stretch"
                        SelectionChanged="OnCountSelectionChanged">
                        <ComboBoxItem Tag="20">20 条</ComboBoxItem>
                        <ComboBoxItem Tag="50">50 条</ComboBoxItem>
                        <ComboBoxItem Tag="100">100 条 (推荐)</ComboBoxItem>
                        <ComboBoxItem Tag="150">150 条</ComboBoxItem>
                        <ComboBoxItem Tag="200">200 条</ComboBoxItem>
                        <ComboBoxItem Tag="300">300 条 (密集)</ComboBoxItem>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock
                        x:Name="DurationLabel"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Text="发射总时长" />
                    <ComboBox
                        x:Name="DurationSelector"
                        HorizontalAlignment="Stretch"
                        SelectionChanged="OnDurationSelectionChanged">
                        <ComboBoxItem Tag="5">5 秒 (快速爆发)</ComboBoxItem>
                        <ComboBoxItem Tag="10">10 秒</ComboBoxItem>
                        <ComboBoxItem Tag="15">15 秒 (推荐)</ComboBoxItem>
                        <ComboBoxItem Tag="20">20 秒</ComboBoxItem>
                        <ComboBoxItem Tag="30">30 秒 (持久)</ComboBoxItem>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <!-- Row 2: Display Area & Speed -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="3">
                    <TextBlock
                        x:Name="AreaLabel"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Text="屏幕显示区域" />
                    <ComboBox
                        x:Name="AreaSelector"
                        HorizontalAlignment="Stretch"
                        SelectionChanged="OnAreaSelectionChanged">
                        <ComboBoxItem Tag="0">避开准星中心 (推荐)</ComboBoxItem>
                        <ComboBoxItem Tag="1">全屏铺满</ComboBoxItem>
                        <ComboBoxItem Tag="2">仅上半屏</ComboBoxItem>
                        <ComboBoxItem Tag="3">仅下半屏</ComboBoxItem>
                        <ComboBoxItem Tag="4">居中区域</ComboBoxItem>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock
                        x:Name="SpeedLabel"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Text="单条飞行速度" />
                    <ComboBox
                        x:Name="SpeedSelector"
                        HorizontalAlignment="Stretch"
                        SelectionChanged="OnSpeedSelectionChanged">
                        <ComboBoxItem Tag="0">平缓 (约 6 秒)</ComboBoxItem>
                        <ComboBoxItem Tag="1">标准 (约 4.5 秒)</ComboBoxItem>
                        <ComboBoxItem Tag="2">快速 (约 3.2 秒)</ComboBoxItem>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <!-- Row 3: Font Size & Font Weight & Outline & Background Toggle -->
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="3">
                    <TextBlock
                        x:Name="FontSizeLabel"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Text="字体大小" />
                    <ComboBox
                        x:Name="FontSizeSelector"
                        HorizontalAlignment="Stretch"
                        SelectionChanged="OnFontSizeSelectionChanged">
                        <ComboBoxItem Tag="12">12 px (极小)</ComboBoxItem>
                        <ComboBoxItem Tag="14">14 px (精简)</ComboBoxItem>
                        <ComboBoxItem Tag="16">16 px (推荐)</ComboBoxItem>
                        <ComboBoxItem Tag="18">18 px (标准)</ComboBoxItem>
                        <ComboBoxItem Tag="20">20 px (清晰)</ComboBoxItem>
                        <ComboBoxItem Tag="24">24 px (醒目)</ComboBoxItem>
                        <ComboBoxItem Tag="28">28 px (特大)</ComboBoxItem>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock
                        x:Name="FontWeightLabel"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Text="字体粗细" />
                    <ComboBox
                        x:Name="FontWeightSelector"
                        HorizontalAlignment="Stretch"
                        SelectionChanged="OnFontWeightSelectionChanged">
                        <ComboBoxItem Tag="0">常规 (Normal)</ComboBoxItem>
                        <ComboBoxItem Tag="1">半粗 (SemiBold)</ComboBoxItem>
                        <ComboBoxItem Tag="2">粗体 (Bold)</ComboBoxItem>
                        <ComboBoxItem Tag="3">特粗 (ExtraBold)</ComboBoxItem>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center">
                    <TextBlock
                        x:Name="OutlineLabel"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Text="文字黑色描边" />
                    <ToggleSwitch
                        x:Name="OutlineToggle"
                        MinWidth="0"
                        OffContent="无描边"
                        OnContent="黑描边"
                        Toggled="OnOutlineToggled" />
                </StackPanel>

                <StackPanel Grid.Column="3" Spacing="3" VerticalAlignment="Center">
                    <TextBlock
                        x:Name="BackgroundLabel"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Text="胶囊背景底框" />
                    <ToggleSwitch
                        x:Name="BackgroundToggle"
                        MinWidth="0"
                        OffContent="无背景"
                        OnContent="深色底框"
                        Toggled="OnBackgroundToggled" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
