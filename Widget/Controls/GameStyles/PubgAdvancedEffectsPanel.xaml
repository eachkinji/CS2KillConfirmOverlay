<UserControl
    x:Class="KillConfirmGameBar.Controls.GameStyles.PubgAdvancedEffectsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KillConfirmGameBar.Controls.GameStyles">

    <StackPanel Spacing="8">
        <TextBlock
            x:Name="TitleText"
            FontSize="13"
            FontWeight="Bold"
            Text="PUBG Effects" />
        <TextBlock
            x:Name="HintText"
            FontSize="10"
            Text="PUBG elimination text, streak captions, and PUBG assets are isolated here."
            TextWrapping="WrapWholeWords" />
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="StreakModeLabel"
                VerticalAlignment="Center"
                FontSize="10"
                FontWeight="SemiBold"
                Text="Kill streak" />
            <ComboBox
                x:Name="StreakModeSelector"
                Grid.Column="1"
                Height="28"
                Padding="7,0,12,0"
                FontSize="10"
                SelectionChanged="OnStreakModeSelectionChanged">
                <ComboBoxItem x:Name="StreakLifeItem" Tag="life">Until death</ComboBoxItem>
                <ComboBoxItem x:Name="StreakTimed5Item" Tag="timed_5">5-second window</ComboBoxItem>
                <ComboBoxItem x:Name="StreakTimed10Item" Tag="timed_10">10-second window</ComboBoxItem>
                <ComboBoxItem x:Name="StreakTimed15Item" Tag="timed_15">15-second window</ComboBoxItem>
            </ComboBox>
        </Grid>
        <local:PubgStylePanel x:Name="StylePanel" />
        <Border
            x:Name="ImportLockedNotice"
            Padding="8"
            BorderThickness="1"
            CornerRadius="10">
            <TextBlock
                x:Name="ImportLockedText"
                FontSize="10"
                Text="Built-in PUBG resources only. File import is disabled for this page."
                TextWrapping="WrapWholeWords" />
        </Border>
    </StackPanel>
</UserControl>
