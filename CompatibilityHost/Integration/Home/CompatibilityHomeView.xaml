<UserControl x:Class="KillConfirmGameBar.Features.CompatibilityDisplay.CompatibilityHomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KillConfirmGameBar.Features.CompatibilityDisplay">
    <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Controls/Settings/SettingsWorkspace.Styles.xaml"/>
    </ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
    <StackPanel Spacing="16">
        <Border x:Name="GameCard" Style="{StaticResource SettingsSectionCardStyle}">
            <Grid ColumnSpacing="18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE7FC;" FontSize="18" Foreground="#0067C0"/><TextBlock x:Name="GameTitle" FontSize="20" FontWeight="SemiBold"/></StackPanel>
                    <TextBlock x:Name="GameHint" FontSize="12" TextWrapping="Wrap"/>
                    <ComboBox x:Name="GameSelector" MinWidth="220" FontSize="13" SelectionChanged="OnGameChanged"/>
                </StackPanel>
                <Button x:Name="EffectsButton" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource SettingsHeaderButtonStyle}" Click="OnOpenEffectsClick"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE7C1;" FontSize="14"/><TextBlock x:Name="EffectsLabel" Text="战斗与视效"/></StackPanel></Button>
            </Grid>
        </Border>
        <Border x:Name="StatusCard" Style="{StaticResource SettingsSectionCardStyle}">
            <StackPanel Spacing="14">
                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE9D9;" FontSize="18" Foreground="#0067C0"/><TextBlock x:Name="StatusTitle" Text="运行状态" FontSize="16" FontWeight="SemiBold"/></StackPanel>
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border x:Name="DisplayStateBadge" CornerRadius="6" Padding="12">
                        <StackPanel Spacing="6"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE7F4;" FontSize="14"/><TextBlock x:Name="DisplayStateLabel" Text="显示端" FontSize="12"/></StackPanel><TextBlock x:Name="DisplayStateText" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="DisplayStateHint" FontSize="12" TextWrapping="Wrap"/></StackPanel>
                    </Border>
                    <Border x:Name="ServiceStateBadge" Grid.Column="1" CornerRadius="6" Padding="12">
                        <StackPanel Spacing="6"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE968;" FontSize="14"/><TextBlock x:Name="ServiceStateLabel" Text="后台服务" FontSize="12"/></StackPanel><TextBlock x:Name="ServiceStateText" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="ServiceStateHint" FontSize="12" TextWrapping="Wrap"/></StackPanel>
                    </Border>
                    <Border x:Name="GameDataBadge" Grid.Column="2" CornerRadius="6" Padding="12">
                        <StackPanel Spacing="6"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE7FC;" FontSize="14"/><TextBlock x:Name="GameDataLabel" Text="游戏数据" FontSize="12"/></StackPanel><TextBlock x:Name="GameDataText" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="GsiText" FontSize="12" TextWrapping="Wrap"/></StackPanel>
                    </Border>
                </Grid>
                <Border x:Name="RuntimeNoticeBorder" CornerRadius="6" Padding="12,9"><TextBlock x:Name="StatusText" FontSize="12" TextWrapping="Wrap" LineHeight="18"/></Border>
                <TextBlock x:Name="ServiceEndpointText" FontSize="12" TextWrapping="Wrap"/>
                <Grid ColumnSpacing="8" RowSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Button x:Name="RetryButton" Style="{StaticResource SettingsHeaderButtonStyle}" HorizontalAlignment="Stretch" Click="OnRetryClick"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE72C;" FontSize="14"/><TextBlock x:Name="RetryLabel" Text="重试连接"/></StackPanel></Button>
                    <Button x:Name="CfgButton" Grid.Column="1" Style="{StaticResource SettingsHeaderButtonStyle}" HorizontalAlignment="Stretch" Click="OnInstallCfgClick"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE90F;" FontSize="14"/><TextBlock x:Name="CfgLabel" Text="修复游戏配置"/></StackPanel></Button>
                    <Button x:Name="CopyButton" Grid.Row="1" Style="{StaticResource SettingsHeaderButtonStyle}" HorizontalAlignment="Stretch" Click="OnCopyClick"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8C8;" FontSize="14"/><TextBlock x:Name="CopyLabel" Text="复制诊断"/></StackPanel></Button>
                    <Button x:Name="LogsButton" Grid.Row="1" Grid.Column="1" Style="{StaticResource SettingsHeaderButtonStyle}" HorizontalAlignment="Stretch" Click="OnLogsClick"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8A5;" FontSize="14"/><TextBlock x:Name="LogsLabel" Text="打开日志"/></StackPanel></Button>
                </Grid>
            </StackPanel>
        </Border>
        <local:PackTestView x:Name="PackTestSectionView" VoicePackSelectionChanged="OnVoicePackSelectionChanged"
            IconPackSelectionChanged="OnIconPackSelectionChanged" AudioVolumeSelectionChanged="OnAudioVolumeSelectionChanged"
            AdvancedEffectsRequested="OnOpenEffectsClick" TestEventRequested="OnTestEventClick"
            RepeatTestRequested="OnRepeatTestClick" ReloadAudioRequested="OnReloadAudioClick"/>
    </StackPanel>
</UserControl>
