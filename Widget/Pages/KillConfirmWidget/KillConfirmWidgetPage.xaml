<Page
    x:Class="KillConfirmGameBar.KillConfirmWidgetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:KillConfirmGameBar.Controls"
    xmlns:danmaku="using:KillConfirmGameBar.Danmaku"
    xmlns:settings="using:KillConfirmGameBar.Controls.Settings"
    xmlns:sections="using:KillConfirmGameBar"
    xmlns:primitives="using:Windows.UI.Xaml.Controls.Primitives"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    RequestedTheme="Light">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Pages/KillConfirmWidget/KillConfirmWidgetPage.Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <!-- 根容器不设背景、不参与命中测试，透明区域点击可穿透到游戏；仅交互面板命中 -->
    <Grid
        x:Name="LayoutRoot"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch">

        <danmaku:DanmakuOverlay
            x:Name="DanmakuOverlayControl"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            IsHitTestVisible="False"
            Canvas.ZIndex="15" />
        <Grid
            x:Name="LowerFeedbackLayer"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <CompositeTransform x:Name="LowerFeedbackTransform" />
            </Grid.RenderTransform>

            <controls:KillConfirmAnimation
                x:Name="LowerFeedbackAnimation"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" />

            <controls:KillConfirmAnimation
                x:Name="LowerBadgeAnimation"
                Margin="0,-128,0,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" />

            <Grid
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="LowerDragOutlineTransform" />
                </Grid.RenderTransform>
                <Border
                    x:Name="LowerDragOutline"
                    Width="400"
                    Height="300"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderBrush="#EF4444"
                    BorderThickness="2"
                    CornerRadius="4"
                    Opacity="0.85"
                    Visibility="Collapsed"
                    PointerPressed="OnAnimationFramePointerPressed"
                    PointerMoved="OnAnimationFramePointerMoved"
                    PointerReleased="OnAnimationFramePointerReleased"
                    PointerCanceled="OnAnimationFramePointerCanceled"
                    PointerCaptureLost="OnAnimationFramePointerCaptureLost"
                    PointerWheelChanged="OnAnimationFramePointerWheelChanged"
                    PointerEntered="OnAnimationFramePointerEntered"
                    PointerExited="OnAnimationFramePointerExited"
                    ContextRequested="OnAnimationFrameContextRequested"
                    ToolTipService.ToolTip="Lower feedback" />
                <Border
                    x:Name="LowerDragHint"
                    MaxWidth="360"
                    Padding="6,2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Background="#D91F1518"
                    BorderBrush="#F87171"
                    BorderThickness="1"
                    CornerRadius="4"
                    IsHitTestVisible="False"
                    Visibility="Collapsed"
                    SizeChanged="OnAnimationDragHintSizeChanged">
                    <Border.RenderTransform>
                        <TranslateTransform />
                    </Border.RenderTransform>
                    <TextBlock
                        x:Name="LowerDragHintText"
                        HorizontalAlignment="Stretch"
                        Foreground="White"
                        FontSize="10"
                        FontWeight="SemiBold"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </Border>
                <Ellipse
                    x:Name="LowerDragCenterDot"
                    Width="6"
                    Height="6"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Fill="White"
                    Stroke="#E6000000"
                    StrokeThickness="1"
                    IsHitTestVisible="False"
                    Visibility="Collapsed" />
            </Grid>
        </Grid>

        <Grid
            x:Name="CrosshairFeedbackLayer"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <CompositeTransform x:Name="CrosshairFeedbackTransform" />
            </Grid.RenderTransform>

            <controls:KillConfirmAnimation
                x:Name="CrosshairFeedbackAnimation"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" />

            <Grid
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="CrosshairDragOutlineTransform" />
                </Grid.RenderTransform>
                <Border
                    x:Name="CrosshairDragOutline"
                    Width="320"
                    Height="320"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderBrush="#F59E0B"
                    BorderThickness="2"
                    CornerRadius="4"
                    Opacity="0.85"
                    Visibility="Collapsed"
                    PointerPressed="OnAnimationFramePointerPressed"
                    PointerMoved="OnAnimationFramePointerMoved"
                    PointerReleased="OnAnimationFramePointerReleased"
                    PointerCanceled="OnAnimationFramePointerCanceled"
                    PointerCaptureLost="OnAnimationFramePointerCaptureLost"
                    PointerWheelChanged="OnAnimationFramePointerWheelChanged"
                    PointerEntered="OnAnimationFramePointerEntered"
                    PointerExited="OnAnimationFramePointerExited"
                    ContextRequested="OnAnimationFrameContextRequested"
                    ToolTipService.ToolTip="Crosshair feedback" />
                <Border
                    x:Name="CrosshairDragHint"
                    MaxWidth="360"
                    Padding="6,2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Background="#D91F1518"
                    BorderBrush="#FCD34D"
                    BorderThickness="1"
                    CornerRadius="4"
                    IsHitTestVisible="False"
                    Visibility="Collapsed"
                    SizeChanged="OnAnimationDragHintSizeChanged">
                    <Border.RenderTransform>
                        <TranslateTransform />
                    </Border.RenderTransform>
                    <TextBlock
                        x:Name="CrosshairDragHintText"
                        HorizontalAlignment="Stretch"
                        Foreground="White"
                        FontSize="10"
                        FontWeight="SemiBold"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </Border>
                <Ellipse
                    x:Name="CrosshairDragCenterDot"
                    Width="6"
                    Height="6"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Fill="White"
                    Stroke="#E6000000"
                    StrokeThickness="1"
                    IsHitTestVisible="False"
                    Visibility="Collapsed" />
            </Grid>
        </Grid>

        <Grid
            x:Name="UpperFeedbackLayer"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <CompositeTransform x:Name="UpperFeedbackTransform" />
            </Grid.RenderTransform>

            <controls:KillConfirmAnimation
                x:Name="UpperFeedbackAnimation"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" />

            <Grid
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="UpperDragOutlineTransform" />
                </Grid.RenderTransform>
                <Border
                    x:Name="UpperDragOutline"
                    Width="496"
                    Height="198"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderBrush="#06B6D4"
                    BorderThickness="2"
                    CornerRadius="4"
                    Opacity="0.85"
                    Visibility="Collapsed"
                    PointerPressed="OnAnimationFramePointerPressed"
                    PointerMoved="OnAnimationFramePointerMoved"
                    PointerReleased="OnAnimationFramePointerReleased"
                    PointerCanceled="OnAnimationFramePointerCanceled"
                    PointerCaptureLost="OnAnimationFramePointerCaptureLost"
                    PointerWheelChanged="OnAnimationFramePointerWheelChanged"
                    PointerEntered="OnAnimationFramePointerEntered"
                    PointerExited="OnAnimationFramePointerExited"
                    ContextRequested="OnAnimationFrameContextRequested"
                    ToolTipService.ToolTip="Upper feedback" />
                <Border
                    x:Name="UpperDragHint"
                    MaxWidth="360"
                    Padding="6,2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Background="#D91F1518"
                    BorderBrush="#67E8F9"
                    BorderThickness="1"
                    CornerRadius="4"
                    IsHitTestVisible="False"
                    Visibility="Collapsed"
                    SizeChanged="OnAnimationDragHintSizeChanged">
                    <Border.RenderTransform>
                        <TranslateTransform />
                    </Border.RenderTransform>
                    <TextBlock
                        x:Name="UpperDragHintText"
                        HorizontalAlignment="Stretch"
                        Foreground="White"
                        FontSize="10"
                        FontWeight="SemiBold"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </Border>
                <Ellipse
                    x:Name="UpperDragCenterDot"
                    Width="6"
                    Height="6"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Fill="White"
                    Stroke="#E6000000"
                    StrokeThickness="1"
                    IsHitTestVisible="False"
                    Visibility="Collapsed" />
            </Grid>
        </Grid>

        <Border
            x:Name="ControlPanel"
            Margin="5"
            Padding="4"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Width="452"
            MaxWidth="452"
            Background="#F4FAFAF7"
            BorderBrush="#E2DDD3"
            BorderThickness="1"
            CornerRadius="18">
            <Grid>
                <Grid x:Name="MainPanelContent" RowSpacing="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <sections:HeaderStatusView
                    x:Name="HeaderStatusSection"
                    LanguageToggleRequested="OnLanguageToggleClick"
                    OpenGuideRequested="OnOpenGuideClick"
                    UpdateRequested="OnUpdateClick"
                    GameStyleSelectionChanged="OnGameStyleSelectionChanged" />

                <sections:StatusDetailsView
                    x:Name="StatusDetailsSection"
                    Grid.Row="1"
                    RetryServiceRequested="OnRetryServiceClick"
                    CopyDiagnosticRequested="OnCopyServiceDiagnosticClick"
                    FreePortRequested="OnFreePortClick"
                    OpenLogsRequested="OnOpenLogsClick"
                    SelectCsFolderRequested="OnSelectCsFolderClick"
                    InstallCfgRequested="OnInstallCfgClick" />


                <sections:PackTestView
                    x:Name="PackTestSectionView"
                    Grid.Row="2"
                    Margin="0,5,0,0"
                    VoicePackSelectionChanged="OnVoicePackSelectionChanged"
                    IconPackSelectionChanged="OnIconPackSelectionChanged"
                    AdvancedEffectsRequested="OnAdvancedEffectsButtonClick"
                    AudioVolumeSelectionChanged="OnAudioVolumeSelectionChanged"
                    TestEventRequested="OnTestEventClick"
                    RepeatTestRequested="OnRepeatTestClick"
                    ReloadAudioRequested="OnReloadAudioClick" />

                <sections:VisualSettingsView
                    x:Name="VisualSettingsSectionView"
                    Grid.Row="3"
                    Margin="0,5,0,0"
                    ResizeRequested="OnResizeClick"
                    FitScreenRequested="OnFitScreenClick"
                    CenterRequested="OnCenterClick"
                    WindowTopRequested="OnWindowTopClick"
                    WindowBottomRequested="OnWindowBottomClick"
                    ControlPanelCenterRequested="OnControlPanelCenterClick"
                    ResetVisualRequested="OnResetVisualAdjustmentsClick"
                    BrightnessSelectionChanged="OnBrightnessSelectionChanged"
                    ContrastSelectionChanged="OnContrastSelectionChanged"
                    PlaybackFpsSelectionChanged="OnPlaybackFpsSelectionChanged" />

                <Button
                    x:Name="PanelCollapseBar"
                    Grid.Row="4"
                    Margin="0,3,0,0"
                    Style="{StaticResource PanelToggleBarButtonStyle}"
                    Click="OnCollapsePanelToggle"
                    ToolTipService.ToolTip="Collapse panel">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="9"
                            Glyph="&#xE70E;" />
                        <TextBlock
                            x:Name="PanelCollapseBarText"
                            VerticalAlignment="Center"
                            FontSize="9"
                            FontWeight="Normal"
                            Text="Collapse" />
                    </StackPanel>
                </Button>
            </Grid>
            <StackPanel
                x:Name="MiniPanel"
                MinWidth="72"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="Transparent"
                Visibility="Collapsed">
                <StackPanel
                    Margin="0,0,0,3"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="MiniSendTestButton"
                        Style="{StaticResource PackImportantIconButtonStyle}"
                        Click="OnTestEventClick"
                        ToolTipService.ToolTip="Send selected test event">
                        <Grid Style="{StaticResource IconHostStyle}">
                            <PathIcon Foreground="#FFFFFF" Style="{StaticResource FluentPathIconStyle}" Data="M15 4.24951C15 3.17089 13.7255 2.59866 12.9195 3.31534L8.42794 7.30861C8.29065 7.43067 8.11333 7.4981 7.92961 7.4981H4.25C3.00736 7.4981 2 8.50546 2 9.7481V14.246C2 15.4886 3.00736 16.496 4.25 16.496H7.92956C8.11329 16.496 8.29063 16.5634 8.42793 16.6855L12.9194 20.6792C13.7255 21.396 15 20.8238 15 19.7451V4.24951Z" />
                        </Grid>
                    </Button>
                    <Button
                        x:Name="MiniRepeatTestButton"
                        Style="{StaticResource PackImportantIconButtonStyle}"
                        Click="OnRepeatTestClick"
                        ToolTipService.ToolTip="反复播放测试">
                        <Grid Style="{StaticResource IconHostStyle}">
                            <TextBlock
                                Text="&#x21BB;"
                                FontSize="14"
                                FontWeight="Bold"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="#FFFFFF" />
                        </Grid>
                    </Button>
                </StackPanel>
                <Button
                    x:Name="MiniPanelExpandBar"
                    Style="{StaticResource PanelToggleBarButtonStyle}"
                    Click="OnCollapsePanelToggle"
                    ToolTipService.ToolTip="Expand panel">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="9"
                            Glyph="&#xE70D;" />
                        <TextBlock
                            x:Name="MiniPanelExpandBarText"
                            VerticalAlignment="Center"
                            FontSize="9"
                            FontWeight="Normal"
                            Text="Open" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>

        <Grid
            x:Name="GameBarSetupGuideLayer"
            Canvas.ZIndex="20"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <Grid.Transitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="18" />
                </TransitionCollection>
            </Grid.Transitions>

            <StackPanel
                x:Name="ClickThroughSetupGuide"
                Width="286"
                Margin="12,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Visibility="Collapsed">
                <Grid Height="9">
                    <Path
                        Width="18"
                        Height="9"
                        Margin="0,0,90,0"
                        HorizontalAlignment="Right"
                        Data="M 0,9 L 9,0 L 18,9 Z"
                        Fill="#F21E1E1E"
                        Stretch="Fill" />
                </Grid>
                <Border
                    Margin="0,-1,0,0"
                    Padding="10"
                    Background="#F21E1E1E"
                    BorderBrush="#FF4B4B4B"
                    BorderThickness="1"
                    CornerRadius="7">
                    <StackPanel Spacing="8">
                        <Image
                            x:Name="ClickThroughSetupGuideImage"
                            Width="252"
                            Height="158"
                            HorizontalAlignment="Center"
                            Stretch="Uniform" />
                        <StackPanel
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <FontIcon
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="15"
                                Foreground="#FFFFC857"
                                Glyph="&#xE7BA;" />
                            <TextBlock
                                x:Name="ClickThroughSetupGuideText"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="请在顶部工具栏关闭“单击浏览”" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Grid
                x:Name="PinSetupGuide"
                Width="220"
                Margin="4,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Visibility="Collapsed">
                <Path
                    Width="18"
                    Height="9"
                    Margin="0,0,32,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Data="M 0,9 L 9,0 L 18,9 Z"
                    Fill="#F21E1E1E"
                    Stretch="Fill" />
                <Border
                    Margin="0,8,0,0"
                    Padding="12,7"
                    Background="#F21E1E1E"
                    BorderBrush="#FF4B4B4B"
                    BorderThickness="1"
                    CornerRadius="7">
                    <TextBlock
                        x:Name="PinSetupGuideText"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="点击上方图钉固定窗口" />
                </Border>
            </Grid>
        </Grid>

        <controls:UpdateOverlayView x:Name="UpdateOverlay" Canvas.ZIndex="30" Visibility="Collapsed" />
    </Grid>
</Page>
